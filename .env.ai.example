# Sao chép thành .env.ai và sửa đường dẫn tuyệt đối.
# Đổi giá trị này nếu workspace được di chuyển.
export AI_WORKSPACE_ROOT="/Users/cmc/Documents/Memories"
export AI_ROOT="$AI_WORKSPACE_ROOT/ai"
export CLAUDE_CONFIG_DIR="$HOME/.project-ai/claude"
export CODEX_HOME="$HOME/.project-ai/codex"

# Có thể thay bằng đường dẫn executable hoặc wrapper nội bộ.
export CLAUDE_COMMAND="claude"
export CODEX_COMMAND="codex"

# CodeGraph: optional (fallback sang tool thường), required (fail-fast), hoặc off.
# Cài CLI riêng theo https://github.com/colbymchenry/codegraph rồi chạy
# ./ai/bin/ai task codegraph <TASK-ID> --init cho từng task.
export AI_CODEGRAPH_MODE="optional"
export CODEGRAPH_COMMAND="codegraph"

# Memory (TencentDB Agent Memory, đã clone sẵn tại services/tencentdb-agent-memory/):
# off theo mặc định — bật rõ ràng bằng AI_MEMORY_ENABLED khi đã chạy service cục bộ.
# AI_MEMORY_ENABLED=false là kill switch toàn cục: task.yaml không thể bật memory
# nếu biến này còn false. Xem ai/integrations/memory/provider-contract.md.
export AI_MEMORY_ENABLED="false"
export AI_MEMORY_PROVIDER="tencentdb"
export AI_MEMORY_SERVICE_ROOT="$AI_WORKSPACE_ROOT/services/tencentdb-agent-memory"
# Cổng mặc định theo tài liệu upstream (INSTALL.md): MemoryCore 8420, Knowledge 8424.
export AI_MEMORY_BASE_URL="http://127.0.0.1:8420"
export AI_MEMORY_KNOWLEDGE_BASE_URL="http://127.0.0.1:8424"
export AI_MEMORY_TIMEOUT_SECONDS="10"
# Đặt giá trị thật trong .env.ai cục bộ (không commit); để trống nghĩa là chưa cấu hình auth.
export AI_MEMORY_API_KEY=""
# Namespace isolation. Đổi các giá trị này khi nhiều workspace dùng chung service.
export AI_MEMORY_SERVICE_ID="default"
export AI_MEMORY_TEAM_ID="default"
export AI_MEMORY_AGENT_ID="claude"
export AI_MEMORY_USER_ID="workspace"

# Không đặt token hoặc credential trực tiếp trong file được commit.
# [BỔ SUNG THEO DỰ ÁN]: khai báo biến môi trường không nhạy cảm cần cho lint/test/build.

# Thời gian tối đa cho một phiên agent; hết hạn task chuyển blocked thay vì treo vô hạn.
export CLAUDE_TIMEOUT_SECONDS="3600"
export CODEX_TIMEOUT_SECONDS="1800"
# Ngưỡng cảnh báo/breach context; phải là số nguyên dương.
export AI_WARN_CONTEXT_TOKENS="60000"
export AI_MAX_CONTEXT_TOKENS="80000"
