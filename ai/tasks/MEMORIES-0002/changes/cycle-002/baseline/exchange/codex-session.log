## Acceptance criteria

1. Account được sử dụng làm principal xác thực duy nhất cho cả public-web và admin-web.

2. Không tạo Account riêng cho public và admin.

3. UserProfile được đặt trong module `user-profiles`, không nằm trong module `customers`.

4. Customer không được tạo tự động khi tạo Account.

5. Account, AuthIdentity và UserProfile được triển khai đầy đủ theo các layer hiện tại.

6. Một Account có thể có nhiều AuthIdentity.

7. Một Account chỉ có tối đa một UserProfile.

8. LOCAL AuthIdentity sử dụng phone đã normalize và password hash.

9. Login bằng email không còn hoạt động.

10. Public web đăng nhập với portal `PUBLIC`.

11. Admin web đăng nhập với portal `ADMIN`.

12. Backend tự map portal sang permission tương ứng.

13. Account phải có `portal.public.access` để đăng nhập public nếu hệ thống áp dụng kiểm soát explicit cho public portal.

14. Account phải có `portal.admin.access` để đăng nhập admin.

15. Account thiếu permission portal không được phát token hoặc tạo refresh session cho portal đó.

16. Không controller hoặc use case nào hard-code role để kiểm tra quyền truy cập portal.

17. Role chỉ là nhóm permission.

18. Account inactive, locked hoặc deleted không thể login hoặc refresh.

19. Access token tiếp tục được lưu trong memory.

20. Refresh token tiếp tục được lưu trong HttpOnly cookie.

21. Refresh session được gắn với portal.

22. JWT hoặc session có thể phân biệt public và admin portal.

23. Token public không thể truy cập admin API nếu không hợp lệ về audience hoặc portal.

24. Password không được lưu dưới dạng plain text.

25. Password hash không xuất hiện trong API response, log hoặc audit record.

26. Account, AuthIdentity và UserProfile có đầy đủ audit fields.

27. Audit actor được lấy từ request context.

28. Hai request đồng thời không bị lẫn context.

29. Tạo Account, AuthIdentity, UserProfile và default role được thực hiện trong cùng transaction.

30. Account CRUD API hoạt động và được bảo vệ bằng permission.

31. UserProfile CRUD API hoạt động và được bảo vệ bằng permission.

32. Xóa hoặc khóa Account làm mất hiệu lực session hiện tại.

33. Không sử dụng TypeORM relation trực tiếp xuyên module.

34. Không trả ORM entity trực tiếp từ controller.

35. Swagger/OpenAPI được cập nhật.

36. API client frontend được cập nhật hoặc regenerate thành công.

37. Migration chạy thành công trên database trống.

38. Seed Role và Permission chạy nhiều lần không tạo dữ liệu trùng.

39. Mock authentication được xóa khỏi backend và frontend.

40. Unit test, integration test, E2E test, lint, typecheck và build đều thành công.

## Out of scope

* Tích hợp Google OAuth thực tế.
* Tích hợp Apple Sign In thực tế.
* Tích hợp Facebook Login thực tế.
* OTP số điện thoại.
* Xác minh số điện thoại.
* Quên mật khẩu qua SMS hoặc email.
* Multi-factor authentication.
* Passkey hoặc WebAuthn.
* Account linking giữa nhiều provider.
* CRUD Role và Permission hoàn chỉnh.
* Giao diện quản trị Role và Permission.
* Data scope nâng cao.
* Attribute-based access control.
* Tạo model Customer.
* Tạo model Staff.
* CRM hoặc loyalty program.
* Import hàng loạt Account.
* Xóa vật lý Account hoặc UserProfile.
import { UNIT_OF_WORK } from '@memories/platform/database';
import {
  TokenService,
  TOKEN_SERVICE,
  UserProfileLookup,
  USER_PROFILE_LOOKUP,
} from '@memories/platform/security';
import {
  CLOCK,
  Clock,
  ID_GENERATOR,
  IdGenerator,
  UniqueEntityId,
  UnitOfWork,
  UseCase,
} from '@memories/shared/kernel';
import { ForbiddenException, Inject, Injectable, UnauthorizedException } from '@nestjs/common';

import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import { Portal } from '../../domain/sessions/portal';
import { RefreshSession } from '../../domain/sessions/refresh-session';
import {
  REFRESH_SESSION_REPOSITORY,
  RefreshSessionRepository,
} from '../../domain/sessions/refresh-session.repository';

export interface RefreshSessionInput {
  refreshToken: string;
  ipAddress: string | null;
  userAgent: string | null;
}

export interface RefreshSessionOutput {
  accessToken: string;
  refreshToken: string;
  refreshTokenExpiresAt: Date;
  portal: Portal;
  sessionId: string;
}

/**
 * Rotates the refresh token on every use (docs/guides/authentication-flow.md): the old
 * `RefreshSession` is revoked and points at the new one via `replacedBySessionId`, so a replayed
 * old refresh token (e.g. stolen and used after the legitimate client already rotated) can be
 * told apart from a session that merely expired — both fail, but this is what makes theft
 * detectable in the session table rather than silently accepted.
 *
 * The revoke-old/create-new step runs as one atomic compare-and-swap
 * (`RefreshSessionRepository.revokeIfActive`, `UPDATE ... WHERE revoked_at IS NULL`) inside the
 * transaction rather than a read-then-write, so two concurrent refresh calls for the same token
 * can't both observe the session as active and both mint a new session — only the request whose
 * `UPDATE` actually flips the row wins; the loser gets rejected as if the session were already
 * inactive.
 */
@Injectable()
export class RefreshSessionUseCase implements UseCase<RefreshSessionInput, RefreshSessionOutput> {
  constructor(
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,
    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,
    @Inject(USER_PROFILE_LOOKUP) private readonly userProfileLookup: UserProfileLookup,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: RefreshSessionInput): Promise<RefreshSessionOutput> {
    let claims;
    try {
      claims = await this.tokenService.verifyRefreshToken(input.refreshToken);
    } catch {
      throw new UnauthorizedException('Invalid or expired refresh token');
    }

    const sessionId = typeof claims.sessionId === 'string' ? claims.sessionId : undefined;
    const portal = typeof claims.portal === 'string' ? (claims.portal as Portal) : undefined;
    if (!sessionId || !portal) {
      throw new UnauthorizedException('Malformed refresh token');
    }

    const now = this.clock.now();
    const currentSession = await this.refreshSessions.findById(new UniqueEntityId(sessionId));
    if (!currentSession || !currentSession.isActive(now)) {
      throw new UnauthorizedException('Refresh session is no longer active');
    }

    const account = await this.accounts.findById(new UniqueEntityId(claims.subject));
    if (!account || !account.canAuthenticate()) {
      await this.refreshSessions.revokeIfActive(sessionId, now);
      throw new ForbiddenException('Account is not active');
    }

    const userProfileId = await this.userProfileLookup.findProfileIdByAccountId(claims.subject);

    return this.unitOfWork.withTransaction(async () => {
      const newSessionId = new UniqueEntityId(this.idGenerator.generate());

      const revoked = await this.refreshSessions.revokeIfActive(sessionId, now, newSessionId.toValue());
      if (!revoked) {
        throw new UnauthorizedException('Refresh session is no longer active');
      }

      const [accessIssued, refreshIssued] = await Promise.all([
        this.tokenService.issueAccessToken({
          subject: claims.subject,
          sessionId: newSessionId.toValue(),
          portal,
          authProvider: AuthProvider.Local,
          userProfileId: userProfileId ?? undefined,
          tokenVersion: account.tokenVersion,
        }),
        this.tokenService.issueRefreshToken({
          subject: claims.subject,
          sessionId: newSessionId.toValue(),
          portal,
        }),
      ]);

      const newSession = RefreshSession.create(
        {
          accountId: claims.subject,
          portal,
          authProvider: AuthProvider.Local,
          ipAddress: input.ipAddress,
          userAgent: input.userAgent,
          issuedAt: now,
          expiresAt: refreshIssued.expiresAt,
          revokedAt: null,
          replacedBySessionId: null,
        },
        newSessionId,
      );
      await this.refreshSessions.save(newSession);

      return {
        accessToken: accessIssued.token,
        refreshToken: refreshIssued.token,
        refreshTokenExpiresAt: refreshIssued.expiresAt,
        portal,
        sessionId: newSessionId.toValue(),
      };
    });
  }
}
import { AuthConfig } from '@memories/platform/configuration';
import {
  buildRefreshCookieOptions,
  CurrentUser,
  JwtAuthGuard,
  OriginGuard,
  readRefreshCookie,
  RequestUser,
} from '@memories/platform/security';
import { Body, Controller, HttpCode, HttpStatus, Post, Req, Res, UnauthorizedException, UseGuards } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { ApiBearerAuth, ApiResponse, ApiTags } from '@nestjs/swagger';
import type { Request, Response } from 'express';

import { LoginUseCase } from '../../application/use-cases/login.use-case';
import { LogoutUseCase } from '../../application/use-cases/logout.use-case';
import { RefreshSessionUseCase } from '../../application/use-cases/refresh-session.use-case';

import { LoginResponseDto, RefreshResponseDto } from './auth-response.dto';
import { LoginDto } from './login.dto';

/**
 * §9/§10/§13 login/refresh/logout. No `@RequirePermissions` here — portal authorization runs
 * *inside* `LoginUseCase` via `PermissionChecker` (DEC-001), not through the HTTP guard layer, so
 * a missing-permission failure and a bad-credential failure both surface as the use case's own
 * exception rather than a route-level 403 before the use case even runs.
 */
@ApiTags('auth')
@Controller('auth')
export class AuthController {
  constructor(
    private readonly loginUseCase: LoginUseCase,
    private readonly refreshSessionUseCase: RefreshSessionUseCase,
    private readonly logoutUseCase: LogoutUseCase,
    private readonly configService: ConfigService,
  ) {}

  @Post('login')
  @HttpCode(HttpStatus.OK)
  @ApiResponse({ status: HttpStatus.OK, type: LoginResponseDto })
  async login(
    @Body() dto: LoginDto,
    @Req() req: Request,
    @Res({ passthrough: true }) res: Response,
  ): Promise<LoginResponseDto> {
    const result = await this.loginUseCase.execute({
      phone: dto.phone,
      password: dto.password,
      portal: dto.portal,
      ipAddress: req.ip ?? null,
      userAgent: req.header('user-agent') ?? null,
    });

    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));

    return {
      accessToken: result.accessToken,
      portal: result.portal,
      sessionId: result.sessionId,
      roles: result.roles,
      permissions: result.permissions,
    };
  }

  @Post('refresh')
  @UseGuards(OriginGuard)
  @HttpCode(HttpStatus.OK)
  @ApiResponse({ status: HttpStatus.OK, type: RefreshResponseDto })
  async refresh(
    @Req() req: Request,
    @Res({ passthrough: true }) res: Response,
  ): Promise<RefreshResponseDto> {
    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    const refreshToken = readRefreshCookie(req.headers.cookie, auth);
    if (!refreshToken) {
      throw new UnauthorizedException('Missing refresh token');
    }

    const result = await this.refreshSessionUseCase.execute({
      refreshToken,
      ipAddress: req.ip ?? null,
      userAgent: req.header('user-agent') ?? null,
    });

    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));

    return { accessToken: result.accessToken, portal: result.portal, sessionId: result.sessionId };
  }

  @Post('logout')
  @UseGuards(JwtAuthGuard)
  @ApiBearerAuth()
  @HttpCode(HttpStatus.NO_CONTENT)
  @ApiResponse({ status: HttpStatus.NO_CONTENT })
  async logout(
    @CurrentUser() user: RequestUser,
    @Res({ passthrough: true }) res: Response,
  ): Promise<void> {
    if (user.sessionId) {
      await this.logoutUseCase.execute({ sessionId: user.sessionId });
    }
    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    res.clearCookie(auth.refreshCookie.name, buildRefreshCookieOptions(auth));
  }
}
import { AppConfig } from '@memories/platform/configuration';
import { CanActivate, ExecutionContext, ForbiddenException, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import type { Request } from 'express';

/**
 * CSRF/origin defense (§19 "Refresh endpoint áp dụng CSRF/origin protection hiện tại") for
 * endpoints that authenticate purely off an ambient HttpOnly cookie — currently only
 * `POST /auth/refresh`. A cross-site page can make a victim's browser send that cookie
 * automatically (that's exactly what a cookie is for), so the cookie alone is not proof the
 * request originated from our own frontend; the `Origin` header a real browser attaches to every
 * fetch/XHR `POST` is. `login`/`logout` don't need this guard: `login` doesn't rely on any ambient
 * authority to forge, and `logout` requires a bearer access token, which cross-site requests can't
 * attach automatically the way cookies are.
 *
 * No-ops (allows the request through) when `CORS_ORIGIN` is unset, so a deployment that hasn't
 * configured an allowlist yet isn't hard-blocked from calling its own refresh endpoint.
 */
@Injectable()
export class OriginGuard implements CanActivate {
  constructor(private readonly configService: ConfigService) {}

  canActivate(context: ExecutionContext): boolean {
    const app = this.configService.getOrThrow<AppConfig>('app');
    if (app.corsOrigins.length === 0) {
      return true;
