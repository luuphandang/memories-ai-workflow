diff --git a/libs/platform/security/src/refresh-cookie.helper.ts b/libs/platform/security/src/refresh-cookie.helper.ts
index 1f6be38..80aabc6 100644
--- a/libs/platform/security/src/refresh-cookie.helper.ts
+++ b/libs/platform/security/src/refresh-cookie.helper.ts
@@ -1,19 +1,39 @@
 import { AuthConfig } from '@memories/platform/configuration';
 
 export interface CookieOptions {
   httpOnly: boolean;
   secure: boolean;
   sameSite: 'lax' | 'strict' | 'none';
   domain: string;
   path: string;
 }
 
 export function buildRefreshCookieOptions(config: AuthConfig): CookieOptions {
   return {
     httpOnly: true,
     secure: config.refreshCookie.secure,
     sameSite: config.refreshCookie.secure ? 'none' : 'lax',
     domain: config.refreshCookie.domain,
     path: '/',
   };
 }
+
+/** No `cookie-parser` middleware is registered app-wide (nothing else needs `req.cookies`), so the
+ * refresh cookie is read directly off the raw `Cookie` header instead of adding a new dependency
+ * for a single lookup. */
+export function readRefreshCookie(cookieHeader: string | undefined, config: AuthConfig): string | undefined {
+  if (!cookieHeader) {
+    return undefined;
+  }
+  for (const part of cookieHeader.split(';')) {
+    const separatorIndex = part.indexOf('=');
+    if (separatorIndex === -1) {
+      continue;
+    }
+    const name = part.slice(0, separatorIndex).trim();
+    if (name === config.refreshCookie.name) {
+      return decodeURIComponent(part.slice(separatorIndex + 1).trim());
+    }
+  }
+  return undefined;
+}
