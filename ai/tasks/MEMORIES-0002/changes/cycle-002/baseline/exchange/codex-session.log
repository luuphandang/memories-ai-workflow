-  constructor(@Inject(CLI_COMMANDS) commands: CliCommand[]) {
+  constructor(
+    @Inject(CLI_COMMANDS) commands: CliCommand[],
+    private readonly requestContext: RequestContext,
+  ) {
     this.commands = new Map(commands.map((command) => [command.name, command]));
   }
 
   async run(argv: string[]): Promise<void> {
     const [commandName, ...args] = argv;
     const command = commandName ? this.commands.get(commandName) : undefined;
 
     if (!command) {
       this.logger.error(
         `Unknown command "${commandName}". Available: ${[...this.commands.keys()].join(', ')}`,
       );
       process.exitCode = 1;
       return;
     }
 
