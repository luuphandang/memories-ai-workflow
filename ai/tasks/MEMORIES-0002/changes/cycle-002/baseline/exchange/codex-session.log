function toResponseDto(output: UserProfileOutput): UserProfileResponseDto {
  return {
    id: output.id,
    accountId: output.accountId,
    fullName: output.fullName,
    email: output.email,
    avatarId: output.avatarId,
    dateOfBirth: output.dateOfBirth ? output.dateOfBirth.toISOString().slice(0, 10) : null,
    address: output.address,
    createdAt: output.createdAt,
    updatedAt: output.updatedAt,
  };
}

