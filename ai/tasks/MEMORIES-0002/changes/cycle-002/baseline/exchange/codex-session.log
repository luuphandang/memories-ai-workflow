  ExecutionContext,
  Inject,
  Injectable,
  Optional,
  UnauthorizedException,
} from '@nestjs/common';
import type { Request } from 'express';

import { ACCOUNT_LOOKUP, AccountLookup } from './identity.contracts';
import { RequestContext } from './request-context';
import { TOKEN_SERVICE, TokenService } from './token.contract';

export interface RequestUser {
  id: string;
  sessionId?: string | undefined;
  portal?: string | undefined;
  userProfileId?: string | undefined;
  authProvider?: string | undefined;
}

/**
 * Verifies the `Authorization: Bearer <access token>` header via `TokenService` and attaches
 * `request.user`. Business modules apply this guard on any endpoint that must know "who is
 * calling" (e.g. an ownership check) — they never verify JWTs themselves.
 *
 * Also enriches the ambient `RequestContext` (§14) with the resolved actor's claims, when a
 * `RequestContextMiddleware` has already seeded one for this request — `@Optional()` because
 * `RequestContext` is only wired for HTTP apps (apps/api); this guard's unit tests construct it
 * directly without a Nest DI container, so `requestContext` is `undefined` there too.
 *
 * A verified signature/expiry only proves the token was genuinely issued — it says nothing about
 * whether the Account has since been locked, deleted or had its password changed (§19 "Protected
 * request kiểm tra Account status"). `AccountLookup` (implemented by identity-access, injected the
 * same way `PermissionsGuard` injects `PERMISSION_CHECKER` — a platform-declared port, not a direct
 * cross-module import) gives a live status + `tokenVersion` read on every protected request, so an
 * already-issued access token stops working the moment the Account is locked/deleted (`isActive`
 * flips) or the password changes (`tokenVersion` bumps) — not just once it naturally expires.
 * `@Optional()` for the same reason as `requestContext`: this guard's plain unit tests construct it
 * without a DI container and only exercise pure JWT verification.
 */
@Injectable()
export class JwtAuthGuard implements CanActivate {
  constructor(
    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,
    @Optional() private readonly requestContext?: RequestContext,
    @Optional() @Inject(ACCOUNT_LOOKUP) private readonly accountLookup?: AccountLookup,
  ) {}

  async canActivate(context: ExecutionContext): Promise<boolean> {
    const request = context.switchToHttp().getRequest<Request & { user?: RequestUser }>();
    const header = request.headers.authorization;
    if (!header?.startsWith('Bearer ')) {
      throw new UnauthorizedException('Missing bearer token');
    }

    let claims;
    try {
      claims = await this.tokenService.verifyAccessToken(header.slice('Bearer '.length));
    } catch {
      throw new UnauthorizedException('Invalid or expired access token');
    }

    if (this.accountLookup) {
      const authState = await this.accountLookup.getAuthState(claims.subject);
      const claimedTokenVersion = typeof claims.tokenVersion === 'number' ? claims.tokenVersion : 0;
      if (!authState || !authState.isActive || authState.tokenVersion !== claimedTokenVersion) {
        throw new UnauthorizedException('Account is no longer authorized to use this token');
      }
    }

    const user: RequestUser = {
      id: claims.subject,
      sessionId: typeof claims.sessionId === 'string' ? claims.sessionId : undefined,
      portal: typeof claims.portal === 'string' ? claims.portal : undefined,
      userProfileId: typeof claims.userProfileId === 'string' ? claims.userProfileId : undefined,
      authProvider: typeof claims.authProvider === 'string' ? claims.authProvider : undefined,
    };
    request.user = user;

    const store = this.requestContext?.get();
    if (store) {
      store.accountId = user.id;
      store.sessionId = user.sessionId ?? null;
      store.portal = user.portal ?? null;
      store.userProfileId = user.userProfileId ?? null;
      store.authProvider = user.authProvider ?? null;
    }

    return true;
  }
}
