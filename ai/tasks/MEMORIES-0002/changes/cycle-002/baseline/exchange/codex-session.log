@@ -14,31 +14,87 @@ function buildContext(headers: Record<string, string>): {
 }
 
 describe('JwtAuthGuard', () => {
   it('attaches request.user from a valid bearer token', async () => {
     const tokenService = { verifyAccessToken: jest.fn().mockResolvedValue({ subject: 'user-1' }) };
     const guard = new JwtAuthGuard(tokenService as never);
     const { context, request } = buildContext({ authorization: 'Bearer valid-token' });
 
     const result = await guard.canActivate(context);
 
     expect(result).toBe(true);
     expect(request.user).toEqual({ id: 'user-1' });
     expect(tokenService.verifyAccessToken).toHaveBeenCalledWith('valid-token');
   });
 
   it('rejects a request with no Authorization header', async () => {
     const tokenService = { verifyAccessToken: jest.fn() };
     const guard = new JwtAuthGuard(tokenService as never);
     const { context } = buildContext({});
 
     await expect(guard.canActivate(context)).rejects.toBeInstanceOf(UnauthorizedException);
   });
 
   it('rejects a request with an invalid/expired token', async () => {
     const tokenService = { verifyAccessToken: jest.fn().mockRejectedValue(new Error('expired')) };
     const guard = new JwtAuthGuard(tokenService as never);
     const { context } = buildContext({ authorization: 'Bearer expired-token' });
 
     await expect(guard.canActivate(context)).rejects.toBeInstanceOf(UnauthorizedException);
   });
+
+  describe('with an AccountLookup wired (live account-state check)', () => {
+    it('accepts a token whose embedded tokenVersion still matches an active Account', async () => {
+      const tokenService = {
+        verifyAccessToken: jest.fn().mockResolvedValue({ subject: 'user-1', tokenVersion: 2 }),
+      };
+      const accountLookup = {
+        getAuthState: jest.fn().mockResolvedValue({ isActive: true, tokenVersion: 2 }),
+      };
+      const guard = new JwtAuthGuard(tokenService as never, undefined, accountLookup as never);
+      const { context, request } = buildContext({ authorization: 'Bearer valid-token' });
+
+      const result = await guard.canActivate(context);
+
+      expect(result).toBe(true);
+      expect(request.user).toEqual({ id: 'user-1' });
+      expect(accountLookup.getAuthState).toHaveBeenCalledWith('user-1');
+    });
+
+    it('rejects a token for an Account that has since been locked or deleted', async () => {
+      const tokenService = {
+        verifyAccessToken: jest.fn().mockResolvedValue({ subject: 'user-1', tokenVersion: 0 }),
+      };
+      const accountLookup = {
+        getAuthState: jest.fn().mockResolvedValue({ isActive: false, tokenVersion: 0 }),
+      };
+      const guard = new JwtAuthGuard(tokenService as never, undefined, accountLookup as never);
+      const { context } = buildContext({ authorization: 'Bearer valid-token' });
+
+      await expect(guard.canActivate(context)).rejects.toBeInstanceOf(UnauthorizedException);
+    });
+
