        "date_of_birth" date,
        "address" character varying,
        "created_by" uuid,
        "created_at" timestamptz NOT NULL,
        "updated_by" uuid,
        "updated_at" timestamptz NOT NULL,
        "deleted_by" uuid,
        "deleted_at" timestamptz,
        CONSTRAINT "PK_profile_user_profiles_id" PRIMARY KEY ("id")
      )
    `);
    await queryRunner.query(`CREATE INDEX "IDX_profile_user_profiles_deleted_at" ON "profile"."user_profiles" ("deleted_at")`);
    // Partial unique index (not a plain UNIQUE constraint): one active UserProfile per Account
    // (task.md §4 AC #7), but a soft-deleted profile must not block ever provisioning a new one
    // for the same account (task.md §7 "Unique index phải xử lý đúng soft delete").
    await queryRunner.query(`
      CREATE UNIQUE INDEX "UQ_profile_user_profiles_account_id"
      ON "profile"."user_profiles" ("account_id")
      WHERE "deleted_at" IS NULL
    `);

    await queryRunner.query(`
      CREATE INDEX "IDX_profile_user_profiles_full_name" ON "profile"."user_profiles" ("full_name")
    `);
    await queryRunner.query(`
      CREATE INDEX "IDX_profile_user_profiles_email" ON "profile"."user_profiles" ("email")
    `);
  }

  public async down(queryRunner: QueryRunner): Promise<void> {
    await queryRunner.query(`DROP TABLE "profile"."user_profiles"`);
    await queryRunner.query(`DROP SCHEMA IF EXISTS "profile" CASCADE`);
  }
}

