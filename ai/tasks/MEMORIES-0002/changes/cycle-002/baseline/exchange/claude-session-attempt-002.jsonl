{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XhtDPC7fbT9hrWzNjEan2y","type":"tool_result","content":"1\timport { AppConfig } from '@memories/platform/configuration';\n2\timport { CanActivate, ExecutionContext, ForbiddenException, Injectable } from '@nestjs/common';\n3\timport { ConfigService } from '@nestjs/config';\n4\timport type { Request } from 'express';\n5\t\n6\t/**\n7\t * CSRF/origin defense (§19 \"Refresh endpoint áp dụng CSRF/origin protection hiện tại\") for\n8\t * endpoints that authenticate purely off an ambient HttpOnly cookie — currently only\n9\t * `POST /auth/refresh`. A cross-site page can make a victim's browser send that cookie\n10\t * automatically (that's exactly what a cookie is for), so the cookie alone is not proof the\n11\t * request originated from our own frontend; the `Origin` header a real browser attaches to every\n12\t * fetch/XHR `POST` is. `login`/`logout` don't need this guard: `login` doesn't rely on any ambient\n13\t * authority to forge, and `logout` requires a bearer access token, which cross-site requests can't\n14\t * attach automatically the way cookies are.\n15\t *\n16\t * No-ops (allows the request through) when `CORS_ORIGIN` is unset, so a deployment that hasn't\n17\t * configured an allowlist yet isn't hard-blocked from calling its own refresh endpoint.\n18\t */\n19\t@Injectable()\n20\texport class OriginGuard implements CanActivate {\n21\t  constructor(private readonly configService: ConfigService) {}\n22\t\n23\t  canActivate(context: ExecutionContext): boolean {\n24\t    const app = this.configService.getOrThrow<AppConfig>('app');\n25\t    if (app.corsOrigins.length === 0) {\n26\t      return true;\n27\t    }\n28\t\n29\t    const request = context.switchToHttp().getRequest<Request>();\n30\t    const origin = request.headers.origin;\n31\t    if (!origin || !app.corsOrigins.includes(origin)) {\n32\t      throw new ForbiddenException('Origin not allowed');\n33\t    }\n34\t    return true;\n35\t  }\n36\t}\n37\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"a2b426c0-d567-4416-9536-a7e18165eb05","timestamp":"2026-08-07T15:20:08.339Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/platform/security/src/origin.guard.ts","content":"import { AppConfig } from '@memories/platform/configuration';\nimport { CanActivate, ExecutionContext, ForbiddenException, Injectable } from '@nestjs/common';\nimport { ConfigService } from '@nestjs/config';\nimport type { Request } from 'express';\n\n/**\n * CSRF/origin defense (§19 \"Refresh endpoint áp dụng CSRF/origin protection hiện tại\") for\n * endpoints that authenticate purely off an ambient HttpOnly cookie — currently only\n * `POST /auth/refresh`. A cross-site page can make a victim's browser send that cookie\n * automatically (that's exactly what a cookie is for), so the cookie alone is not proof the\n * request originated from our own frontend; the `Origin` header a real browser attaches to every\n * fetch/XHR `POST` is. `login`/`logout` don't need this guard: `login` doesn't rely on any ambient\n * authority to forge, and `logout` requires a bearer access token, which cross-site requests can't\n * attach automatically the way cookies are.\n *\n * No-ops (allows the request through) when `CORS_ORIGIN` is unset, so a deployment that hasn't\n * configured an allowlist yet isn't hard-blocked from calling its own refresh endpoint.\n */\n@Injectable()\nexport class OriginGuard implements CanActivate {\n  constructor(private readonly configService: ConfigService) {}\n\n  canActivate(context: ExecutionContext): boolean {\n    const app = this.configService.getOrThrow<AppConfig>('app');\n    if (app.corsOrigins.length === 0) {\n      return true;\n    }\n\n    const request = context.switchToHttp().getRequest<Request>();\n    const origin = request.headers.origin;\n    if (!origin || !app.corsOrigins.includes(origin)) {\n      throw new ForbiddenException('Origin not allowed');\n    }\n    return true;\n  }\n}\n","numLines":37,"startLine":1,"totalLines":37}}}
