{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Csuctzw58KMKP87gQ1a32g","type":"tool_result","content":"1\timport { UNIT_OF_WORK } from '@memories/platform/database';\n2\timport { RequestContext } from '@memories/platform/security';\n3\timport {\n4\t  CLOCK,\n5\t  Clock,\n6\t  DomainError,\n7\t  UniqueEntityId,\n8\t  UnitOfWork,\n9\t  UseCase,\n10\t} from '@memories/shared/kernel';\n11\timport { Inject, Injectable } from '@nestjs/common';\n12\t\n13\timport { AccountStatus } from '../../domain/accounts/account-status';\n14\timport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\n15\timport {\n16\t  REFRESH_SESSION_REPOSITORY,\n17\t  RefreshSessionRepository,\n18\t} from '../../domain/sessions/refresh-session.repository';\n19\t\n20\texport interface ChangeAccountStatusInput {\n21\t  accountId: string;\n22\t  status: AccountStatus;\n23\t}\n24\t\n25\t/**\n26\t * §16 `PATCH /accounts/:accountId/status`. Any transition away from `ACTIVE` revokes every\n27\t * outstanding session for the account — AC #32 only calls out lock/delete explicitly, but\n28\t * `INACTIVE` is just as unable to authenticate (§2), so leaving its sessions live would be\n29\t * inconsistent with \"Account inactive, locked hoặc deleted không được đăng nhập/refresh\" (§2, §9).\n30\t */\n31\t@Injectable()\n32\texport class ChangeAccountStatusUseCase implements UseCase<ChangeAccountStatusInput, void> {\n33\t  constructor(\n34\t    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n35\t    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n36\t    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n37\t    @Inject(CLOCK) private readonly clock: Clock,\n38\t    private readonly requestContext: RequestContext,\n39\t  ) {}\n40\t\n41\t  async execute(input: ChangeAccountStatusInput): Promise<void> {\n42\t    const actorId = this.requestContext.currentActorId();\n43\t\n44\t    await this.unitOfWork.withTransaction(async () => {\n45\t      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));\n46\t      if (!account) {\n47\t        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);\n48\t      }\n49\t\n50\t      const now = this.clock.now();\n51\t      switch (input.status) {\n52\t        case AccountStatus.Active:\n53\t          account.activate(actorId, now);\n54\t          break;\n55\t        case AccountStatus.Locked:\n56\t          account.lock(actorId, now);\n57\t          break;\n58\t        case AccountStatus.Inactive:\n59\t          account.deactivate(actorId, now);\n60\t          break;\n61\t      }\n62\t      await this.accounts.save(account);\n63\t\n64\t      if (input.status !== AccountStatus.Active) {\n65\t        await this.refreshSessions.revokeAllForAccount(input.accountId, now);\n66\t      }\n67\t    });\n68\t  }\n69\t}\n70\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"14a7357c-abd0-40eb-be55-8842962eb327","timestamp":"2026-08-07T15:20:06.785Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/identity-access/src/application/use-cases/change-account-status.use-case.ts","content":"import { UNIT_OF_WORK } from '@memories/platform/database';\nimport { RequestContext } from '@memories/platform/security';\nimport {\n  CLOCK,\n  Clock,\n  DomainError,\n  UniqueEntityId,\n  UnitOfWork,\n  UseCase,\n} from '@memories/shared/kernel';\nimport { Inject, Injectable } from '@nestjs/common';\n\nimport { AccountStatus } from '../../domain/accounts/account-status';\nimport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\nimport {\n  REFRESH_SESSION_REPOSITORY,\n  RefreshSessionRepository,\n} from '../../domain/sessions/refresh-session.repository';\n\nexport interface ChangeAccountStatusInput {\n  accountId: string;\n  status: AccountStatus;\n}\n\n/**\n * §16 `PATCH /accounts/:accountId/status`. Any transition away from `ACTIVE` revokes every\n * outstanding session for the account — AC #32 only calls out lock/delete explicitly, but\n * `INACTIVE` is just as unable to authenticate (§2), so leaving its sessions live would be\n * inconsistent with \"Account inactive, locked hoặc deleted không được đăng nhập/refresh\" (§2, §9).\n */\n@Injectable()\nexport class ChangeAccountStatusUseCase implements UseCase<ChangeAccountStatusInput, void> {\n  constructor(\n    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n    @Inject(CLOCK) private readonly clock: Clock,\n    private readonly requestContext: RequestContext,\n  ) {}\n\n  async execute(input: ChangeAccountStatusInput): Promise<void> {\n    const actorId = this.requestContext.currentActorId();\n\n    await this.unitOfWork.withTransaction(async () => {\n      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));\n      if (!account) {\n        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);\n      }\n\n      const now = this.clock.now();\n      switch (input.status) {\n        case AccountStatus.Active:\n          account.activate(actorId, now);\n          break;\n        case AccountStatus.Locked:\n          account.lock(actorId, now);\n          break;\n        case AccountStatus.Inactive:\n          account.deactivate(actorId, now);\n          break;\n      }\n      await this.accounts.save(account);\n\n      if (input.status !== AccountStatus.Active) {\n        await this.refreshSessions.revokeAllForAccount(input.accountId, now);\n      }\n    });\n  }\n}\n","numLines":70,"startLine":1,"totalLines":70}}}
