n48\t}\n49\t\n50\texport interface CreateAccountOutput {\n51\t  accountId: string;\n52\t  userProfileId: string;\n53\t}\n54\t\n55\t/**\n56\t * §8 transactional flow: normalize phone -> check duplicate -> hash password -> create Account ->\n57\t * create LOCAL AuthIdentity -> create UserProfile -> assign default role, all inside one\n58\t * `UnitOfWork.withTransaction`. UserProfile creation delegates to `USER_PROFILE_PROVISIONER`\n59\t * (implemented by the `user-profiles` module, injected globally — see\n60\t * `libs/platform/security/src/identity.contracts.ts` for why identity-access depends on that port\n61\t * instead of importing `@memories/modules/user-profiles` directly: it keeps the module graph\n62\t * acyclic since user-profiles' own existence checks use `AccountLookup`, not a direct import back).\n63\t */\n64\t@Injectable()\n65\texport class CreateAccountUseCase implements UseCase<CreateAccountInput, CreateAccountOutput> {\n66\t  constructor(\n67\t    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n68\t    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n69\t    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,\n70\t    @Inject(ACCOUNT_ROLE_REPOSITORY) private readonly accountRoles: AccountRoleRepository,\n71\t    @Inject(ROLE_REPOSITORY) private readonly roles: RoleRepository,\n72\t    @Inject(PASSWORD_HASHER) private readonly passwordHasher: PasswordHasher,\n73\t    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,\n74\t    @Inject(USER_PROFILE_PROVISIONER) private readonly userProfileProvisioner: UserProfileProvisioner,\n75\t    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n76\t    @Inject(CLOCK) private readonly clock: Clock,\n77\t    private readonly configService: ConfigService,\n78\t    private readonly requestContext: RequestContext,\n79\t  ) {}\n80\t\n81\t  async execute(input: CreateAccountInput): Promise<CreateAccountOutput> {\n82\t    // Resolved once, ambiently (§14/AC27 \"Audit actor được lấy từ request context\") — never from a\n83\t    // client-suppliable field — so the authenticated caller (or `SYSTEM_ACTOR_ID`/`null`, see\n84\t    // `RequestContext.currentActorId`) is the actor for every write this transaction makes,\n85\t    // including the cross-module `userProfileProvisioner.provision` call below (same async\n86\t    // context, so it resolves to the same value independently rather than trusting a\n87\t    // caller-supplied one).\n88\t    const actorId = this.requestContext.currentActorId();\n89\t\n90\t    return this.unitOfWork.withTransaction(async () => {\n91\t      const auth = this.configService.getOrThrow<AuthConfig>('auth');\n92\t      const now = this.clock.now();\n93\t      const phone = this.phoneNormalizer.normalize(input.phone, auth.phone.defaultRegion);\n94\t\n95\t      if (await this.authIdentities.existsByProviderAndIdentifier(AuthProvider.Local, phone.value)) {\n96\t        throw DomainError.conflict('phone_already_exists', `Phone ${phone.value} is already registered`);\n97\t      }\n98\t\n99\t      const passwordHash = await this.passwordHasher.hash(input.password);\n100\t\n101\t      const accountId = new UniqueEntityId(this.idGenerator.generate());\n102\t      const account = Account.create(\n103\t        {\n104\t          status: AccountStatus.Active,\n105\t          tokenVersion: 0,\n106\t          ...createAuditableProps(actorId, now),\n107\t        },\n108\t        accountId,\n109\t      );\n110\t      await this.accounts.save(account);\n111\t\n112\t      const authIdentityId = new UniqueEntityId(this.idGenerator.generate());\n113\t      const authIdentity = AuthIdentity.create(\n114\t        {\n115\t          accountId: accountId.toValue(),\n116\t          provider: AuthProvider.Local,\n117\t          identifier: phone.value,\n118\t          providerSubject: null,\n119\t          passwordHash,\n120\t          verifiedAt: null,\n121\t          ...createAuditableProps(actorId, now),\n122\t        },\n123\t        authIdentityId,\n124\t      );\n125\t      await this.authIdentities.save(authIdentity);\n126\t\n127\t      const defaultRole = await this.roles.findByCode(auth.defaultRole.code);\n128\t      if (!defaultRole) {\n129\t        throw DomainError.externalDependency(\n130\t          'default_role_not_seeded',\n131\t          `Default role \"${auth.defaultRole.code}\" has not been seeded`,\n132\t        );\n133\t      }\n134\t      await this.accountRoles.assign(accountId.toValue(), defaultRole.id.toValue(), actorId, now);\n135\t\n136\t      const profile: ProvisionUserProfileOutput = await this.userProfileProvisioner.provision({\n137\t        accountId: accountId.toValue(),\n138\t        fullName: input.fullName,\n139\t        email: input.email,\n140\t        dateOfBirth: input.dateOfBirth,\n141\t        address: input.address,\n142\t        avatarId: input.avatarId,\n143\t      });\n144\t\n145\t      return { accountId: accountId.toValue(), userProfileId: profile.userProfileId };\n146\t    });\n147\t  }\n148\t}\n149\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"ecc40c51-2726-4edb-80e3-751028139dcd","timestamp":"2026-08-07T15:19:43.787Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/identity-access/src/application/use-cases/create-account.use-case.ts","content":"import { AuthConfig } from '@memories/platform/configuration';\nimport { UNIT_OF_WORK } from '@memories/platform/database';\nimport {\n  ProvisionUserProfileOutput,\n  RequestContext,\n  UserProfileProvisioner,\n  USER_PROFILE_PROVISIONER,\n} from '@memories/platform/security';\nimport {\n  CLOCK,\n  Clock,\n  createAuditableProps,\n  DomainError,\n  ID_GENERATOR,\n  IdGenerator,\n  UniqueEntityId,\n  UnitOfWork,\n  UseCase,\n} from '@memories/shared/kernel';\nimport { Inject, Injectable } from '@nestjs/common';\nimport { ConfigService } from '@nestjs/config';\n\nimport { Account } from '../../domain/accounts/account';\nimport { AccountStatus } from '../../domain/accounts/account-status';\nimport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\nimport { AuthIdentity } from '../../domain/auth-identities/auth-identity';\nimport {\n  AUTH_IDENTITY_REPOSITORY,\n  AuthIdentityRepository,\n} from '../../domain/auth-identities/auth-identity.repository';\nimport { AuthProvider } from '../../domain/auth-identities/auth-provider';\nimport {\n  ACCOUNT_ROLE_REPOSITORY,\n  AccountRoleRepository,\n} from '../../domain/roles/account-role.repository';\nimport { ROLE_REPOSITORY, RoleRepository } from '../../domain/roles/role.repository';\nimport { PASSWORD_HASHER, PasswordHasher } from '../ports/password-hasher.port';\nimport { PHONE_NORMALIZER, PhoneNormalizerPort } from '../ports/phone-normalizer.port';\n\nexport interface CreateAccountInput {\n  phone: string;\n  password: string;\n  fullName: string;\n  email?: string | undefined;\n  dateOfBirth?: Date | undefined;\n  address?: string | undefined;\n  avatarId?: string | undefined;\n}\n\nexport interface CreateAccountOutput {\n  accountId: string;\n  userProfileId: string;\n}\n\n/**\n * §8 transactional flow: normalize phone -> check duplicate -> hash password -> create Account ->\n * create LOCAL AuthIdentity -> create UserProfile -> assign default role, all inside one\n * `UnitOfWork.withTransaction`. UserProfile creation delegates to `USER_PROFILE_PROVISIONER`\n * (implemented by the `user-profiles` module, injected globally — see\n * `libs/platform/security/src/identity.contracts.ts` for why identity-access depends on that port\n * instead of importing `@memories/modules/user-profiles` directly: it keeps the module graph\n * acyclic since user-profiles' own existence checks use `AccountLookup`, not a direct import back).\n */\n@Injectable()\nexport class CreateAccountUseCase implements UseCase<CreateAccountInput, CreateAccountOutput> {\n  constructor(\n    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,\n    @Inject(ACCOUNT_ROLE_REPOSITORY) private readonly accountRoles: AccountRoleRepository,\n    @Inject(ROLE_REPOSITORY) private readonly roles: RoleRepository,\n    @Inject(PASSWORD_HASHER) private readonly passwordHasher: PasswordHasher,\n    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,\n    @Inject(USER_PROFILE_PROVISIONER) private readonly userProfileProvisioner: UserProfileProvisioner,\n    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n    @Inject(CLOCK) private readonly clock: Clock,\n    private readonly configService: ConfigService,\n    private readonly requestContext: RequestContext,\n  ) {}\n\n  async execute(input: CreateAccountInput): Promise<CreateAccountOutput> {\n    // Resolved once, ambiently (§14/AC27 \"Audit actor được lấy từ request context\") — never from a\n    // client-suppliable field — so the authenticated caller (or `SYSTEM_ACTOR_ID`/`null`, see\n    // `RequestContext.currentActorId`) is the actor for every write this transaction makes,\n    // including the cross-module `userProfileProvisioner.provision` call below (same async\n    // context, so it resolves to the same value independently rather than trusting a\n    // caller-supplied one).\n    const actorId = this.requestContext.currentActorId();\n\n    return this.unitOfWork.withTransaction(async () => {\n      const auth = this.configService.getOrThrow<AuthConfig>('auth');\n      const now = this.clock.now();\n      const phone = this.phoneNormalizer.normalize(input.phone, auth.phone.defaultRegion);\n\n      if (await this.authIdentities.existsByProviderAndIdentifier(AuthProvider.Local, phone.value)) {\n        throw DomainError.conflict('phone_already_exists', `Phone ${phone.value} is already registered`);\n      }\n\n      const passwordHash = await this.passwordHasher.hash(input.password);\n\n      const accountId = new UniqueEntityId(this.idGenerator.generate());\n      const account = Account.create(\n        {\n          status: AccountStatus.Active,\n          tokenVersion: 0,\n          ...createAuditableProps(actorId, now),\n        },\n        accountId,\n      );\n      await this.accounts.save(account);\n\n      const authIdentityId = new UniqueEntityId(this.idGenerator.generate());\n      const authIdentity = AuthIdentity.create(\n        {\n          accountId: accountId.toValue(),\n          provider: AuthProvider.Local,\n          identifier: phone.value,\n          providerSubject: null,\n          passwordHash,\n          verifiedAt: null,\n          ...createAuditableProps(actorId, now),\n        },\n        authIdentityId,\n      );\n      await this.authIdentities.save(authIdentity);\n\n      const defaultRole = await this.roles.findByCode(auth.defaultRole.code);\n      if (!defaultRole) {\n        throw DomainError.externalDependency(\n          'default_role_not_seeded',\n          `Default role \"${auth.defaultRole.code}\" has not been seeded`,\n        );\n      }\n      await this.accountRoles.assign(accountId.toValue(), defaultRole.id.toValue(), actorId, now);\n\n      const profile: ProvisionUserProfileOutput = await this.userProfileProvisioner.provision({\n        accountId: accountId.toValue(),\n        fullName: input.fullName,\n        email: input.email,\n        dateOfBirth: input.dateOfBirth,\n        address: input.address,\n        avatarId: input.avatarId,\n      });\n\n      return { accountId: accountId.toValue(), userProfileId: profile.userProfileId };\n    });\n  }\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
