{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DiBiUa2uQAx84R13DbBLkV","type":"tool_result","content":"The file /Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/apps/api/test/auth-flow.e2e-spec.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"8e9a4606-e206-459f-99bf-888693585a3e","timestamp":"2026-08-07T15:26:00.578Z","tool_use_result":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/apps/api/test/auth-flow.e2e-spec.ts","oldString":"      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n    });\n\n    it('logout revokes the current session so the refresh cookie can no longer be used', async () => {","newString":"      await refresh(cookie).expect(401);\n    });\n\n    it('logout revokes the current session so the refresh cookie can no longer be used', async () => {","originalFile":"import { randomInt } from 'node:crypto';\n\nimport {\n  ACCOUNT_ROLE_REPOSITORY,\n  AccountRoleRepository,\n  CreateAccountUseCase,\n  ROLE_REPOSITORY,\n  RoleRepository,\n  SeedRolesAndPermissionsUseCase,\n} from '@memories/modules/identity-access';\nimport { AppConfig } from '@memories/platform/configuration';\nimport { TOKEN_SERVICE, TokenService } from '@memories/platform/security';\nimport { INestApplication } from '@nestjs/common';\nimport { ConfigService } from '@nestjs/config';\nimport { Test, TestingModule } from '@nestjs/testing';\nimport request from 'supertest';\n\nimport { AppModule } from '../src/app.module';\nimport { configureApp } from '../src/configure-app';\n\n/**\n * Requires the local infrastructure stack (`docker compose -f docker/docker-compose.yml\n * --profile infrastructure up -d`) and a populated `.env`; run via `npm run test:e2e`.\n *\n * Exercises MEMORIES-0002's login/authorization/CRUD flows end to end against a real\n * Postgres-backed AppModule — the real HTTP layer, guards and use cases, not mocks. Test-only\n * setup (seeding roles/permissions, provisioning a bootstrap SUPER_ADMIN, granting extra roles)\n * goes through `CreateAccountUseCase`/`AccountRoleRepository` obtained directly from the Nest\n * container (`{ strict: false }`, same pattern as `media-upload-flow.e2e-spec.ts`) since there is\n * no HTTP-only way to create the very first admin account — every other assertion goes through\n * `supertest` against the real routes.\n */\nconst API_PREFIX = '/api/v1';\n/** First entry of this env's `CORS_ORIGIN` allowlist — `OriginGuard` (§19 CSRF/origin protection\n * on `/auth/refresh`) only accepts requests whose `Origin` header is in that list, so every\n * refresh call in this suite must set it to simulate a real first-party frontend request; a raw\n * `supertest` POST sends no `Origin` header at all and would otherwise always get 403. */\nconst ALLOWED_ORIGIN = 'http://localhost:3100';\n\ninterface Credentials {\n  accountId: string;\n  userProfileId: string;\n  phone: string;\n  password: string;\n}\n\ndescribe('Auth & portal authorization flow (e2e)', () => {\n  let app: INestApplication;\n  let tokenService: TokenService;\n  let createAccount: CreateAccountUseCase;\n  let accountRoles: AccountRoleRepository;\n  let roles: RoleRepository;\n  let roleIdByCode: Map<string, string>;\n\n  beforeAll(async () => {\n    const moduleRef: TestingModule = await Test.createTestingModule({\n      imports: [AppModule],\n    }).compile();\n    app = moduleRef.createNestApplication();\n    configureApp(app, moduleRef.get(ConfigService).getOrThrow<AppConfig>('app'));\n    await app.init();\n\n    tokenService = moduleRef.get(TOKEN_SERVICE);\n    createAccount = moduleRef.get(CreateAccountUseCase, { strict: false });\n    accountRoles = moduleRef.get(ACCOUNT_ROLE_REPOSITORY, { strict: false });\n    roles = moduleRef.get(ROLE_REPOSITORY, { strict: false });\n\n    const seed = moduleRef.get(SeedRolesAndPermissionsUseCase, { strict: false });\n    await seed.execute();\n\n    roleIdByCode = new Map<string, string>();\n    for (const code of ['PUBLIC_USER', 'ADMIN', 'SUPER_ADMIN']) {\n      const role = await roles.findByCode(code);\n      if (!role) {\n        throw new Error(`Role ${code} was not seeded`);\n      }\n      roleIdByCode.set(code, role.id.toValue());\n    }\n  }, 30_000);\n\n  afterAll(async () => {\n    await app.close();\n  });\n\n  /** 09 + 8 random digits — confirmed a valid VN mobile shape via libphonenumber-js. Random\n   * (not a per-run counter) so re-running this suite against a database that still has rows\n   * from a previous run can't collide on the unique `provider + identifier` constraint. */\n  function nextPhone(): string {\n    const suffix = randomInt(10_000_000, 99_999_999);\n    return `09${String(suffix).padStart(8, '0')}`;\n  }\n\n  async function createTestAccount(extraRoleCode?: 'ADMIN' | 'SUPER_ADMIN'): Promise<Credentials> {\n    const phone = nextPhone();\n    const password = 'Sup3rSecret!';\n    const output = await createAccount.execute({\n      phone,\n      password,\n      fullName: 'E2E Test User',\n    });\n    if (extraRoleCode) {\n      const roleId = roleIdByCode.get(extraRoleCode);\n      if (!roleId) {\n        throw new Error(`Role ${extraRoleCode} not resolved`);\n      }\n      await accountRoles.assign(output.accountId, roleId, null, new Date());\n    }\n    return { accountId: output.accountId, userProfileId: output.userProfileId, phone, password };\n  }\n\n  function login(phone: string, password: string, portal: 'PUBLIC' | 'ADMIN') {\n    return request(app.getHttpServer()).post(`${API_PREFIX}/auth/login`).send({ phone, password, portal });\n  }\n\n  /** Every real browser call to `/auth/refresh` carries an `Origin` header; this helper mirrors\n   * that so the suite exercises `OriginGuard` the way production traffic does. */\n  function refresh(cookie: string[]) {\n    return request(app.getHttpServer())\n      .post(`${API_PREFIX}/auth/refresh`)\n      .set('Cookie', cookie)\n      .set('Origin', ALLOWED_ORIGIN);\n  }\n\n  describe('login', () => {\n    it('logs in a default account on the PUBLIC portal', async () => {\n      const account = await createTestAccount();\n      const res = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      expect(res.body.accessToken).toEqual(expect.any(String));\n      expect(res.body.portal).toBe('PUBLIC');\n      expect(res.body.permissions).toContain('portal.public.access');\n      expect(res.headers['set-cookie']?.[0]).toMatch(/HttpOnly/i);\n\n      const claims = await tokenService.verifyAccessToken(res.body.accessToken);\n      expect(claims.subject).toBe(account.accountId);\n      expect(claims.portal).toBe('PUBLIC');\n    });\n\n    it('logs in an account granted the ADMIN role on the ADMIN portal', async () => {\n      const account = await createTestAccount('ADMIN');\n      const res = await login(account.phone, account.password, 'ADMIN').expect(200);\n\n      expect(res.body.portal).toBe('ADMIN');\n      expect(res.body.permissions).toContain('portal.admin.access');\n    });\n\n    it('rejects a PUBLIC-only account attempting to log into the ADMIN portal without creating a session', async () => {\n      const account = await createTestAccount();\n      await login(account.phone, account.password, 'ADMIN').expect(403);\n\n      // No refresh session/token was issued for the rejected portal — the account can still log\n      // into the portal it does have access to right afterwards.\n      await login(account.phone, account.password, 'PUBLIC').expect(200);\n    });\n\n    it('returns the same generic error for an unknown phone and for a wrong password (no account enumeration)', async () => {\n      const account = await createTestAccount();\n      const unknownPhoneRes = await login(nextPhone(), account.password, 'PUBLIC').expect(401);\n      const wrongPasswordRes = await login(account.phone, 'wrong-password', 'PUBLIC').expect(401);\n\n      expect(unknownPhoneRes.body.message).toBe(wrongPasswordRes.body.message);\n    });\n\n    it('rejects login for an INACTIVE account', async () => {\n      const account = await createTestAccount();\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'INACTIVE' })\n        .expect(204);\n\n      await login(account.phone, account.password, 'PUBLIC').expect(403);\n    });\n\n    it('rejects login for a LOCKED account', async () => {\n      const account = await createTestAccount();\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await login(account.phone, account.password, 'PUBLIC').expect(403);\n    });\n\n    it('rejects login for a deleted (soft-deleted) account', async () => {\n      const account = await createTestAccount();\n      await request(app.getHttpServer())\n        .delete(`${API_PREFIX}/accounts/${account.accountId}`)\n        .set('Authorization', await adminBearer())\n        .expect(204);\n\n      await login(account.phone, account.password, 'PUBLIC').expect(401);\n    });\n  });\n\n  describe('refresh & logout', () => {\n    it('rotates the refresh session and keeps the same portal', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      const refreshRes = await refresh(cookie).expect(200);\n\n      expect(refreshRes.body.portal).toBe('PUBLIC');\n      expect(refreshRes.body.sessionId).not.toBe(loginRes.body.sessionId);\n\n      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);\n      expect(claims.subject).toBe(account.accountId);\n    });\n\n    it('revokes the session once the account is locked, so a later refresh fails', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n    });\n\n    it('logout revokes the current session so the refresh cookie can no longer be used', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      await request(app.getHttpServer())\n        .post(`${API_PREFIX}/auth/logout`)\n        .set('Authorization', `Bearer ${loginRes.body.accessToken}`)\n        .set('Cookie', cookie)\n        .expect(204);\n\n      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n    });\n\n    it('keeps the userProfileId claim on the access token reissued by refresh', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      const refreshRes = await request(app.getHttpServer())\n        .post(`${API_PREFIX}/auth/refresh`)\n        .set('Cookie', cookie)\n        .expect(200);\n\n      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);\n      expect(claims.userProfileId).toBe(account.userProfileId);\n    });\n\n    it('lets only one of two concurrent refreshes of the same token succeed', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      const [first, second] = await Promise.all([\n        request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie),\n        request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie),\n      ]);\n\n      const statuses = [first.status, second.status].sort();\n      expect(statuses).toEqual([200, 401]);\n    });\n\n    it('rejects an already-issued access token immediately once the Account is locked, ahead of the token natural expiry', async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const loginRes = await login(account.phone, account.password, 'ADMIN').expect(200);\n      const accessToken = loginRes.body.accessToken as string;\n\n      // The token itself is still a validly-signed, unexpired JWT — only the live Account-status\n      // check added to JwtAuthGuard can catch this.\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(200);\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(401);\n    });\n\n    it(\"rejects an already-issued access token once the account's password changes (tokenVersion bump)\", async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const loginRes = await login(account.phone, account.password, 'ADMIN').expect(200);\n      const accessToken = loginRes.body.accessToken as string;\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(200);\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/password`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .send({ newPassword: 'AnotherSecret1!' })\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(401);\n    });\n  });\n\n  describe('Account CRUD, gated by ADMIN portal + permission', () => {\n    it('rejects an ADMIN-portal request with no bearer token', async () => {\n      await request(app.getHttpServer()).get(`${API_PREFIX}/accounts`).expect(401);\n    });\n\n    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n    });\n\n    it('rejects an ADMIN account that lacks account.create when creating a new account', async () => {\n      const admin = await createTestAccount('ADMIN');\n      const adminLogin = await login(admin.phone, admin.password, 'ADMIN').expect(200);\n\n      await request(app.getHttpServer())\n        .post(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${adminLogin.body.accessToken}`)\n        .send({ phone: nextPhone(), password: 'Sup3rSecret!', fullName: 'Should not be created' })\n        .expect(403);\n    });\n\n    it('lets a SUPER_ADMIN create, list, fetch, update status and delete an account', async () => {\n      const bearer = await adminBearer();\n      const newPhone = nextPhone();\n\n      const createRes = await request(app.getHttpServer())\n        .post(`${API_PREFIX}/accounts`)\n        .set('Authorization', bearer)\n        .send({ phone: newPhone, password: 'Sup3rSecret!', fullName: 'Created Via API' })\n        .expect(201);\n      const accountId: string = createRes.body.accountId;\n      expect(accountId).toEqual(expect.any(String));\n\n      const listRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', bearer)\n        .query({ phone: newPhone })\n        .expect(200);\n      expect(listRes.body.items.some((item: { id: string }) => item.id === accountId)).toBe(true);\n      expect(listRes.body.items[0].phone).not.toBeUndefined();\n      // Response never leaks the password hash under any field name.\n      expect(JSON.stringify(listRes.body)).not.toMatch(/passwordHash/i);\n\n      const getRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts/${accountId}`)\n        .set('Authorization', bearer)\n        .expect(200);\n      expect(getRes.body.status).toBe('ACTIVE');\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${accountId}/status`)\n        .set('Authorization', bearer)\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .delete(`${API_PREFIX}/accounts/${accountId}`)\n        .set('Authorization', bearer)\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts/${accountId}`)\n        .set('Authorization', bearer)\n        .expect(404);\n    });\n  });\n\n  describe('UserProfile CRUD, gated by permission', () => {\n    it('rejects a request with no permission for the account', async () => {\n      const account = await createTestAccount();\n      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n    });\n\n    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n    });\n\n    it('round-trips a non-null dateOfBirth through create, get, list and update without a 500', async () => {\n      const bearer = await adminBearer();\n      const account = await createTestAccount();\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .send({ dateOfBirth: '1990-05-17' })\n        .expect(200)\n        .then((res) => expect(res.body.dateOfBirth).toBe('1990-05-17'));\n\n      const getRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .expect(200);\n      expect(getRes.body.dateOfBirth).toBe('1990-05-17');\n\n      const listRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', bearer)\n        .query({ fullName: 'E2E Test User' })\n        .expect(200);\n      expect(\n        listRes.body.items.find((item: { id: string }) => item.id === account.userProfileId)?.dateOfBirth,\n      ).toBe('1990-05-17');\n    });\n\n    it('lets a SUPER_ADMIN read, update and delete the profile auto-provisioned with an account, and rejects a duplicate', async () => {\n      const bearer = await adminBearer();\n      const account = await createTestAccount();\n\n      const getRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .expect(200);\n      expect(getRes.body.accountId).toBe(account.accountId);\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .send({ fullName: 'Updated Name' })\n        .expect(200)\n        .then((res) => expect(res.body.fullName).toBe('Updated Name'));\n\n      // §4 \"Mỗi Account chỉ có tối đa một UserProfile\" — creating a second one for the same\n      // account must fail even for a fully-privileged actor.\n      await request(app.getHttpServer())\n        .post(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', bearer)\n        .send({ accountId: account.accountId, fullName: 'Duplicate Profile' })\n        .expect(409);\n\n      await request(app.getHttpServer())\n        .delete(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .expect(204);\n    });\n\n    it('finds a profile by searching the local-format phone (identity-access stores it E.164)', async () => {\n      const bearer = await adminBearer();\n      const account = await createTestAccount();\n\n      const res = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', bearer)\n        .query({ phone: account.phone })\n        .expect(200);\n\n      expect(res.body.items.some((item: { id: string }) => item.id === account.userProfileId)).toBe(true);\n    });\n  });\n\n  describe('concurrent requests do not leak request context between accounts', () => {\n    it('resolves each of several concurrent logins to its own account, never crossing subjects', async () => {\n      const accounts = await Promise.all([\n        createTestAccount(),\n        createTestAccount(),\n        createTestAccount(),\n        createTestAccount(),\n        createTestAccount(),\n      ]);\n\n      const responses = await Promise.all(\n        accounts.map((account) => login(account.phone, account.password, 'PUBLIC').expect(200)),\n      );\n\n      const claims = await Promise.all(\n        responses.map((res) => tokenService.verifyAccessToken(res.body.accessToken)),\n      );\n\n      claims.forEach((claim, index) => {\n        expect(claim.subject).toBe(accounts[index]?.accountId);\n      });\n      // Every resolved subject must be distinct — a leaked/shared context would collapse these.\n      expect(new Set(claims.map((c) => c.subject)).size).toBe(accounts.length);\n    });\n  });\n\n  let cachedAdminBearer: string | undefined;\n  async function adminBearer(): Promise<string> {\n    if (cachedAdminBearer) {\n      return cachedAdminBearer;\n    }\n    const admin = await createTestAccount('SUPER_ADMIN');\n    const res = await login(admin.phone, admin.password, 'ADMIN').expect(200);\n    cachedAdminBearer = `Bearer ${res.body.accessToken}`;\n    return cachedAdminBearer;\n  }\n});\n","structuredPatch":[{"oldStart":220,"oldLines":7,"newStart":220,"newLines":7,"lines":["         .send({ status: 'LOCKED' })","         .expect(204);"," ","-      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);","+      await refresh(cookie).expect(401);","     });"," ","     it('logout revokes the current session so the refresh cookie can no longer be used', async () => {"]}],"userModified":false,"replaceAll":false}}
