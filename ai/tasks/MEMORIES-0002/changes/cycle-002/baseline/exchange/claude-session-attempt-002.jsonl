{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BU5fNf97CdxWQ6MT4Ni1fB","type":"tool_result","content":"1\timport {\n2\t  CanActivate,\n3\t  ExecutionContext,\n4\t  Inject,\n5\t  Injectable,\n6\t  Optional,\n7\t  UnauthorizedException,\n8\t} from '@nestjs/common';\n9\timport type { Request } from 'express';\n10\t\n11\timport { ACCOUNT_LOOKUP, AccountLookup } from './identity.contracts';\n12\timport { RequestContext } from './request-context';\n13\timport { TOKEN_SERVICE, TokenService } from './token.contract';\n14\t\n15\texport interface RequestUser {\n16\t  id: string;\n17\t  sessionId?: string | undefined;\n18\t  portal?: string | undefined;\n19\t  userProfileId?: string | undefined;\n20\t  authProvider?: string | undefined;\n21\t}\n22\t\n23\t/**\n24\t * Verifies the `Authorization: Bearer <access token>` header via `TokenService` and attaches\n25\t * `request.user`. Business modules apply this guard on any endpoint that must know \"who is\n26\t * calling\" (e.g. an ownership check) — they never verify JWTs themselves.\n27\t *\n28\t * Also enriches the ambient `RequestContext` (§14) with the resolved actor's claims, when a\n29\t * `RequestContextMiddleware` has already seeded one for this request — `@Optional()` because\n30\t * `RequestContext` is only wired for HTTP apps (apps/api); this guard's unit tests construct it\n31\t * directly without a Nest DI container, so `requestContext` is `undefined` there too.\n32\t *\n33\t * A verified signature/expiry only proves the token was genuinely issued — it says nothing about\n34\t * whether the Account has since been locked, deleted or had its password changed (§19 \"Protected\n35\t * request kiểm tra Account status\"). `AccountLookup` (implemented by identity-access, injected the\n36\t * same way `PermissionsGuard` injects `PERMISSION_CHECKER` — a platform-declared port, not a direct\n37\t * cross-module import) gives a live status + `tokenVersion` read on every protected request, so an\n38\t * already-issued access token stops working the moment the Account is locked/deleted (`isActive`\n39\t * flips) or the password changes (`tokenVersion` bumps) — not just once it naturally expires.\n40\t * `@Optional()` for the same reason as `requestContext`: this guard's plain unit tests construct it\n41\t * without a DI container and only exercise pure JWT verification.\n42\t */\n43\t@Injectable()\n44\texport class JwtAuthGuard implements CanActivate {\n45\t  constructor(\n46\t    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,\n47\t    @Optional() private readonly requestContext?: RequestContext,\n48\t    @Optional() @Inject(ACCOUNT_LOOKUP) private readonly accountLookup?: AccountLookup,\n49\t  ) {}\n50\t\n51\t  async canActivate(context: ExecutionContext): Promise<boolean> {\n52\t    const request = context.switchToHttp().getRequest<Request & { user?: RequestUser }>();\n53\t    const header = request.headers.authorization;\n54\t    if (!header?.startsWith('Bearer ')) {\n55\t      throw new UnauthorizedException('Missing bearer token');\n56\t    }\n57\t\n58\t    let claims;\n59\t    try {\n60\t      claims = await this.tokenService.verifyAccessToken(header.slice('Bearer '.length));\n61\t    } catch {\n62\t      throw new UnauthorizedException('Invalid or expired access token');\n63\t    }\n64\t\n65\t    if (this.accountLookup) {\n66\t      const authState = await this.accountLookup.getAuthState(claims.subject);\n67\t      const claimedTokenVersion = typeof claims.tokenVersion === 'number' ? claims.tokenVersion : 0;\n68\t      if (!authState || !authState.isActive || authState.tokenVersion !== claimedTokenVersion) {\n69\t        throw new UnauthorizedException('Account is no longer authorized to use this token');\n70\t      }\n71\t    }\n72\t\n73\t    const user: RequestUser = {\n74\t      id: claims.subject,\n75\t      sessionId: typeof claims.sessionId === 'string' ? claims.sessionId : undefined,\n76\t      portal: typeof claims.portal === 'string' ? claims.portal : undefined,\n77\t      userProfileId: typeof claims.userProfileId === 'string' ? claims.userProfileId : undefined,\n78\t      authProvider: typeof claims.authProvider === 'string' ? claims.authProvider : undefined,\n79\t    };\n80\t    request.user = user;\n81\t\n82\t    const store = this.requestContext?.get();\n83\t    if (store) {\n84\t      store.accountId = user.id;\n85\t      store.sessionId = user.sessionId ?? null;\n86\t      store.portal = user.portal ?? null;\n87\t      store.userProfileId = user.userProfileId ?? null;\n88\t      store.authProvider = user.authProvider ?? null;\n89\t    }\n90\t\n91\t    return true;\n92\t  }\n93\t}\n94\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"5318c981-ffcd-411a-b6f7-55f4b986fdb8","timestamp":"2026-08-07T15:18:32.669Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/platform/security/src/jwt-auth.guard.ts","content":"import {\n  CanActivate,\n  ExecutionContext,\n  Inject,\n  Injectable,\n  Optional,\n  UnauthorizedException,\n} from '@nestjs/common';\nimport type { Request } from 'express';\n\nimport { ACCOUNT_LOOKUP, AccountLookup } from './identity.contracts';\nimport { RequestContext } from './request-context';\nimport { TOKEN_SERVICE, TokenService } from './token.contract';\n\nexport interface RequestUser {\n  id: string;\n  sessionId?: string | undefined;\n  portal?: string | undefined;\n  userProfileId?: string | undefined;\n  authProvider?: string | undefined;\n}\n\n/**\n * Verifies the `Authorization: Bearer <access token>` header via `TokenService` and attaches\n * `request.user`. Business modules apply this guard on any endpoint that must know \"who is\n * calling\" (e.g. an ownership check) — they never verify JWTs themselves.\n *\n * Also enriches the ambient `RequestContext` (§14) with the resolved actor's claims, when a\n * `RequestContextMiddleware` has already seeded one for this request — `@Optional()` because\n * `RequestContext` is only wired for HTTP apps (apps/api); this guard's unit tests construct it\n * directly without a Nest DI container, so `requestContext` is `undefined` there too.\n *\n * A verified signature/expiry only proves the token was genuinely issued — it says nothing about\n * whether the Account has since been locked, deleted or had its password changed (§19 \"Protected\n * request kiểm tra Account status\"). `AccountLookup` (implemented by identity-access, injected the\n * same way `PermissionsGuard` injects `PERMISSION_CHECKER` — a platform-declared port, not a direct\n * cross-module import) gives a live status + `tokenVersion` read on every protected request, so an\n * already-issued access token stops working the moment the Account is locked/deleted (`isActive`\n * flips) or the password changes (`tokenVersion` bumps) — not just once it naturally expires.\n * `@Optional()` for the same reason as `requestContext`: this guard's plain unit tests construct it\n * without a DI container and only exercise pure JWT verification.\n */\n@Injectable()\nexport class JwtAuthGuard implements CanActivate {\n  constructor(\n    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,\n    @Optional() private readonly requestContext?: RequestContext,\n    @Optional() @Inject(ACCOUNT_LOOKUP) private readonly accountLookup?: AccountLookup,\n  ) {}\n\n  async canActivate(context: ExecutionContext): Promise<boolean> {\n    const request = context.switchToHttp().getRequest<Request & { user?: RequestUser }>();\n    const header = request.headers.authorization;\n    if (!header?.startsWith('Bearer ')) {\n      throw new UnauthorizedException('Missing bearer token');\n    }\n\n    let claims;\n    try {\n      claims = await this.tokenService.verifyAccessToken(header.slice('Bearer '.length));\n    } catch {\n      throw new UnauthorizedException('Invalid or expired access token');\n    }\n\n    if (this.accountLookup) {\n      const authState = await this.accountLookup.getAuthState(claims.subject);\n      const claimedTokenVersion = typeof claims.tokenVersion === 'number' ? claims.tokenVersion : 0;\n      if (!authState || !authState.isActive || authState.tokenVersion !== claimedTokenVersion) {\n        throw new UnauthorizedException('Account is no longer authorized to use this token');\n      }\n    }\n\n    const user: RequestUser = {\n      id: claims.subject,\n      sessionId: typeof claims.sessionId === 'string' ? claims.sessionId : undefined,\n      portal: typeof claims.portal === 'string' ? claims.portal : undefined,\n      userProfileId: typeof claims.userProfileId === 'string' ? claims.userProfileId : undefined,\n      authProvider: typeof claims.authProvider === 'string' ? claims.authProvider : undefined,\n    };\n    request.user = user;\n\n    const store = this.requestContext?.get();\n    if (store) {\n      store.accountId = user.id;\n      store.sessionId = user.sessionId ?? null;\n      store.portal = user.portal ?? null;\n      store.userProfileId = user.userProfileId ?? null;\n      store.authProvider = user.authProvider ?? null;\n    }\n\n    return true;\n  }\n}\n","numLines":94,"startLine":1,"totalLines":94}}}
