{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ctT6YS5jnaXtzwiayDMyK","type":"tool_result","content":"1\timport { UNIT_OF_WORK } from '@memories/platform/database';\n2\timport {\n3\t  TokenService,\n4\t  TOKEN_SERVICE,\n5\t  UserProfileLookup,\n6\t  USER_PROFILE_LOOKUP,\n7\t} from '@memories/platform/security';\n8\timport {\n9\t  CLOCK,\n10\t  Clock,\n11\t  ID_GENERATOR,\n12\t  IdGenerator,\n13\t  UniqueEntityId,\n14\t  UnitOfWork,\n15\t  UseCase,\n16\t} from '@memories/shared/kernel';\n17\timport { ForbiddenException, Inject, Injectable, UnauthorizedException } from '@nestjs/common';\n18\t\n19\timport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\n20\timport { AuthProvider } from '../../domain/auth-identities/auth-provider';\n21\timport { Portal } from '../../domain/sessions/portal';\n22\timport { RefreshSession } from '../../domain/sessions/refresh-session';\n23\timport {\n24\t  REFRESH_SESSION_REPOSITORY,\n25\t  RefreshSessionRepository,\n26\t} from '../../domain/sessions/refresh-session.repository';\n27\t\n28\texport interface RefreshSessionInput {\n29\t  refreshToken: string;\n30\t  ipAddress: string | null;\n31\t  userAgent: string | null;\n32\t}\n33\t\n34\texport interface RefreshSessionOutput {\n35\t  accessToken: string;\n36\t  refreshToken: string;\n37\t  refreshTokenExpiresAt: Date;\n38\t  portal: Portal;\n39\t  sessionId: string;\n40\t}\n41\t\n42\t/**\n43\t * Rotates the refresh token on every use (docs/guides/authentication-flow.md): the old\n44\t * `RefreshSession` is revoked and points at the new one via `replacedBySessionId`, so a replayed\n45\t * old refresh token (e.g. stolen and used after the legitimate client already rotated) can be\n46\t * told apart from a session that merely expired — both fail, but this is what makes theft\n47\t * detectable in the session table rather than silently accepted.\n48\t *\n49\t * The revoke-old/create-new step runs as one atomic compare-and-swap\n50\t * (`RefreshSessionRepository.revokeIfActive`, `UPDATE ... WHERE revoked_at IS NULL`) inside the\n51\t * transaction rather than a read-then-write, so two concurrent refresh calls for the same token\n52\t * can't both observe the session as active and both mint a new session — only the request whose\n53\t * `UPDATE` actually flips the row wins; the loser gets rejected as if the session were already\n54\t * inactive.\n55\t */\n56\t@Injectable()\n57\texport class RefreshSessionUseCase implements UseCase<RefreshSessionInput, RefreshSessionOutput> {\n58\t  constructor(\n59\t    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n60\t    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n61\t    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,\n62\t    @Inject(USER_PROFILE_LOOKUP) private readonly userProfileLookup: UserProfileLookup,\n63\t    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n64\t    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n65\t    @Inject(CLOCK) private readonly clock: Clock,\n66\t  ) {}\n67\t\n68\t  async execute(input: RefreshSessionInput): Promise<RefreshSessionOutput> {\n69\t    let claims;\n70\t    try {\n71\t      claims = await this.tokenService.verifyRefreshToken(input.refreshToken);\n72\t    } catch {\n73\t      throw new UnauthorizedException('Invalid or expired refresh token');\n74\t    }\n75\t\n76\t    const sessionId = typeof claims.sessionId === 'string' ? claims.sessionId : undefined;\n77\t    const portal = typeof claims.portal === 'string' ? (claims.portal as Portal) : undefined;\n78\t    if (!sessionId || !portal) {\n79\t      throw new UnauthorizedException('Malformed refresh token');\n80\t    }\n81\t\n82\t    const now = this.clock.now();\n83\t    const currentSession = await this.refreshSessions.findById(new UniqueEntityId(sessionId));\n84\t    if (!currentSession || !currentSession.isActive(now)) {\n85\t      throw new UnauthorizedException('Refresh session is no longer active');\n86\t    }\n87\t\n88\t    const account = await this.accounts.findById(new UniqueEntityId(claims.subject));\n89\t    if (!account || !account.canAuthenticate()) {\n90\t      await this.refreshSessions.revokeIfActive(sessionId, now);\n91\t      throw new ForbiddenException('Account is not active');\n92\t    }\n93\t\n94\t    const userProfileId = await this.userProfileLookup.findProfileIdByAccountId(claims.subject);\n95\t\n96\t    return this.unitOfWork.withTransaction(async () => {\n97\t      const newSessionId = new UniqueEntityId(this.idGenerator.generate());\n98\t\n99\t      const revoked = await this.refreshSessions.revokeIfActive(sessionId, now, newSessionId.toValue());\n100\t      if (!revoked) {\n101\t        throw new UnauthorizedException('Refresh session is no longer active');\n102\t      }\n103\t\n104\t      const [accessIssued, refreshIssued] = await Promise.all([\n105\t        this.tokenService.issueAccessToken({\n106\t          subject: claims.subject,\n107\t          sessionId: newSessionId.toValue(),\n108\t          portal,\n109\t          authProvider: AuthProvider.Local,\n110\t          userProfileId: userProfileId ?? undefined,\n111\t          tokenVersion: account.tokenVersion,\n112\t        }),\n113\t        this.tokenService.issueRefreshToken({\n114\t          subject: claims.subject,\n115\t          sessionId: newSessionId.toValue(),\n116\t          portal,\n117\t        }),\n118\t      ]);\n119\t\n120\t      const newSession = RefreshSession.create(\n121\t        {\n122\t          accountId: claims.subject,\n123\t          portal,\n124\t          authProvider: AuthProvider.Local,\n125\t          ipAddress: input.ipAddress,\n126\t          userAgent: input.userAgent,\n127\t          issuedAt: now,\n128\t          expiresAt: refreshIssued.expiresAt,\n129\t          revokedAt: null,\n130\t          replacedBySessionId: null,\n131\t        },\n132\t        newSessionId,\n133\t      );\n134\t      await this.refreshSessions.save(newSession);\n135\t\n136\t      return {\n137\t        accessToken: accessIssued.token,\n138\t        refreshToken: refreshIssued.token,\n139\t        refreshTokenExpiresAt: refreshIssued.expiresAt,\n140\t        portal,\n141\t        sessionId: newSessionId.toValue(),\n142\t      };\n143\t    });\n144\t  }\n145\t}\n146\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"75729e4b-6664-4d8a-a8ea-87499d89fbf6","timestamp":"2026-08-07T15:19:33.830Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/identity-access/src/application/use-cases/refresh-session.use-case.ts","content":"import { UNIT_OF_WORK } from '@memories/platform/database';\nimport {\n  TokenService,\n  TOKEN_SERVICE,\n  UserProfileLookup,\n  USER_PROFILE_LOOKUP,\n} from '@memories/platform/security';\nimport {\n  CLOCK,\n  Clock,\n  ID_GENERATOR,\n  IdGenerator,\n  UniqueEntityId,\n  UnitOfWork,\n  UseCase,\n} from '@memories/shared/kernel';\nimport { ForbiddenException, Inject, Injectable, UnauthorizedException } from '@nestjs/common';\n\nimport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\nimport { AuthProvider } from '../../domain/auth-identities/auth-provider';\nimport { Portal } from '../../domain/sessions/portal';\nimport { RefreshSession } from '../../domain/sessions/refresh-session';\nimport {\n  REFRESH_SESSION_REPOSITORY,\n  RefreshSessionRepository,\n} from '../../domain/sessions/refresh-session.repository';\n\nexport interface RefreshSessionInput {\n  refreshToken: string;\n  ipAddress: string | null;\n  userAgent: string | null;\n}\n\nexport interface RefreshSessionOutput {\n  accessToken: string;\n  refreshToken: string;\n  refreshTokenExpiresAt: Date;\n  portal: Portal;\n  sessionId: string;\n}\n\n/**\n * Rotates the refresh token on every use (docs/guides/authentication-flow.md): the old\n * `RefreshSession` is revoked and points at the new one via `replacedBySessionId`, so a replayed\n * old refresh token (e.g. stolen and used after the legitimate client already rotated) can be\n * told apart from a session that merely expired — both fail, but this is what makes theft\n * detectable in the session table rather than silently accepted.\n *\n * The revoke-old/create-new step runs as one atomic compare-and-swap\n * (`RefreshSessionRepository.revokeIfActive`, `UPDATE ... WHERE revoked_at IS NULL`) inside the\n * transaction rather than a read-then-write, so two concurrent refresh calls for the same token\n * can't both observe the session as active and both mint a new session — only the request whose\n * `UPDATE` actually flips the row wins; the loser gets rejected as if the session were already\n * inactive.\n */\n@Injectable()\nexport class RefreshSessionUseCase implements UseCase<RefreshSessionInput, RefreshSessionOutput> {\n  constructor(\n    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,\n    @Inject(USER_PROFILE_LOOKUP) private readonly userProfileLookup: UserProfileLookup,\n    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n    @Inject(CLOCK) private readonly clock: Clock,\n  ) {}\n\n  async execute(input: RefreshSessionInput): Promise<RefreshSessionOutput> {\n    let claims;\n    try {\n      claims = await this.tokenService.verifyRefreshToken(input.refreshToken);\n    } catch {\n      throw new UnauthorizedException('Invalid or expired refresh token');\n    }\n\n    const sessionId = typeof claims.sessionId === 'string' ? claims.sessionId : undefined;\n    const portal = typeof claims.portal === 'string' ? (claims.portal as Portal) : undefined;\n    if (!sessionId || !portal) {\n      throw new UnauthorizedException('Malformed refresh token');\n    }\n\n    const now = this.clock.now();\n    const currentSession = await this.refreshSessions.findById(new UniqueEntityId(sessionId));\n    if (!currentSession || !currentSession.isActive(now)) {\n      throw new UnauthorizedException('Refresh session is no longer active');\n    }\n\n    const account = await this.accounts.findById(new UniqueEntityId(claims.subject));\n    if (!account || !account.canAuthenticate()) {\n      await this.refreshSessions.revokeIfActive(sessionId, now);\n      throw new ForbiddenException('Account is not active');\n    }\n\n    const userProfileId = await this.userProfileLookup.findProfileIdByAccountId(claims.subject);\n\n    return this.unitOfWork.withTransaction(async () => {\n      const newSessionId = new UniqueEntityId(this.idGenerator.generate());\n\n      const revoked = await this.refreshSessions.revokeIfActive(sessionId, now, newSessionId.toValue());\n      if (!revoked) {\n        throw new UnauthorizedException('Refresh session is no longer active');\n      }\n\n      const [accessIssued, refreshIssued] = await Promise.all([\n        this.tokenService.issueAccessToken({\n          subject: claims.subject,\n          sessionId: newSessionId.toValue(),\n          portal,\n          authProvider: AuthProvider.Local,\n          userProfileId: userProfileId ?? undefined,\n          tokenVersion: account.tokenVersion,\n        }),\n        this.tokenService.issueRefreshToken({\n          subject: claims.subject,\n          sessionId: newSessionId.toValue(),\n          portal,\n        }),\n      ]);\n\n      const newSession = RefreshSession.create(\n        {\n          accountId: claims.subject,\n          portal,\n          authProvider: AuthProvider.Local,\n          ipAddress: input.ipAddress,\n          userAgent: input.userAgent,\n          issuedAt: now,\n          expiresAt: refreshIssued.expiresAt,\n          revokedAt: null,\n          replacedBySessionId: null,\n        },\n        newSessionId,\n      );\n      await this.refreshSessions.save(newSession);\n\n      return {\n        accessToken: accessIssued.token,\n        refreshToken: refreshIssued.token,\n        refreshTokenExpiresAt: refreshIssued.expiresAt,\n        portal,\n        sessionId: newSessionId.toValue(),\n      };\n    });\n  }\n}\n","numLines":146,"startLine":1,"totalLines":146}}}
