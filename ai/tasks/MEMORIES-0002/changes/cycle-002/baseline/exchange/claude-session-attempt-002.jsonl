{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011X4S7V6gsqk3KnFNzsuhMm","type":"tool_result","content":"1\timport { UNIT_OF_WORK } from '@memories/platform/database';\n2\timport {\n3\t  RequestContext,\n4\t  UserProfileProvisioner,\n5\t  USER_PROFILE_PROVISIONER,\n6\t} from '@memories/platform/security';\n7\timport {\n8\t  CLOCK,\n9\t  Clock,\n10\t  DomainError,\n11\t  UniqueEntityId,\n12\t  UnitOfWork,\n13\t  UseCase,\n14\t} from '@memories/shared/kernel';\n15\timport { Inject, Injectable } from '@nestjs/common';\n16\t\n17\timport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\n18\timport {\n19\t  AUTH_IDENTITY_REPOSITORY,\n20\t  AuthIdentityRepository,\n21\t} from '../../domain/auth-identities/auth-identity.repository';\n22\timport {\n23\t  REFRESH_SESSION_REPOSITORY,\n24\t  RefreshSessionRepository,\n25\t} from '../../domain/sessions/refresh-session.repository';\n26\t\n27\texport interface DeleteAccountInput {\n28\t  accountId: string;\n29\t}\n30\t\n31\t/**\n32\t * §16 `DELETE /accounts/:accountId`. Soft deletes the Account and every one of its AuthIdentities,\n33\t * asks `user-profiles` (via the cross-module `UserProfileProvisioner` port) to soft delete the\n34\t * UserProfile, and revokes every outstanding session — all inside one transaction (task.md §16\n35\t * \"Xóa Account phải: Soft delete Account, Soft delete AuthIdentity, Soft delete UserProfile, Revoke\n36\t * refresh sessions\"). This is a soft delete only (out of scope: \"Xóa vật lý Account hoặc\n37\t * UserProfile\").\n38\t */\n39\t@Injectable()\n40\texport class DeleteAccountUseCase implements UseCase<DeleteAccountInput, void> {\n41\t  constructor(\n42\t    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n43\t    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,\n44\t    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n45\t    @Inject(USER_PROFILE_PROVISIONER) private readonly userProfileProvisioner: UserProfileProvisioner,\n46\t    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n47\t    @Inject(CLOCK) private readonly clock: Clock,\n48\t    private readonly requestContext: RequestContext,\n49\t  ) {}\n50\t\n51\t  async execute(input: DeleteAccountInput): Promise<void> {\n52\t    const actorId = this.requestContext.currentActorId();\n53\t\n54\t    await this.unitOfWork.withTransaction(async () => {\n55\t      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));\n56\t      if (!account) {\n57\t        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);\n58\t      }\n59\t\n60\t      const now = this.clock.now();\n61\t      account.softDelete(actorId, now);\n62\t      await this.accounts.save(account);\n63\t\n64\t      const identities = await this.authIdentities.findAllByAccountId(input.accountId);\n65\t      for (const identity of identities) {\n66\t        if (!identity.isDeleted) {\n67\t          identity.softDelete(actorId, now);\n68\t          await this.authIdentities.save(identity);\n69\t        }\n70\t      }\n71\t\n72\t      await this.userProfileProvisioner.deleteByAccountId(input.accountId);\n73\t      await this.refreshSessions.revokeAllForAccount(input.accountId, now);\n74\t    });\n75\t  }\n76\t}\n77\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"d2202620-ee01-45b7-9321-bb2682f38e8f","timestamp":"2026-08-07T15:20:07.293Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/identity-access/src/application/use-cases/delete-account.use-case.ts","content":"import { UNIT_OF_WORK } from '@memories/platform/database';\nimport {\n  RequestContext,\n  UserProfileProvisioner,\n  USER_PROFILE_PROVISIONER,\n} from '@memories/platform/security';\nimport {\n  CLOCK,\n  Clock,\n  DomainError,\n  UniqueEntityId,\n  UnitOfWork,\n  UseCase,\n} from '@memories/shared/kernel';\nimport { Inject, Injectable } from '@nestjs/common';\n\nimport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\nimport {\n  AUTH_IDENTITY_REPOSITORY,\n  AuthIdentityRepository,\n} from '../../domain/auth-identities/auth-identity.repository';\nimport {\n  REFRESH_SESSION_REPOSITORY,\n  RefreshSessionRepository,\n} from '../../domain/sessions/refresh-session.repository';\n\nexport interface DeleteAccountInput {\n  accountId: string;\n}\n\n/**\n * §16 `DELETE /accounts/:accountId`. Soft deletes the Account and every one of its AuthIdentities,\n * asks `user-profiles` (via the cross-module `UserProfileProvisioner` port) to soft delete the\n * UserProfile, and revokes every outstanding session — all inside one transaction (task.md §16\n * \"Xóa Account phải: Soft delete Account, Soft delete AuthIdentity, Soft delete UserProfile, Revoke\n * refresh sessions\"). This is a soft delete only (out of scope: \"Xóa vật lý Account hoặc\n * UserProfile\").\n */\n@Injectable()\nexport class DeleteAccountUseCase implements UseCase<DeleteAccountInput, void> {\n  constructor(\n    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,\n    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n    @Inject(USER_PROFILE_PROVISIONER) private readonly userProfileProvisioner: UserProfileProvisioner,\n    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n    @Inject(CLOCK) private readonly clock: Clock,\n    private readonly requestContext: RequestContext,\n  ) {}\n\n  async execute(input: DeleteAccountInput): Promise<void> {\n    const actorId = this.requestContext.currentActorId();\n\n    await this.unitOfWork.withTransaction(async () => {\n      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));\n      if (!account) {\n        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);\n      }\n\n      const now = this.clock.now();\n      account.softDelete(actorId, now);\n      await this.accounts.save(account);\n\n      const identities = await this.authIdentities.findAllByAccountId(input.accountId);\n      for (const identity of identities) {\n        if (!identity.isDeleted) {\n          identity.softDelete(actorId, now);\n          await this.authIdentities.save(identity);\n        }\n      }\n\n      await this.userProfileProvisioner.deleteByAccountId(input.accountId);\n      await this.refreshSessions.revokeAllForAccount(input.accountId, now);\n    });\n  }\n}\n","numLines":77,"startLine":1,"totalLines":77}}}
