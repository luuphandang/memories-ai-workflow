{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XGx6cWUr5vrrU6Y8bXCaNn","type":"tool_result","content":"1\timport {\n2\t  JwtAuthGuard,\n3\t  PermissionsGuard,\n4\t  PortalGuard,\n5\t  RequirePermissions,\n6\t  RequirePortal,\n7\t} from '@memories/platform/security';\n8\timport { Body, Controller, Delete, Get, HttpCode, HttpStatus, Param, Patch, Post, Query, UseGuards } from '@nestjs/common';\n9\timport { ApiBearerAuth, ApiParam, ApiResponse, ApiTags } from '@nestjs/swagger';\n10\t\n11\timport { CreateUserProfileUseCase, UserProfileOutput } from '../../application/use-cases/create-user-profile.use-case';\n12\timport { DeleteUserProfileUseCase } from '../../application/use-cases/delete-user-profile.use-case';\n13\timport { GetUserProfileUseCase } from '../../application/use-cases/get-user-profile.use-case';\n14\timport { ListUserProfilesUseCase } from '../../application/use-cases/list-user-profiles.use-case';\n15\timport { UpdateUserProfileUseCase } from '../../application/use-cases/update-user-profile.use-case';\n16\t\n17\timport { CreateUserProfileDto } from './create-user-profile.dto';\n18\timport { ListUserProfilesQueryDto } from './list-user-profiles.dto';\n19\timport { UpdateUserProfileDto } from './update-user-profile.dto';\n20\timport { ListUserProfilesResponseDto, UserProfileResponseDto } from './user-profile-response.dto';\n21\t\n22\tfunction toResponseDto(output: UserProfileOutput): UserProfileResponseDto {\n23\t  return {\n24\t    id: output.id,\n25\t    accountId: output.accountId,\n26\t    fullName: output.fullName,\n27\t    email: output.email,\n28\t    avatarId: output.avatarId,\n29\t    dateOfBirth: output.dateOfBirth ? output.dateOfBirth.toISOString().slice(0, 10) : null,\n30\t    address: output.address,\n31\t    createdAt: output.createdAt,\n32\t    updatedAt: output.updatedAt,\n33\t  };\n34\t}\n35\t\n36\t/**\n37\t * §17. Never returns the ORM entity — always through `UserProfileOutput`/`UserProfileResponseDto`.\n38\t * Every route here can read/write ANY account's profile by id — an administrative surface, not a\n39\t * \"my profile\" self-service endpoint — so it is gated the same way `AccountController` is:\n40\t * `@RequirePortal('ADMIN')` rejects a token issued for the PUBLIC portal even if the same Account\n41\t * also holds `user-profile.*` permissions (a PUBLIC-portal token must never reach an admin-only\n42\t * route just because the underlying Account happens to also have admin permissions).\n43\t */\n44\t@ApiTags('user-profiles')\n45\t@ApiBearerAuth()\n46\t@UseGuards(JwtAuthGuard, PortalGuard, PermissionsGuard)\n47\t@RequirePortal('ADMIN')\n48\t@Controller('user-profiles')\n49\texport class UserProfileController {\n50\t  constructor(\n51\t    private readonly createUserProfile: CreateUserProfileUseCase,\n52\t    private readonly getUserProfile: GetUserProfileUseCase,\n53\t    private readonly listUserProfiles: ListUserProfilesUseCase,\n54\t    private readonly updateUserProfile: UpdateUserProfileUseCase,\n55\t    private readonly deleteUserProfile: DeleteUserProfileUseCase,\n56\t  ) {}\n57\t\n58\t  @Post()\n59\t  @RequirePermissions('user-profile.create')\n60\t  @ApiResponse({ status: HttpStatus.CREATED, type: UserProfileResponseDto })\n61\t  async create(@Body() dto: CreateUserProfileDto): Promise<UserProfileResponseDto> {\n62\t    const output = await this.createUserProfile.execute({\n63\t      accountId: dto.accountId,\n64\t      fullName: dto.fullName,\n65\t      email: dto.email,\n66\t      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,\n67\t      address: dto.address,\n68\t      avatarId: dto.avatarId,\n69\t    });\n70\t    return toResponseDto(output);\n71\t  }\n72\t\n73\t  @Get()\n74\t  @RequirePermissions('user-profile.read')\n75\t  @ApiResponse({ status: HttpStatus.OK, type: ListUserProfilesResponseDto })\n76\t  async list(@Query() query: ListUserProfilesQueryDto): Promise<ListUserProfilesResponseDto> {\n77\t    const result = await this.listUserProfiles.execute({\n78\t      fullNameSearch: query.fullName,\n79\t      emailSearch: query.email,\n80\t      phoneSearch: query.phone,\n81\t      page: query.page,\n82\t      pageSize: query.pageSize,\n83\t      sortBy: query.sortBy,\n84\t      sortDirection: query.sortDirection,\n85\t    });\n86\t    return {\n87\t      items: result.items.map(toResponseDto),\n88\t      total: result.total,\n89\t      page: result.page,\n90\t      pageSize: result.pageSize,\n91\t      totalPages: result.totalPages,\n92\t    };\n93\t  }\n94\t\n95\t  @Get(':userProfileId')\n96\t  @RequirePermissions('user-profile.read')\n97\t  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })\n98\t  @ApiResponse({ status: HttpStatus.OK, type: UserProfileResponseDto })\n99\t  async getById(@Param('userProfileId') userProfileId: string): Promise<UserProfileResponseDto> {\n100\t    const output = await this.getUserProfile.execute({ userProfileId });\n101\t    return toResponseDto(output);\n102\t  }\n103\t\n104\t  @Patch(':userProfileId')\n105\t  @RequirePermissions('user-profile.update')\n106\t  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })\n107\t  @ApiResponse({ status: HttpStatus.OK, type: UserProfileResponseDto })\n108\t  async update(\n109\t    @Param('userProfileId') userProfileId: string,\n110\t    @Body() dto: UpdateUserProfileDto,\n111\t  ): Promise<UserProfileResponseDto> {\n112\t    const output = await this.updateUserProfile.execute({\n113\t      userProfileId,\n114\t      fullName: dto.fullName,\n115\t      email: dto.email,\n116\t      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,\n117\t      address: dto.address,\n118\t      avatarId: dto.avatarId,\n119\t    });\n120\t    return toResponseDto(output);\n121\t  }\n122\t\n123\t  @Delete(':userProfileId')\n124\t  @RequirePermissions('user-profile.delete')\n125\t  @HttpCode(HttpStatus.NO_CONTENT)\n126\t  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })\n127\t  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n128\t  async remove(@Param('userProfileId') userProfileId: string): Promise<void> {\n129\t    await this.deleteUserProfile.execute({ userProfileId });\n130\t  }\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"7611dafd-4cee-4b73-a286-3a7d0ca15998","timestamp":"2026-08-07T15:19:25.287Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/user-profiles/src/presentation/http/user-profile.controller.ts","content":"import {\n  JwtAuthGuard,\n  PermissionsGuard,\n  PortalGuard,\n  RequirePermissions,\n  RequirePortal,\n} from '@memories/platform/security';\nimport { Body, Controller, Delete, Get, HttpCode, HttpStatus, Param, Patch, Post, Query, UseGuards } from '@nestjs/common';\nimport { ApiBearerAuth, ApiParam, ApiResponse, ApiTags } from '@nestjs/swagger';\n\nimport { CreateUserProfileUseCase, UserProfileOutput } from '../../application/use-cases/create-user-profile.use-case';\nimport { DeleteUserProfileUseCase } from '../../application/use-cases/delete-user-profile.use-case';\nimport { GetUserProfileUseCase } from '../../application/use-cases/get-user-profile.use-case';\nimport { ListUserProfilesUseCase } from '../../application/use-cases/list-user-profiles.use-case';\nimport { UpdateUserProfileUseCase } from '../../application/use-cases/update-user-profile.use-case';\n\nimport { CreateUserProfileDto } from './create-user-profile.dto';\nimport { ListUserProfilesQueryDto } from './list-user-profiles.dto';\nimport { UpdateUserProfileDto } from './update-user-profile.dto';\nimport { ListUserProfilesResponseDto, UserProfileResponseDto } from './user-profile-response.dto';\n\nfunction toResponseDto(output: UserProfileOutput): UserProfileResponseDto {\n  return {\n    id: output.id,\n    accountId: output.accountId,\n    fullName: output.fullName,\n    email: output.email,\n    avatarId: output.avatarId,\n    dateOfBirth: output.dateOfBirth ? output.dateOfBirth.toISOString().slice(0, 10) : null,\n    address: output.address,\n    createdAt: output.createdAt,\n    updatedAt: output.updatedAt,\n  };\n}\n\n/**\n * §17. Never returns the ORM entity — always through `UserProfileOutput`/`UserProfileResponseDto`.\n * Every route here can read/write ANY account's profile by id — an administrative surface, not a\n * \"my profile\" self-service endpoint — so it is gated the same way `AccountController` is:\n * `@RequirePortal('ADMIN')` rejects a token issued for the PUBLIC portal even if the same Account\n * also holds `user-profile.*` permissions (a PUBLIC-portal token must never reach an admin-only\n * route just because the underlying Account happens to also have admin permissions).\n */\n@ApiTags('user-profiles')\n@ApiBearerAuth()\n@UseGuards(JwtAuthGuard, PortalGuard, PermissionsGuard)\n@RequirePortal('ADMIN')\n@Controller('user-profiles')\nexport class UserProfileController {\n  constructor(\n    private readonly createUserProfile: CreateUserProfileUseCase,\n    private readonly getUserProfile: GetUserProfileUseCase,\n    private readonly listUserProfiles: ListUserProfilesUseCase,\n    private readonly updateUserProfile: UpdateUserProfileUseCase,\n    private readonly deleteUserProfile: DeleteUserProfileUseCase,\n  ) {}\n\n  @Post()\n  @RequirePermissions('user-profile.create')\n  @ApiResponse({ status: HttpStatus.CREATED, type: UserProfileResponseDto })\n  async create(@Body() dto: CreateUserProfileDto): Promise<UserProfileResponseDto> {\n    const output = await this.createUserProfile.execute({\n      accountId: dto.accountId,\n      fullName: dto.fullName,\n      email: dto.email,\n      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,\n      address: dto.address,\n      avatarId: dto.avatarId,\n    });\n    return toResponseDto(output);\n  }\n\n  @Get()\n  @RequirePermissions('user-profile.read')\n  @ApiResponse({ status: HttpStatus.OK, type: ListUserProfilesResponseDto })\n  async list(@Query() query: ListUserProfilesQueryDto): Promise<ListUserProfilesResponseDto> {\n    const result = await this.listUserProfiles.execute({\n      fullNameSearch: query.fullName,\n      emailSearch: query.email,\n      phoneSearch: query.phone,\n      page: query.page,\n      pageSize: query.pageSize,\n      sortBy: query.sortBy,\n      sortDirection: query.sortDirection,\n    });\n    return {\n      items: result.items.map(toResponseDto),\n      total: result.total,\n      page: result.page,\n      pageSize: result.pageSize,\n      totalPages: result.totalPages,\n    };\n  }\n\n  @Get(':userProfileId')\n  @RequirePermissions('user-profile.read')\n  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.OK, type: UserProfileResponseDto })\n  async getById(@Param('userProfileId') userProfileId: string): Promise<UserProfileResponseDto> {\n    const output = await this.getUserProfile.execute({ userProfileId });\n    return toResponseDto(output);\n  }\n\n  @Patch(':userProfileId')\n  @RequirePermissions('user-profile.update')\n  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.OK, type: UserProfileResponseDto })\n  async update(\n    @Param('userProfileId') userProfileId: string,\n    @Body() dto: UpdateUserProfileDto,\n  ): Promise<UserProfileResponseDto> {\n    const output = await this.updateUserProfile.execute({\n      userProfileId,\n      fullName: dto.fullName,\n      email: dto.email,\n      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,\n      address: dto.address,\n      avatarId: dto.avatarId,\n    });\n    return toResponseDto(output);\n  }\n\n  @Delete(':userProfileId')\n  @RequirePermissions('user-profile.delete')\n  @HttpCode(HttpStatus.NO_CONTENT)\n  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n  async remove(@Param('userProfileId') userProfileId: string): Promise<void> {\n    await this.deleteUserProfile.execute({ userProfileId });\n  }\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
