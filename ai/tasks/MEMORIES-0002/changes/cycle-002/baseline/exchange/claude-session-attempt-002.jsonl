kerApp = workerModuleRef.createNestApplication();\n@@ -79,9 +87,26 @@ describe('Media upload flow (e2e)', () => {\n     await workerApp.close();\n   });\n \n-  async function authHeader(subject: string): Promise<string> {\n-    const { token } = await tokenService.issueAccessToken({ subject });\n-    return `Bearer ${token}`;\n+  /** 09 + 8 random digits — a valid VN mobile shape (libphonenumber-js), random per call so\n+   * re-running this suite against a database with rows from a previous run can't collide on the\n+   * unique `provider + identifier` constraint. */\n+  function nextPhone(): string {\n+    const suffix = randomInt(10_000_000, 99_999_999);\n+    return `09${String(suffix).padStart(8, '0')}`;\n+  }\n+\n+  /** Provisions a real Account (so `JwtAuthGuard`'s live status/tokenVersion check accepts the\n+   * token) and mints an access token for it directly via `TokenService`, bypassing the\n+   * phone/password login flow — this suite only needs a valid authenticated subject, not portal\n+   * authorization, which media routes don't check. */\n+  async function authHeader(): Promise<{ ownerId: string; authorization: string }> {\n+    const { accountId } = await createAccount.execute({\n+      phone: nextPhone(),\n+      password: 'Sup3rSecret!',\n+      fullName: 'Media E2E Owner',\n+    });\n+    const { token } = await tokenService.issueAccessToken({ subject: accountId, tokenVersion: 0 });\n+    return { ownerId: accountId, authorization: `Bearer ${token}` };\n   }\n \n   async function pollUntilSettled(\n@@ -108,8 +133,7 @@ describe('Media upload flow (e2e)', () => {\n   }\n \n   it('runs create -> upload -> confirm -> worker through to `ready`', async () => {\n-    const ownerId = randomUUID();\n-    const authorization = await authHeader(ownerId);\n+    const { authorization } = await authHeader();\n     // confirm-upload cross-checks the real uploaded object's Content-Type/Content-Length against\n     // what was declared at creation time — must match exactly for this flow to reach 'ready'.\n     const fileBytes = Buffer.from('e2e-test-fixture-bytes');\n@@ -156,8 +180,7 @@ describe('Media upload flow (e2e)', () => {\n     // whose actual Content-Length differs fails signature verification (403) before any bytes are\n     // stored. Without this, a client could declare a small size at creation time and then upload\n     // an object of any size using the same presigned URL, leaving unbounded objects in storage.\n-    const ownerId = randomUUID();\n-    const authorization = await authHeader(ownerId);\n+    const { authorization } = await authHeader();\n     const declaredBytes = Buffer.from('small');\n \n     const createResponse = await request(apiApp.getHttpServer())\n@@ -185,8 +208,7 @@ describe('Media upload flow (e2e)', () => {\n     // time, an object swapped out after confirmation (using the SAME still-valid presigned URL)\n     // but before the worker actually runs would be silently processed as if it were the original,\n     // already-validated file.\n-    const ownerId = randomUUID();\n-    const authorization = await authHeader(ownerId);\n+    const { authorization } = await authHeader();\n     const originalBytes = Buffer.from('e2e-toctou-original-bytes');\n \n     const createResponse = await request(apiApp.getHttpServer())\n@@ -242,8 +264,7 @@ describe('Media upload flow (e2e)', () => {\n   }, 30_000);\n \n   it('marks the asset failed when the object goes missing, then reprocess brings it to ready once restored', async () => {\n-    const ownerId = randomUUID();\n-    const authorization = await authHeader(ownerId);\n+    const { authorization } = await authHeader();\n     const fileBytes = Buffer.from('e2e-reprocess-fixture-bytes');\n \n     const createResponse = await request(apiApp.getHttpServer())\n@@ -309,8 +330,7 @@ describe('Media upload flow (e2e)', () => {\n   }, 30_000);\n \n   it('reconciliation sweeping the OLD failed job never clobbers a newer reprocess attempt (attempt-scoped C