{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BEjd7AgXviE8izuBMUo3rN","type":"tool_result","content":"1\timport { CanActivate, ExecutionContext, Injectable, SetMetadata } from '@nestjs/common';\n2\timport { Reflector } from '@nestjs/core';\n3\t\n4\timport type { RequestUser } from './jwt-auth.guard';\n5\t\n6\texport const PORTAL_METADATA_KEY = 'memories:required-portal';\n7\t\n8\t/** e.g. `@RequirePortal('ADMIN')` on a controller/route. Plain string, not identity-access's\n9\t * `Portal` enum — `libs/platform/security` must not depend on a business module (module boundary,\n10\t * `npm run test:architecture`). */\n11\texport const RequirePortal = (portal: string) => SetMetadata(PORTAL_METADATA_KEY, portal);\n12\t\n13\t/**\n14\t * §13/§23: a token issued for one portal must not be treated as valid for another — \"Token public\n15\t * không thể truy cập admin API nếu không hợp lệ về audience hoặc portal\". Run after `JwtAuthGuard`\n16\t * (needs `request.user.portal`, populated from the `portal` JWT claim) and before `PermissionsGuard`\n17\t * — a PUBLIC-portal token must be rejected here even if the underlying Account also happens to hold\n18\t * admin permissions, since that Account never authenticated *into* the admin portal for this session.\n19\t */\n20\t@Injectable()\n21\texport class PortalGuard implements CanActivate {\n22\t  constructor(private readonly reflector: Reflector) {}\n23\t\n24\t  canActivate(context: ExecutionContext): boolean {\n25\t    const requiredPortal = this.reflector.getAllAndOverride<string>(PORTAL_METADATA_KEY, [\n26\t      context.getHandler(),\n27\t      context.getClass(),\n28\t    ]);\n29\t    if (!requiredPortal) {\n30\t      return true;\n31\t    }\n32\t\n33\t    const request = context.switchToHttp().getRequest<{ user?: RequestUser }>();\n34\t    return request.user?.portal === requiredPortal;\n35\t  }\n36\t}\n37\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"f4610c66-c6e1-44d6-90f7-fe2b9a8ad6ee","timestamp":"2026-08-07T15:19:25.823Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/platform/security/src/portal.guard.ts","content":"import { CanActivate, ExecutionContext, Injectable, SetMetadata } from '@nestjs/common';\nimport { Reflector } from '@nestjs/core';\n\nimport type { RequestUser } from './jwt-auth.guard';\n\nexport const PORTAL_METADATA_KEY = 'memories:required-portal';\n\n/** e.g. `@RequirePortal('ADMIN')` on a controller/route. Plain string, not identity-access's\n * `Portal` enum — `libs/platform/security` must not depend on a business module (module boundary,\n * `npm run test:architecture`). */\nexport const RequirePortal = (portal: string) => SetMetadata(PORTAL_METADATA_KEY, portal);\n\n/**\n * §13/§23: a token issued for one portal must not be treated as valid for another — \"Token public\n * không thể truy cập admin API nếu không hợp lệ về audience hoặc portal\". Run after `JwtAuthGuard`\n * (needs `request.user.portal`, populated from the `portal` JWT claim) and before `PermissionsGuard`\n * — a PUBLIC-portal token must be rejected here even if the underlying Account also happens to hold\n * admin permissions, since that Account never authenticated *into* the admin portal for this session.\n */\n@Injectable()\nexport class PortalGuard implements CanActivate {\n  constructor(private readonly reflector: Reflector) {}\n\n  canActivate(context: ExecutionContext): boolean {\n    const requiredPortal = this.reflector.getAllAndOverride<string>(PORTAL_METADATA_KEY, [\n      context.getHandler(),\n      context.getClass(),\n    ]);\n    if (!requiredPortal) {\n      return true;\n    }\n\n    const request = context.switchToHttp().getRequest<{ user?: RequestUser }>();\n    return request.user?.portal === requiredPortal;\n  }\n}\n","numLines":37,"startLine":1,"totalLines":37}}}
