{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0163UjkfEgF5MCSXQkGC5AGJ","type":"tool_result","content":"1\timport {\n2\t  CanActivate,\n3\t  ExecutionContext,\n4\t  Inject,\n5\t  Injectable,\n6\t  Optional,\n7\t  SetMetadata,\n8\t} from '@nestjs/common';\n9\timport { Reflector } from '@nestjs/core';\n10\t\n11\timport { RequestContext } from './request-context';\n12\t\n13\texport const PERMISSIONS_METADATA_KEY = 'memories:required-permissions';\n14\t\n15\t/** e.g. RequirePermissions('orders:read', 'orders:refund') on a controller method. */\n16\texport const RequirePermissions = (...permissions: string[]) =>\n17\t  SetMetadata(PERMISSIONS_METADATA_KEY, permissions);\n18\t\n19\texport interface ResolvedPermissions {\n20\t  roles: string[];\n21\t  permissions: string[];\n22\t}\n23\t\n24\t/** Implemented by identity-access; other modules only see this port through DI. */\n25\texport interface PermissionChecker {\n26\t  hasPermissions(userId: string, permissions: string[]): Promise<boolean>;\n27\t  /** Full role/permission resolution for the request context (§14) — used by `PermissionsGuard`\n28\t   * to populate `RequestContext.roles`/`.permissions` even on routes that don't declare\n29\t   * `@RequirePermissions(...)`, so downstream code (audit, business rules) can still read \"what\n30\t   * can this caller do\" without a second round-trip. */\n31\t  resolvePermissions(userId: string): Promise<ResolvedPermissions>;\n32\t}\n33\t\n34\texport const PERMISSION_CHECKER = Symbol('PERMISSION_CHECKER');\n35\t\n36\t@Injectable()\n37\texport class PermissionsGuard implements CanActivate {\n38\t  constructor(\n39\t    private readonly reflector: Reflector,\n40\t    @Inject(PERMISSION_CHECKER) private readonly permissionChecker: PermissionChecker,\n41\t    @Optional() private readonly requestContext?: RequestContext,\n42\t  ) {}\n43\t\n44\t  async canActivate(context: ExecutionContext): Promise<boolean> {\n45\t    const required = this.reflector.getAllAndOverride<string[]>(PERMISSIONS_METADATA_KEY, [\n46\t      context.getHandler(),\n47\t      context.getClass(),\n48\t    ]);\n49\t\n50\t    const request = context.switchToHttp().getRequest<{ user?: { id: string } }>();\n51\t    if (!request.user) {\n52\t      return !required || required.length === 0;\n53\t    }\n54\t\n55\t    const store = this.requestContext?.get();\n56\t    if (store && store.accountId === request.user.id && store.roles.length === 0) {\n57\t      const resolved = await this.permissionChecker.resolvePermissions(request.user.id);\n58\t      store.roles = resolved.roles;\n59\t      store.permissions = resolved.permissions;\n60\t    }\n61\t\n62\t    if (!required || required.length === 0) {\n63\t      return true;\n64\t    }\n65\t\n66\t    return this.permissionChecker.hasPermissions(request.user.id, required);\n67\t  }\n68\t}\n69\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"d949b235-ad96-4745-abb5-a96eefa99d4e","timestamp":"2026-08-07T15:18:34.699Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/platform/security/src/authorization.contract.ts","content":"import {\n  CanActivate,\n  ExecutionContext,\n  Inject,\n  Injectable,\n  Optional,\n  SetMetadata,\n} from '@nestjs/common';\nimport { Reflector } from '@nestjs/core';\n\nimport { RequestContext } from './request-context';\n\nexport const PERMISSIONS_METADATA_KEY = 'memories:required-permissions';\n\n/** e.g. RequirePermissions('orders:read', 'orders:refund') on a controller method. */\nexport const RequirePermissions = (...permissions: string[]) =>\n  SetMetadata(PERMISSIONS_METADATA_KEY, permissions);\n\nexport interface ResolvedPermissions {\n  roles: string[];\n  permissions: string[];\n}\n\n/** Implemented by identity-access; other modules only see this port through DI. */\nexport interface PermissionChecker {\n  hasPermissions(userId: string, permissions: string[]): Promise<boolean>;\n  /** Full role/permission resolution for the request context (§14) — used by `PermissionsGuard`\n   * to populate `RequestContext.roles`/`.permissions` even on routes that don't declare\n   * `@RequirePermissions(...)`, so downstream code (audit, business rules) can still read \"what\n   * can this caller do\" without a second round-trip. */\n  resolvePermissions(userId: string): Promise<ResolvedPermissions>;\n}\n\nexport const PERMISSION_CHECKER = Symbol('PERMISSION_CHECKER');\n\n@Injectable()\nexport class PermissionsGuard implements CanActivate {\n  constructor(\n    private readonly reflector: Reflector,\n    @Inject(PERMISSION_CHECKER) private readonly permissionChecker: PermissionChecker,\n    @Optional() private readonly requestContext?: RequestContext,\n  ) {}\n\n  async canActivate(context: ExecutionContext): Promise<boolean> {\n    const required = this.reflector.getAllAndOverride<string[]>(PERMISSIONS_METADATA_KEY, [\n      context.getHandler(),\n      context.getClass(),\n    ]);\n\n    const request = context.switchToHttp().getRequest<{ user?: { id: string } }>();\n    if (!request.user) {\n      return !required || required.length === 0;\n    }\n\n    const store = this.requestContext?.get();\n    if (store && store.accountId === request.user.id && store.roles.length === 0) {\n      const resolved = await this.permissionChecker.resolvePermissions(request.user.id);\n      store.roles = resolved.roles;\n      store.permissions = resolved.permissions;\n    }\n\n    if (!required || required.length === 0) {\n      return true;\n    }\n\n    return this.permissionChecker.hasPermissions(request.user.id, required);\n  }\n}\n","numLines":69,"startLine":1,"totalLines":69}}}
