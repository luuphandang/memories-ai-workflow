{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S7HRUKcWBcMdjpLNztmEgb","type":"tool_result","content":"1\timport { AsyncLocalStorage } from 'node:async_hooks';\n2\t\n3\timport { UnitOfWork } from '@memories/shared/kernel';\n4\timport { Injectable } from '@nestjs/common';\n5\timport { DataSource, QueryRunner } from 'typeorm';\n6\t\n7\t/**\n8\t * AsyncLocalStorage-backed so concurrent requests each see only their own active transaction's\n9\t * QueryRunner. A plain mutable field (the original scaffolded shape) would be a shared singleton\n10\t * across every concurrent request: one request's `withTransaction` call would silently overwrite\n11\t * another's in-flight QueryRunner, corrupting whichever transaction started first. This had never\n12\t * been exercised by any real repository until the confirm-upload/outbox work needed it for real.\n13\t */\n14\t@Injectable()\n15\texport class TypeOrmQueryRunnerContext {\n16\t  private static readonly storage = new AsyncLocalStorage<QueryRunner>();\n17\t\n18\t  run<TResult>(queryRunner: QueryRunner, callback: () => Promise<TResult>): Promise<TResult> {\n19\t    return TypeOrmQueryRunnerContext.storage.run(queryRunner, callback);\n20\t  }\n21\t\n22\t  get(): QueryRunner | undefined {\n23\t    return TypeOrmQueryRunnerContext.storage.getStore();\n24\t  }\n25\t}\n26\t\n27\t@Injectable()\n28\texport class TypeOrmUnitOfWork implements UnitOfWork {\n29\t  constructor(\n30\t    private readonly dataSource: DataSource,\n31\t    private readonly context: TypeOrmQueryRunnerContext,\n32\t  ) {}\n33\t\n34\t  async withTransaction<TResult>(work: () => Promise<TResult>): Promise<TResult> {\n35\t    const queryRunner = this.dataSource.createQueryRunner();\n36\t    // `connect()` checks a connection out of the pool — once it resolves, that connection MUST\n37\t    // be released no matter what happens next, so everything from here on is wrapped in a\n38\t    // try/finally. `startTransaction()` used to run BEFORE