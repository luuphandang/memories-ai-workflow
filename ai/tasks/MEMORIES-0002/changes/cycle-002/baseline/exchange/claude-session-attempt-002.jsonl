{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FLrDz7f4sr4ZmQK4E6B5es","type":"tool_result","content":"1\timport { randomInt } from 'node:crypto';\n2\t\n3\timport {\n4\t  ACCOUNT_ROLE_REPOSITORY,\n5\t  AccountRoleRepository,\n6\t  CreateAccountUseCase,\n7\t  ROLE_REPOSITORY,\n8\t  RoleRepository,\n9\t  SeedRolesAndPermissionsUseCase,\n10\t} from '@memories/modules/identity-access';\n11\timport { AppConfig } from '@memories/platform/configuration';\n12\timport { TOKEN_SERVICE, TokenService } from '@memories/platform/security';\n13\timport { INestApplication } from '@nestjs/common';\n14\timport { ConfigService } from '@nestjs/config';\n15\timport { Test, TestingModule } from '@nestjs/testing';\n16\timport request from 'supertest';\n17\t\n18\timport { AppModule } from '../src/app.module';\n19\timport { configureApp } from '../src/configure-app';\n20\t\n21\t/**\n22\t * Requires the local infrastructure stack (`docker compose -f docker/docker-compose.yml\n23\t * --profile infrastructure up -d`) and a populated `.env`; run via `npm run test:e2e`.\n24\t *\n25\t * Exercises MEMORIES-0002's login/authorization/CRUD flows end to end against a real\n26\t * Postgres-backed AppModule — the real HTTP layer, guards and use cases, not mocks. Test-only\n27\t * setup (seeding roles/permissions, provisioning a bootstrap SUPER_ADMIN, granting extra roles)\n28\t * goes through `CreateAccountUseCase`/`AccountRoleRepository` obtained directly from the Nest\n29\t * container (`{ strict: false }`, same pattern as `media-upload-flow.e2e-spec.ts`) since there is\n30\t * no HTTP-only way to create the very first admin account — every other assertion goes through\n31\t * `supertest` against the real routes.\n32\t */\n33\tconst API_PREFIX = '/api/v1';\n34\t\n35\tinterface Credentials {\n36\t  accountId: string;\n37\t  userProfileId: string;\n38\t  phone: string;\n39\t  password: string;\n40\t}\n41\t\n42\tdescribe('Auth & portal authorization flow (e2e)', () => {\n43\t  let app: INestApplication;\n44\t  let tokenService: TokenService;\n45\t  let createAccount: CreateAccountUseCase;\n46\t  let accountRoles: AccountRoleRepository;\n47\t  let roles: RoleRepository;\n48\t  let roleIdByCode: Map<string, string>;\n49\t\n50\t  beforeAll(async () => {\n51\t    const moduleRef: TestingModule = await Test.createTestingModule({\n52\t      imports: [AppModule],\n53\t    }).compile();\n54\t    app = moduleRef.createNestApplication();\n55\t    configureApp(app, moduleRef.get(ConfigService).getOrThrow<AppConfig>('app'));\n56\t    await app.init();\n57\t\n58\t    tokenService = moduleRef.get(TOKEN_SERVICE);\n59\t    createAccount = moduleRef.get(CreateAccountUseCase, { strict: false });\n60\t    accountRoles = moduleRef.get(ACCOUNT_ROLE_REPOSITORY, { strict: false });\n61\t    roles = moduleRef.get(ROLE_REPOSITORY, { strict: false });\n62\t\n63\t    const seed = moduleRef.get(SeedRolesAndPermissionsUseCase, { strict: false });\n64\t    await seed.execute();\n65\t\n66\t    roleIdByCode = new Map<string, string>();\n67\t    for (const code of ['PUBLIC_USER', 'ADMIN', 'SUPER_ADMIN']) {\n68\t      const role = await roles.findByCode(code);\n69\t      if (!role) {\n70\t        throw new Error(`Role ${code} was not seeded`);\n71\t      }\n72\t      roleIdByCode.set(code, role.id.toValue());\n73\t    }\n74\t  }, 30_000);\n75\t\n76\t  afterAll(async () => {\n77\t    await app.close();\n78\t  });\n79\t\n80\t  /** 09 + 8 random digits — confirmed a valid VN mobile shape via libphonenumber-js. Random\n81\t   * (not a per-run counter) so re-running this suite against a database that still has rows\n82\t   * from a previous run can't collide on the unique `provider + identifier` constraint. */\n83\t  function nextPhone(): string {\n84\t    const suffix = randomInt(10_000_000, 99_999_999);\n85\t    return `09${String(suffix).padStart(8, '0')}`;\n86\t  }\n87\t\n88\t  async function createTestAccount(extraRoleCode?: 'ADMIN' | 'SUPER_ADMIN'): Promise<Credentials> {\n89\t    const phone = nextPhone();\n90\t    const password = 'Sup3rSecret!';\n91\t    const output = await createAccount.execute({\n92\t      phone,\n93\t      password,\n94\t      fullName: 'E2E Test User',\n95\t    });\n96\t    if (extraRoleCode) {\n97\t      const roleId = roleIdByCode.get(extraRoleCode);\n98\t      if (!roleId) {\n99\t        throw new Error(`Role ${extraRoleCode} not resolved`);\n100\t      }\n101\t      await accountRoles.assign(output.accountId, roleId, null, new Date());\n102\t    }\n103\t    return { accountId: output.accountId, userProfileId: output.userProfileId, phone, password };\n104\t  }\n105\t\n106\t  function login(phone: string, password: string, portal: 'PUBLIC' | 'ADMIN') {\n107\t    return request(app.getHttpServer()).post(`${API_PREFIX}/auth/login`).send({ phone, password, portal });\n108\t  }\n109\t\n110\t  describe('login', () => {\n111\t    it('logs in a default account on the PUBLIC portal', async () => {\n112\t      const account = await createTestAccount();\n113\t      const res = await login(account.phone, account.password, 'PUBLIC').expect(200);\n114\t\n115\t      expect(res.body.accessToken).toEqual(expect.any(String));\n116\t      expect(res.body.portal).toBe('PUBLIC');\n117\t      expect(res.body.permissions).toContain('portal.public.access');\n118\t      expect(res.headers['set-cookie']?.[0]).toMatch(/HttpOnly/i);\n119\t\n120\t      const claims = await tokenService.verifyAccessToken(res.body.accessToken);\n121\t      expect(claims.subject).toBe(account.accountId);\n122\t      expect(claims.portal).toBe('PUBLIC');\n123\t    });\n124\t\n125\t    it('logs in an account granted the ADMIN role on the ADMIN portal', async () => {\n126\t      const account = await createTestAccount('ADMIN');\n127\t      const res = await login(account.phone, account.password, 'ADMIN').expect(200);\n128\t\n129\t      expect(res.body.portal).toBe('ADMIN');\n130\t      expect(res.body.permissions).toContain('portal.admin.access');\n131\t    });\n132\t\n133\t    it('rejects a PUBLIC-only account attempting to log into the ADMIN portal without creating a session', async () => {\n134\t      const account = await createTestAccount();\n135\t      await login(account.phone, account.password, 'ADMIN').expect(403);\n136\t\n137\t      // No refresh session/token was issued for the rejected portal — the account can still log\n138\t      // into the portal it does have access to right afterwards.\n139\t      await login(account.phone, account.password, 'PUBLIC').expect(200);\n140\t    });\n141\t\n142\t    it('returns the same generic error for an unknown phone and for a wrong password (no account enumeration)', async () => {\n143\t      const account = await createTestAccount();\n144\t      const unknownPhoneRes = await login(nextPhone(), account.password, 'PUBLIC').expect(401);\n145\t      const wrongPasswordRes = await login(account.phone, 'wrong-password', 'PUBLIC').expect(401);\n146\t\n147\t      expect(unknownPhoneRes.body.message).toBe(wrongPasswordRes.body.message);\n148\t    });\n149\t\n150\t    it('rejects login for an INACTIVE account', async () => {\n151\t      const account = await createTestAccount();\n152\t      await request(app.getHttpServer())\n153\t        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n154\t        .set('Authorization', await adminBearer())\n155\t        .send({ status: 'INACTIVE' })\n156\t        .expect(204);\n157\t\n158\t      await login(account.phone, account.password, 'PUBLIC').expect(403);\n159\t    });\n160\t\n161\t    it('rejects login for a LOCKED account', async () => {\n162\t      const account = await createTestAccount();\n163\t      await request(app.getHttpServer())\n164\t        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n165\t        .set('Authorization', await adminBearer())\n166\t        .send({ status: 'LOCKED' })\n167\t        .expect(204);\n168\t\n169\t      await login(account.phone, account.password, 'PUBLIC').expect(403);\n170\t    });\n171\t\n172\t    it('rejects login for a deleted (soft-deleted) account', async () => {\n173\t      const account = await createTestAccount();\n174\t      await request(app.getHttpServer())\n175\t        .delete(`${API_PREFIX}/accounts/${account.accountId}`)\n176\t        .set('Authorization', await adminBearer())\n177\t        .expect(204);\n178\t\n179\t      await login(account.phone, account.password, 'PUBLIC').expect(401);\n180\t    });\n181\t  });\n182\t\n183\t  describe('refresh & logout', () => {\n184\t    it('rotates the refresh session and keeps the same portal', async () => {\n185\t      const account = await createTestAccount();\n186\t      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n187\t      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n188\t\n189\t      const refreshRes = await request(app.getHttpServer())\n190\t        .post(`${API_PREFIX}/auth/refresh`)\n191\t        .set('Cookie', cookie)\n192\t        .expect(200);\n193\t\n194\t      expect(refreshRes.body.portal).toBe('PUBLIC');\n195\t      expect(refreshRes.body.sessionId).not.toBe(loginRes.body.sessionId);\n196\t\n197\t      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);\n198\t      expect(claims.subject).toBe(account.accountId);\n199\t    });\n200\t\n201\t    it('revokes the session once the account is locked, so a later refresh fails', async () => {\n202\t      const account = await createTestAccount();\n203\t      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n204\t      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n205\t\n206\t      await request(app.getHttpServer())\n207\t        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n208\t        .set('Authorization', await adminBearer())\n209\t        .send({ status: 'LOCKED' })\n210\t        .expect(204);\n211\t\n212\t      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n213\t    });\n214\t\n215\t    it('logout revokes the current session so the refresh cookie can no longer be used', async () => {\n216\t      const account = await createTestAccount();\n217\t      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n218\t      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n219\t\n220\t      await request(app.getHttpServer())\n221\t        .post(`${API_PREFIX}/auth/logout`)\n222\t        .set('Authorization', `Bearer ${loginRes.body.accessToken}`)\n223\t        .set('Cookie', cookie)\n224\t        .expect(204);\n225\t\n226\t      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n227\t    });\n228\t\n229\t    it('keeps the userProfileId claim on the access token reissued by refresh', async () => {\n230\t      const account = await createTestAccount();\n231\t      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n232\t      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n233\t\n234\t      const refreshRes = await request(app.getHttpServer())\n235\t        .post(`${API_PREFIX}/auth/refresh`)\n236\t        .set('Cookie', cookie)\n237\t        .expect(200);\n238\t\n239\t      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);\n240\t      expect(claims.userProfileId).toBe(account.userProfileId);\n241\t    });\n242\t\n243\t    it('lets only one of two concurrent refreshes of the same token succeed', async () => {\n244\t      const account = await createTestAccount();\n245\t      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n246\t      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n247\t\n248\t      const [first, second] = await Promise.all([\n249\t        request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie),\n250\t        request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie),\n251\t      ]);\n252\t\n253\t      const statuses = [first.status, second.status].sort();\n254\t      expect(statuses).toEqual([200, 401]);\n255\t    });\n256\t\n257\t    it('rejects an already-issued access token immediately once the Account is locked, ahead of the token natural expiry', async () => {\n258\t      const account = await createTestAccount('SUPER_ADMIN');\n259\t      const loginRes = await login(account.phone, account.password, 'ADMIN').expect(200);\n260\t      const accessToken = loginRes.body.accessToken as string;\n261\t\n262\t      // The token itself is still a validly-signed, unexpired JWT — only the live Account-status\n263\t      // check added to JwtAuthGuard can catch this.\n264\t      await request(app.getHttpServer())\n265\t        .get(`${API_PREFIX}/accounts`)\n266\t        .set('Authorization', `Bearer ${accessToken}`)\n267\t        .expect(200);\n268\t\n269\t      await request(app.getHttpServer())\n270\t        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n271\t        .set('Authorization', await adminBearer())\n272\t        .send({ status: 'LOCKED' })\n273\t        .expect(204);\n274\t\n275\t      await request(app.getHttpServer())\n276\t        .get(`${API_PREFIX}/accounts`)\n277\t        .set('Authorization', `Bearer ${accessToken}`)\n278\t        .expect(401);\n279\t    });\n280\t\n281\t    it(\"rejects an already-issued access token once the account's password changes (tokenVersion bump)\", async () => {\n282\t      const account = await createTestAccount('SUPER_ADMIN');\n283\t      const loginRes = await login(account.phone, account.password, 'ADMIN').expect(200);\n284\t      const accessToken = loginRes.body.accessToken as string;\n285\t\n286\t      await request(app.getHttpServer())\n287\t        .get(`${API_PREFIX}/accounts`)\n288\t        .set('Authorization', `Bearer ${accessToken}`)\n289\t        .expect(200);\n290\t\n291\t      await request(app.getHttpServer())\n292\t        .patch(`${API_PREFIX}/accounts/${account.accountId}/password`)\n293\t        .set('Authorization', `Bearer ${accessToken}`)\n294\t        .send({ newPassword: 'AnotherSecret1!' })\n295\t        .expect(204);\n296\t\n297\t      await request(app.getHttpServer())\n298\t        .get(`${API_PREFIX}/accounts`)\n299\t        .set('Authorization', `Bearer ${accessToken}`)\n300\t        .expect(401);\n301\t    });\n302\t  });\n303\t\n304\t  describe('Account CRUD, gated by ADMIN portal + permission', () => {\n305\t    it('rejects an ADMIN-portal request with no bearer token', async () => {\n306\t      await request(app.getHttpServer()).get(`${API_PREFIX}/accounts`).expect(401);\n307\t    });\n308\t\n309\t    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {\n310\t      const account = await createTestAccount('SUPER_ADMIN');\n311\t      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n312\t\n313\t      await request(app.getHttpServer())\n314\t        .get(`${API_PREFIX}/accounts`)\n315\t        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n316\t        .expect(403);\n317\t    });\n318\t\n319\t    it('rejects an ADMIN account that lacks account.create when creating a new account', async () => {\n320\t      const admin = await createTestAccount('ADMIN');\n321\t      const adminLogin = await login(admin.phone, admin.password, 'ADMIN').expect(200);\n322\t\n323\t      await request(app.getHttpServer())\n324\t        .post(`${API_PREFIX}/accounts`)\n325\t        .set('Authorization', `Bearer ${adminLogin.body.accessToken}`)\n326\t        .send({ phone: nextPhone(), password: 'Sup3rSecret!', fullName: 'Should not be created' })\n327\t        .expect(403);\n328\t    });\n329\t\n330\t    it('lets a SUPER_ADMIN create, list, fetch, update status and delete an account', async () => {\n331\t      const bearer = await adminBearer();\n332\t      const newPhone = nextPhone();\n333\t\n334\t      const createRes = await request(app.getHttpServer())\n335\t        .post(`${API_PREFIX}/accounts`)\n336\t        .set('Authorization', bearer)\n337\t        .send({ phone: newPhone, password: 'Sup3rSecret!', fullName: 'Created Via API' })\n338\t        .expect(201);\n339\t      const accountId: string = createRes.body.accountId;\n340\t      expect(accountId).toEqual(expect.any(String));\n341\t\n342\t      const listRes = await request(app.getHttpServer())\n343\t        .get(`${API_PREFIX}/accounts`)\n344\t        .set('Authorization', bearer)\n345\t        .query({ phone: newPhone })\n346\t        .expect(200);\n347\t      expect(listRes.body.items.some((item: { id: string }) => item.id === accountId)).toBe(true);\n348\t      expect(listRes.body.items[0].phone).not.toBeUndefined();\n349\t      // Response never leaks the password hash under any field name.\n350\t      expect(JSON.stringify(listRes.body)).not.toMatch(/passwordHash/i);\n351\t\n352\t      const getRes = await request(app.getHttpServer())\n353\t        .get(`${API_PREFIX}/accounts/${accountId}`)\n354\t        .set('Authorization', bearer)\n355\t        .expect(200);\n356\t      expect(getRes.body.status).toBe('ACTIVE');\n357\t\n358\t      await request(app.getHttpServer())\n359\t        .patch(`${API_PREFIX}/accounts/${accountId}/status`)\n360\t        .set('Authorization', bearer)\n361\t        .send({ status: 'LOCKED' })\n362\t        .expect(204);\n363\t\n364\t      await request(app.getHttpServer())\n365\t        .delete(`${API_PREFIX}/accounts/${accountId}`)\n366\t        .set('Authorization', bearer)\n367\t        .expect(204);\n368\t\n369\t      await request(app.getHttpServer())\n370\t        .get(`${API_PREFIX}/accounts/${accountId}`)\n371\t        .set('Authorization', bearer)\n372\t        .expect(404);\n373\t    });\n374\t  });\n375\t\n376\t  describe('UserProfile CRUD, gated by permission', () => {\n377\t    it('rejects a request with no permission for the account', async () => {\n378\t      const account = await createTestAccount();\n379\t      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n380\t\n381\t      await request(app.getHttpServer())\n382\t        .get(`${API_PREFIX}/user-profiles`)\n383\t        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n384\t        .expect(403);\n385\t    });\n386\t\n387\t    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {\n388\t      const account = await createTestAccount('SUPER_ADMIN');\n389\t      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n390\t\n391\t      await request(app.getHttpServer())\n392\t        .get(`${API_PREFIX}/user-profiles`)\n393\t        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n394\t        .expect(403);\n395\t\n396\t      await request(app.getHttpServer())\n397\t        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n398\t        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n399\t        .expect(403);\n400\t    });\n401\t\n402\t    it('round-trips a non-null dateOfBirth through create, get, list and update without a 500', async () => {\n403\t      const bearer = await adminBearer();\n404\t      const account = await createTestAccount();\n405\t\n406\t      await request(app.getHttpServer())\n407\t        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n408\t        .set('Authorization', bearer)\n409\t        .send({ dateOfBirth: '1990-05-17' })\n410\t        .expect(200)\n411\t        .then((res) => expect(res.body.dateOfBirth).toBe('1990-05-17'));\n412\t\n413\t      const getRes = await request(app.getHttpServer())\n414\t        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n415\t        .set('Authorization', bearer)\n416\t        .expect(200);\n417\t      expect(getRes.body.dateOfBirth).toBe('1990-05-17');\n418\t\n419\t      const listRes = await request(app.getHttpServer())\n420\t        .get(`${API_PREFIX}/user-profiles`)\n421\t        .set('Authorization', bearer)\n422\t        .query({ fullName: 'E2E Test User' })\n423\t        .expect(200);\n424\t      expect(\n425\t        listRes.body.items.find((item: { id: string }) => item.id === account.userProfileId)?.dateOfBirth,\n426\t      ).toBe('1990-05-17');\n427\t    });\n428\t\n429\t    it('lets a SUPER_ADMIN read, update and delete the profile auto-provisioned with an account, and rejects a duplicate', async () => {\n430\t      const bearer = await adminBearer();\n431\t      const account = await createTestAccount();\n432\t\n433\t      const getRes = await request(app.getHttpServer())\n434\t        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n435\t        .set('Authorization', bearer)\n436\t        .expect(200);\n437\t      expect(getRes.body.accountId).toBe(account.accountId);\n438\t\n439\t      await request(app.getHttpServer())\n440\t        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n441\t        .set('Authorization', bearer)\n442\t        .send({ fullName: 'Updated Name' })\n443\t        .expect(200)\n444\t        .then((res) => expect(res.body.fullName).toBe('Updated Name'));\n445\t\n446\t      // §4 \"Mỗi Account chỉ có tối đa một UserProfile\" — creating a second one for the same\n447\t      // account must fail even for a fully-privileged actor.\n448\t      await request(app.getHttpServer())\n449\t        .post(`${API_PREFIX}/user-profiles`)\n450\t        .set('Authorization', bearer)\n451\t        .send({ accountId: account.accountId, fullName: 'Duplicate Profile' })\n452\t        .expect(409);\n453\t\n454\t      await request(app.getHttpServer())\n455\t        .delete(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n456\t        .set('Authorization', bearer)\n457\t        .expect(204);\n458\t    });\n459\t\n460\t    it('finds a profile by searching the local-format phone (identity-access stores it E.164)', async () => {\n461\t      const bearer = await adminBearer();\n462\t      const account = await createTestAccount();\n463\t\n464\t      const res = await request(app.getHttpServer())\n465\t        .get(`${API_PREFIX}/user-profiles`)\n466\t        .set('Authorization', bearer)\n467\t        .query({ phone: account.phone })\n468\t        .expect(200);\n469\t\n470\t      expect(res.body.items.some((item: { id: string }) => item.id === account.userProfileId)).toBe(true);\n471\t    });\n472\t  });\n473\t\n474\t  describe('concurrent requests do not leak request context between accounts', () => {\n475\t    it('resolves each of several concurrent logins to its own account, never crossing subjects', async () => {\n476\t      const accounts = await Promise.all([\n477\t        createTestAccount(),\n478\t        createTestAccount(),\n479\t        createTestAccount(),\n480\t        createTestAccount(),\n481\t        createTestAccount(),\n482\t      ]);\n483\t\n484\t      const responses = await Promise.all(\n485\t        accounts.map((account) => login(account.phone, account.password, 'PUBLIC').expect(200)),\n486\t      );\n487\t\n488\t      const claims = await Promise.all(\n489\t        responses.map((res) => tokenService.verifyAccessToken(res.body.accessToken)),\n490\t      );\n491\t\n492\t      claims.forEach((claim, index) => {\n493\t        expect(claim.subject).toBe(accounts[index]?.accountId);\n494\t      });\n495\t      // Every resolved subject must be distinct — a leaked/shared context would collapse these.\n496\t      expect(new Set(claims.map((c) => c.subject)).size).toBe(accounts.length);\n497\t    });\n498\t  });\n499\t\n500\t  let cachedAdminBearer: string | undefined;\n501\t  async function adminBearer(): Promise<string> {\n502\t    if (cachedAdminBearer) {\n503\t      return cachedAdminBearer;\n504\t    }\n505\t    const admin = await createTestAccount('SUPER_ADMIN');\n506\t    const res = await login(admin.phone, admin.password, 'ADMIN').expect(200);\n507\t    cachedAdminBearer = `Bearer ${res.body.accessToken}`;\n508\t    return cachedAdminBearer;\n509\t  }\n510\t});\n511\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"e7584346-d44b-4c7c-a95f-086fbe77e088","timestamp":"2026-08-07T15:24:41.273Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/apps/api/test/auth-flow.e2e-spec.ts","content":"import { randomInt } from 'node:crypto';\n\nimport {\n  ACCOUNT_ROLE_REPOSITORY,\n  AccountRoleRepository,\n  CreateAccountUseCase,\n  ROLE_REPOSITORY,\n  RoleRepository,\n  SeedRolesAndPermissionsUseCase,\n} from '@memories/modules/identity-access';\nimport { AppConfig } from '@memories/platform/configuration';\nimport { TOKEN_SERVICE, TokenService } from '@memories/platform/security';\nimport { INestApplication } from '@nestjs/common';\nimport { ConfigService } from '@nestjs/config';\nimport { Test, TestingModule } from '@nestjs/testing';\nimport request from 'supertest';\n\nimport { AppModule } from '../src/app.module';\nimport { configureApp } from '../src/configure-app';\n\n/**\n * Requires the local infrastructure stack (`docker compose -f docker/docker-compose.yml\n * --profile infrastructure up -d`) and a populated `.env`; run via `npm run test:e2e`.\n *\n * Exercises MEMORIES-0002's login/authorization/CRUD flows end to end against a real\n * Postgres-backed AppModule — the real HTTP layer, guards and use cases, not mocks. Test-only\n * setup (seeding roles/permissions, provisioning a bootstrap SUPER_ADMIN, granting extra roles)\n * goes through `CreateAccountUseCase`/`AccountRoleRepository` obtained directly from the Nest\n * container (`{ strict: false }`, same pattern as `media-upload-flow.e2e-spec.ts`) since there is\n * no HTTP-only way to create the very first admin account — every other assertion goes through\n * `supertest` against the real routes.\n */\nconst API_PREFIX = '/api/v1';\n\ninterface Credentials {\n  accountId: string;\n  userProfileId: string;\n  phone: string;\n  password: string;\n}\n\ndescribe('Auth & portal authorization flow (e2e)', () => {\n  let app: INestApplication;\n  let tokenService: TokenService;\n  let createAccount: CreateAccountUseCase;\n  let accountRoles: AccountRoleRepository;\n  let roles: RoleRepository;\n  let roleIdByCode: Map<string, string>;\n\n  beforeAll(async () => {\n    const moduleRef: TestingModule = await Test.createTestingModule({\n      imports: [AppModule],\n    }).compile();\n    app = moduleRef.createNestApplication();\n    configureApp(app, moduleRef.get(ConfigService).getOrThrow<AppConfig>('app'));\n    await app.init();\n\n    tokenService = moduleRef.get(TOKEN_SERVICE);\n    createAccount = moduleRef.get(CreateAccountUseCase, { strict: false });\n    accountRoles = moduleRef.get(ACCOUNT_ROLE_REPOSITORY, { strict: false });\n    roles = moduleRef.get(ROLE_REPOSITORY, { strict: false });\n\n    const seed = moduleRef.get(SeedRolesAndPermissionsUseCase, { strict: false });\n    await seed.execute();\n\n    roleIdByCode = new Map<string, string>();\n    for (const code of ['PUBLIC_USER', 'ADMIN', 'SUPER_ADMIN']) {\n      const role = await roles.findByCode(code);\n      if (!role) {\n        throw new Error(`Role ${code} was not seeded`);\n      }\n      roleIdByCode.set(code, role.id.toValue());\n    }\n  }, 30_000);\n\n  afterAll(async () => {\n    await app.close();\n  });\n\n  /** 09 + 8 random digits — confirmed a valid VN mobile shape via libphonenumber-js. Random\n   * (not a per-run counter) so re-running this suite against a database that still has rows\n   * from a previous run can't collide on the unique `provider + identifier` constraint. */\n  function nextPhone(): string {\n    const suffix = randomInt(10_000_000, 99_999_999);\n    return `09${String(suffix).padStart(8, '0')}`;\n  }\n\n  async function createTestAccount(extraRoleCode?: 'ADMIN' | 'SUPER_ADMIN'): Promise<Credentials> {\n    const phone = nextPhone();\n    const password = 'Sup3rSecret!';\n    const output = await createAccount.execute({\n      phone,\n      password,\n      fullName: 'E2E Test User',\n    });\n    if (extraRoleCode) {\n      const roleId = roleIdByCode.get(extraRoleCode);\n      if (!roleId) {\n        throw new Error(`Role ${extraRoleCode} not resolved`);\n      }\n      await accountRoles.assign(output.accountId, roleId, null, new Date());\n    }\n    return { accountId: output.accountId, userProfileId: output.userProfileId, phone, password };\n  }\n\n  function login(phone: string, password: string, portal: 'PUBLIC' | 'ADMIN') {\n    return request(app.getHttpServer()).post(`${API_PREFIX}/auth/login`).send({ phone, password, portal });\n  }\n\n  describe('login', () => {\n    it('logs in a default account on the PUBLIC portal', async () => {\n      const account = await createTestAccount();\n      const res = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      expect(res.body.accessToken).toEqual(expect.any(String));\n      expect(res.body.portal).toBe('PUBLIC');\n      expect(res.body.permissions).toContain('portal.public.access');\n      expect(res.headers['set-cookie']?.[0]).toMatch(/HttpOnly/i);\n\n      const claims = await tokenService.verifyAccessToken(res.body.accessToken);\n      expect(claims.subject).toBe(account.accountId);\n      expect(claims.portal).toBe('PUBLIC');\n    });\n\n    it('logs in an account granted the ADMIN role on the ADMIN portal', async () => {\n      const account = await createTestAccount('ADMIN');\n      const res = await login(account.phone, account.password, 'ADMIN').expect(200);\n\n      expect(res.body.portal).toBe('ADMIN');\n      expect(res.body.permissions).toContain('portal.admin.access');\n    });\n\n    it('rejects a PUBLIC-only account attempting to log into the ADMIN portal without creating a session', async () => {\n      const account = await createTestAccount();\n      await login(account.phone, account.password, 'ADMIN').expect(403);\n\n      // No refresh session/token was issued for the rejected portal — the account can still log\n      // into the portal it does have access to right afterwards.\n      await login(account.phone, account.password, 'PUBLIC').expect(200);\n    });\n\n    it('returns the same generic error for an unknown phone and for a wrong password (no account enumeration)', async () => {\n      const account = await createTestAccount();\n      const unknownPhoneRes = await login(nextPhone(), account.password, 'PUBLIC').expect(401);\n      const wrongPasswordRes = await login(account.phone, 'wrong-password', 'PUBLIC').expect(401);\n\n      expect(unknownPhoneRes.body.message).toBe(wrongPasswordRes.body.message);\n    });\n\n    it('rejects login for an INACTIVE account', async () => {\n      const account = await createTestAccount();\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'INACTIVE' })\n        .expect(204);\n\n      await login(account.phone, account.password, 'PUBLIC').expect(403);\n    });\n\n    it('rejects login for a LOCKED account', async () => {\n      const account = await createTestAccount();\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await login(account.phone, account.password, 'PUBLIC').expect(403);\n    });\n\n    it('rejects login for a deleted (soft-deleted) account', async () => {\n      const account = await createTestAccount();\n      await request(app.getHttpServer())\n        .delete(`${API_PREFIX}/accounts/${account.accountId}`)\n        .set('Authorization', await adminBearer())\n        .expect(204);\n\n      await login(account.phone, account.password, 'PUBLIC').expect(401);\n    });\n  });\n\n  describe('refresh & logout', () => {\n    it('rotates the refresh session and keeps the same portal', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      const refreshRes = await request(app.getHttpServer())\n        .post(`${API_PREFIX}/auth/refresh`)\n        .set('Cookie', cookie)\n        .expect(200);\n\n      expect(refreshRes.body.portal).toBe('PUBLIC');\n      expect(refreshRes.body.sessionId).not.toBe(loginRes.body.sessionId);\n\n      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);\n      expect(claims.subject).toBe(account.accountId);\n    });\n\n    it('revokes the session once the account is locked, so a later refresh fails', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n    });\n\n    it('logout revokes the current session so the refresh cookie can no longer be used', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      await request(app.getHttpServer())\n        .post(`${API_PREFIX}/auth/logout`)\n        .set('Authorization', `Bearer ${loginRes.body.accessToken}`)\n        .set('Cookie', cookie)\n        .expect(204);\n\n      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);\n    });\n\n    it('keeps the userProfileId claim on the access token reissued by refresh', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      const refreshRes = await request(app.getHttpServer())\n        .post(`${API_PREFIX}/auth/refresh`)\n        .set('Cookie', cookie)\n        .expect(200);\n\n      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);\n      expect(claims.userProfileId).toBe(account.userProfileId);\n    });\n\n    it('lets only one of two concurrent refreshes of the same token succeed', async () => {\n      const account = await createTestAccount();\n      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);\n      const cookie = loginRes.headers['set-cookie'] as unknown as string[];\n\n      const [first, second] = await Promise.all([\n        request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie),\n        request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie),\n      ]);\n\n      const statuses = [first.status, second.status].sort();\n      expect(statuses).toEqual([200, 401]);\n    });\n\n    it('rejects an already-issued access token immediately once the Account is locked, ahead of the token natural expiry', async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const loginRes = await login(account.phone, account.password, 'ADMIN').expect(200);\n      const accessToken = loginRes.body.accessToken as string;\n\n      // The token itself is still a validly-signed, unexpired JWT — only the live Account-status\n      // check added to JwtAuthGuard can catch this.\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(200);\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)\n        .set('Authorization', await adminBearer())\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(401);\n    });\n\n    it(\"rejects an already-issued access token once the account's password changes (tokenVersion bump)\", async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const loginRes = await login(account.phone, account.password, 'ADMIN').expect(200);\n      const accessToken = loginRes.body.accessToken as string;\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(200);\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${account.accountId}/password`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .send({ newPassword: 'AnotherSecret1!' })\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${accessToken}`)\n        .expect(401);\n    });\n  });\n\n  describe('Account CRUD, gated by ADMIN portal + permission', () => {\n    it('rejects an ADMIN-portal request with no bearer token', async () => {\n      await request(app.getHttpServer()).get(`${API_PREFIX}/accounts`).expect(401);\n    });\n\n    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n    });\n\n    it('rejects an ADMIN account that lacks account.create when creating a new account', async () => {\n      const admin = await createTestAccount('ADMIN');\n      const adminLogin = await login(admin.phone, admin.password, 'ADMIN').expect(200);\n\n      await request(app.getHttpServer())\n        .post(`${API_PREFIX}/accounts`)\n        .set('Authorization', `Bearer ${adminLogin.body.accessToken}`)\n        .send({ phone: nextPhone(), password: 'Sup3rSecret!', fullName: 'Should not be created' })\n        .expect(403);\n    });\n\n    it('lets a SUPER_ADMIN create, list, fetch, update status and delete an account', async () => {\n      const bearer = await adminBearer();\n      const newPhone = nextPhone();\n\n      const createRes = await request(app.getHttpServer())\n        .post(`${API_PREFIX}/accounts`)\n        .set('Authorization', bearer)\n        .send({ phone: newPhone, password: 'Sup3rSecret!', fullName: 'Created Via API' })\n        .expect(201);\n      const accountId: string = createRes.body.accountId;\n      expect(accountId).toEqual(expect.any(String));\n\n      const listRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts`)\n        .set('Authorization', bearer)\n        .query({ phone: newPhone })\n        .expect(200);\n      expect(listRes.body.items.some((item: { id: string }) => item.id === accountId)).toBe(true);\n      expect(listRes.body.items[0].phone).not.toBeUndefined();\n      // Response never leaks the password hash under any field name.\n      expect(JSON.stringify(listRes.body)).not.toMatch(/passwordHash/i);\n\n      const getRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts/${accountId}`)\n        .set('Authorization', bearer)\n        .expect(200);\n      expect(getRes.body.status).toBe('ACTIVE');\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/accounts/${accountId}/status`)\n        .set('Authorization', bearer)\n        .send({ status: 'LOCKED' })\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .delete(`${API_PREFIX}/accounts/${accountId}`)\n        .set('Authorization', bearer)\n        .expect(204);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/accounts/${accountId}`)\n        .set('Authorization', bearer)\n        .expect(404);\n    });\n  });\n\n  describe('UserProfile CRUD, gated by permission', () => {\n    it('rejects a request with no permission for the account', async () => {\n      const account = await createTestAccount();\n      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n    });\n\n    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {\n      const account = await createTestAccount('SUPER_ADMIN');\n      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n\n      await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)\n        .expect(403);\n    });\n\n    it('round-trips a non-null dateOfBirth through create, get, list and update without a 500', async () => {\n      const bearer = await adminBearer();\n      const account = await createTestAccount();\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .send({ dateOfBirth: '1990-05-17' })\n        .expect(200)\n        .then((res) => expect(res.body.dateOfBirth).toBe('1990-05-17'));\n\n      const getRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .expect(200);\n      expect(getRes.body.dateOfBirth).toBe('1990-05-17');\n\n      const listRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', bearer)\n        .query({ fullName: 'E2E Test User' })\n        .expect(200);\n      expect(\n        listRes.body.items.find((item: { id: string }) => item.id === account.userProfileId)?.dateOfBirth,\n      ).toBe('1990-05-17');\n    });\n\n    it('lets a SUPER_ADMIN read, update and delete the profile auto-provisioned with an account, and rejects a duplicate', async () => {\n      const bearer = await adminBearer();\n      const account = await createTestAccount();\n\n      const getRes = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .expect(200);\n      expect(getRes.body.accountId).toBe(account.accountId);\n\n      await request(app.getHttpServer())\n        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .send({ fullName: 'Updated Name' })\n        .expect(200)\n        .then((res) => expect(res.body.fullName).toBe('Updated Name'));\n\n      // §4 \"Mỗi Account chỉ có tối đa một UserProfile\" — creating a second one for the same\n      // account must fail even for a fully-privileged actor.\n      await request(app.getHttpServer())\n        .post(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', bearer)\n        .send({ accountId: account.accountId, fullName: 'Duplicate Profile' })\n        .expect(409);\n\n      await request(app.getHttpServer())\n        .delete(`${API_PREFIX}/user-profiles/${account.userProfileId}`)\n        .set('Authorization', bearer)\n        .expect(204);\n    });\n\n    it('finds a profile by searching the local-format phone (identity-access stores it E.164)', async () => {\n      const bearer = await adminBearer();\n      const account = await createTestAccount();\n\n      const res = await request(app.getHttpServer())\n        .get(`${API_PREFIX}/user-profiles`)\n        .set('Authorization', bearer)\n        .query({ phone: account.phone })\n        .expect(200);\n\n      expect(res.body.items.some((item: { id: string }) => item.id === account.userProfileId)).toBe(true);\n    });\n  });\n\n  describe('concurrent requests do not leak request context between accounts', () => {\n    it('resolves each of several concurrent logins to its own account, never crossing subjects', async () => {\n      const accounts = await Promise.all([\n        createTestAccount(),\n        createTestAccount(),\n        createTestAccount(),\n        createTestAccount(),\n        createTestAccount(),\n      ]);\n\n      const responses = await Promise.all(\n        accounts.map((account) => login(account.phone, account.password, 'PUBLIC').expect(200)),\n      );\n\n      const claims = await Promise.all(\n        responses.map((res) => tokenService.verifyAccessToken(res.body.accessToken)),\n      );\n\n      claims.forEach((claim, index) => {\n        expect(claim.subject).toBe(accounts[index]?.accountId);\n      });\n      // Every resolved subject must be distinct — a leaked/shared context would collapse these.\n      expect(new Set(claims.map((c) => c.subject)).size).toBe(accounts.length);\n    });\n  });\n\n  let cachedAdminBearer: string | undefined;\n  async function adminBearer(): Promise<string> {\n    if (cachedAdminBearer) {\n      return cachedAdminBearer;\n    }\n    const admin = await createTestAccount('SUPER_ADMIN');\n    const res = await login(admin.phone, admin.password, 'ADMIN').expect(200);\n    cachedAdminBearer = `Bearer ${res.body.accessToken}`;\n    return cachedAdminBearer;\n  }\n});\n","numLines":511,"startLine":1,"totalLines":511}}}
