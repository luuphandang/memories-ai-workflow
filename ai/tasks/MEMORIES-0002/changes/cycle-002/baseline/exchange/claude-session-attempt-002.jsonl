iderRegistry } from '../ports/authentication-provider.port';\nimport { PHONE_NORMALIZER, PhoneNormalizerPort } from '../ports/phone-normalizer.port';\n\nexport interface LoginInput {\n  phone: string;\n  password: string;\n  portal: Portal;\n  ipAddress: string | null;\n  userAgent: string | null;\n}\n\nexport interface LoginOutput {\n  accountId: string;\n  accessToken: string;\n  refreshToken: string;\n  refreshTokenExpiresAt: Date;\n  portal: Portal;\n  sessionId: string;\n  roles: string[];\n  permissions: string[];\n}\n\n/**\n * §9/§10: authentication (credential + Account status) is fully separated from portal\n * authorization (permission check via the same `PermissionChecker` port every other protected\n * route uses) — never `if (role === 'ADMIN')`. Portal mismatch or missing permission => no\n * RefreshSession, no token, same as a failed credential check but with a distinguishable message\n * (api-contract.md error mapping).\n */\n@Injectable()\nexport class LoginUseCase implements UseCase<LoginInput, LoginOutput> {\n  constructor(\n    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n    @Inject(PERMISSION_CHECKER) private readonly permissionChecker: PermissionChecker,\n    @Inject(USER_PROFILE_LOOKUP) private readonly userProfileLookup: UserProfileLookup,\n    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,\n    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,\n    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n    @Inject(CLOCK) private readonly clock: Clock,\n    private readonly authenticationProviders: AuthenticationProviderRegistry,\n    private readonly configService: ConfigService,\n  ) {}\n\n  async execute(input: LoginInput): Promise<LoginOutput> {\n    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n    const phone = this.phoneNormalizer.normalize(input.phone, auth.phone.defaultRegion);\n\n    // Same generic failure for \"phone not found\" and \"wrong password\" (task.md §9 — no account\n    // enumeration) — the provider itself throws a uniform UnauthorizedException for both.\n    const { accountId } = await this.authenticationProviders\n      .resolve(AuthProvider.Local)\n      .authenticate({ provider: AuthProvider.Local, identifier: phone.value, plainPassword: input.password });\n\n    const account = await this.accounts.findById(new UniqueEntityId(accountId));\n    if (!account || !account.canAuthenticate()) {\n      throw new ForbiddenException('Account is not active');\n    }\n\n    const requiredPermission = PORTAL_PERMISSION[input.portal];\n    const hasPortalAccess = await this.permissionChecker.hasPermissions(accountId, [requiredPermission]);\n    if (!hasPortalAccess) {\n      throw new ForbiddenException(`Account does not have access to the ${input.portal} portal`);\n    }\n\n    const resolved = await this.permissionChecker.resolvePermissions(accountId);\n    const userProfileId = await this.userProfileLookup.findProfileIdByAccountId(accountId);\n\n    const sessionId = new UniqueEntityId(this.idGenerator.generate());\n    const now = this.clock.now();\n\n    return this.unitOfWork.withTransaction(async () => {\n      const [accessIssued, refreshIssued] = await Promise.all([\n        this.tokenService.issueAccessToken({\n          subject: accountId,\n          sessionId: sessionId.toValue(),\n          portal: input.portal,\n          authProvider: AuthProvider.Local,\n          userProfileId: userProfileId ?? undefined,\n          tokenVersion: account.tokenVersion,\n        }),\n        this.tokenService.issueRefreshToken({\n          subject: accountId,\n          sessionId: sessionId.toValue(),\n          portal: input.portal,\n        }),\n      ]);\n\n      const session = RefreshSession.create(\n        {\n          accountId,\n          portal: input.portal,\n          authProvider: AuthProvider.Local,\n          ipAddress: input.ipAddress,\n          userAgent: input.userAgent,\n          issuedAt: now,\n          expiresAt: refreshIssued.expiresAt,\n          revokedAt: null,\n          replacedBySessionId: null,\n        },\n        sessionId,\n      );\n      await this.refreshSessions.save(session);\n\n      return {\n        accountId,\n        accessToken: accessIssued.token,\n        refreshToken: refreshIssued.token,\n        refreshTokenExpiresAt: refreshIssued.expiresAt,\n        portal: input.portal,\n        sessionId: sessionId.toValue(),\n        roles: resolved.roles,\n        permissions: resolved.permissions,\n      };\n    });\n  }\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
