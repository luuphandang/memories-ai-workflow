{\n  static register(): DynamicModule {\n    return {\n      module: SecurityModule,\n      global: true,\n      imports: [\n        JwtModule.register({}),\n        ThrottlerModule.forRootAsync({\n          inject: [ConfigService],\n          useFactory: (configService: ConfigService) => {\n            const security = configService.getOrThrow<SecurityConfig>('security');\n            return [\n              { ttl: security.rateLimit.ttlSeconds * 1000, limit: security.rateLimit.maxRequests },\n            ];\n          },\n        }),\n      ],\n      providers: [\n        { provide: TOKEN_SERVICE, useClass: JwtTokenService },\n        // `ThrottlerModule.forRootAsync` above only registers the RATE_LIMIT_* configuration —\n        // it does not, by itself, make anything enforce it. `APP_GUARD` is NestJS's own token for\n        // registering a guard globally regardless of which module provides it, so every HTTP\n        // request across every controller in any app that imports this module (only apps/api has\n        // controllers with real inbound HTTP traffic; the guard is simply never invoked for\n        // apps/worker/scheduler/cli/realtime, which have none) is actually throttled — without\n        // this, RATE_LIMIT_TTL_SECONDS/RATE_LIMIT_MAX_REQUESTS had no effect at all.\n        { provide: APP_GUARD, useClass: ThrottlerGuard },\n        RequestContext,\n        RequestContextMiddleware,\n      ],\n      exports: [TOKEN_SERVICE, ThrottlerModule, RequestContext],\n    };\n  }\n\n  static registerAsync(): DynamicModule {\n    return SecurityModule.register();\n  }\n\n  /** Runs after `ObservabilityModule`'s `CorrelationMiddleware` (import order in `app.module.ts`\n   * puts Observability before Security), so `RequestContextMiddleware` can read the correlation\n   * IDs it already established for this request. */\n  configure(consumer: MiddlewareConsumer): void {\n    consumer.apply(RequestContextMiddleware).forRoutes('*');\n  }\n}\n","numLines":59,"startL