 RequestContext } from '@memories/platform/security';\nimport {\n  CLOCK,\n  Clock,\n  DomainError,\n  UniqueEntityId,\n  UnitOfWork,\n  UseCase,\n} from '@memories/shared/kernel';\nimport { Inject, Injectable } from '@nestjs/common';\n\nimport { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';\nimport {\n  AUTH_IDENTITY_REPOSITORY,\n  AuthIdentityRepository,\n} from '../../domain/auth-identities/auth-identity.repository';\nimport { AuthProvider } from '../../domain/auth-identities/auth-provider';\nimport {\n  REFRESH_SESSION_REPOSITORY,\n  RefreshSessionRepository,\n} from '../../domain/sessions/refresh-session.repository';\nimport { PASSWORD_HASHER, PasswordHasher } from '../ports/password-hasher.port';\n\nexport interface ChangeAccountPasswordInput {\n  accountId: string;\n  newPassword: string;\n}\n\n/** §16 `PATCH /accounts/:accountId/password` (also used for admin-triggered reset). Revokes every\n * outstanding session and bumps `Account.tokenVersion` (§13) — standard hygiene after a password\n * change/reset, forcing re-login everywhere else the Account is currently signed in. */\n@Injectable()\nexport class ChangeAccountPasswordUseCase implements UseCase<ChangeAccountPasswordInput, void> {\n  constructor(\n    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,\n    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,\n    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,\n    @Inject(PASSWORD_HASHER) private readonly passwordHasher: PasswordHasher,\n    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,\n    @Inject(CLOCK) private readonly clock: Clock,\n    private readonly requestContext: RequestContext,\n  ) {}\n\n  async execute(input: ChangeAccountPasswordInput): Promise<void> {\n    const actorId = this.requestContext.currentActorId();\n\n    await this.unitOfWork.withTransaction(async () => {\n      const now = this.clock.now();\n\n      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));\n      if (!account) {\n        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);\n      }\n\n      const identities = await this.authIdentities.findAllByAccountId(input.accountId);\n      const localIdentity = identities.find((identity) => identity.provider === AuthProvider.Local);\n      if (!localIdentity) {\n        throw DomainError.notFound(\n          'local_auth_identity_not_found',\n          `Account ${input.accountId} has no LOCAL auth identity`,\n        );\n      }\n\n      const passwordHash = await this.passwordHasher.hash(input.newPassword);\n      localIdentity.changePasswordHash(passwordHash, actorId, now);\n      await this.authIdentities.save(localIdentity);\n\n      account.incrementTokenVersion(actorId, now);\n      await this.accounts.save(account);\n\n      await this.refreshSessions.revokeAllForAccount(input.accountId, now);\n    });\n  }\n}\n","numLines":76,"startLine":1,"totalLines":76}}}
