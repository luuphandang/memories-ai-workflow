ount-phone.use-case';\nimport { ChangeAccountStatusUseCase } from '../../application/use-cases/change-account-status.use-case';\nimport { CreateAccountUseCase } from '../../application/use-cases/create-account.use-case';\nimport { DeleteAccountUseCase } from '../../application/use-cases/delete-account.use-case';\nimport { AccountDetail, GetAccountUseCase } from '../../application/use-cases/get-account.use-case';\nimport { AccountSummary, ListAccountsUseCase } from '../../application/use-cases/list-accounts.use-case';\n\nimport {\n  AccountResponseDto,\n  CreateAccountResponseDto,\n  ListAccountsResponseDto,\n} from './account-response.dto';\nimport { ChangeAccountPasswordDto } from './change-account-password.dto';\nimport { ChangeAccountPhoneDto } from './change-account-phone.dto';\nimport { ChangeAccountStatusDto } from './change-account-status.dto';\nimport { CreateAccountDto } from './create-account.dto';\nimport { ListAccountsQueryDto } from './list-accounts.dto';\n\nfunction toAccountResponseDto(detail: AccountDetail | AccountSummary): AccountResponseDto {\n  return {\n    id: detail.id,\n    status: detail.status,\n    phone: detail.phone,\n    createdAt: detail.createdAt,\n    updatedAt: detail.updatedAt,\n  };\n}\n\n/**\n * §16. Never returns the ORM entity, never exposes `passwordHash` (AC #25/#34). Account management\n * is an admin-portal operation — `@RequirePortal('ADMIN')` rejects a token issued for the PUBLIC\n * portal even if the same Account also holds `account.*` permissions (AC #23, task.md §13\n * \"Token phát cho PUBLIC không được tự động sử dụng để truy cập ADMIN nếu audience/portal không\n * hợp lệ\"). Must run after `JwtAuthGuard` (needs `request.user.portal`) and before\n * `PermissionsGuard`.\n */\n@ApiTags('accounts')\n@ApiBearerAuth()\n@UseGuards(JwtAuthGuard, PortalGuard, PermissionsGuard)\n@RequirePortal('ADMIN')\n@Controller('accounts')\nexport class AccountController {\n  constructor(\n    private readonly createAccount: CreateAccountUseCase,\n    private readonly getAccount: GetAccountUseCase,\n    private readonly listAccounts: ListAccountsUseCase,\n    private readonly changeAccountStatus: ChangeAccountStatusUseCase,\n    private readonly changeAccountPhone: ChangeAccountPhoneUseCase,\n    private readonly changeAccountPassword: ChangeAccountPasswordUseCase,\n    private readonly deleteAccount: DeleteAccountUseCase,\n  ) {}\n\n  @Post()\n  @RequirePermissions('account.create')\n  @ApiResponse({ status: HttpStatus.CREATED, type: CreateAccountResponseDto })\n  async create(@Body() dto: CreateAccountDto): Promise<CreateAccountResponseDto> {\n    return this.createAccount.execute({\n      phone: dto.phone,\n      password: dto.password,\n      fullName: dto.fullName,\n      email: dto.email,\n      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,\n      address: dto.address,\n      avatarId: dto.avatarId,\n    });\n  }\n\n  @Get()\n  @RequirePermissions('account.read')\n  @ApiResponse({ status: HttpStatus.OK, type: ListAccountsResponseDto })\n  async list(@Query() query: ListAccountsQueryDto): Promise<ListAccountsResponseDto> {\n    const result = await this.listAccounts.execute({\n      status: query.status,\n      provider: query.provider,\n      phoneSearch: query.phone,\n      page: query.page,\n      pageSize: query.pageSize,\n      sortBy: query.sortBy,\n      sortDirection: query.sortDirection,\n    });\n    return {\n      items: result.items.map(toAccountResponseDto),\n      total: result.total,\n      page: result.page,\n      pageSize: result.pageSize,\n      totalPages: result.totalPages,\n    };\n  }\n\n  @Get(':accountId')\n  @RequirePermissions('account.read')\n  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.OK, type: AccountResponseDto })\n  async getById(@Param('accountId') accountId: string): Promise<AccountResponseDto> {\n    const detail = await this.getAccount.execute({ accountId });\n    return toAccountResponseDto(detail);\n  }\n\n  @Patch(':accountId/status')\n  @RequirePermissions('account.change-status')\n  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n  @HttpCode(HttpStatus.NO_CONTENT)\n  async changeStatus(\n    @Param('accountId') accountId: string,\n    @Body() dto: ChangeAccountStatusDto,\n  ): Promise<void> {\n    await this.changeAccountStatus.execute({ accountId, status: dto.status });\n  }\n\n  @Patch(':accountId/phone')\n  @RequirePermissions('account.update')\n  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n  @HttpCode(HttpStatus.NO_CONTENT)\n  async changePhone(\n    @Param('accountId') accountId: string,\n    @Body() dto: ChangeAccountPhoneDto,\n  ): Promise<void> {\n    await this.changeAccountPhone.execute({ accountId, newPhone: dto.phone });\n  }\n\n  @Patch(':accountId/password')\n  @RequirePermissions('account.change-password')\n  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n  @HttpCode(HttpStatus.NO_CONTENT)\n  async changePassword(\n    @Param('accountId') accountId: string,\n    @Body() dto: ChangeAccountPasswordDto,\n  ): Promise<void> {\n    await this.changeAccountPassword.execute({ accountId, newPassword: dto.newPassword });\n  }\n\n  @Delete(':accountId')\n  @RequirePermissions('account.delete')\n  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })\n  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n  @HttpCode(HttpStatus.NO_CONTENT)\n  async remove(@Param('accountId') accountId: string): Promise<void> {\n    await this.deleteAccount.execute({ accountId });\n  }\n}\n","numLines":155,"startLine":1,"totalLines":155}}}
