{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XRp9u2e5SfUFuZa2CBSRhN","type":"tool_result","content":"1\timport { AsyncLocalStorage } from 'node:async_hooks';\n2\t\n3\timport { Injectable } from '@nestjs/common';\n4\t\n5\t/**\n6\t * Actor/request metadata threaded through a single request's async call chain (§14). Roles and\n7\t * permissions are mutable arrays on the same store object — `RequestContextMiddleware` seeds an\n8\t * empty store before any guard runs; `JwtAuthGuard`/`PermissionsGuard` enrich the SAME object\n9\t * in place once they resolve the caller, rather than starting a new `AsyncLocalStorage.run`, so\n10\t * every layer downstream (use cases, repositories, audit metadata) observes the same reference.\n11\t * A `null` `accountId` means \"no authenticated Account\" (anonymous request or system actor);\n12\t * `isSystemActor` distinguishes worker/scheduler/CLI background execution from an anonymous HTTP\n13\t * caller (both have `accountId: null`).\n14\t */\n15\texport interface RequestContextStore {\n16\t  requestId: string;\n17\t  correlationId: string;\n18\t  accountId: string | null;\n19\t  userProfileId: string | null;\n20\t  sessionId: string | null;\n21\t  portal: string | null;\n22\t  authProvider: string | null;\n23\t  roles: string[];\n24\t  permissions: string[];\n25\t  ipAddress: string | null;\n26\t  userAgent: string | null;\n27\t  requestedAt: Date;\n28\t  isSystemActor: boolean;\n29\t}\n30\t\n31\t/** Same shape as `Partial<RequestContextStore>`, but each key explicitly allows `undefined` so\n32\t * callers built with `exactOptionalPropertyTypes` can pass through possibly-undefined values\n33\t * (e.g. `correlation?.requestId`) without first stripping the key. */\n34\ttype RequestContextOverrides = {\n35\t  [K in keyof RequestContextStore]?: RequestContextStore[K] | undefined;\n36\t};\n37\t\n38\t/** Stamped into `createdBy`/`updatedBy`/`deletedBy` audit columns for writes performed by a\n39\t * background actor (worker/scheduler/CLI, §14) instead of `null` — audit columns are `uuid`\n40\t * (no free-text sentinel like `'SYSTEM'` fits), and `null` must stay reserved for \"no authenticated\n41\t * actor at all\" (e.g. unauthenticated self-registration) so the two cases stay distinguishable\n42\t * (§14 \"System actor phải được phân biệt với Account actor\"). */\n43\texport const SYSTEM_ACTOR_ID = '00000000-0000-0000-0000-000000000000';\n44\t\n45\texport function createEmptyRequestContextStore(\n46\t  overrides: RequestContextOverrides = {},\n47\t): RequestContextStore {\n48\t  return {\n49\t    requestId: overrides.requestId ?? crypto.randomUUID(),\n50\t    correlationId: overrides.correlationId ?? overrides.requestId ?? crypto.randomUUID(),\n51\t    accountId: overrides.accountId ?? null,\n52\t    userProfileId: overrides.userProfileId ?? null,\n53\t    sessionId: overrides.sessionId ?? null,\n54\t    portal: overrides.portal ?? null,\n55\t    authProvider: overrides.authProvider ?? null,\n56\t    roles: overrides.roles ?? [],\n57\t    permissions: overrides.permissions ?? [],\n58\t    ipAddress: overrides.ipAddress ?? null,\n59\t    userAgent: overrides.userAgent ?? null,\n60\t    requestedAt: overrides.requestedAt ?? new Date(),\n61\t    isSystemActor: overrides.isSystemActor ?? false,\n62\t  };\n63\t}\n64\t\n65\t@Injectable()\n66\texport class RequestContext {\n67\t  private static readonly storage = new AsyncLocalStorage<RequestContextStore>();\n68\t\n69\t  run<TResult>(store: RequestContextStore, callback: () => TResult): TResult {\n70\t    return RequestContext.storage.run(store, callback);\n71\t  }\n72\t\n73\t  get(): RequestContextStore | undefined {\n74\t    return RequestContext.storage.getStore();\n75\t  }\n76\t\n77\t  /** The actor id to stamp on audit columns: the authenticated Account, `SYSTEM_ACTOR_ID` for a\n78\t   * `runAsSystem` background actor, or `null` for a genuinely anonymous request (no Account\n79\t   * authenticated at all, e.g. self-registration) — never throws, since not every write happens\n80\t   * inside a request with a context (direct unit-test/use-case construction). */\n81\t  currentActorId(): string | null {\n82\t    const store = RequestContext.storage.getStore();\n83\t    if (!store) {\n84\t      return null;\n85\t    }\n86\t    return store.isSystemActor ? SYSTEM_ACTOR_ID : store.accountId;\n87\t  }\n88\t\n89\t  /** Runs `work` under a synthetic system-actor context (worker/scheduler/CLI, §14) so audit\n90\t   * columns and correlation IDs are still populated outside of any HTTP request. */\n91\t  runAsSystem<TResult>(callback: () => TResult, correlationId?: string): TResult {\n92\t    return this.run(\n93\t      createEmptyRequestContextStore({ isSystemActor: true, correlationId }),\n94\t      callback,\n95\t    );\n96\t  }\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"f5767e53-2b9a-4ee3-8164-72b0a850131e","timestamp":"2026-08-07T15:18:33.204Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/platform/security/src/request-context.ts","content":"import { AsyncLocalStorage } from 'node:async_hooks';\n\nimport { Injectable } from '@nestjs/common';\n\n/**\n * Actor/request metadata threaded through a single request's async call chain (§14). Roles and\n * permissions are mutable arrays on the same store object — `RequestContextMiddleware` seeds an\n * empty store before any guard runs; `JwtAuthGuard`/`PermissionsGuard` enrich the SAME object\n * in place once they resolve the caller, rather than starting a new `AsyncLocalStorage.run`, so\n * every layer downstream (use cases, repositories, audit metadata) observes the same reference.\n * A `null` `accountId` means \"no authenticated Account\" (anonymous request or system actor);\n * `isSystemActor` distinguishes worker/scheduler/CLI background execution from an anonymous HTTP\n * caller (both have `accountId: null`).\n */\nexport interface RequestContextStore {\n  requestId: string;\n  correlationId: string;\n  accountId: string | null;\n  userProfileId: string | null;\n  sessionId: string | null;\n  portal: string | null;\n  authProvider: string | null;\n  roles: string[];\n  permissions: string[];\n  ipAddress: string | null;\n  userAgent: string | null;\n  requestedAt: Date;\n  isSystemActor: boolean;\n}\n\n/** Same shape as `Partial<RequestContextStore>`, but each key explicitly allows `undefined` so\n * callers built with `exactOptionalPropertyTypes` can pass through possibly-undefined values\n * (e.g. `correlation?.requestId`) without first stripping the key. */\ntype RequestContextOverrides = {\n  [K in keyof RequestContextStore]?: RequestContextStore[K] | undefined;\n};\n\n/** Stamped into `createdBy`/`updatedBy`/`deletedBy` audit columns for writes performed by a\n * background actor (worker/scheduler/CLI, §14) instead of `null` — audit columns are `uuid`\n * (no free-text sentinel like `'SYSTEM'` fits), and `null` must stay reserved for \"no authenticated\n * actor at all\" (e.g. unauthenticated self-registration) so the two cases stay distinguishable\n * (§14 \"System actor phải được phân biệt với Account actor\"). */\nexport const SYSTEM_ACTOR_ID = '00000000-0000-0000-0000-000000000000';\n\nexport function createEmptyRequestContextStore(\n  overrides: RequestContextOverrides = {},\n): RequestContextStore {\n  return {\n    requestId: overrides.requestId ?? crypto.randomUUID(),\n    correlationId: overrides.correlationId ?? overrides.requestId ?? crypto.randomUUID(),\n    accountId: overrides.accountId ?? null,\n    userProfileId: overrides.userProfileId ?? null,\n    sessionId: overrides.sessionId ?? null,\n    portal: overrides.portal ?? null,\n    authProvider: overrides.authProvider ?? null,\n    roles: overrides.roles ?? [],\n    permissions: overrides.permissions ?? [],\n    ipAddress: overrides.ipAddress ?? null,\n    userAgent: overrides.userAgent ?? null,\n    requestedAt: overrides.requestedAt ?? new Date(),\n    isSystemActor: overrides.isSystemActor ?? false,\n  };\n}\n\n@Injectable()\nexport class RequestContext {\n  private static readonly storage = new AsyncLocalStorage<RequestContextStore>();\n\n  run<TResult>(store: RequestContextStore, callback: () => TResult): TResult {\n    return RequestContext.storage.run(store, callback);\n  }\n\n  get(): RequestContextStore | undefined {\n    return RequestContext.storage.getStore();\n  }\n\n  /** The actor id to stamp on audit columns: the authenticated Account, `SYSTEM_ACTOR_ID` for a\n   * `runAsSystem` background actor, or `null` for a genuinely anonymous request (no Account\n   * authenticated at all, e.g. self-registration) — never throws, since not every write happens\n   * inside a request with a context (direct unit-test/use-case construction). */\n  currentActorId(): string | null {\n    const store = RequestContext.storage.getStore();\n    if (!store) {\n      return null;\n    }\n    return store.isSystemActor ? SYSTEM_ACTOR_ID : store.accountId;\n  }\n\n  /** Runs `work` under a synthetic system-actor context (worker/scheduler/CLI, §14) so audit\n   * columns and correlation IDs are still populated outside of any HTTP request. */\n  runAsSystem<TResult>(callback: () => TResult, correlationId?: string): TResult {\n    return this.run(\n      createEmptyRequestContextStore({ isSystemActor: true, correlationId }),\n      callback,\n    );\n  }\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
