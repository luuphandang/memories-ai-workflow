{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013U1sYGGUgchcecEpLKReS3","type":"tool_result","content":"1\timport {\n2\t  CLOCK,\n3\t  Clock,\n4\t  createAuditableProps,\n5\t  ID_GENERATOR,\n6\t  IdGenerator,\n7\t  UniqueEntityId,\n8\t  UseCase,\n9\t} from '@memories/shared/kernel';\n10\timport { Inject, Injectable } from '@nestjs/common';\n11\t\n12\timport { Permission } from '../../domain/permissions/permission';\n13\timport { PERMISSION_REPOSITORY, PermissionRepository } from '../../domain/permissions/permission.repository';\n14\timport {\n15\t  ROLE_PERMISSION_REPOSITORY,\n16\t  RolePermissionRepository,\n17\t} from '../../domain/permissions/role-permission.repository';\n18\timport { Role } from '../../domain/roles/role';\n19\timport { ROLE_REPOSITORY, RoleRepository } from '../../domain/roles/role.repository';\n20\t\n21\t/** Minimum permission set required by the epic (task.md §12). */\n22\tconst PERMISSION_CODES = [\n23\t  'portal.public.access',\n24\t  'portal.admin.access',\n25\t  'account.create',\n26\t  'account.read',\n27\t  'account.update',\n28\t  'account.delete',\n29\t  'account.change-status',\n30\t  'account.change-password',\n31\t  'user-profile.create',\n32\t  'user-profile.read',\n33\t  'user-profile.update',\n34\t  'user-profile.delete',\n35\t  'role.read',\n36\t  'role.assign',\n37\t  'permission.read',\n38\t] as const;\n39\t\n40\tconst ACCOUNT_WILDCARD = [\n41\t  'account.create',\n42\t  'account.read',\n43\t  'account.update',\n44\t  'account.delete',\n45\t  'account.change-status',\n46\t  'account.change-password',\n47\t];\n48\tconst USER_PROFILE_WILDCARD = [\n49\t  'user-profile.create',\n50\t  'user-profile.read',\n51\t  'user-profile.update',\n52\t  'user-profile.delete',\n53\t];\n54\tconst ROLE_WILDCARD = ['role.read', 'role.assign'];\n55\tconst PERMISSION_WILDCARD = ['permission.read'];\n56\t\n57\t/** Role -> permission codes, matching task.md §12's sample tree exactly. */\n58\tconst ROLE_DEFINITIONS: { code: string; name: string; permissions: string[] }[] = [\n59\t  { code: 'PUBLIC_USER', name: 'Public User', permissions: ['portal.public.access'] },\n60\t  {\n61\t    code: 'ADMIN',\n62\t    name: 'Admin',\n63\t    permissions: ['portal.admin.access', 'account.read', 'user-profile.read'],\n64\t  },\n65\t  {\n66\t    code: 'SUPER_ADMIN',\n67\t    name: 'Super Admin',\n68\t    permissions: [\n69\t      'portal.admin.access',\n70\t      ...ACCOUNT_WILDCARD,\n71\t      ...USER_PROFILE_WILDCARD,\n72\t      ...ROLE_WILDCARD,\n73\t      ...PERMISSION_WILDCARD,\n74\t    ],\n75\t  },\n76\t];\n77\t\n78\t/**\n79\t * §7/§12 \"Seed Role và Permission phải idempotent\" — running this any number of times converges\n80\t * on the same Role/Permission/RolePermission rows (find-or-create + upsert grants), never\n81\t * duplicating data. Invoked by `apps/cli`'s `seed` command; not run automatically at application\n82\t * startup.\n83\t */\n84\t@Injectable()\n85\texport class SeedRolesAndPermissionsUseCase implements UseCase<void, void> {\n86\t  constructor(\n87\t    @Inject(PERMISSION_REPOSITORY) private readonly permissions: PermissionRepository,\n88\t    @Inject(ROLE_REPOSITORY) private readonly roles: RoleRepository,\n89\t    @Inject(ROLE_PERMISSION_REPOSITORY) private readonly rolePermissions: RolePermissionRepository,\n90\t    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n91\t    @Inject(CLOCK) private readonly clock: Clock,\n92\t  ) {}\n93\t\n94\t  async execute(): Promise<void> {\n95\t    const now = this.clock.now();\n96\t\n97\t    const permissionByCode = new Map<string, Permission>();\n98\t    for (const code of PERMISSION_CODES) {\n99\t      permissionByCode.set(code, await this.findOrCreatePermission(code, now));\n100\t    }\n101\t\n102\t    for (const definition of ROLE_DEFINITIONS) {\n103\t      const role = await this.findOrCreateRole(definition.code, definition.name, now);\n104\t      for (const permissionCode of definition.permissions) {\n105\t        const permission = permissionByCode.get(permissionCode);\n106\t        if (!permission) {\n107\t          continue;\n108\t        }\n109\t        await this.rolePermissions.grant(role.id.toValue(), permission.id.toValue(), null, now);\n110\t      }\n111\t    }\n112\t  }\n113\t\n114\t  private async findOrCreatePermission(code: string, now: Date): Promise<Permission> {\n115\t    const existing = await this.permissions.findByCode(code);\n116\t    if (existing) {\n117\t      return existing;\n118\t    }\n119\t    const permission = Permission.create(\n120\t      { code, description: code, ...createAuditableProps(null, now) },\n121\t      new UniqueEntityId(this.idGenerator.generate()),\n122\t    );\n123\t    await this.permissions.save(permission);\n124\t    return permission;\n125\t  }\n126\t\n127\t  private async findOrCreateRole(code: string, name: string, now: Date): Promise<Role> {\n128\t    const existing = await this.roles.findByCode(code);\n129\t    if (existing) {\n130\t      return existing;\n131\t    }\n132\t    const role = Role.create(\n133\t      { code, name, ...createAuditableProps(null, now) },\n134\t      new UniqueEntityId(this.idGenerator.generate()),\n135\t    );\n136\t    await this.roles.save(role);\n137\t    return role;\n138\t  }\n139\t}\n140\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"f2780e7f-2de1-433f-a61b-44c6496fbe9e","timestamp":"2026-08-07T15:29:21.203Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/identity-access/src/application/use-cases/seed-roles-and-permissions.use-case.ts","content":"import {\n  CLOCK,\n  Clock,\n  createAuditableProps,\n  ID_GENERATOR,\n  IdGenerator,\n  UniqueEntityId,\n  UseCase,\n} from '@memories/shared/kernel';\nimport { Inject, Injectable } from '@nestjs/common';\n\nimport { Permission } from '../../domain/permissions/permission';\nimport { PERMISSION_REPOSITORY, PermissionRepository } from '../../domain/permissions/permission.repository';\nimport {\n  ROLE_PERMISSION_REPOSITORY,\n  RolePermissionRepository,\n} from '../../domain/permissions/role-permission.repository';\nimport { Role } from '../../domain/roles/role';\nimport { ROLE_REPOSITORY, RoleRepository } from '../../domain/roles/role.repository';\n\n/** Minimum permission set required by the epic (task.md §12). */\nconst PERMISSION_CODES = [\n  'portal.public.access',\n  'portal.admin.access',\n  'account.create',\n  'account.read',\n  'account.update',\n  'account.delete',\n  'account.change-status',\n  'account.change-password',\n  'user-profile.create',\n  'user-profile.read',\n  'user-profile.update',\n  'user-profile.delete',\n  'role.read',\n  'role.assign',\n  'permission.read',\n] as const;\n\nconst ACCOUNT_WILDCARD = [\n  'account.create',\n  'account.read',\n  'account.update',\n  'account.delete',\n  'account.change-status',\n  'account.change-password',\n];\nconst USER_PROFILE_WILDCARD = [\n  'user-profile.create',\n  'user-profile.read',\n  'user-profile.update',\n  'user-profile.delete',\n];\nconst ROLE_WILDCARD = ['role.read', 'role.assign'];\nconst PERMISSION_WILDCARD = ['permission.read'];\n\n/** Role -> permission codes, matching task.md §12's sample tree exactly. */\nconst ROLE_DEFINITIONS: { code: string; name: string; permissions: string[] }[] = [\n  { code: 'PUBLIC_USER', name: 'Public User', permissions: ['portal.public.access'] },\n  {\n    code: 'ADMIN',\n    name: 'Admin',\n    permissions: ['portal.admin.access', 'account.read', 'user-profile.read'],\n  },\n  {\n    code: 'SUPER_ADMIN',\n    name: 'Super Admin',\n    permissions: [\n      'portal.admin.access',\n      ...ACCOUNT_WILDCARD,\n      ...USER_PROFILE_WILDCARD,\n      ...ROLE_WILDCARD,\n      ...PERMISSION_WILDCARD,\n    ],\n  },\n];\n\n/**\n * §7/§12 \"Seed Role và Permission phải idempotent\" — running this any number of times converges\n * on the same Role/Permission/RolePermission rows (find-or-create + upsert grants), never\n * duplicating data. Invoked by `apps/cli`'s `seed` command; not run automatically at application\n * startup.\n */\n@Injectable()\nexport class SeedRolesAndPermissionsUseCase implements UseCase<void, void> {\n  constructor(\n    @Inject(PERMISSION_REPOSITORY) private readonly permissions: PermissionRepository,\n    @Inject(ROLE_REPOSITORY) private readonly roles: RoleRepository,\n    @Inject(ROLE_PERMISSION_REPOSITORY) private readonly rolePermissions: RolePermissionRepository,\n    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,\n    @Inject(CLOCK) private readonly clock: Clock,\n  ) {}\n\n  async execute(): Promise<void> {\n    const now = this.clock.now();\n\n    const permissionByCode = new Map<string, Permission>();\n    for (const code of PERMISSION_CODES) {\n      permissionByCode.set(code, await this.findOrCreatePermission(code, now));\n    }\n\n    for (const definition of ROLE_DEFINITIONS) {\n      const role = await this.findOrCreateRole(definition.code, definition.name, now);\n      for (const permissionCode of definition.permissions) {\n        const permission = permissionByCode.get(permissionCode);\n        if (!permission) {\n          continue;\n        }\n        await this.rolePermissions.grant(role.id.toValue(), permission.id.toValue(), null, now);\n      }\n    }\n  }\n\n  private async findOrCreatePermission(code: string, now: Date): Promise<Permission> {\n    const existing = await this.permissions.findByCode(code);\n    if (existing) {\n      return existing;\n    }\n    const permission = Permission.create(\n      { code, description: code, ...createAuditableProps(null, now) },\n      new UniqueEntityId(this.idGenerator.generate()),\n    );\n    await this.permissions.save(permission);\n    return permission;\n  }\n\n  private async findOrCreateRole(code: string, name: string, now: Date): Promise<Role> {\n    const existing = await this.roles.findByCode(code);\n    if (existing) {\n      return existing;\n    }\n    const role = Role.create(\n      { code, name, ...createAuditableProps(null, now) },\n      new UniqueEntityId(this.idGenerator.generate()),\n    );\n    await this.roles.save(role);\n    return role;\n  }\n}\n","numLines":140,"startLine":1,"totalLines":140}}}
