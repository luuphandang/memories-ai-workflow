lizer } from './infrastructure/security/phone-normalizer';\nimport { ScryptPasswordHasher } from './infrastructure/security/scrypt-password-hasher';\nimport { AccountController } from './presentation/http/account.controller';\nimport { AuthController } from './presentation/http/auth.controller';\n\n/**\n * Identity & Access bounded context (task.md — Account/AuthIdentity/RefreshSession/Role/Permission/\n * portal authorization). Marked `@Global()` for the same reason as `UserProfilesModule`: it\n * implements several cross-cutting ports declared in `@memories/platform/security`\n * (`PERMISSION_CHECKER`, `ACCOUNT_LOOKUP`, `ACCOUNT_PHONE_SEARCH`) that most other business modules\n * need (any controller using `@RequirePermissions`), without every one of them adding this module\n * to their own `imports`.\n */\n@Global()\n@Module({\n  imports: [\n    TypeOrmModule.forFeature([\n      AccountOrmEntity,\n      AuthIdentityOrmEntity,\n      RefreshSessionOrmEntity,\n      RoleOrmEntity,\n      PermissionOrmEntity,\n      AccountRoleOrmEntity,\n      RolePermissionOrmEntity,\n    ]),\n  ],\n  controllers: [AuthController, AccountController],\n  providers: [\n    CreateAccountUseCase,\n    DeleteAccountUseCase,\n    LoginUseCase,\n    LogoutUseCase,\n    RefreshSessionUseCase,\n    ChangeAccountPasswordUseCase,\n    ChangeAccountPhoneUseCase,\n    ChangeAccountStatusUseCase,\n    GetAccountUseCase,\n    ListAccountsUseCase,\n    SeedRolesAndPermissionsUseCase,\n    { provide: ACCOUNT_REPOSITORY, useClass: TypeOrmAccountRepository },\n    { provide: AUTH_IDENTITY_REPOSITORY, useClass: TypeOrmAuthIdentityRepository },\n    { provide: REFRESH_SESSION_REPOSITORY, useClass: TypeOrmRefreshSessionRepository },\n    { provide: ROLE_REPOSITORY, useClass: TypeOrmRoleRepository },\n    { provide: PERMISSION_REPOSITORY, useClass: TypeOrmPermissionRepository },\n    { provide: ACCOUNT_ROLE_REPOSITORY, useClass: TypeOrmAccountRoleRepository },\n    { provide: ROLE_PERMISSION_REPOSITORY, useClass: TypeOrmRolePermissionRepository },\n    { provide: PASSWORD_HASHER, useClass: ScryptPasswordHasher },\n    { provide: PHONE_NORMALIZER, useClass: PhoneNormalizer },\n    { provide: PERMISSION_CHECKER, useClass: PermissionCheckerService },\n    { provide: ACCOUNT_LOOKUP, useClass: AccountLookupService },\n    { provide: ACCOUNT_PHONE_SEARCH, useClass: AccountPhoneSearchService },\n    { provide: ID_GENERATOR, useClass: UuidGenerator },\n    { provide: CLOCK, useClass: SystemClock },\n    LocalAuthenticationProvider,\n    {\n      provide: AUTHENTICATION_PROVIDERS,\n      useFactory: (local: LocalAuthenticationProvider) => [local],\n      inject: [LocalAuthenticationProvider],\n    },\n    {\n      provide: AuthenticationProviderRegistry,\n      useFactory: (providers: LocalAuthenticationProvider[]) => new AuthenticationProviderRegistry(providers),\n      inject: [AUTHENTICATION_PROVIDERS],\n    },\n  ],\n  exports: [PERMISSION_CHECKER, ACCOUNT_LOOKUP, ACCOUNT_PHONE_SEARCH, SeedRolesAndPermissionsUseCase],\n})\nexport class IdentityAccessModule {}\n","numLines":113,"startLine":1,"totalLines":113}}}
