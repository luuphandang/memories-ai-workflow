{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T8bXbxSyksJ1ZfxUDAB9Zh","type":"tool_result","content":"1\timport { AuthConfig } from '@memories/platform/configuration';\n2\timport {\n3\t  buildRefreshCookieOptions,\n4\t  CurrentUser,\n5\t  JwtAuthGuard,\n6\t  OriginGuard,\n7\t  readRefreshCookie,\n8\t  RequestUser,\n9\t} from '@memories/platform/security';\n10\timport { Body, Controller, HttpCode, HttpStatus, Post, Req, Res, UnauthorizedException, UseGuards } from '@nestjs/common';\n11\timport { ConfigService } from '@nestjs/config';\n12\timport { ApiBearerAuth, ApiResponse, ApiTags } from '@nestjs/swagger';\n13\timport type { Request, Response } from 'express';\n14\t\n15\timport { LoginUseCase } from '../../application/use-cases/login.use-case';\n16\timport { LogoutUseCase } from '../../application/use-cases/logout.use-case';\n17\timport { RefreshSessionUseCase } from '../../application/use-cases/refresh-session.use-case';\n18\t\n19\timport { LoginResponseDto, RefreshResponseDto } from './auth-response.dto';\n20\timport { LoginDto } from './login.dto';\n21\t\n22\t/**\n23\t * §9/§10/§13 login/refresh/logout. No `@RequirePermissions` here — portal authorization runs\n24\t * *inside* `LoginUseCase` via `PermissionChecker` (DEC-001), not through the HTTP guard layer, so\n25\t * a missing-permission failure and a bad-credential failure both surface as the use case's own\n26\t * exception rather than a route-level 403 before the use case even runs.\n27\t */\n28\t@ApiTags('auth')\n29\t@Controller('auth')\n30\texport class AuthController {\n31\t  constructor(\n32\t    private readonly loginUseCase: LoginUseCase,\n33\t    private readonly refreshSessionUseCase: RefreshSessionUseCase,\n34\t    private readonly logoutUseCase: LogoutUseCase,\n35\t    private readonly configService: ConfigService,\n36\t  ) {}\n37\t\n38\t  @Post('login')\n39\t  @HttpCode(HttpStatus.OK)\n40\t  @ApiResponse({ status: HttpStatus.OK, type: LoginResponseDto })\n41\t  async login(\n42\t    @Body() dto: LoginDto,\n43\t    @Req() req: Request,\n44\t    @Res({ passthrough: true }) res: Response,\n45\t  ): Promise<LoginResponseDto> {\n46\t    const result = await this.loginUseCase.execute({\n47\t      phone: dto.phone,\n48\t      password: dto.password,\n49\t      portal: dto.portal,\n50\t      ipAddress: req.ip ?? null,\n51\t      userAgent: req.header('user-agent') ?? null,\n52\t    });\n53\t\n54\t    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n55\t    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));\n56\t\n57\t    return {\n58\t      accessToken: result.accessToken,\n59\t      portal: result.portal,\n60\t      sessionId: result.sessionId,\n61\t      roles: result.roles,\n62\t      permissions: result.permissions,\n63\t    };\n64\t  }\n65\t\n66\t  @Post('refresh')\n67\t  @UseGuards(OriginGuard)\n68\t  @HttpCode(HttpStatus.OK)\n69\t  @ApiResponse({ status: HttpStatus.OK, type: RefreshResponseDto })\n70\t  async refresh(\n71\t    @Req() req: Request,\n72\t    @Res({ passthrough: true }) res: Response,\n73\t  ): Promise<RefreshResponseDto> {\n74\t    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n75\t    const refreshToken = readRefreshCookie(req.headers.cookie, auth);\n76\t    if (!refreshToken) {\n77\t      throw new UnauthorizedException('Missing refresh token');\n78\t    }\n79\t\n80\t    const result = await this.refreshSessionUseCase.execute({\n81\t      refreshToken,\n82\t      ipAddress: req.ip ?? null,\n83\t      userAgent: req.header('user-agent') ?? null,\n84\t    });\n85\t\n86\t    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));\n87\t\n88\t    return { accessToken: result.accessToken, portal: result.portal, sessionId: result.sessionId };\n89\t  }\n90\t\n91\t  @Post('logout')\n92\t  @UseGuards(JwtAuthGuard)\n93\t  @ApiBearerAuth()\n94\t  @HttpCode(HttpStatus.NO_CONTENT)\n95\t  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n96\t  async logout(\n97\t    @CurrentUser() user: RequestUser,\n98\t    @Res({ passthrough: true }) res: Response,\n99\t  ): Promise<void> {\n100\t    if (user.sessionId) {\n101\t      await this.logoutUseCase.execute({ sessionId: user.sessionId });\n102\t    }\n103\t    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n104\t    res.clearCookie(auth.refreshCookie.name, buildRefreshCookieOptions(auth));\n105\t  }\n106\t}\n107\t"}]},"parent_tool_use_id":null,"session_id":"5d102af9-172e-451d-979a-7278a337c3c4","uuid":"ee2dc06c-757d-4739-bc37-28805f60525a","timestamp":"2026-08-07T15:19:26.379Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cmc/Documents/Memories/worktrees/MEMORIES-0002/backend/libs/modules/identity-access/src/presentation/http/auth.controller.ts","content":"import { AuthConfig } from '@memories/platform/configuration';\nimport {\n  buildRefreshCookieOptions,\n  CurrentUser,\n  JwtAuthGuard,\n  OriginGuard,\n  readRefreshCookie,\n  RequestUser,\n} from '@memories/platform/security';\nimport { Body, Controller, HttpCode, HttpStatus, Post, Req, Res, UnauthorizedException, UseGuards } from '@nestjs/common';\nimport { ConfigService } from '@nestjs/config';\nimport { ApiBearerAuth, ApiResponse, ApiTags } from '@nestjs/swagger';\nimport type { Request, Response } from 'express';\n\nimport { LoginUseCase } from '../../application/use-cases/login.use-case';\nimport { LogoutUseCase } from '../../application/use-cases/logout.use-case';\nimport { RefreshSessionUseCase } from '../../application/use-cases/refresh-session.use-case';\n\nimport { LoginResponseDto, RefreshResponseDto } from './auth-response.dto';\nimport { LoginDto } from './login.dto';\n\n/**\n * §9/§10/§13 login/refresh/logout. No `@RequirePermissions` here — portal authorization runs\n * *inside* `LoginUseCase` via `PermissionChecker` (DEC-001), not through the HTTP guard layer, so\n * a missing-permission failure and a bad-credential failure both surface as the use case's own\n * exception rather than a route-level 403 before the use case even runs.\n */\n@ApiTags('auth')\n@Controller('auth')\nexport class AuthController {\n  constructor(\n    private readonly loginUseCase: LoginUseCase,\n    private readonly refreshSessionUseCase: RefreshSessionUseCase,\n    private readonly logoutUseCase: LogoutUseCase,\n    private readonly configService: ConfigService,\n  ) {}\n\n  @Post('login')\n  @HttpCode(HttpStatus.OK)\n  @ApiResponse({ status: HttpStatus.OK, type: LoginResponseDto })\n  async login(\n    @Body() dto: LoginDto,\n    @Req() req: Request,\n    @Res({ passthrough: true }) res: Response,\n  ): Promise<LoginResponseDto> {\n    const result = await this.loginUseCase.execute({\n      phone: dto.phone,\n      password: dto.password,\n      portal: dto.portal,\n      ipAddress: req.ip ?? null,\n      userAgent: req.header('user-agent') ?? null,\n    });\n\n    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));\n\n    return {\n      accessToken: result.accessToken,\n      portal: result.portal,\n      sessionId: result.sessionId,\n      roles: result.roles,\n      permissions: result.permissions,\n    };\n  }\n\n  @Post('refresh')\n  @UseGuards(OriginGuard)\n  @HttpCode(HttpStatus.OK)\n  @ApiResponse({ status: HttpStatus.OK, type: RefreshResponseDto })\n  async refresh(\n    @Req() req: Request,\n    @Res({ passthrough: true }) res: Response,\n  ): Promise<RefreshResponseDto> {\n    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n    const refreshToken = readRefreshCookie(req.headers.cookie, auth);\n    if (!refreshToken) {\n      throw new UnauthorizedException('Missing refresh token');\n    }\n\n    const result = await this.refreshSessionUseCase.execute({\n      refreshToken,\n      ipAddress: req.ip ?? null,\n      userAgent: req.header('user-agent') ?? null,\n    });\n\n    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));\n\n    return { accessToken: result.accessToken, portal: result.portal, sessionId: result.sessionId };\n  }\n\n  @Post('logout')\n  @UseGuards(JwtAuthGuard)\n  @ApiBearerAuth()\n  @HttpCode(HttpStatus.NO_CONTENT)\n  @ApiResponse({ status: HttpStatus.NO_CONTENT })\n  async logout(\n    @CurrentUser() user: RequestUser,\n    @Res({ passthrough: true }) res: Response,\n  ): Promise<void> {\n    if (user.sessionId) {\n      await this.logoutUseCase.execute({ sessionId: user.sessionId });\n    }\n    const auth = this.configService.getOrThrow<AuthConfig>('auth');\n    res.clearCookie(auth.refreshCookie.name, buildRefreshCookieOptions(auth));\n  }\n}\n","numLines":107,"startLine":1,"totalLines":107}}}
