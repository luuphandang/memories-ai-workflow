import { SeedRolesAndPermissionsUseCase } from '../src/application/use-cases/seed-roles-and-permissions.use-case';
import { Permission } from '../src/domain/permissions/permission';
import { Role } from '../src/domain/roles/role';

const NOW = new Date('2026-01-01T00:00:00Z');

function buildUseCase() {
  const permissionStore = new Map<string, Permission>();
  const roleStore = new Map<string, Role>();
  let idCounter = 0;

  const permissions = {
    findByCode: jest.fn((code: string) => Promise.resolve(permissionStore.get(code) ?? null)),
    save: jest.fn((permission: Permission) => {
      permissionStore.set(permission.code, permission);
      return Promise.resolve();
    }),
  };
  const roles = {
    findByCode: jest.fn((code: string) => Promise.resolve(roleStore.get(code) ?? null)),
    save: jest.fn((role: Role) => {
      roleStore.set(role.code, role);
      return Promise.resolve();
    }),
  };
  const rolePermissions = { grant: jest.fn().mockResolvedValue(undefined) };
  const idGenerator = { generate: jest.fn(() => `generated-${++idCounter}`) };
  const clock = { now: () => NOW };

  const useCase = new SeedRolesAndPermissionsUseCase(
    permissions as never,
    roles as never,
    rolePermissions as never,
    idGenerator as never,
    clock as never,
  );

  return { useCase, permissions, roles, rolePermissions, permissionStore, roleStore };
}

describe('SeedRolesAndPermissionsUseCase', () => {
  it('creates every seeded Role and Permission on first run', async () => {
    const { useCase, roleStore, permissionStore } = buildUseCase();

    await useCase.execute();

    expect(roleStore.has('PUBLIC_USER')).toBe(true);
    expect(roleStore.has('ADMIN')).toBe(true);
    expect(roleStore.has('SUPER_ADMIN')).toBe(true);
    expect(permissionStore.has('portal.public.access')).toBe(true);
    expect(permissionStore.has('portal.admin.access')).toBe(true);
    expect(permissionStore.has('account.create')).toBe(true);
  });

  it('is idempotent: running twice does not create duplicate Role/Permission rows', async () => {
    const { useCase, roles, permissions } = buildUseCase();

    await useCase.execute();
    const roleSaveCallsAfterFirstRun = roles.save.mock.calls.length;
    const permissionSaveCallsAfterFirstRun = permissions.save.mock.calls.length;

    await useCase.execute();

    expect(roles.save).toHaveBeenCalledTimes(roleSaveCallsAfterFirstRun);
    expect(permissions.save).toHaveBeenCalledTimes(permissionSaveCallsAfterFirstRun);
  });

  it('grants SUPER_ADMIN every account/user-profile/role/permission wildcard permission', async () => {
    const { useCase, rolePermissions, roleStore, permissionStore } = buildUseCase();

    await useCase.execute();

    const superAdminId = roleStore.get('SUPER_ADMIN')!.id.toValue();
    const grantedPermissionIds = rolePermissions.grant.mock.calls
      .filter(([roleId]) => roleId === superAdminId)
      .map(([, permissionId]) => permissionId);

    expect(grantedPermissionIds).toContain(permissionStore.get('account.delete')!.id.toValue());
    expect(grantedPermissionIds).toContain(permissionStore.get('role.assign')!.id.toValue());
    expect(grantedPermissionIds).toContain(permissionStore.get('permission.read')!.id.toValue());
  });
});
