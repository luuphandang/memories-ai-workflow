@ApiTags('user-profiles')
@ApiBearerAuth()
@UseGuards(JwtAuthGuard, PermissionsGuard)
@Controller('user-profiles')
export class UserProfileController {
  constructor(
    private readonly createUserProfile: CreateUserProfileUseCase,
    private readonly getUserProfile: GetUserProfileUseCase,
    private readonly listUserProfiles: ListUserProfilesUseCase,
    private readonly updateUserProfile: UpdateUserProfileUseCase,
    private readonly deleteUserProfile: DeleteUserProfileUseCase,
  ) {}

  @Post()
  @RequirePermissions('user-profile.create')
  @ApiResponse({ status: HttpStatus.CREATED, type: UserProfileResponseDto })
  async create(
    @CurrentUser() user: RequestUser,
    @Body() dto: CreateUserProfileDto,
  ): Promise<UserProfileResponseDto> {
    const output = await this.createUserProfile.execute({
      accountId: dto.accountId,
      fullName: dto.fullName,
      email: dto.email,
      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,
      address: dto.address,
      avatarId: dto.avatarId,
      actorId: user.id,
    });
    return toResponseDto(output);
  }

  @Get()
  @RequirePermissions('user-profile.read')
  @ApiResponse({ status: HttpStatus.OK, type: ListUserProfilesResponseDto })
  async list(@Query() query: ListUserProfilesQueryDto): Promise<ListUserProfilesResponseDto> {
    const result = await this.listUserProfiles.execute({
      fullNameSearch: query.fullName,
      emailSearch: query.email,
      phoneSearch: query.phone,
      page: query.page,
      pageSize: query.pageSize,
      sortBy: query.sortBy,
      sortDirection: query.sortDirection,
    });
    return {
      items: result.items.map(toResponseDto),
      total: result.total,
      page: result.page,
      pageSize: result.pageSize,
      totalPages: result.totalPages,
    };
  }

  @Get(':userProfileId')
  @RequirePermissions('user-profile.read')
  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })
  @ApiResponse({ status: HttpStatus.OK, type: UserProfileResponseDto })
  async getById(@Param('userProfileId') userProfileId: string): Promise<UserProfileResponseDto> {
    const output = await this.getUserProfile.execute({ userProfileId });
    return toResponseDto(output);
  }

  @Patch(':userProfileId')
  @RequirePermissions('user-profile.update')
  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })
  @ApiResponse({ status: HttpStatus.OK, type: UserProfileResponseDto })
  async update(
    @CurrentUser() user: RequestUser,
    @Param('userProfileId') userProfileId: string,
    @Body() dto: UpdateUserProfileDto,
  ): Promise<UserProfileResponseDto> {
    const output = await this.updateUserProfile.execute({
      userProfileId,
      fullName: dto.fullName,
      email: dto.email,
      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,
      address: dto.address,
      avatarId: dto.avatarId,
      actorId: user.id,
    });
    return toResponseDto(output);
  }

  @Delete(':userProfileId')
  @RequirePermissions('user-profile.delete')
  @HttpCode(HttpStatus.NO_CONTENT)
  @ApiParam({ name: 'userProfileId', type: String, format: 'uuid' })
  @ApiResponse({ status: HttpStatus.NO_CONTENT })
  async remove(
    @CurrentUser() user: RequestUser,
    @Param('userProfileId') userProfileId: string,
  ): Promise<void> {
    await this.deleteUserProfile.execute({ userProfileId, actorId: user.id });
  }
}
