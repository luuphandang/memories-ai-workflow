import { PermissionChecker, ResolvedPermissions } from '@memories/platform/security';
import { Inject, Injectable } from '@nestjs/common';

import {
  PERMISSION_REPOSITORY,
  PermissionRepository,
} from '../../domain/permissions/permission.repository';
import {
  ROLE_PERMISSION_REPOSITORY,
  RolePermissionRepository,
} from '../../domain/permissions/role-permission.repository';
import {
  ACCOUNT_ROLE_REPOSITORY,
  AccountRoleRepository,
} from '../../domain/roles/account-role.repository';
import { ROLE_REPOSITORY, RoleRepository } from '../../domain/roles/role.repository';

/**
 * Implements the `PermissionChecker` port declared in `libs/platform/security` (DEC-001): resolves
 * an Account's roles/permissions through `AccountRole` -> `RolePermission` -> `Permission`, never
 * hard-coding a role check. A permission code that doesn't exist in the seeded list is simply
 * absent from the resolved set — never implicitly granted (authorization/business-rules.md edge
 * case).
 */
@Injectable()
export class PermissionCheckerService implements PermissionChecker {
  constructor(
    @Inject(ACCOUNT_ROLE_REPOSITORY) private readonly accountRoles: AccountRoleRepository,
    @Inject(ROLE_REPOSITORY) private readonly roles: RoleRepository,
    @Inject(ROLE_PERMISSION_REPOSITORY) private readonly rolePermissions: RolePermissionRepository,
    @Inject(PERMISSION_REPOSITORY) private readonly permissions: PermissionRepository,
  ) {}

  async hasPermissions(userId: string, permissions: string[]): Promise<boolean> {
    if (permissions.length === 0) {
      return true;
    }
    const resolved = await this.resolvePermissions(userId);
    const granted = new Set(resolved.permissions);
    return permissions.every((permission) => granted.has(permission));
  }

  async resolvePermissions(userId: string): Promise<ResolvedPermissions> {
    const roleIds = await this.accountRoles.listRoleIdsForAccount(userId);
    if (roleIds.length === 0) {
      return { roles: [], permissions: [] };
    }

    const [roles, permissionIds] = await Promise.all([
      this.roles.list(),
      this.rolePermissions.listPermissionIdsForRoles(roleIds),
    ]);

    const roleIdSet = new Set(roleIds);
    const roleCodes = roles.filter((role) => roleIdSet.has(role.id.toValue())).map((role) => role.code);

    if (permissionIds.length === 0) {
      return { roles: roleCodes, permissions: [] };
    }

    const permissionIdSet = new Set(permissionIds);
    const allPermissions = await this.permissions.list();
    const permissionCodes = allPermissions
      .filter((permission) => permissionIdSet.has(permission.id.toValue()))
      .map((permission) => permission.code);

    return { roles: roleCodes, permissions: permissionCodes };
  }
}
