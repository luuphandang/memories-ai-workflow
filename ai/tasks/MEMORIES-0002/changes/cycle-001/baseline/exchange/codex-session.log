  ): Promise<void> {
    await this.changeAccountStatus.execute({ accountId, status: dto.status, actorId: user.id });
  }

  @Patch(':accountId/phone')
  @RequirePermissions('account.update')
  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })
  @ApiResponse({ status: HttpStatus.NO_CONTENT })
  @HttpCode(HttpStatus.NO_CONTENT)
  async changePhone(
    @CurrentUser() user: RequestUser,
    @Param('accountId') accountId: string,
    @Body() dto: ChangeAccountPhoneDto,
  ): Promise<void> {
    await this.changeAccountPhone.execute({ accountId, newPhone: dto.phone, actorId: user.id });
