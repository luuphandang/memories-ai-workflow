import { Mapper, UniqueEntityId } from '@memories/shared/kernel';

import { UserProfile } from '../../domain/user-profile';

import { UserProfileOrmEntity } from './user-profile.orm-entity';

export class UserProfileMapper implements Mapper<UserProfile, UserProfileOrmEntity> {
  toDomain(raw: UserProfileOrmEntity): UserProfile {
    return UserProfile.create(
      {
        accountId: raw.accountId,
        fullName: raw.fullName,
        email: raw.email,
        avatarId: raw.avatarId,
        dateOfBirth: raw.dateOfBirth,
        address: raw.address,
        createdBy: raw.createdBy,
        createdAt: raw.createdAt,
        updatedBy: raw.updatedBy,
        updatedAt: raw.updatedAt,
        deletedBy: raw.deletedBy,
        deletedAt: raw.deletedAt,
      },
      new UniqueEntityId(raw.id),
    );
  }

