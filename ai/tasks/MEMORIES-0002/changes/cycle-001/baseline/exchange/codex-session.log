import { UserProfileProvisioner, USER_PROFILE_PROVISIONER } from '@memories/platform/security';
import {
  CLOCK,
  Clock,
  DomainError,
  UniqueEntityId,
  UnitOfWork,
  UseCase,
} from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';

import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import {
  AUTH_IDENTITY_REPOSITORY,
  AuthIdentityRepository,
} from '../../domain/auth-identities/auth-identity.repository';
import {
  REFRESH_SESSION_REPOSITORY,
  RefreshSessionRepository,
} from '../../domain/sessions/refresh-session.repository';

export interface DeleteAccountInput {
  accountId: string;
  actorId: string | null;
}

/**
 * §16 `DELETE /accounts/:accountId`. Soft deletes the Account and every one of its AuthIdentities,
 * asks `user-profiles` (via the cross-module `UserProfileProvisioner` port) to soft delete the
 * UserProfile, and revokes every outstanding session — all inside one transaction (task.md §16
 * "Xóa Account phải: Soft delete Account, Soft delete AuthIdentity, Soft delete UserProfile, Revoke
 * refresh sessions"). This is a soft delete only (out of scope: "Xóa vật lý Account hoặc
 * UserProfile").
 */
@Injectable()
export class DeleteAccountUseCase implements UseCase<DeleteAccountInput, void> {
  constructor(
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,
    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,
    @Inject(USER_PROFILE_PROVISIONER) private readonly userProfileProvisioner: UserProfileProvisioner,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: DeleteAccountInput): Promise<void> {
    await this.unitOfWork.withTransaction(async () => {
      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));
      if (!account) {
        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);
      }

      const now = this.clock.now();
      account.softDelete(input.actorId, now);
      await this.accounts.save(account);

      const identities = await this.authIdentities.findAllByAccountId(input.accountId);
      for (const identity of identities) {
        if (!identity.isDeleted) {
          identity.softDelete(input.actorId, now);
          await this.authIdentities.save(identity);
        }
      }

      await this.userProfileProvisioner.deleteByAccountId(input.accountId, input.actorId);
      await this.refreshSessions.revokeAllForAccount(input.accountId, now);
    });
  }
}
