import { TypeOrmQueryRunnerContext } from '@memories/platform/database';
import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository as TypeOrmRepository } from 'typeorm';

import { AccountRoleRepository } from '../../domain/roles/account-role.repository';

import { AccountRoleOrmEntity } from './account-role.orm-entity';

@Injectable()
export class TypeOrmAccountRoleRepository implements AccountRoleRepository {
  constructor(
    @InjectRepository(AccountRoleOrmEntity)
    private readonly repository: TypeOrmRepository<AccountRoleOrmEntity>,
    private readonly queryRunnerContext: TypeOrmQueryRunnerContext,
  ) {}

  private repositoryFor(): TypeOrmRepository<AccountRoleOrmEntity> {
    const queryRunner = this.queryRunnerContext.get();
    return queryRunner ? queryRunner.manager.getRepository(AccountRoleOrmEntity) : this.repository;
  }

  async assign(accountId: string, roleId: string, actorId: string | null, now: Date): Promise<void> {
    await this.repositoryFor().upsert(
      { accountId, roleId, createdBy: actorId, createdAt: now },
      { conflictPaths: ['accountId', 'roleId'], skipUpdateIfNoValuesChanged: true },
    );
  }

  async unassign(accountId: string, roleId: string): Promise<void> {
    await this.repositoryFor().delete({ accountId, roleId });
  }

  async listRoleIdsForAccount(accountId: string): Promise<string[]> {
    const rows = await this.repositoryFor().find({ where: { accountId } });
    return rows.map((row) => row.roleId);
  }
}
