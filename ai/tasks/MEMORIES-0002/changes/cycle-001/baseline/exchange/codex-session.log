import {
  CLOCK,
  Clock,
  DomainError,
  UniqueEntityId,
  UnitOfWork,
  UseCase,
} from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';

import { AccountStatus } from '../../domain/accounts/account-status';
import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import {
  REFRESH_SESSION_REPOSITORY,
  RefreshSessionRepository,
} from '../../domain/sessions/refresh-session.repository';

export interface ChangeAccountStatusInput {
  accountId: string;
  status: AccountStatus;
  actorId: string | null;
}

/**
 * §16 `PATCH /accounts/:accountId/status`. Any transition away from `ACTIVE` revokes every
 * outstanding session for the account — AC #32 only calls out lock/delete explicitly, but
 * `INACTIVE` is just as unable to authenticate (§2), so leaving its sessions live would be
 * inconsistent with "Account inactive, locked hoặc deleted không được đăng nhập/refresh" (§2, §9).
 */
@Injectable()
export class ChangeAccountStatusUseCase implements UseCase<ChangeAccountStatusInput, void> {
  constructor(
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: ChangeAccountStatusInput): Promise<void> {
    await this.unitOfWork.withTransaction(async () => {
      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));
      if (!account) {
        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);
      }

      const now = this.clock.now();
      switch (input.status) {
        case AccountStatus.Active:
          account.activate(input.actorId, now);
          break;
        case AccountStatus.Locked:
          account.lock(input.actorId, now);
          break;
        case AccountStatus.Inactive:
          account.deactivate(input.actorId, now);
          break;
      }
      await this.accounts.save(account);

      if (input.status !== AccountStatus.Active) {
        await this.refreshSessions.revokeAllForAccount(input.accountId, now);
      }
    });
  }
}
