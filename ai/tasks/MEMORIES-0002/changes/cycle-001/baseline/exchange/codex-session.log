} from '@memories/shared/kernel';

export interface UserProfileProps extends AuditableProps {
  accountId: string;
  fullName: string;
  /** Contact info only — never a login identifier (task.md §4 "Email không được sử dụng làm login
   * identifier"); always normalized to lowercase before persisting. */
  email: string | null;
  avatarId: string | null;
  dateOfBirth: Date | null;
  address: string | null;
}

/**
 * The single shared profile for an Account (task.md §4). Holds personal data only — no password,
 * no permission — and never a TypeORM relation to `Account` (module boundary, task.md §4/§1):
 * `accountId` is a plain string FK, existence/status checked through `AccountLookup`.
 */
export class UserProfile extends AggregateRoot<UserProfileProps> {
  static create(props: UserProfileProps, id?: UniqueEntityId): UserProfile {
    if (!props.fullName.trim()) {
      throw DomainError.validation('full_name_required', 'UserProfile requires a full name');
    }
    return new UserProfile(props, id);
  }

  get accountId(): string {
    return this.props.accountId;
  }

  get fullName(): string {
    return this.props.fullName;
  }

  get email(): string | null {
    return this.props.email;
  }

  get avatarId(): string | null {
    return this.props.avatarId;
  }

  get dateOfBirth(): Date | null {
    return this.props.dateOfBirth;
  }

  get address(): string | null {
    return this.props.address;
  }

  get audit(): AuditableProps {
    return this.props;
  }

  get isDeleted(): boolean {
    return this.props.deletedAt !== null;
  }

  update(
    changes: {
      fullName?: string | undefined;
      email?: string | null | undefined;
      avatarId?: string | null | undefined;
      dateOfBirth?: Date | null | undefined;
      address?: string | null | undefined;
    },
    actorId: string | null,
    now: Date,
  ): void {
    if (changes.fullName !== undefined) {
      if (!changes.fullName.trim()) {
        throw DomainError.validation('full_name_required', 'UserProfile requires a full name');
      }
      this.props.fullName = changes.fullName;
    }
    if (changes.email !== undefined) {
      this.props.email = changes.email;
    }
    if (changes.avatarId !== undefined) {
      this.props.avatarId = changes.avatarId;
    }
    if (changes.dateOfBirth !== undefined) {
      this.props.dateOfBirth = changes.dateOfBirth;
    }
    if (changes.address !== undefined) {
      this.props.address = changes.address;
    }
    this.touch(actorId, now);
  }

  softDelete(actorId: string | null, now: Date): void {
    if (this.isDeleted) {
      throw DomainError.conflict(
        'user_profile_already_deleted',
        `UserProfile ${this._id.toString()} is already deleted`,
      );
    }
    this.props.deletedBy = actorId;
    this.props.deletedAt = now;
    this.touch(actorId, now);
  }

  private touch(actorId: string | null, now: Date): void {
    this.props.updatedBy = actorId;
    this.props.updatedAt = now;
  }
}

