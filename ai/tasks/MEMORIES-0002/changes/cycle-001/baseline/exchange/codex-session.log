import { DomainError } from '@memories/shared/kernel';

import { AuthProvider } from '../../domain/auth-identities/auth-provider';

export interface AuthenticationCredential {
  provider: AuthProvider;
  [claim: string]: unknown;
}

export interface AuthenticationResult {
  accountId: string;
  authIdentityId: string;
}

/**
 * §11 provider contract: "Xác định provider, Validate credential, Resolve normalized identity,
 * Resolve Account." Only `LocalAuthenticationProvider` is implemented in this epic; Google/Apple/
 * Facebook get this same contract later without changing `LoginUseCase`.
 */
export interface AuthenticationProvider {
  readonly provider: AuthProvider;
  authenticate(credential: AuthenticationCredential): Promise<AuthenticationResult>;
}

export const AUTHENTICATION_PROVIDERS = Symbol('AUTHENTICATION_PROVIDERS');

/** Injected with the full `AuthenticationProvider[]` list; `LoginUseCase` resolves by `AuthProvider`
 * instead of a provider-specific switch/case (task.md §11 "Login use case không chứa switch/case
 * theo từng provider"). */
export class AuthenticationProviderRegistry {
  private readonly providers = new Map<AuthProvider, AuthenticationProvider>();

  constructor(providers: AuthenticationProvider[]) {
    for (const provider of providers) {
      this.providers.set(provider.provider, provider);
    }
  }

  resolve(provider: AuthProvider): AuthenticationProvider {
    const found = this.providers.get(provider);
    if (!found) {
      throw DomainError.validation(
        'unsupported_auth_provider',
        `Authentication provider "${provider}" is not supported`,
      );
    }
    return found;
  }
}
