import { AggregateRoot, AuditableProps, UniqueEntityId } from '@memories/shared/kernel';

export interface RoleProps extends AuditableProps {
  /** Stable business identifier (`PUBLIC_USER`, `ADMIN`, ...) — never the display name (task.md
   * §12, BR-003). */
  code: string;
  name: string;
}

/** A named set of permissions, assigned to Accounts via `AccountRole`. Carries no logic of its
 * own beyond identity — "Role chỉ là nhóm các permission" (task.md §12). */
export class Role extends AggregateRoot<RoleProps> {
  static create(props: RoleProps, id?: UniqueEntityId): Role {
    return new Role(props, id);
  }

  get code(): string {
    return this.props.code;
  }

  get name(): string {
    return this.props.name;
  }

  get audit(): AuditableProps {
    return this.props;
  }
}
