import { AccountPhoneSearch } from '@memories/platform/security';
import { Inject, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { InjectRepository } from '@nestjs/typeorm';
import { ILike, IsNull, Repository as TypeOrmRepository } from 'typeorm';

import { PHONE_NORMALIZER, PhoneNormalizerPort } from '../../application/ports/phone-normalizer.port';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import { AuthIdentityOrmEntity } from '../persistence/auth-identity.orm-entity';

/** Implements `AccountPhoneSearch` (`libs/platform/security/src/identity.contracts.ts`) so
 * `user-profiles`' list query can filter by phone without a cross-module TypeORM join. */
@Injectable()
export class AccountPhoneSearchService implements AccountPhoneSearch {
  constructor(
    @InjectRepository(AuthIdentityOrmEntity)
    private readonly repository: TypeOrmRepository<AuthIdentityOrmEntity>,
    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,
    private readonly configService: ConfigService,
  ) {}

  async searchAccountIdsByPhone(search: string): Promise<string[]> {
    const rows = await this.repository.find({
      where: {
        provider: AuthProvider.Local,
        identifier: ILike(`%${this.normalize(search)}%`),
        deletedAt: IsNull(),
      },
      select: { accountId: true },
    });
    return rows.map((row) => row.accountId);
  }

  /** `identifier` is stored E.164 (`+849...`); a caller searching with the same local format
   * accepted everywhere else (e.g. `0912345678`) would otherwise never match (§9/§19). A full,
   * parseable phone term is normalized to E.164 first; a partial term (e.g. `5678`) can't be
   * parsed as a phone number at all, so it is used as-is to keep substring search working. */
  private normalize(search: string): string {
    try {
      const auth = this.configService.getOrThrow<AuthConfig>('auth');
      return this.phoneNormalizer.normalize(search, auth.phone.defaultRegion).value;
    } catch {
      return search;
    }
  }
}
import { AccountLookup } from '@memories/platform/security';
import { UniqueEntityId } from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';

import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';

/** Implements the `AccountLookup` port (`libs/platform/security/src/identity.contracts.ts`) so
 * `user-profiles` can validate an `accountId` exists/is active without importing identity-access
 * internals directly (module boundary — task.md §4 "Kiểm tra Account tồn tại thông qua application
 * contract"). */
@Injectable()
export class AccountLookupService implements AccountLookup {
  constructor(@Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository) {}

  async exists(accountId: string): Promise<boolean> {
    const account = await this.accounts.findByIdIncludingDeleted(new UniqueEntityId(accountId));
    return account !== null;
  }

  async isActive(accountId: string): Promise<boolean> {
    const account = await this.accounts.findById(new UniqueEntityId(accountId));
    return account !== null && account.canAuthenticate();
  }
}
import {
  ProvisionUserProfileInput,
  ProvisionUserProfileOutput,
  UserProfileProvisioner,
} from '@memories/platform/security';
import { CLOCK, Clock } from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';

import { CreateUserProfileUseCase } from '../../application/use-cases/create-user-profile.use-case';
import { USER_PROFILE_REPOSITORY, UserProfileRepository } from '../../domain/user-profile.repository';

/**
 * Implements `UserProfileProvisioner` (`libs/platform/security/src/identity.contracts.ts`), the
 * port identity-access's `CreateAccountUseCase`/account-deletion flow depend on instead of
 * importing `@memories/modules/user-profiles` directly (DEC in identity.contracts.ts — keeps the
 * module graph acyclic). Delegates creation to `CreateUserProfileUseCase` so both entry points
 * (this port and the `POST /user-profiles` route) share one validation path.
 */
@Injectable()
export class UserProfileProvisionerService implements UserProfileProvisioner {
  constructor(
    private readonly createUserProfile: CreateUserProfileUseCase,
    @Inject(USER_PROFILE_REPOSITORY) private readonly userProfiles: UserProfileRepository,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async provision(input: ProvisionUserProfileInput): Promise<ProvisionUserProfileOutput> {
    const result = await this.createUserProfile.execute(input);
    return { userProfileId: result.id };
  }

  async deleteByAccountId(accountId: string, actorId: string | null): Promise<void> {
    const profile = await this.userProfiles.findByAccountId(accountId);
    if (!profile || profile.isDeleted) {
      return;
    }
    profile.softDelete(actorId, this.clock.now());
    await this.userProfiles.save(profile);
  }
}
import { UserProfileLookup } from '@memories/platform/security';
import { Inject, Injectable } from '@nestjs/common';

import { USER_PROFILE_REPOSITORY, UserProfileRepository } from '../../domain/user-profile.repository';

/** Implements `UserProfileLookup` (`libs/platform/security/src/identity.contracts.ts`) — consumed
 * by identity-access's `LoginUseCase` to put `userProfileId` in the JWT payload (§13) without
 * importing `@memories/modules/user-profiles` directly. */
@Injectable()
export class UserProfileLookupService implements UserProfileLookup {
  constructor(@Inject(USER_PROFILE_REPOSITORY) private readonly userProfiles: UserProfileRepository) {}

  async findProfileIdByAccountId(accountId: string): Promise<string | null> {
    const profile = await this.userProfiles.findByAccountId(accountId);
    return profile ? profile.id.toValue() : null;
  }
}

