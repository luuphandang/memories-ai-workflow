import { randomInt } from 'node:crypto';

import {
  ACCOUNT_ROLE_REPOSITORY,
  AccountRoleRepository,
  CreateAccountUseCase,
  ROLE_REPOSITORY,
  RoleRepository,
  SeedRolesAndPermissionsUseCase,
} from '@memories/modules/identity-access';
import { AppConfig } from '@memories/platform/configuration';
import { TOKEN_SERVICE, TokenService } from '@memories/platform/security';
import { INestApplication } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';

import { AppModule } from '../src/app.module';
import { configureApp } from '../src/configure-app';

/**
 * Requires the local infrastructure stack (`docker compose -f docker/docker-compose.yml
 * --profile infrastructure up -d`) and a populated `.env`; run via `npm run test:e2e`.
 *
 * Exercises MEMORIES-0002's login/authorization/CRUD flows end to end against a real
 * Postgres-backed AppModule — the real HTTP layer, guards and use cases, not mocks. Test-only
 * setup (seeding roles/permissions, provisioning a bootstrap SUPER_ADMIN, granting extra roles)
 * goes through `CreateAccountUseCase`/`AccountRoleRepository` obtained directly from the Nest
 * container (`{ strict: false }`, same pattern as `media-upload-flow.e2e-spec.ts`) since there is
 * no HTTP-only way to create the very first admin account — every other assertion goes through
 * `supertest` against the real routes.
 */
const API_PREFIX = '/api/v1';

interface Credentials {
  accountId: string;
  userProfileId: string;
  phone: string;
  password: string;
}

describe('Auth & portal authorization flow (e2e)', () => {
  let app: INestApplication;
  let tokenService: TokenService;
  let createAccount: CreateAccountUseCase;
  let accountRoles: AccountRoleRepository;
  let roles: RoleRepository;
  let roleIdByCode: Map<string, string>;

  beforeAll(async () => {
    const moduleRef: TestingModule = await Test.createTestingModule({
      imports: [AppModule],
    }).compile();
    app = moduleRef.createNestApplication();
    configureApp(app, moduleRef.get(ConfigService).getOrThrow<AppConfig>('app'));
    await app.init();

    tokenService = moduleRef.get(TOKEN_SERVICE);
    createAccount = moduleRef.get(CreateAccountUseCase, { strict: false });
    accountRoles = moduleRef.get(ACCOUNT_ROLE_REPOSITORY, { strict: false });
    roles = moduleRef.get(ROLE_REPOSITORY, { strict: false });

    const seed = moduleRef.get(SeedRolesAndPermissionsUseCase, { strict: false });
    await seed.execute();

    roleIdByCode = new Map<string, string>();
    for (const code of ['PUBLIC_USER', 'ADMIN', 'SUPER_ADMIN']) {
      const role = await roles.findByCode(code);
      if (!role) {
        throw new Error(`Role ${code} was not seeded`);
      }
      roleIdByCode.set(code, role.id.toValue());
    }
  }, 30_000);

  afterAll(async () => {
    await app.close();
  });

  /** 09 + 8 random digits — confirmed a valid VN mobile shape via libphonenumber-js. Random
   * (not a per-run counter) so re-running this suite against a database that still has rows
   * from a previous run can't collide on the unique `provider + identifier` constraint. */
  function nextPhone(): string {
    const suffix = randomInt(10_000_000, 99_999_999);
    return `09${String(suffix).padStart(8, '0')}`;
  }

  async function createTestAccount(extraRoleCode?: 'ADMIN' | 'SUPER_ADMIN'): Promise<Credentials> {
    const phone = nextPhone();
    const password = 'Sup3rSecret!';
    const output = await createAccount.execute({
      phone,
      password,
      fullName: 'E2E Test User',
      actorId: null,
    });
    if (extraRoleCode) {
      const roleId = roleIdByCode.get(extraRoleCode);
      if (!roleId) {
        throw new Error(`Role ${extraRoleCode} not resolved`);
      }
      await accountRoles.assign(output.accountId, roleId, null, new Date());
    }
    return { accountId: output.accountId, userProfileId: output.userProfileId, phone, password };
  }

  function login(phone: string, password: string, portal: 'PUBLIC' | 'ADMIN') {
    return request(app.getHttpServer()).post(`${API_PREFIX}/auth/login`).send({ phone, password, portal });
  }

  describe('login', () => {
    it('logs in a default account on the PUBLIC portal', async () => {
      const account = await createTestAccount();
      const res = await login(account.phone, account.password, 'PUBLIC').expect(200);

      expect(res.body.accessToken).toEqual(expect.any(String));
      expect(res.body.portal).toBe('PUBLIC');
      expect(res.body.permissions).toContain('portal.public.access');
      expect(res.headers['set-cookie']?.[0]).toMatch(/HttpOnly/i);

      const claims = await tokenService.verifyAccessToken(res.body.accessToken);
      expect(claims.subject).toBe(account.accountId);
      expect(claims.portal).toBe('PUBLIC');
    });

    it('logs in an account granted the ADMIN role on the ADMIN portal', async () => {
      const account = await createTestAccount('ADMIN');
      const res = await login(account.phone, account.password, 'ADMIN').expect(200);

      expect(res.body.portal).toBe('ADMIN');
      expect(res.body.permissions).toContain('portal.admin.access');
    });

    it('rejects a PUBLIC-only account attempting to log into the ADMIN portal without creating a session', async () => {
      const account = await createTestAccount();
      await login(account.phone, account.password, 'ADMIN').expect(403);

      // No refresh session/token was issued for the rejected portal — the account can still log
      // into the portal it does have access to right afterwards.
      await login(account.phone, account.password, 'PUBLIC').expect(200);
    });

    it('returns the same generic error for an unknown phone and for a wrong password (no account enumeration)', async () => {
      const account = await createTestAccount();
      const unknownPhoneRes = await login(nextPhone(), account.password, 'PUBLIC').expect(401);
      const wrongPasswordRes = await login(account.phone, 'wrong-password', 'PUBLIC').expect(401);

      expect(unknownPhoneRes.body.message).toBe(wrongPasswordRes.body.message);
    });

    it('rejects login for an INACTIVE account', async () => {
      const account = await createTestAccount();
      await request(app.getHttpServer())
        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)
        .set('Authorization', await adminBearer())
        .send({ status: 'INACTIVE' })
        .expect(204);

      await login(account.phone, account.password, 'PUBLIC').expect(403);
    });

    it('rejects login for a LOCKED account', async () => {
      const account = await createTestAccount();
      await request(app.getHttpServer())
        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)
        .set('Authorization', await adminBearer())
        .send({ status: 'LOCKED' })
        .expect(204);

      await login(account.phone, account.password, 'PUBLIC').expect(403);
    });

    it('rejects login for a deleted (soft-deleted) account', async () => {
      const account = await createTestAccount();
      await request(app.getHttpServer())
        .delete(`${API_PREFIX}/accounts/${account.accountId}`)
        .set('Authorization', await adminBearer())
        .expect(204);

      await login(account.phone, account.password, 'PUBLIC').expect(401);
    });
  });

  describe('refresh & logout', () => {
    it('rotates the refresh session and keeps the same portal', async () => {
      const account = await createTestAccount();
      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);
      const cookie = loginRes.headers['set-cookie'] as unknown as string[];

      const refreshRes = await request(app.getHttpServer())
        .post(`${API_PREFIX}/auth/refresh`)
        .set('Cookie', cookie)
        .expect(200);

      expect(refreshRes.body.portal).toBe('PUBLIC');
      expect(refreshRes.body.sessionId).not.toBe(loginRes.body.sessionId);

      const claims = await tokenService.verifyAccessToken(refreshRes.body.accessToken);
      expect(claims.subject).toBe(account.accountId);
    });

    it('revokes the session once the account is locked, so a later refresh fails', async () => {
      const account = await createTestAccount();
      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);
      const cookie = loginRes.headers['set-cookie'] as unknown as string[];

      await request(app.getHttpServer())
        .patch(`${API_PREFIX}/accounts/${account.accountId}/status`)
        .set('Authorization', await adminBearer())
        .send({ status: 'LOCKED' })
        .expect(204);

      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);
    });

    it('logout revokes the current session so the refresh cookie can no longer be used', async () => {
      const account = await createTestAccount();
      const loginRes = await login(account.phone, account.password, 'PUBLIC').expect(200);
      const cookie = loginRes.headers['set-cookie'] as unknown as string[];

      await request(app.getHttpServer())
        .post(`${API_PREFIX}/auth/logout`)
        .set('Authorization', `Bearer ${loginRes.body.accessToken}`)
        .set('Cookie', cookie)
        .expect(204);

      await request(app.getHttpServer()).post(`${API_PREFIX}/auth/refresh`).set('Cookie', cookie).expect(401);
    });
  });

  describe('Account CRUD, gated by ADMIN portal + permission', () => {
    it('rejects an ADMIN-portal request with no bearer token', async () => {
      await request(app.getHttpServer()).get(`${API_PREFIX}/accounts`).expect(401);
    });

    it('rejects a PUBLIC-portal token even when the underlying account also holds admin permissions', async () => {
      const account = await createTestAccount('SUPER_ADMIN');
      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);

      await request(app.getHttpServer())
        .get(`${API_PREFIX}/accounts`)
        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)
        .expect(403);
    });

    it('rejects an ADMIN account that lacks account.create when creating a new account', async () => {
      const admin = await createTestAccount('ADMIN');
      const adminLogin = await login(admin.phone, admin.password, 'ADMIN').expect(200);

      await request(app.getHttpServer())
        .post(`${API_PREFIX}/accounts`)
        .set('Authorization', `Bearer ${adminLogin.body.accessToken}`)
        .send({ phone: nextPhone(), password: 'Sup3rSecret!', fullName: 'Should not be created' })
        .expect(403);
    });

    it('lets a SUPER_ADMIN create, list, fetch, update status and delete an account', async () => {
      const bearer = await adminBearer();
      const newPhone = nextPhone();

      const createRes = await request(app.getHttpServer())
        .post(`${API_PREFIX}/accounts`)
        .set('Authorization', bearer)
        .send({ phone: newPhone, password: 'Sup3rSecret!', fullName: 'Created Via API' })
        .expect(201);
      const accountId: string = createRes.body.accountId;
      expect(accountId).toEqual(expect.any(String));

      const listRes = await request(app.getHttpServer())
        .get(`${API_PREFIX}/accounts`)
        .set('Authorization', bearer)
        .query({ phone: newPhone })
        .expect(200);
      expect(listRes.body.items.some((item: { id: string }) => item.id === accountId)).toBe(true);
      expect(listRes.body.items[0].phone).not.toBeUndefined();
      // Response never leaks the password hash under any field name.
      expect(JSON.stringify(listRes.body)).not.toMatch(/passwordHash/i);

      const getRes = await request(app.getHttpServer())
        .get(`${API_PREFIX}/accounts/${accountId}`)
        .set('Authorization', bearer)
        .expect(200);
      expect(getRes.body.status).toBe('ACTIVE');

      await request(app.getHttpServer())
        .patch(`${API_PREFIX}/accounts/${accountId}/status`)
        .set('Authorization', bearer)
        .send({ status: 'LOCKED' })
        .expect(204);

      await request(app.getHttpServer())
        .delete(`${API_PREFIX}/accounts/${accountId}`)
        .set('Authorization', bearer)
        .expect(204);

      await request(app.getHttpServer())
        .get(`${API_PREFIX}/accounts/${accountId}`)
        .set('Authorization', bearer)
        .expect(404);
    });
  });

  describe('UserProfile CRUD, gated by permission', () => {
    it('rejects a request with no permission for the account', async () => {
      const account = await createTestAccount();
      const publicLogin = await login(account.phone, account.password, 'PUBLIC').expect(200);

      await request(app.getHttpServer())
        .get(`${API_PREFIX}/user-profiles`)
        .set('Authorization', `Bearer ${publicLogin.body.accessToken}`)
        .expect(403);
    });

    it('lets a SUPER_ADMIN read, update and delete the profile auto-provisioned with an account, and rejects a duplicate', async () => {
      const bearer = await adminBearer();
      const account = await createTestAccount();

      const getRes = await request(app.getHttpServer())
        .get(`${API_PREFIX}/user-profiles/${account.userProfileId}`)
        .set('Authorization', bearer)
        .expect(200);
      expect(getRes.body.accountId).toBe(account.accountId);

      await request(app.getHttpServer())
        .patch(`${API_PREFIX}/user-profiles/${account.userProfileId}`)
        .set('Authorization', bearer)
        .send({ fullName: 'Updated Name' })
        .expect(200)
        .then((res) => expect(res.body.fullName).toBe('Updated Name'));

      // §4 "Mỗi Account chỉ có tối đa một UserProfile" — creating a second one for the same
      // account must fail even for a fully-privileged actor.
      await request(app.getHttpServer())
        .post(`${API_PREFIX}/user-profiles`)
        .set('Authorization', bearer)
        .send({ accountId: account.accountId, fullName: 'Duplicate Profile' })
        .expect(409);

      await request(app.getHttpServer())
        .delete(`${API_PREFIX}/user-profiles/${account.userProfileId}`)
        .set('Authorization', bearer)
        .expect(204);
    });

    it('finds a profile by searching the local-format phone (identity-access stores it E.164)', async () => {
      const bearer = await adminBearer();
      const account = await createTestAccount();

      const res = await request(app.getHttpServer())
        .get(`${API_PREFIX}/user-profiles`)
        .set('Authorization', bearer)
        .query({ phone: account.phone })
        .expect(200);

      expect(res.body.items.some((item: { id: string }) => item.id === account.userProfileId)).toBe(true);
    });
  });

  describe('concurrent requests do not leak request context between accounts', () => {
    it('resolves each of several concurrent logins to its own account, never crossing subjects', async () => {
      const accounts = await Promise.all([
        createTestAccount(),
        createTestAccount(),
        createTestAccount(),
        createTestAccount(),
        createTestAccount(),
      ]);

      const responses = await Promise.all(
        accounts.map((account) => login(account.phone, account.password, 'PUBLIC').expect(200)),
      );

      const claims = await Promise.all(
        responses.map((res) => tokenService.verifyAccessToken(res.body.accessToken)),
      );

      claims.forEach((claim, index) => {
        expect(claim.subject).toBe(accounts[index]?.accountId);
      });
      // Every resolved subject must be distinct — a leaked/shared context would collapse these.
      expect(new Set(claims.map((c) => c.subject)).size).toBe(accounts.length);
    });
  });

  let cachedAdminBearer: string | undefined;
  async function adminBearer(): Promise<string> {
    if (cachedAdminBearer) {
      return cachedAdminBearer;
    }
    const admin = await createTestAccount('SUPER_ADMIN');
    const res = await login(admin.phone, admin.password, 'ADMIN').expect(200);
    cachedAdminBearer = `Bearer ${res.body.accessToken}`;
    return cachedAdminBearer;
  }
});

