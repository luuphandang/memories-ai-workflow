    private readonly repository: TypeOrmRepository<RolePermissionOrmEntity>,
    private readonly queryRunnerContext: TypeOrmQueryRunnerContext,
  ) {}

  private repositoryFor(): TypeOrmRepository<RolePermissionOrmEntity> {
    const queryRunner = this.queryRunnerContext.get();
    return queryRunner ? queryRunner.manager.getRepository(RolePermissionOrmEntity) : this.repository;
  }

  async grant(roleId: string, permissionId: string, actorId: string | null, now: Date): Promise<void> {
    await this.repositoryFor().upsert(
      { roleId, permissionId, createdBy: actorId, createdAt: now },
      { conflictPaths: ['roleId', 'permissionId'], skipUpdateIfNoValuesChanged: true },
    );
  }

  async revoke(roleId: string, permissionId: string): Promise<void> {
