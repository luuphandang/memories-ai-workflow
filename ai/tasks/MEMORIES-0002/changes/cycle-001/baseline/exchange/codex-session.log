import { UniqueEntityId } from '@memories/shared/kernel';
import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { IsNull, Repository as TypeOrmRepository } from 'typeorm';

import { UserProfile } from '../../domain/user-profile';
import {
  UserProfileListFilter,
  UserProfileRepository,
} from '../../domain/user-profile.repository';

import { UserProfileMapper } from './user-profile.mapper';
import { UserProfileOrmEntity } from './user-profile.orm-entity';

const SORT_COLUMN: Record<UserProfileListFilter['sortBy'], string> = {
  createdAt: 'created_at',
  updatedAt: 'updated_at',
  fullName: 'full_name',
};

@Injectable()
export class TypeOrmUserProfileRepository implements UserProfileRepository {
  private readonly mapper = new UserProfileMapper();

  constructor(
    @InjectRepository(UserProfileOrmEntity)
    private readonly repository: TypeOrmRepository<UserProfileOrmEntity>,
    private readonly queryRunnerContext: TypeOrmQueryRunnerContext,
  ) {}

  private repositoryFor(): TypeOrmRepository<UserProfileOrmEntity> {
    const queryRunner = this.queryRunnerContext.get();
    return queryRunner ? queryRunner.manager.getRepository(UserProfileOrmEntity) : this.repository;
  }

  async findById(id: UniqueEntityId): Promise<UserProfile | null> {
    const raw = await this.repositoryFor().findOne({
      where: { id: id.toValue(), deletedAt: IsNull() },
    });
    return raw ? this.mapper.toDomain(raw) : null;
  }

  async save(aggregate: UserProfile): Promise<void> {
    await this.repositoryFor().save(this.mapper.toPersistence(aggregate));
  }

  async delete(id: UniqueEntityId): Promise<void> {
    await this.repositoryFor().delete({ id: id.toValue() });
  }

  async findByAccountId(accountId: string): Promise<UserProfile | null> {
    const raw = await this.repositoryFor().findOne({ where: { accountId, deletedAt: IsNull() } });
    return raw ? this.mapper.toDomain(raw) : null;
  }

  async existsByAccountId(accountId: string): Promise<boolean> {
    const count = await this.repositoryFor().count({ where: { accountId, deletedAt: IsNull() } });
    return count > 0;
  }

  async list(filter: UserProfileListFilter): Promise<{ items: UserProfile[]; total: number }> {
    const qb = this.repositoryFor()
      .createQueryBuilder('profile')
      .where('profile.deleted_at IS NULL');

    if (filter.fullNameSearch) {
      qb.andWhere('profile.full_name ILIKE :fullNameSearch', {
        fullNameSearch: `%${filter.fullNameSearch}%`,
      });
    }
    if (filter.emailSearch) {
      qb.andWhere('profile.email ILIKE :emailSearch', { emailSearch: `%${filter.emailSearch}%` });
    }
    if (filter.accountIdsMatchingPhone) {
      qb.andWhere('profile.account_id IN (:...accountIds)', {
        accountIds: filter.accountIdsMatchingPhone,
      });
    }

    qb.orderBy(`profile.${SORT_COLUMN[filter.sortBy]}`, filter.sortDirection)
      .skip((filter.page - 1) * filter.pageSize)
      .take(filter.pageSize);

    const [rows, total] = await Promise.all([qb.getMany(), qb.getCount()]);
    return { items: rows.map((row) => this.mapper.toDomain(row)), total };
  }
}
