import { Mapper, UniqueEntityId } from '@memories/shared/kernel';

import { Account } from '../../domain/accounts/account';

import { AccountOrmEntity } from './account.orm-entity';

export class AccountMapper implements Mapper<Account, AccountOrmEntity> {
  toDomain(raw: AccountOrmEntity): Account {
    return Account.create(
      {
        status: raw.status,
        tokenVersion: raw.tokenVersion,
        createdBy: raw.createdBy,
        createdAt: raw.createdAt,
        updatedBy: raw.updatedBy,
        updatedAt: raw.updatedAt,
        deletedBy: raw.deletedBy,
        deletedAt: raw.deletedAt,
      },
      new UniqueEntityId(raw.id),
    );
  }

  toPersistence(domain: Account): AccountOrmEntity {
    const entity = new AccountOrmEntity();
    entity.id = domain.id.toValue();
    entity.status = domain.status;
    entity.tokenVersion = domain.tokenVersion;
    entity.createdBy = domain.audit.createdBy;
    entity.createdAt = domain.audit.createdAt;
    entity.updatedBy = domain.audit.updatedBy;
    entity.updatedAt = domain.audit.updatedAt;
    entity.deletedBy = domain.audit.deletedBy;
    entity.deletedAt = domain.audit.deletedAt;
    return entity;
  }

  toDto(domain: Account) {
    return { id: domain.id.toValue(), status: domain.status };
  }
}
