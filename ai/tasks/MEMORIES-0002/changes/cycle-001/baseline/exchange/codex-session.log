 * is an admin-portal operation — `@RequirePortal('ADMIN')` rejects a token issued for the PUBLIC
 * portal even if the same Account also holds `account.*` permissions (AC #23, task.md §13
 * "Token phát cho PUBLIC không được tự động sử dụng để truy cập ADMIN nếu audience/portal không
 * hợp lệ"). Must run after `JwtAuthGuard` (needs `request.user.portal`) and before
 * `PermissionsGuard`.
 */
@ApiTags('accounts')
@ApiBearerAuth()
@UseGuards(JwtAuthGuard, PortalGuard, PermissionsGuard)
@RequirePortal('ADMIN')
@Controller('accounts')
export class AccountController {
  constructor(
    private readonly createAccount: CreateAccountUseCase,
    private readonly getAccount: GetAccountUseCase,
    private readonly listAccounts: ListAccountsUseCase,
    private readonly updateAccount: UpdateAccountUseCase,
    private readonly changeAccountStatus: ChangeAccountStatusUseCase,
    private readonly changeAccountPhone: ChangeAccountPhoneUseCase,
    private readonly changeAccountPassword: ChangeAccountPasswordUseCase,
    private readonly deleteAccount: DeleteAccountUseCase,
  ) {}

  @Post()
  @RequirePermissions('account.create')
  @ApiResponse({ status: HttpStatus.CREATED, type: CreateAccountResponseDto })
  async create(
    @CurrentUser() user: RequestUser,
    @Body() dto: CreateAccountDto,
  ): Promise<CreateAccountResponseDto> {
    return this.createAccount.execute({
      phone: dto.phone,
      password: dto.password,
      fullName: dto.fullName,
      email: dto.email,
      dateOfBirth: dto.dateOfBirth ? new Date(dto.dateOfBirth) : undefined,
      address: dto.address,
      avatarId: dto.avatarId,
      actorId: user.id,
    });
  }

  @Get()
  @RequirePermissions('account.read')
  @ApiResponse({ status: HttpStatus.OK, type: ListAccountsResponseDto })
  async list(@Query() query: ListAccountsQueryDto): Promise<ListAccountsResponseDto> {
    const result = await this.listAccounts.execute({
      status: query.status,
      provider: query.provider,
      phoneSearch: query.phone,
      page: query.page,
      pageSize: query.pageSize,
      sortBy: query.sortBy,
      sortDirection: query.sortDirection,
    });
    return {
      items: result.items.map(toAccountResponseDto),
      total: result.total,
      page: result.page,
      pageSize: result.pageSize,
      totalPages: result.totalPages,
