import { createAuditableProps } from '@memories/shared/kernel';

import { UserProfile } from '../src/domain/user-profile';

const NOW = new Date('2026-01-01T00:00:00Z');

function buildProfile(): UserProfile {
  return UserProfile.create({
    accountId: 'account-1',
    fullName: 'Nguyen Van A',
    email: null,
    avatarId: null,
    dateOfBirth: null,
    address: null,
    ...createAuditableProps(null, NOW),
  });
}

describe('UserProfile', () => {
  it('rejects creation with a blank full name', () => {
    expect(() =>
      UserProfile.create({
        accountId: 'account-1',
        fullName: '   ',
        email: null,
        avatarId: null,
        dateOfBirth: null,
        address: null,
        ...createAuditableProps(null, NOW),
      }),
    ).toThrow(/full name/i);
  });

  it('updates only the fields provided, leaving the rest untouched', () => {
    const profile = buildProfile();
    const later = new Date('2026-01-02T00:00:00Z');

    profile.update({ email: 'user@example.com' }, 'admin-1', later);

    expect(profile.email).toBe('user@example.com');
    expect(profile.fullName).toBe('Nguyen Van A');
    expect(profile.audit.updatedBy).toBe('admin-1');
  });

  it('rejects updating to a blank full name', () => {
    const profile = buildProfile();
    expect(() => profile.update({ fullName: '  ' }, null, NOW)).toThrow(/full name/i);
  });

  it('can clear a nullable field back to null via update', () => {
    const profile = buildProfile();
    profile.update({ address: '123 Main St' }, null, NOW);

    profile.update({ address: null }, null, NOW);

    expect(profile.address).toBeNull();
  });

  it('rejects deleting an already-deleted profile', () => {
    const profile = buildProfile();
    profile.softDelete('admin-1', NOW);

    expect(() => profile.softDelete('admin-1', NOW)).toThrow(/already deleted/);
  });
});
