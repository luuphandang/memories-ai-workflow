+/** No `cookie-parser` middleware is registered app-wide (nothing else needs `req.cookies`), so the
+ * refresh cookie is read directly off the raw `Cookie` header instead of adding a new dependency
+ * for a single lookup. */
+export function readRefreshCookie(cookieHeader: string | undefined, config: AuthConfig): string | undefined {
+  if (!cookieHeader) {
+    return undefined;
+  }
+  for (const part of cookieHeader.split(';')) {
+    const separatorIndex = part.indexOf('=');
+    if (separatorIndex === -1) {
+      continue;
+    }
+    const name = part.slice(0, separatorIndex).trim();
+    if (name === config.refreshCookie.name) {
+      return decodeURIComponent(part.slice(separatorIndex + 1).trim());
+    }
+  }
+  return undefined;
+}
