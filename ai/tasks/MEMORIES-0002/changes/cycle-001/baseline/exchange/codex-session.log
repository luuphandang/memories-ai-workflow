import { Column } from 'typeorm';

/**
 * Mixed into a module's own `@Entity` class via plain class inheritance (TypeORM maps parent-class
 * `@Column`s the same as the subclass's own — no `@Entity`/`TableInheritance` needed on this base).
 * Centralizes the six audit columns (§6) so individual modules never redeclare them. `timestamptz`
 * so timestamps stay timezone-aware regardless of the DB server's local timezone setting.
 */
export abstract class AuditableOrmEntity {
  @Column({ name: 'created_by', type: 'uuid', nullable: true })
  createdBy!: string | null;

  @Column({ name: 'created_at', type: 'timestamptz' })
  createdAt!: Date;

  @Column({ name: 'updated_by', type: 'uuid', nullable: true })
  updatedBy!: string | null;

  @Column({ name: 'updated_at', type: 'timestamptz' })
  updatedAt!: Date;

  @Column({ name: 'deleted_by', type: 'uuid', nullable: true })
  deletedBy!: string | null;

  @Column({ name: 'deleted_at', type: 'timestamptz', nullable: true })
  deletedAt!: Date | null;
}
/** Shared audit trail shape mixed into an aggregate's own props (§6 of MEMORIES-0002). Only add
 * here once at least two modules need it — identity-access and user-profiles both do. */
export interface AuditableProps {
  createdBy: string | null;
  createdAt: Date;
  updatedBy: string | null;
  updatedAt: Date;
  deletedBy: string | null;
  deletedAt: Date | null;
}

/** `actorId` is null for system/background actors (worker, scheduler, CLI) — see request context
 * system-actor distinction (§14). Aggregates mutate their own audit fields in place afterwards
 * (see `Account.touch`) rather than through further helpers here, matching this codebase's
 * existing entity-mutation convention (`MediaAsset.markReady` etc. mutate `this.props` directly). */
export function createAuditableProps(actorId: string | null, now: Date): AuditableProps {
  return {
    createdBy: actorId,
    createdAt: now,
    updatedBy: actorId,
    updatedAt: now,
    deletedBy: null,
    deletedAt: null,
  };
}

export function isAuditablePropsDeleted(props: AuditableProps): boolean {
  return props.deletedAt !== null;
}
import {
  AggregateRoot,
  AuditableProps,
  DomainError,
  UniqueEntityId,
} from '@memories/shared/kernel';

import { AccountStatus } from './account-status';

export interface AccountProps extends AuditableProps {
  status: AccountStatus;
  /** Bumped on password change / forced logout so previously issued access tokens can be
   * invalidated without a server-side session store (§13 "token version"). */
  tokenVersion: number;
}

/**
 * The single login identity shared by public-web and admin-web (task.md "Background"). Deliberately
 * carries NO profile data (name/email/address) — that lives in `user-profiles`' `UserProfile` — and
 * NO credential (that lives in `AuthIdentity`); `Account` is only identity + status + authz anchor.
 */
export class Account extends AggregateRoot<AccountProps> {
  static create(props: AccountProps, id?: UniqueEntityId): Account {
    return new Account(props, id);
  }

  get status(): AccountStatus {
    return this.props.status;
  }

  get tokenVersion(): number {
    return this.props.tokenVersion;
  }

  get audit(): AuditableProps {
    return this.props;
  }

  get isDeleted(): boolean {
    return this.props.deletedAt !== null;
  }

  /** Account inactive, locked or deleted must not authenticate or refresh (task.md §2/§9/§13). */
  canAuthenticate(): boolean {
    return this.props.status === AccountStatus.Active && !this.isDeleted;
  }

  activate(actorId: string | null, now: Date): void {
    this.props.status = AccountStatus.Active;
    this.touch(actorId, now);
  }

  lock(actorId: string | null, now: Date): void {
    this.props.status = AccountStatus.Locked;
    this.touch(actorId, now);
  }

  deactivate(actorId: string | null, now: Date): void {
    this.props.status = AccountStatus.Inactive;
    this.touch(actorId, now);
  }

  /** Bumps `tokenVersion` so access tokens issued before this call can be treated as stale by
   * anything that checks it (§13 permission/token version mechanism). */
  incrementTokenVersion(actorId: string | null, now: Date): void {
    this.props.tokenVersion += 1;
    this.touch(actorId, now);
  }

  softDelete(actorId: string | null, now: Date): void {
    if (this.isDeleted) {
      throw DomainError.conflict(
        'account_already_deleted',
        `Account ${this._id.toString()} is already deleted`,
      );
    }
    this.props.deletedBy = actorId;
    this.props.deletedAt = now;
    this.touch(actorId, now);
  }

  private touch(actorId: string | null, now: Date): void {
    this.props.updatedBy = actorId;
    this.props.updatedAt = now;
  }
}
import { AggregateRoot, AuditableProps, DomainError, UniqueEntityId } from '@memories/shared/kernel';

import { AuthProvider } from './auth-provider';

export interface AuthIdentityProps extends AuditableProps {
  accountId: string;
  provider: AuthProvider;
  /** Normalized login identifier for the provider — the E.164 phone number for `LOCAL`. Null for
   * social providers, which are looked up by `providerSubject` instead. */
  identifier: string | null;
  /** The provider's own user id (e.g. Google `sub`) — null for `LOCAL`. */
  providerSubject: string | null;
  /** Required for `LOCAL`, null for every social provider (never a plaintext password). */
  passwordHash: string | null;
  verifiedAt: Date | null;
}

/**
 * One login method for an `Account` (§3). An Account can have several — one per provider it has
 * linked — but only `LOCAL` is exercised end-to-end in this epic.
 */
export class AuthIdentity extends AggregateRoot<AuthIdentityProps> {
  static create(props: AuthIdentityProps, id?: UniqueEntityId): AuthIdentity {
    if (props.provider === AuthProvider.Local) {
      if (!props.identifier) {
        throw DomainError.validation('phone_required', 'LOCAL auth identity requires a phone identifier');
      }
      if (!props.passwordHash) {
        throw DomainError.validation('password_required', 'LOCAL auth identity requires a password hash');
      }
    }
    return new AuthIdentity(props, id);
  }

  get accountId(): string {
    return this.props.accountId;
  }

  get provider(): AuthProvider {
    return this.props.provider;
  }

  get identifier(): string | null {
    return this.props.identifier;
  }

  get providerSubject(): string | null {
    return this.props.providerSubject;
  }

  get passwordHash(): string | null {
    return this.props.passwordHash;
  }

  get verifiedAt(): Date | null {
    return this.props.verifiedAt;
  }

  get audit(): AuditableProps {
    return this.props;
  }

  get isDeleted(): boolean {
    return this.props.deletedAt !== null;
  }

  changePasswordHash(passwordHash: string, actorId: string | null, now: Date): void {
    if (this.props.provider !== AuthProvider.Local) {
      throw DomainError.businessRule(
        'password_change_not_supported',
        `Auth identity provider "${this.props.provider}" does not support password changes`,
      );
    }
    this.props.passwordHash = passwordHash;
    this.touch(actorId, now);
  }

  changeIdentifier(identifier: string, actorId: string | null, now: Date): void {
    if (this.props.provider !== AuthProvider.Local) {
      throw DomainError.businessRule(
        'identifier_change_not_supported',
        `Auth identity provider "${this.props.provider}" does not support changing the identifier`,
      );
    }
    this.props.identifier = identifier;
    this.touch(actorId, now);
  }

  softDelete(actorId: string | null, now: Date): void {
    this.props.deletedBy = actorId;
    this.props.deletedAt = now;
    this.touch(actorId, now);
  }

  private touch(actorId: string | null, now: Date): void {
    this.props.updatedBy = actorId;
    this.props.updatedAt = now;
  }
}
import { AggregateRoot, UniqueEntityId } from '@memories/shared/kernel';

import { Portal } from './portal';

export interface RefreshSessionProps {
  accountId: string;
  portal: Portal;
  authProvider: string;
  ipAddress: string | null;
  userAgent: string | null;
  issuedAt: Date;
  expiresAt: Date;
  revokedAt: Date | null;
  /** Set when this session was rotated into a newer one on refresh, so a stolen/replayed old
   * refresh token can be told apart from one that merely expired. */
  replacedBySessionId: string | null;
}

/**
 * One issued refresh token's server-side record (§13). The JWT refresh token itself stays
 * stateless (verified by signature via `TokenService`) — this row is what makes it *revocable*:
 * "Xóa hoặc khóa Account làm mất hiệu lực session hiện tại" (AC #32) requires something to flip.
 * `id` IS the `sessionId` claim embedded in both the access and refresh JWTs (§13).
 */
export class RefreshSession extends AggregateRoot<RefreshSessionProps> {
  static create(props: RefreshSessionProps, id?: UniqueEntityId): RefreshSession {
    return new RefreshSession(props, id);
  }

  get accountId(): string {
    return this.props.accountId;
  }

  get portal(): Portal {
    return this.props.portal;
  }

  get authProvider(): string {
    return this.props.authProvider;
  }

  get ipAddress(): string | null {
    return this.props.ipAddress;
  }

  get userAgent(): string | null {
    return this.props.userAgent;
  }

  get issuedAt(): Date {
    return this.props.issuedAt;
  }

  get expiresAt(): Date {
    return this.props.expiresAt;
  }

  get revokedAt(): Date | null {
    return this.props.revokedAt;
  }

  get replacedBySessionId(): string | null {
    return this.props.replacedBySessionId;
  }

  isActive(now: Date): boolean {
    return this.props.revokedAt === null && this.props.expiresAt.getTime() > now.getTime();
  }

  revoke(now: Date, replacedBySessionId?: string): void {
    this.props.revokedAt = now;
    if (replacedBySessionId !== undefined) {
      this.props.replacedBySessionId = replacedBySessionId;
    }
  }
}
