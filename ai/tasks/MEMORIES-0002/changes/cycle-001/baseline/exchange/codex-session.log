import { UNIT_OF_WORK } from '@memories/platform/database';
import { CLOCK, Clock, DomainError, UnitOfWork, UseCase } from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

import {
  AUTH_IDENTITY_REPOSITORY,
  AuthIdentityRepository,
} from '../../domain/auth-identities/auth-identity.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import { PHONE_NORMALIZER, PhoneNormalizerPort } from '../ports/phone-normalizer.port';

export interface ChangeAccountPhoneInput {
  accountId: string;
  newPhone: string;
  actorId: string | null;
}

/** §16 `PATCH /accounts/:accountId/phone` — dedicated endpoint (not the generic update DTO) so
 * uniqueness is always re-checked against the normalized number. */
@Injectable()
export class ChangeAccountPhoneUseCase implements UseCase<ChangeAccountPhoneInput, void> {
  constructor(
    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,
    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(CLOCK) private readonly clock: Clock,
    private readonly configService: ConfigService,
  ) {}

  async execute(input: ChangeAccountPhoneInput): Promise<void> {
    await this.unitOfWork.withTransaction(async () => {
      const auth = this.configService.getOrThrow<AuthConfig>('auth');
      const phone = this.phoneNormalizer.normalize(input.newPhone, auth.phone.defaultRegion);

      const identities = await this.authIdentities.findAllByAccountId(input.accountId);
      const localIdentity = identities.find((identity) => identity.provider === AuthProvider.Local);
      if (!localIdentity) {
        throw DomainError.notFound(
          'local_auth_identity_not_found',
          `Account ${input.accountId} has no LOCAL auth identity`,
        );
      }

      if (localIdentity.identifier !== phone.value) {
        const exists = await this.authIdentities.existsByProviderAndIdentifier(AuthProvider.Local, phone.value);
        if (exists) {
          throw DomainError.conflict('phone_already_exists', `Phone ${phone.value} is already registered`);
        }
      }

      localIdentity.changeIdentifier(phone.value, input.actorId, this.clock.now());
      await this.authIdentities.save(localIdentity);
    });
  }
}

