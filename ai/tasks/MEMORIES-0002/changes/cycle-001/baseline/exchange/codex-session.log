import { TypeOrmQueryRunnerContext } from '@memories/platform/database';
import { UniqueEntityId } from '@memories/shared/kernel';
import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { IsNull, Repository as TypeOrmRepository } from 'typeorm';

import { Account } from '../../domain/accounts/account';
import {
  AccountListFilter,
  AccountListItem,
  AccountRepository,
} from '../../domain/accounts/account.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';

import { AccountMapper } from './account.mapper';
import { AccountOrmEntity } from './account.orm-entity';
import { AuthIdentityOrmEntity } from './auth-identity.orm-entity';

@Injectable()
export class TypeOrmAccountRepository implements AccountRepository {
  private readonly mapper = new AccountMapper();

  constructor(
    @InjectRepository(AccountOrmEntity)
    private readonly repository: TypeOrmRepository<AccountOrmEntity>,
    private readonly queryRunnerContext: TypeOrmQueryRunnerContext,
  ) {}

  private repositoryFor(): TypeOrmRepository<AccountOrmEntity> {
    const queryRunner = this.queryRunnerContext.get();
    return queryRunner ? queryRunner.manager.getRepository(AccountOrmEntity) : this.repository;
  }

  async findById(id: UniqueEntityId): Promise<Account | null> {
    const raw = await this.repositoryFor().findOne({
      where: { id: id.toValue(), deletedAt: IsNull() },
    });
    return raw ? this.mapper.toDomain(raw) : null;
  }

  async findByIdIncludingDeleted(id: UniqueEntityId): Promise<Account | null> {
    const raw = await this.repositoryFor().findOne({ where: { id: id.toValue() } });
    return raw ? this.mapper.toDomain(raw) : null;
  }

  async save(aggregate: Account): Promise<void> {
    await this.repositoryFor().save(this.mapper.toPersistence(aggregate));
  }

  async delete(id: UniqueEntityId): Promise<void> {
    await this.repositoryFor().delete({ id: id.toValue() });
  }

  async list(filter: AccountListFilter): Promise<{ items: AccountListItem[]; total: number }> {
    const qb = this.repositoryFor()
      .createQueryBuilder('account')
      .leftJoin(
        AuthIdentityOrmEntity,
        'localIdentity',
        'localIdentity.account_id = account.id AND localIdentity.provider = :localProvider AND localIdentity.deleted_at IS NULL',
        { localProvider: AuthProvider.Local },
      )
      .addSelect('localIdentity.identifier', 'phone')
      .where('account.deleted_at IS NULL');

    if (filter.status) {
      qb.andWhere('account.status = :status', { status: filter.status });
    }
    if (filter.provider) {
      qb.andWhere('localIdentity.provider = :provider', { provider: filter.provider });
    }
    if (filter.phoneSearch) {
      qb.andWhere('localIdentity.identifier ILIKE :phoneSearch', {
        phoneSearch: `%${filter.phoneSearch}%`,
      });
    }

    // Must be the entity property path (`createdAt`), not the raw DB column name
    // (`created_at`): this query combines a join with `skip`/`take`, which routes TypeORM
    // through its DISTINCT-subquery pagination strategy — that strategy resolves each `orderBy`
    // alias/property pair against entity metadata via `findColumnWithPropertyPath`, which only
    // recognizes JS property names and crashes (`Cannot read properties of undefined (reading
    // 'databaseName')`) on a raw snake_case column name.
    const sortColumn = filter.sortBy === 'updatedAt' ? 'account.updatedAt' : 'account.createdAt';
    qb.orderBy(sortColumn, filter.sortDirection)
      .skip((filter.page - 1) * filter.pageSize)
      .take(filter.pageSize);

    const [rows, total] = await Promise.all([qb.getRawAndEntities(), qb.getCount()]);

    const items = rows.entities.map((entity, index) => ({
      account: this.mapper.toDomain(entity),
      phone: (rows.raw[index]?.phone as string | null | undefined) ?? null,
    }));

    return { items, total };
  }
}
