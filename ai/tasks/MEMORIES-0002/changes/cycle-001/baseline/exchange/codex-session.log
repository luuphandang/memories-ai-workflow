import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import {
  AUTH_IDENTITY_REPOSITORY,
  AuthIdentityRepository,
} from '../../domain/auth-identities/auth-identity.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import {
  REFRESH_SESSION_REPOSITORY,
  RefreshSessionRepository,
} from '../../domain/sessions/refresh-session.repository';
import { PASSWORD_HASHER, PasswordHasher } from '../ports/password-hasher.port';

export interface ChangeAccountPasswordInput {
  accountId: string;
  newPassword: string;
  actorId: string | null;
}

/** §16 `PATCH /accounts/:accountId/password` (also used for admin-triggered reset). Revokes every
 * outstanding session and bumps `Account.tokenVersion` (§13) — standard hygiene after a password
 * change/reset, forcing re-login everywhere else the Account is currently signed in. */
@Injectable()
export class ChangeAccountPasswordUseCase implements UseCase<ChangeAccountPasswordInput, void> {
  constructor(
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,
    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,
    @Inject(PASSWORD_HASHER) private readonly passwordHasher: PasswordHasher,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: ChangeAccountPasswordInput): Promise<void> {
    await this.unitOfWork.withTransaction(async () => {
      const now = this.clock.now();

      const account = await this.accounts.findById(new UniqueEntityId(input.accountId));
      if (!account) {
        throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);
      }

      const identities = await this.authIdentities.findAllByAccountId(input.accountId);
      const localIdentity = identities.find((identity) => identity.provider === AuthProvider.Local);
      if (!localIdentity) {
        throw DomainError.notFound(
          'local_auth_identity_not_found',
          `Account ${input.accountId} has no LOCAL auth identity`,
        );
      }

      const passwordHash = await this.passwordHasher.hash(input.newPassword);
      localIdentity.changePasswordHash(passwordHash, input.actorId, now);
      await this.authIdentities.save(localIdentity);

      account.incrementTokenVersion(input.actorId, now);
      await this.accounts.save(account);

      await this.refreshSessions.revokeAllForAccount(input.accountId, now);
    });
  }
}
