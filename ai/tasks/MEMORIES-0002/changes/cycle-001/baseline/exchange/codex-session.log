import { UNIT_OF_WORK } from '@memories/platform/database';
import {
  PermissionChecker,
  PERMISSION_CHECKER,
  TokenService,
  TOKEN_SERVICE,
  UserProfileLookup,
  USER_PROFILE_LOOKUP,
} from '@memories/platform/security';
import {
  CLOCK,
  Clock,
  ID_GENERATOR,
  IdGenerator,
  UniqueEntityId,
  UnitOfWork,
  UseCase,
} from '@memories/shared/kernel';
import { ForbiddenException, Inject, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import { PORTAL_PERMISSION, Portal } from '../../domain/sessions/portal';
import { RefreshSession } from '../../domain/sessions/refresh-session';
import {
  REFRESH_SESSION_REPOSITORY,
  RefreshSessionRepository,
} from '../../domain/sessions/refresh-session.repository';
import { AuthenticationProviderRegistry } from '../ports/authentication-provider.port';
import { PHONE_NORMALIZER, PhoneNormalizerPort } from '../ports/phone-normalizer.port';

export interface LoginInput {
  phone: string;
  password: string;
  portal: Portal;
  ipAddress: string | null;
  userAgent: string | null;
}

export interface LoginOutput {
  accountId: string;
  accessToken: string;
  refreshToken: string;
  refreshTokenExpiresAt: Date;
  portal: Portal;
  sessionId: string;
  roles: string[];
  permissions: string[];
}

/**
 * §9/§10: authentication (credential + Account status) is fully separated from portal
 * authorization (permission check via the same `PermissionChecker` port every other protected
 * route uses) — never `if (role === 'ADMIN')`. Portal mismatch or missing permission => no
 * RefreshSession, no token, same as a failed credential check but with a distinguishable message
 * (api-contract.md error mapping).
 */
@Injectable()
export class LoginUseCase implements UseCase<LoginInput, LoginOutput> {
  constructor(
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,
    @Inject(PERMISSION_CHECKER) private readonly permissionChecker: PermissionChecker,
    @Inject(USER_PROFILE_LOOKUP) private readonly userProfileLookup: UserProfileLookup,
    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,
    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,
    @Inject(CLOCK) private readonly clock: Clock,
    private readonly authenticationProviders: AuthenticationProviderRegistry,
    private readonly configService: ConfigService,
  ) {}

  async execute(input: LoginInput): Promise<LoginOutput> {
    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    const phone = this.phoneNormalizer.normalize(input.phone, auth.phone.defaultRegion);

    // Same generic failure for "phone not found" and "wrong password" (task.md §9 — no account
    // enumeration) — the provider itself throws a uniform UnauthorizedException for both.
    const { accountId } = await this.authenticationProviders
      .resolve(AuthProvider.Local)
      .authenticate({ provider: AuthProvider.Local, identifier: phone.value, plainPassword: input.password });

    const account = await this.accounts.findById(new UniqueEntityId(accountId));
    if (!account || !account.canAuthenticate()) {
      throw new ForbiddenException('Account is not active');
    }

    const requiredPermission = PORTAL_PERMISSION[input.portal];
    const hasPortalAccess = await this.permissionChecker.hasPermissions(accountId, [requiredPermission]);
    if (!hasPortalAccess) {
      throw new ForbiddenException(`Account does not have access to the ${input.portal} portal`);
    }

    const resolved = await this.permissionChecker.resolvePermissions(accountId);
    const userProfileId = await this.userProfileLookup.findProfileIdByAccountId(accountId);

    const sessionId = new UniqueEntityId(this.idGenerator.generate());
    const now = this.clock.now();

    return this.unitOfWork.withTransaction(async () => {
      const [accessIssued, refreshIssued] = await Promise.all([
        this.tokenService.issueAccessToken({
          subject: accountId,
          sessionId: sessionId.toValue(),
          portal: input.portal,
          authProvider: AuthProvider.Local,
          userProfileId: userProfileId ?? undefined,
        }),
        this.tokenService.issueRefreshToken({
          subject: accountId,
          sessionId: sessionId.toValue(),
          portal: input.portal,
        }),
      ]);

      const session = RefreshSession.create(
        {
          accountId,
          portal: input.portal,
          authProvider: AuthProvider.Local,
          ipAddress: input.ipAddress,
          userAgent: input.userAgent,
          issuedAt: now,
          expiresAt: refreshIssued.expiresAt,
          revokedAt: null,
          replacedBySessionId: null,
        },
        sessionId,
      );
      await this.refreshSessions.save(session);

      return {
        accountId,
        accessToken: accessIssued.token,
        refreshToken: refreshIssued.token,
        refreshTokenExpiresAt: refreshIssued.expiresAt,
        portal: input.portal,
        sessionId: sessionId.toValue(),
        roles: resolved.roles,
        permissions: resolved.permissions,
      };
    });
  }
