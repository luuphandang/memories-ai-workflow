import { USER_PROFILE_REPOSITORY, UserProfileRepository } from '../../domain/user-profile.repository';

import { toOutput, UserProfileOutput } from './create-user-profile.use-case';

export interface UpdateUserProfileInput {
  userProfileId: string;
  fullName?: string | undefined;
  email?: string | null | undefined;
  dateOfBirth?: Date | null | undefined;
  address?: string | null | undefined;
  avatarId?: string | null | undefined;
  actorId: string | null;
}

/** §17 `PATCH /user-profiles/:userProfileId` — `accountId` is never accepted here (task.md "Không
 * cho client đổi accountId qua update DTO"). */
@Injectable()
export class UpdateUserProfileUseCase implements UseCase<UpdateUserProfileInput, UserProfileOutput> {
  constructor(
    @Inject(USER_PROFILE_REPOSITORY) private readonly userProfiles: UserProfileRepository,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: UpdateUserProfileInput): Promise<UserProfileOutput> {
    const profile = await this.userProfiles.findById(new UniqueEntityId(input.userProfileId));
    if (!profile) {
      throw DomainError.notFound('user_profile_not_found', `UserProfile ${input.userProfileId} was not found`);
    }

    profile.update(
      {
        fullName: input.fullName,
        email: input.email === undefined ? undefined : (input.email?.toLowerCase() ?? null),
        dateOfBirth: input.dateOfBirth,
        address: input.address,
        avatarId: input.avatarId,
      },
      input.actorId,
      this.clock.now(),
    );
    await this.userProfiles.save(profile);

    return toOutput(profile);
  }
}
