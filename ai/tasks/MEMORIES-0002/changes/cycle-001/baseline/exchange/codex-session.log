import { DomainError, ValueObject } from '@memories/shared/kernel';

export interface PhoneNumberProps extends Record<string, unknown> {
  /** Always E.164 (`+<countrycode><subscriber>`), the canonical form stored on `AuthIdentity.
   * identifier` and used for lookups/uniqueness (task.md §3 "identifier là số điện thoại đã
   * normalize"). */
  e164: string;
}

/**
 * A normalized phone number. Construction itself does the normalizing (via the `normalize`
 * function passed in — kept out of the domain layer's own dependencies, since libphonenumber-js
 * normalization is an infrastructure concern; `domain` must not depend on it directly) — see
 * `infrastructure/security/phone-normalizer.ts` for the concrete implementation and
 * `LocalAuthenticationProvider`/`CreateAccountUseCase` for where it's invoked.
 */
export class PhoneNumber extends ValueObject<PhoneNumberProps> {
  private constructor(props: PhoneNumberProps) {
    super(props);
  }

  static fromE164(e164: string): PhoneNumber {
    if (!/^\+[1-9]\d{6,14}$/.test(e164)) {
      throw DomainError.validation('invalid_phone_number', `"${e164}" is not a valid E.164 phone number`);
    }
    return new PhoneNumber({ e164 });
  }

  get value(): string {
    return this.props.e164;
  }
}
