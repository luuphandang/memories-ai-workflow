import { TokenService, TOKEN_SERVICE } from '@memories/platform/security';
import {
  CLOCK,
  Clock,
  ID_GENERATOR,
  IdGenerator,
  UniqueEntityId,
  UnitOfWork,
  UseCase,
} from '@memories/shared/kernel';
import { ForbiddenException, Inject, Injectable, UnauthorizedException } from '@nestjs/common';

import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import { Portal } from '../../domain/sessions/portal';
import { RefreshSession } from '../../domain/sessions/refresh-session';
import {
  REFRESH_SESSION_REPOSITORY,
  RefreshSessionRepository,
} from '../../domain/sessions/refresh-session.repository';

export interface RefreshSessionInput {
  refreshToken: string;
  ipAddress: string | null;
  userAgent: string | null;
}

export interface RefreshSessionOutput {
  accessToken: string;
  refreshToken: string;
  refreshTokenExpiresAt: Date;
  portal: Portal;
  sessionId: string;
}

/**
 * Rotates the refresh token on every use (docs/guides/authentication-flow.md): the old
 * `RefreshSession` is revoked and points at the new one via `replacedBySessionId`, so a replayed
 * old refresh token (e.g. stolen and used after the legitimate client already rotated) can be
 * told apart from a session that merely expired — both fail, but this is what makes theft
 * detectable in the session table rather than silently accepted.
 */
@Injectable()
export class RefreshSessionUseCase implements UseCase<RefreshSessionInput, RefreshSessionOutput> {
  constructor(
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(REFRESH_SESSION_REPOSITORY) private readonly refreshSessions: RefreshSessionRepository,
    @Inject(TOKEN_SERVICE) private readonly tokenService: TokenService,
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: RefreshSessionInput): Promise<RefreshSessionOutput> {
    let claims;
    try {
      claims = await this.tokenService.verifyRefreshToken(input.refreshToken);
    } catch {
      throw new UnauthorizedException('Invalid or expired refresh token');
    }

    const sessionId = typeof claims.sessionId === 'string' ? claims.sessionId : undefined;
    const portal = typeof claims.portal === 'string' ? (claims.portal as Portal) : undefined;
    if (!sessionId || !portal) {
      throw new UnauthorizedException('Malformed refresh token');
    }

    const now = this.clock.now();
    const currentSession = await this.refreshSessions.findById(new UniqueEntityId(sessionId));
    if (!currentSession || !currentSession.isActive(now)) {
      throw new UnauthorizedException('Refresh session is no longer active');
    }

    const account = await this.accounts.findById(new UniqueEntityId(claims.subject));
    if (!account || !account.canAuthenticate()) {
      currentSession.revoke(now);
      await this.refreshSessions.save(currentSession);
      throw new ForbiddenException('Account is not active');
    }

    return this.unitOfWork.withTransaction(async () => {
      const newSessionId = new UniqueEntityId(this.idGenerator.generate());

      const [accessIssued, refreshIssued] = await Promise.all([
        this.tokenService.issueAccessToken({
          subject: claims.subject,
          sessionId: newSessionId.toValue(),
          portal,
          authProvider: AuthProvider.Local,
        }),
        this.tokenService.issueRefreshToken({
          subject: claims.subject,
          sessionId: newSessionId.toValue(),
          portal,
        }),
      ]);

      currentSession.revoke(now, newSessionId.toValue());
      await this.refreshSessions.save(currentSession);

      const newSession = RefreshSession.create(
        {
          accountId: claims.subject,
          portal,
          authProvider: AuthProvider.Local,
          ipAddress: input.ipAddress,
          userAgent: input.userAgent,
          issuedAt: now,
          expiresAt: refreshIssued.expiresAt,
          revokedAt: null,
          replacedBySessionId: null,
        },
        newSessionId,
      );
      await this.refreshSessions.save(newSession);

      return {
        accessToken: accessIssued.token,
        refreshToken: refreshIssued.token,
        refreshTokenExpiresAt: refreshIssued.expiresAt,
        portal,
        sessionId: newSessionId.toValue(),
      };
    });
  }
}
