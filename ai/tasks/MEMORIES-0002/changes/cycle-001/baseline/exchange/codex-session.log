import { ExecutionContext } from '@nestjs/common';

import { PortalGuard } from '../src/portal.guard';

function buildContext(user: { portal?: string } | undefined): ExecutionContext {
  const request = { user };
  return {
    switchToHttp: () => ({ getRequest: () => request }),
    getHandler: () => undefined,
    getClass: () => undefined,
  } as unknown as ExecutionContext;
}

describe('PortalGuard', () => {
  it('allows the request when no @RequirePortal metadata is declared', () => {
    const reflector = { getAllAndOverride: jest.fn().mockReturnValue(undefined) };
    const guard = new PortalGuard(reflector as never);

    expect(guard.canActivate(buildContext({ portal: 'PUBLIC' }))).toBe(true);
  });

  it('allows a request whose token portal matches the required portal', () => {
    const reflector = { getAllAndOverride: jest.fn().mockReturnValue('ADMIN') };
    const guard = new PortalGuard(reflector as never);

    expect(guard.canActivate(buildContext({ portal: 'ADMIN' }))).toBe(true);
  });

  it('rejects a PUBLIC-portal token on an ADMIN-only route, even if permissions would otherwise pass', () => {
    const reflector = { getAllAndOverride: jest.fn().mockReturnValue('ADMIN') };
    const guard = new PortalGuard(reflector as never);

    expect(guard.canActivate(buildContext({ portal: 'PUBLIC' }))).toBe(false);
  });

  it('rejects when there is no authenticated user at all', () => {
    const reflector = { getAllAndOverride: jest.fn().mockReturnValue('ADMIN') };
    const guard = new PortalGuard(reflector as never);

    expect(guard.canActivate(buildContext(undefined))).toBe(false);
  });
