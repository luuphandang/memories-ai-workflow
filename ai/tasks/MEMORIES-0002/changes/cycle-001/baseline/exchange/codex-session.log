describe('CreateUserProfileUseCase', () => {
  it('rejects creating a profile for an Account that does not exist', async () => {
    const { useCase, accountLookup, userProfiles } = buildUseCase();
    accountLookup.exists.mockResolvedValue(false);

    await expect(
      useCase.execute({ accountId: 'ghost', fullName: 'A', actorId: null }),
    ).rejects.toThrow(/was not found/);
    expect(userProfiles.save).not.toHaveBeenCalled();
  });

  it('rejects creating a second profile for the same Account', async () => {
    const { useCase, accountLookup, userProfiles } = buildUseCase();
    accountLookup.exists.mockResolvedValue(true);
    userProfiles.existsByAccountId.mockResolvedValue(true);

    await expect(
      useCase.execute({ accountId: 'account-1', fullName: 'A', actorId: null }),
    ).rejects.toThrow(/already has a UserProfile/);
    expect(userProfiles.save).not.toHaveBeenCalled();
  });

  it('normalizes email to lowercase before saving', async () => {
    const { useCase, accountLookup, userProfiles } = buildUseCase();
    accountLookup.exists.mockResolvedValue(true);
    userProfiles.existsByAccountId.mockResolvedValue(false);

    const result = await useCase.execute({
      accountId: 'account-1',
      fullName: 'Nguyen Van A',
      email: 'User@Example.com',
      actorId: null,
    });

    expect(result.email).toBe('user@example.com');
    expect(userProfiles.save).toHaveBeenCalledWith(
      expect.objectContaining({ accountId: 'account-1', email: 'user@example.com' }),
    );
  });
});
