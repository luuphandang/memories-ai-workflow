  ): Promise<void> {
    await this.changeAccountPassword.execute({
      accountId,
      newPassword: dto.newPassword,
      actorId: user.id,
    });
  }

  @Delete(':accountId')
  @RequirePermissions('account.delete')
  @ApiParam({ name: 'accountId', type: String, format: 'uuid' })
  @ApiResponse({ status: HttpStatus.NO_CONTENT })
  @HttpCode(HttpStatus.NO_CONTENT)
  async remove(
    @CurrentUser() user: RequestUser,
    @Param('accountId') accountId: string,
  ): Promise<void> {
    await this.deleteAccount.execute({ accountId, actorId: user.id });
  }
}
