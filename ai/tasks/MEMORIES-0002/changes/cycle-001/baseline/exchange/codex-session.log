function toAccountResponseDto(detail: AccountDetail | AccountSummary): AccountResponseDto {
  return {
    id: detail.id,
    status: detail.status,
    phone: detail.phone,
    createdAt: detail.createdAt,
    updatedAt: detail.updatedAt,
  };
}

/**
