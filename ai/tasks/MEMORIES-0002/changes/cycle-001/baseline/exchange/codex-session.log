import { AuditableOrmEntity } from '@memories/platform/database';
import { Column, Entity, Index, PrimaryColumn } from 'typeorm';

/** Persistence shape only — never imported by domain (task.md §7 `profile.user_profiles`). No
 * TypeORM relation to `AccountOrmEntity` — `accountId` is a plain FK column (module boundary). */
@Entity({ name: 'user_profiles', schema: 'profile' })
export class UserProfileOrmEntity extends AuditableOrmEntity {
  @PrimaryColumn('uuid')
  id!: string;

  // Not `@Index({ unique: true })`: the real constraint is a partial unique index
  // (`WHERE deleted_at IS NULL`, see the `CreateUserProfilesSchema` migration) so a soft-deleted
  // profile never blocks provisioning a new one for the same account — `synchronize` is always
  // `false`, so this decorator is documentation only, kept honest with what the migration creates.
  @Index()
  @Column({ name: 'account_id', type: 'uuid' })
  accountId!: string;

  @Column({ name: 'full_name', type: 'varchar' })
  fullName!: string;

  @Column({ type: 'varchar', nullable: true })
  email!: string | null;

  @Column({ name: 'avatar_id', type: 'uuid', nullable: true })
  avatarId!: string | null;

  @Column({ name: 'date_of_birth', type: 'date', nullable: true })
  dateOfBirth!: Date | null;

  @Column({ type: 'varchar', nullable: true })
  address!: string | null;
}

