import {
  buildRefreshCookieOptions,
  CurrentUser,
  JwtAuthGuard,
  readRefreshCookie,
  RequestUser,
} from '@memories/platform/security';
import { Body, Controller, HttpCode, HttpStatus, Post, Req, Res, UnauthorizedException, UseGuards } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { ApiBearerAuth, ApiResponse, ApiTags } from '@nestjs/swagger';
import type { Request, Response } from 'express';

import { LoginUseCase } from '../../application/use-cases/login.use-case';
import { LogoutUseCase } from '../../application/use-cases/logout.use-case';
import { RefreshSessionUseCase } from '../../application/use-cases/refresh-session.use-case';

import { LoginResponseDto, RefreshResponseDto } from './auth-response.dto';
import { LoginDto } from './login.dto';

/**
 * §9/§10/§13 login/refresh/logout. No `@RequirePermissions` here — portal authorization runs
 * *inside* `LoginUseCase` via `PermissionChecker` (DEC-001), not through the HTTP guard layer, so
 * a missing-permission failure and a bad-credential failure both surface as the use case's own
 * exception rather than a route-level 403 before the use case even runs.
 */
@ApiTags('auth')
@Controller('auth')
export class AuthController {
  constructor(
    private readonly loginUseCase: LoginUseCase,
    private readonly refreshSessionUseCase: RefreshSessionUseCase,
    private readonly logoutUseCase: LogoutUseCase,
    private readonly configService: ConfigService,
  ) {}

  @Post('login')
  @HttpCode(HttpStatus.OK)
  @ApiResponse({ status: HttpStatus.OK, type: LoginResponseDto })
  async login(
    @Body() dto: LoginDto,
    @Req() req: Request,
    @Res({ passthrough: true }) res: Response,
  ): Promise<LoginResponseDto> {
    const result = await this.loginUseCase.execute({
      phone: dto.phone,
      password: dto.password,
      portal: dto.portal,
      ipAddress: req.ip ?? null,
      userAgent: req.header('user-agent') ?? null,
    });

    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));

    return {
      accessToken: result.accessToken,
      portal: result.portal,
      sessionId: result.sessionId,
      roles: result.roles,
      permissions: result.permissions,
    };
  }

  @Post('refresh')
  @HttpCode(HttpStatus.OK)
  @ApiResponse({ status: HttpStatus.OK, type: RefreshResponseDto })
  async refresh(
    @Req() req: Request,
    @Res({ passthrough: true }) res: Response,
  ): Promise<RefreshResponseDto> {
    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    const refreshToken = readRefreshCookie(req.headers.cookie, auth);
    if (!refreshToken) {
      throw new UnauthorizedException('Missing refresh token');
    }

    const result = await this.refreshSessionUseCase.execute({
      refreshToken,
      ipAddress: req.ip ?? null,
      userAgent: req.header('user-agent') ?? null,
    });

    res.cookie(auth.refreshCookie.name, result.refreshToken, buildRefreshCookieOptions(auth));

    return { accessToken: result.accessToken, portal: result.portal, sessionId: result.sessionId };
  }

  @Post('logout')
  @UseGuards(JwtAuthGuard)
  @ApiBearerAuth()
  @HttpCode(HttpStatus.NO_CONTENT)
  @ApiResponse({ status: HttpStatus.NO_CONTENT })
  async logout(
    @CurrentUser() user: RequestUser,
    @Res({ passthrough: true }) res: Response,
  ): Promise<void> {
    if (user.sessionId) {
      await this.logoutUseCase.execute({ sessionId: user.sessionId });
    }
    const auth = this.configService.getOrThrow<AuthConfig>('auth');
    res.clearCookie(auth.refreshCookie.name, buildRefreshCookieOptions(auth));
  }
}
