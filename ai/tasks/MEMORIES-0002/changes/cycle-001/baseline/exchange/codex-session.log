import { AccountLookup, ACCOUNT_LOOKUP } from '@memories/platform/security';
import {
  CLOCK,
  Clock,
  createAuditableProps,
  DomainError,
  ID_GENERATOR,
  IdGenerator,
  UniqueEntityId,
  UseCase,
} from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';

import { UserProfile } from '../../domain/user-profile';
import { USER_PROFILE_REPOSITORY, UserProfileRepository } from '../../domain/user-profile.repository';

export interface CreateUserProfileInput {
  accountId: string;
  fullName: string;
  email?: string | undefined;
  dateOfBirth?: Date | undefined;
  address?: string | undefined;
  avatarId?: string | undefined;
  actorId: string | null;
}

export interface UserProfileOutput {
  id: string;
  accountId: string;
  fullName: string;
  email: string | null;
  avatarId: string | null;
  dateOfBirth: Date | null;
  address: string | null;
  createdAt: Date;
  updatedAt: Date;
}

/** §16/§4: one UserProfile per Account, existence of the Account itself is checked through
 * `AccountLookup` (never a direct import of identity-access — module boundary). */
@Injectable()
export class CreateUserProfileUseCase implements UseCase<CreateUserProfileInput, UserProfileOutput> {
  constructor(
    @Inject(USER_PROFILE_REPOSITORY) private readonly userProfiles: UserProfileRepository,
    @Inject(ACCOUNT_LOOKUP) private readonly accountLookup: AccountLookup,
    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,
    @Inject(CLOCK) private readonly clock: Clock,
  ) {}

  async execute(input: CreateUserProfileInput): Promise<UserProfileOutput> {
    const accountExists = await this.accountLookup.exists(input.accountId);
    if (!accountExists) {
      throw DomainError.notFound('account_not_found', `Account ${input.accountId} was not found`);
    }

    const alreadyHasProfile = await this.userProfiles.existsByAccountId(input.accountId);
    if (alreadyHasProfile) {
      throw DomainError.conflict(
        'user_profile_already_exists',
        `Account ${input.accountId} already has a UserProfile`,
      );
    }

    const now = this.clock.now();
    const id = new UniqueEntityId(this.idGenerator.generate());
    const profile = UserProfile.create(
      {
        accountId: input.accountId,
        fullName: input.fullName,
        email: input.email?.toLowerCase() ?? null,
        avatarId: input.avatarId ?? null,
        dateOfBirth: input.dateOfBirth ?? null,
        address: input.address ?? null,
        ...createAuditableProps(input.actorId, now),
      },
      id,
    );
    await this.userProfiles.save(profile);

    return toOutput(profile);
  }
}

export function toOutput(profile: UserProfile): UserProfileOutput {
  return {
    id: profile.id.toValue(),
    accountId: profile.accountId,
    fullName: profile.fullName,
    email: profile.email,
    avatarId: profile.avatarId,
    dateOfBirth: profile.dateOfBirth,
    address: profile.address,
    createdAt: profile.audit.createdAt,
    updatedAt: profile.audit.updatedAt,
  };
}
import { AccountPhoneSearch, ACCOUNT_PHONE_SEARCH } from '@memories/platform/security';
import { PaginatedResult, UseCase } from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';

import { USER_PROFILE_REPOSITORY, UserProfileRepository } from '../../domain/user-profile.repository';

import { toOutput, UserProfileOutput } from './create-user-profile.use-case';

export interface ListUserProfilesInput {
  fullNameSearch?: string | undefined;
  emailSearch?: string | undefined;
  phoneSearch?: string | undefined;
  page: number;
  pageSize: number;
  sortBy: 'createdAt' | 'updatedAt' | 'fullName';
  sortDirection: 'ASC' | 'DESC';
}

@Injectable()
export class ListUserProfilesUseCase implements UseCase<ListUserProfilesInput, PaginatedResult<UserProfileOutput>> {
  constructor(
    @Inject(USER_PROFILE_REPOSITORY) private readonly userProfiles: UserProfileRepository,
    @Inject(ACCOUNT_PHONE_SEARCH) private readonly accountPhoneSearch: AccountPhoneSearch,
  ) {}

  async execute(input: ListUserProfilesInput): Promise<PaginatedResult<UserProfileOutput>> {
    const accountIdsMatchingPhone = input.phoneSearch
      ? await this.accountPhoneSearch.searchAccountIdsByPhone(input.phoneSearch)
      : undefined;

    // An explicit phone search that matches nothing must return an empty page, not "no filter".
    if (accountIdsMatchingPhone && accountIdsMatchingPhone.length === 0) {
      return PaginatedResult.of([], 0, { page: input.page, pageSize: input.pageSize });
    }

    const { items, total } = await this.userProfiles.list({
      fullNameSearch: input.fullNameSearch,
      emailSearch: input.emailSearch,
      accountIdsMatchingPhone,
      page: input.page,
      pageSize: input.pageSize,
      sortBy: input.sortBy,
      sortDirection: input.sortDirection,
    });

    return PaginatedResult.of(items.map(toOutput), total, { page: input.page, pageSize: input.pageSize });
  }
}
import { CLOCK, Clock, DomainError, UniqueEntityId, UseCase } from '@memories/shared/kernel';
