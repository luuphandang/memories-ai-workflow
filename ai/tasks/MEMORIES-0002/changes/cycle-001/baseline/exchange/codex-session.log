import { AppConfig } from '@memories/platform/configuration';
import { buildCorsOptions, buildValidationPipe, GlobalExceptionFilter } from '@memories/platform/security';
import { INestApplication } from '@nestjs/common';
import helmet from 'helmet';

/**
 * Applied before building the Swagger document too (`export-openapi.ts`): NestJS's Swagger
 * module reads route paths from whatever the global prefix already is at the time
 * `SwaggerModule.createDocument` runs, so the exported contract must see the exact same prefix
 * real requests are routed under — otherwise the committed schema documents `/media` while the
 * real, deployed endpoint is `/api/v1/media`.
 */
export function applyGlobalPrefix(app: INestApplication, appConfig: AppConfig): void {
  app.setGlobalPrefix(`${appConfig.apiPrefix}/${appConfig.apiVersion}`, {
    exclude: ['health/liveness', 'health/readiness', 'metrics'],
  });
}

/**
 * Global request/response wiring (helmet, CORS, API prefix, validation pipe, exception filter)
 * shared between `main.ts` (the real running process) and e2e tests built via
 * `Test.createTestingModule(...).createNestApplication()`. Without this, an e2e test exercises
 * an app that behaves differently from production — no DTO validation, no domain-error-to-HTTP-
 * status mapping — and silently gives false confidence (this is exactly how round-1's e2e test
 * only ever hit endpoints with no validation/error paths and never caught it).
 */
export function configureApp(app: INestApplication, appConfig: AppConfig): void {
  app.use(helmet());
  app.enableCors(buildCorsOptions(appConfig));
  applyGlobalPrefix(app, appConfig);
  app.useGlobalPipes(buildValidationPipe());
  app.useGlobalFilters(new GlobalExceptionFilter(appConfig.env === 'production'));
}

