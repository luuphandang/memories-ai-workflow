import { AuthConfig } from '@memories/platform/configuration';
import { UNIT_OF_WORK } from '@memories/platform/database';
import { ProvisionUserProfileOutput, UserProfileProvisioner, USER_PROFILE_PROVISIONER } from '@memories/platform/security';
import {
  CLOCK,
  Clock,
  createAuditableProps,
  DomainError,
  ID_GENERATOR,
  IdGenerator,
  UniqueEntityId,
  UnitOfWork,
  UseCase,
} from '@memories/shared/kernel';
import { Inject, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

import { Account } from '../../domain/accounts/account';
import { AccountStatus } from '../../domain/accounts/account-status';
import { ACCOUNT_REPOSITORY, AccountRepository } from '../../domain/accounts/account.repository';
import { AuthIdentity } from '../../domain/auth-identities/auth-identity';
import {
  AUTH_IDENTITY_REPOSITORY,
  AuthIdentityRepository,
} from '../../domain/auth-identities/auth-identity.repository';
import { AuthProvider } from '../../domain/auth-identities/auth-provider';
import {
  ACCOUNT_ROLE_REPOSITORY,
  AccountRoleRepository,
} from '../../domain/roles/account-role.repository';
import { ROLE_REPOSITORY, RoleRepository } from '../../domain/roles/role.repository';
import { PASSWORD_HASHER, PasswordHasher } from '../ports/password-hasher.port';
import { PHONE_NORMALIZER, PhoneNormalizerPort } from '../ports/phone-normalizer.port';

export interface CreateAccountInput {
  phone: string;
  password: string;
  fullName: string;
  email?: string | undefined;
  dateOfBirth?: Date | undefined;
  address?: string | undefined;
  avatarId?: string | undefined;
  /** Actor performing the creation (admin operator), or `null` for an unauthenticated
   * self-registration flow. */
  actorId: string | null;
}

export interface CreateAccountOutput {
  accountId: string;
  userProfileId: string;
}

/**
 * §8 transactional flow: normalize phone -> check duplicate -> hash password -> create Account ->
 * create LOCAL AuthIdentity -> create UserProfile -> assign default role, all inside one
 * `UnitOfWork.withTransaction`. UserProfile creation delegates to `USER_PROFILE_PROVISIONER`
 * (implemented by the `user-profiles` module, injected globally — see
 * `libs/platform/security/src/identity.contracts.ts` for why identity-access depends on that port
 * instead of importing `@memories/modules/user-profiles` directly: it keeps the module graph
 * acyclic since user-profiles' own existence checks use `AccountLookup`, not a direct import back).
 */
@Injectable()
export class CreateAccountUseCase implements UseCase<CreateAccountInput, CreateAccountOutput> {
  constructor(
    @Inject(UNIT_OF_WORK) private readonly unitOfWork: UnitOfWork,
    @Inject(ACCOUNT_REPOSITORY) private readonly accounts: AccountRepository,
    @Inject(AUTH_IDENTITY_REPOSITORY) private readonly authIdentities: AuthIdentityRepository,
    @Inject(ACCOUNT_ROLE_REPOSITORY) private readonly accountRoles: AccountRoleRepository,
    @Inject(ROLE_REPOSITORY) private readonly roles: RoleRepository,
    @Inject(PASSWORD_HASHER) private readonly passwordHasher: PasswordHasher,
    @Inject(PHONE_NORMALIZER) private readonly phoneNormalizer: PhoneNormalizerPort,
    @Inject(USER_PROFILE_PROVISIONER) private readonly userProfileProvisioner: UserProfileProvisioner,
    @Inject(ID_GENERATOR) private readonly idGenerator: IdGenerator,
    @Inject(CLOCK) private readonly clock: Clock,
    private readonly configService: ConfigService,
  ) {}

  async execute(input: CreateAccountInput): Promise<CreateAccountOutput> {
    return this.unitOfWork.withTransaction(async () => {
      const auth = this.configService.getOrThrow<AuthConfig>('auth');
      const now = this.clock.now();
      const phone = this.phoneNormalizer.normalize(input.phone, auth.phone.defaultRegion);

      if (await this.authIdentities.existsByProviderAndIdentifier(AuthProvider.Local, phone.value)) {
        throw DomainError.conflict('phone_already_exists', `Phone ${phone.value} is already registered`);
      }

      const passwordHash = await this.passwordHasher.hash(input.password);

      const accountId = new UniqueEntityId(this.idGenerator.generate());
      const account = Account.create(
        {
          status: AccountStatus.Active,
          tokenVersion: 0,
          ...createAuditableProps(input.actorId, now),
        },
        accountId,
      );
      await this.accounts.save(account);

      const authIdentityId = new UniqueEntityId(this.idGenerator.generate());
      const authIdentity = AuthIdentity.create(
        {
          accountId: accountId.toValue(),
          provider: AuthProvider.Local,
          identifier: phone.value,
          providerSubject: null,
          passwordHash,
          verifiedAt: null,
          ...createAuditableProps(input.actorId, now),
        },
        authIdentityId,
      );
      await this.authIdentities.save(authIdentity);

      const defaultRole = await this.roles.findByCode(auth.defaultRole.code);
      if (!defaultRole) {
        throw DomainError.externalDependency(
          'default_role_not_seeded',
          `Default role "${auth.defaultRole.code}" has not been seeded`,
        );
      }
      await this.accountRoles.assign(accountId.toValue(), defaultRole.id.toValue(), input.actorId, now);

      const profile: ProvisionUserProfileOutput = await this.userProfileProvisioner.provision({
        accountId: accountId.toValue(),
        fullName: input.fullName,
        email: input.email,
        dateOfBirth: input.dateOfBirth,
        address: input.address,
        avatarId: input.avatarId,
        actorId: input.actorId,
      });

      return { accountId: accountId.toValue(), userProfileId: profile.userProfileId };
    });
  }
}
