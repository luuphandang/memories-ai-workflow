{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AI_ORCHESTRATED": "1",
    "HUSKY": "0"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "mcp__codegraph_*__*",
      "Bash",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * show *)",
      "Bash(git -C * ls-files *)",
      "Bash(git -C * grep *)",
      "Bash(git -C * branch --show-current)",
      "Bash(git -C * rev-parse *)",
      "Bash(yarn *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(corepack *)",
      "Bash(node *)",
      "Bash(docker build *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(docker info)",
      "Bash(docker info *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker images *)",
      "Bash(docker pull *)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker start *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Edit(ai/shared/**)",
      "Edit(ai/repos/**)",
      "Edit(ai/domains/**)",
      "Bash(git add *)",
      "Bash(git apply *)",
      "Bash(git am *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git worktree *)",
      "Bash(git -C * add *)",
      "Bash(git -C * apply *)",
      "Bash(git -C * am *)",
      "Bash(git -C * push *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * switch *)",
      "Bash(git -C * restore *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * clean *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * merge *)",
      "Bash(git -C * cherry-pick *)",
      "Bash(git -C * stash *)",
      "Bash(git -C * tag *)",
      "Bash(git -C * mv *)",
      "Bash(git -C * rm *)",
      "Bash(git -C * pull *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * worktree *)",
      "Bash(docker compose * down *--volumes*)",
      "Bash(docker compose * down * -v*)",
      "Bash(docker-compose * down *--volumes*)",
      "Bash(docker-compose * down * -v*)",
      "Bash(docker system prune *)",
      "Bash(docker volume prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker image prune *)",
      "Bash(docker image rm *)",
      "Bash(docker rmi *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$AI_ROOT/config/claude/hooks/block-destructive.sh"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "agentPushNotifEnabled": true
}
