#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import (
    ROOT,
    configured_fail_severities,
    detect_risk_categories,
    ensure_task,
    now_iso,
    read_json,
    read_yaml,
    require_file,
    runtime_dir,
    write_json,
    write_yaml,
)


def impacted_slice_ids_for_file(file_path: str, slices: list[dict]) -> list[str]:
    """Match a finding's file against slice deliverables (conservative: the file path
    must appear inside the deliverable text, not the reverse, to avoid a short/generic
    deliverable string spuriously matching an unrelated file)."""
    if not file_path:
        return []
    return [
        item["id"]
        for item in slices
        if any(file_path in deliverable for deliverable in item.get("deliverables", []) if deliverable)
    ]


def impacted_slice_ids_for_criterion(criterion: str, slices: list[dict]) -> list[str]:
    if criterion.startswith("slice:"):
        slice_id = criterion.split(":", 1)[1]
        return [slice_id] if any(item["id"] == slice_id for item in slices) else []
    return [item["id"] for item in slices if criterion in item.get("acceptance_criteria", [])]


def build_correction_scope(
    task_id: str,
    cycle: int,
    execution_plan_required: bool,
    slices: list[dict],
    findings: list[dict],
    failed_criteria: list[dict],
    missing_validation: list[str],
) -> dict:
    risk_text = "\n".join(
        [
            *(f"{item.get('title', '')} {item.get('evidence', '')} {item.get('expected_fix', '')}" for item in findings),
            *(str(item.get("criterion", "")) for item in failed_criteria),
            *(str(item) for item in missing_validation),
        ]
    )
    risk_categories = detect_risk_categories(risk_text)

    scope = {
        "task_id": task_id,
        "review_cycle": cycle,
        "generated_at": now_iso(),
        "execution_plan_required": execution_plan_required,
        "findings": [
            {
                "id": index,
                "title": finding.get("title"),
                "severity": finding.get("severity"),
                "repo": finding.get("repo"),
                "file": finding.get("file"),
            }
            for index, finding in enumerate(findings, 1)
        ],
        "impacted_acceptance_criteria": [item.get("criterion") for item in failed_criteria],
        "risk_categories": risk_categories,
    }
    artifact_markers = ("evidence/", "provenance.json", "implementation.json", "implementation-progress.json", "final-report.md")
    remediation_types: list[str] = []
    for finding in findings:
        file_path = str(finding.get("file") or "").lower()
        title = str(finding.get("title") or "").lower()
        if "provenance" in title or "evidence" in title or any(marker in file_path for marker in artifact_markers):
            remediation_types.append("evidence_or_handoff")
        else:
            remediation_types.append("code_or_test")
    if missing_validation:
        remediation_types.append("validation")
    scope["remediation_types"] = sorted(set(remediation_types))
    scope["source_change_expected"] = "code_or_test" in remediation_types

    if not execution_plan_required:
        scope["impacted_slices"] = []
        scope["full_plan_fallback_required"] = False
        scope["full_plan_fallback_reason"] = "execution plan not required for this task"
        return scope

    impacted: set[str] = set()
    unmapped_count = 0
    for finding in findings:
        matches = impacted_slice_ids_for_file(str(finding.get("file") or ""), slices)
        if matches:
            impacted.update(matches)
        else:
            unmapped_count += 1
    for item in failed_criteria:
        matches = impacted_slice_ids_for_criterion(str(item.get("criterion", "")), slices)
        if matches:
            impacted.update(matches)
        else:
            unmapped_count += 1

    fallback_reasons = []
    if risk_categories:
        fallback_reasons.append(
            "sensitive correction (risk categories: " + ", ".join(risk_categories) + ") always escalates to full-plan scope"
        )
    if unmapped_count:
        fallback_reasons.append(
            f"{unmapped_count} finding(s)/criterion(criteria) could not be mapped to a specific slice"
        )
    if missing_validation:
        fallback_reasons.append("missing validation evidence is not attributable to a specific slice")
    if not impacted and (findings or failed_criteria):
        fallback_reasons.append("no finding or criterion mapped to any slice")

    scope["impacted_slices"] = sorted(impacted)
    scope["full_plan_fallback_required"] = bool(fallback_reasons)
    scope["full_plan_fallback_reason"] = "; ".join(fallback_reasons) if fallback_reasons else None
    return scope


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Create a concise fix request from Codex findings"
    )
    parser.add_argument("task_id")
    args = parser.parse_args()

    td = ensure_task(args.task_id)
    review_path = require_file(
        td / "review.json",
        "Codex review output",
        f"run ./ai/bin/ai task review {args.task_id}",
    )
    review = read_json(review_path)
    state = read_yaml(td / "state.yaml")
    task = read_yaml(td / "task.yaml")
    cycle = int(state.get("review_cycle", 0))
    fix_cycle = int(state.get("fix_cycle", 0))
    max_cycles = int(task.get("review", {}).get("max_fix_cycles", task.get("review", {}).get("max_cycles", 5)))
    fail_on = configured_fail_severities(task)

    verdict = review.get("verdict")
    if verdict == "pass":
        raise SystemExit(
            "Codex review passed; there are no fixes to request. "
            f"Run ./ai/bin/ai task accept {args.task_id} --accepted-by <name> after user acceptance."
        )
    if verdict != "changes_requested":
        raise SystemExit(
            f"Cannot create a fix request from review verdict {verdict!r}; "
            "resolve the blocked/invalid review first."
        )

    if fix_cycle >= max_cycles:
        state["status"] = "blocked"
        state["last_error"] = f"Maximum fix cycles reached ({max_cycles})"
        write_yaml(td / "state.yaml", state)
        raise SystemExit(state["last_error"])

    findings = [
        item for item in review.get("findings", []) if item.get("severity") in fail_on
    ]
    lines = [
        f"# Fix request — {args.task_id} — review cycle {cycle}",
        "",
        "Resolve the verified blocking items below while preserving all effective requirements and unrelated changes. Then update implementation.json.",
        "",
        f"Configured blocking severities: {', '.join(fail_on)}.",
        "",
    ]
    for index, finding in enumerate(findings, 1):
        location = f"{finding.get('repo')}:{finding.get('file')}"
        if finding.get("line"):
            location += f":{finding.get('line')}"
        evidence = str(finding.get("evidence", ""))
        expected_fix = str(finding.get("expected_fix", ""))
        guidance = finding.get("implementation_guidance") or {}
        lines.extend(
            [
                f"## {index}. [{finding.get('severity')}] {finding.get('title')}",
                "",
                f"- Location: `{location}`",
                f"- Evidence: {evidence[:800]}",
                f"- Expected fix: {expected_fix[:500]}",
                f"- Suggested approach: {str(guidance.get('approach', ''))[:800]}",
            ]
        )
        if guidance.get("code_locations"):
            lines.append("- Code locations: " + ", ".join(f"`{item}`" for item in guidance["code_locations"]))
        if guidance.get("tests"):
            lines.append("- Tests to add/change: " + "; ".join(guidance["tests"]))
        if guidance.get("done_when"):
            lines.append("- Done when: " + "; ".join(guidance["done_when"]))
        if len(evidence) > 800 or len(expected_fix) > 500:
            lines.append(f"- Full finding: `{review_path.relative_to(ROOT)}` (finding #{index})")
        lines.append("")

    failed_criteria = [
        item
        for item in review.get("acceptance_criteria", [])
        if item.get("status") in {"failed", "partial", "not_verified"}
    ]
    missing_validation = review.get("validation_assessment", {}).get("missing", [])
    if failed_criteria:
        lines.extend(["## Acceptance criteria requiring work", ""])
        lines.extend(
            f"- [{item.get('status')}] {item.get('criterion')}"
            for item in failed_criteria
        )
        lines.append("")
    if missing_validation:
        lines.extend(["## Missing validation evidence", ""])
        lines.extend(f"- {item}" for item in missing_validation)
        lines.append("")

    if not findings and not failed_criteria and not missing_validation:
        raise SystemExit(
            "Invalid changes_requested review: no configured blocking finding, failed criterion, "
            "or missing validation evidence was found. Re-run or inspect review.json."
        )

    execution_plan_required = bool(task.get("scope", {}).get("execution_plan_required", False))
    slices: list = []
    if execution_plan_required and (td / "execution-plan.json").exists():
        slices = read_json(td / "execution-plan.json").get("slices", [])
    correction_scope = build_correction_scope(
        args.task_id, cycle, execution_plan_required, slices, findings, failed_criteria, missing_validation
    )
    if correction_scope["full_plan_fallback_required"]:
        lines.extend([
            "## Correction scope",
            "",
            f"Full-plan scope required: {correction_scope['full_plan_fallback_reason']}",
            "",
        ])
    elif correction_scope["impacted_slices"]:
        lines.extend([
            "## Correction scope",
            "",
            "Impacted slices (plus their direct dependencies): " + ", ".join(correction_scope["impacted_slices"]),
            "",
        ])

    path = runtime_dir(args.task_id) / "input" / f"fix-request-review-{cycle:03d}.md"
    path.write_text("\n".join(lines), encoding="utf-8")
    scope_path = runtime_dir(args.task_id) / "input" / f"correction-scope-review-{cycle:03d}.json"
    write_json(scope_path, correction_scope)

    progress_path = td / "implementation-progress.json"
    if progress_path.exists():
        progress = read_json(progress_path)
        checklist = {
            item.get("id"): item for item in progress.get("checklist", []) if item.get("id")
        }
        for index, finding in enumerate(findings, 1):
            item_id = f"review:{cycle}:{index}"
            guidance = finding.get("implementation_guidance") or {}
            done_when = "; ".join(guidance.get("done_when", []))
            checklist[item_id] = {
                "id": item_id,
                "source": "review_finding",
                "source_ref": f"review:{cycle}",
                "description": f"{finding.get('title')}. Done when: {done_when}",
                "status": "pending",
                "evidence": "",
                "updated_at": now_iso(),
            }
        progress["checklist"] = list(checklist.values())
        progress["updated_at"] = now_iso()
        write_json(progress_path, progress)

    state["status"] = "changes_requested_by_codex"
    state["fix_cycle"] = fix_cycle + 1
    state["fix_cycles_total"] = int(state.get("fix_cycles_total", 0)) + 1
    state.setdefault("timestamps", {})["fix_requested_at"] = now_iso()
    state["last_error"] = None
    # Record the scope decision (and fallback reason, if any) in state for audit — not
    # only in the sidecar file — per the "sensitive/ambiguous corrections must safely
    # escalate, and the reason must be recorded" requirement.
    state["last_correction_scope"] = {
        "review_cycle": cycle,
        "impacted_slices": correction_scope["impacted_slices"],
        "full_plan_fallback_required": correction_scope["full_plan_fallback_required"],
        "full_plan_fallback_reason": correction_scope["full_plan_fallback_reason"],
    }
    write_yaml(td / "state.yaml", state)
    print(path)
    print(scope_path)


if __name__ == "__main__":
    main()
