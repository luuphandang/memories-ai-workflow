#!/usr/bin/env python3
from __future__ import annotations
import argparse
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.docker_infra import infra_gc


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Sweep and tear down per-task validation infra stacks for completed, "
        "deleted, or stale (unused past --max-age-hours) tasks"
    )
    parser.add_argument("--max-age-hours", type=int, default=48)
    args = parser.parse_args()
    cleaned = infra_gc(max_age_hours=args.max_age_hours)
    if cleaned:
        print("Reclaimed infra for: " + ", ".join(cleaned))
    else:
        print("Nothing to reclaim")


if __name__ == "__main__":
    main()
