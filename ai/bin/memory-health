#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.memory import health_probe


def main() -> None:
    argparse.ArgumentParser(description="Probe memory provider health").parse_args()
    result = health_probe()
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if not result.get("enabled"):
        return
    raise SystemExit(0 if result.get("service_available") else 1)


if __name__ == "__main__":
    main()
