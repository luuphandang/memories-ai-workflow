#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.memory import sync_repository_for


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Sync CodeGraph for a stable repository under apps/<repo>. Never accepts a "
            "worktree path -- worktrees/<TICKET_ID>/<repo> is never indexed as global "
            "CodeGraph. Requires apps/<repo> to have a public https:// origin remote; "
            "reports supports_code_graph=false otherwise rather than faking success."
        )
    )
    parser.add_argument("repo", help="Repository name, matching apps/<repo> and ai/repos/<repo>/")
    args = parser.parse_args()

    result = sync_repository_for(args.repo)
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if not result.get("supports_code_graph"):
        raise SystemExit(1)


if __name__ == "__main__":
    main()
