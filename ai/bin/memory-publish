#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.memory import publish_for_task


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Publish approved knowledge-updates.json entries as durable memory. "
            "Only allowed once state.status == completed and acceptance.status == accepted."
        )
    )
    parser.add_argument("task_id")
    parser.add_argument(
        "--supersedes",
        default=None,
        help="Explicit cross-task asset_id this publish supersedes (manual escape hatch; "
        "automatic supersession only covers same-task/same-target republishes)",
    )
    args = parser.parse_args()

    result = publish_for_task(args.task_id, supersedes=args.supersedes)
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if result["errors"]:
        raise SystemExit("Memory publish completed with errors:\n- " + "\n- ".join(result["errors"]))


if __name__ == "__main__":
    main()
