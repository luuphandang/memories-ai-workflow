#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.memory import recall_for_task


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Recall memory for a task and write ai/tasks/<ID>/memory/{recall.json,recall.md}"
    )
    parser.add_argument("task_id")
    args = parser.parse_args()

    memory_block, missing = recall_for_task(args.task_id)
    print(json.dumps(memory_block, ensure_ascii=False, indent=2))
    if missing:
        raise SystemExit("Memory recall blocked:\n- " + "\n- ".join(missing))


if __name__ == "__main__":
    main()
