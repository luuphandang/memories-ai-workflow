#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import ensure_task, runtime_dir


def main() -> None:
    parser = argparse.ArgumentParser(description="Summarize local AI attempt metrics")
    parser.add_argument("task_id")
    args = parser.parse_args()
    ensure_task(args.task_id)
    path = runtime_dir(args.task_id) / "metrics" / "agent-attempts.jsonl"
    events = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()] if path.exists() else []
    usage_keys = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
    totals = {key: sum(int(event.get("usage", {}).get(key, 0) or 0) for event in events) for key in usage_keys}
    result = {
        "task_id": args.task_id,
        "attempts": len(events),
        "implement_attempts": sum(event.get("phase") == "implement" for event in events),
        "review_attempts": sum(event.get("phase") == "review" for event in events),
        "resumed_attempts": sum(bool(event.get("resumed")) for event in events),
        "duration_seconds": round(sum(float(event.get("duration_seconds", 0)) for event in events), 2),
        **totals,
        "total_context_tokens": totals["input_tokens"] + totals["cache_creation_input_tokens"] + totals["cache_read_input_tokens"],
        "num_turns": sum(int(event.get("usage", {}).get("num_turns", 0) or 0) for event in events),
        "total_cost_usd": round(sum(float(event.get("usage", {}).get("total_cost_usd", 0) or 0) for event in events), 6),
        "by_slice": {},
        "events": events,
    }
    for event in events:
        slice_id = event.get("slice_id") or "whole-task"
        bucket = result["by_slice"].setdefault(slice_id, {"attempts": 0, "context_tokens": 0, "output_tokens": 0, "cost_usd": 0.0})
        usage = event.get("usage", {})
        bucket["attempts"] += 1
        bucket["context_tokens"] += sum(int(usage.get(key, 0) or 0) for key in usage_keys[:-1])
        bucket["output_tokens"] += int(usage.get("output_tokens", 0) or 0)
        bucket["cost_usd"] = round(bucket["cost_usd"] + float(usage.get("total_cost_usd", 0) or 0), 6)
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
