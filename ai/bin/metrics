#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import ensure_task, runtime_dir


def main() -> None:
    parser = argparse.ArgumentParser(description="Summarize local AI attempt metrics")
    parser.add_argument("task_id")
    args = parser.parse_args()
    ensure_task(args.task_id)
    path = runtime_dir(args.task_id) / "metrics" / "agent-attempts.jsonl"
    events = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()] if path.exists() else []
    input_tokens = sum(int(event.get("usage", {}).get("input_tokens", 0)) for event in events)
    output_tokens = sum(int(event.get("usage", {}).get("output_tokens", 0)) for event in events)
    result = {
        "task_id": args.task_id,
        "attempts": len(events),
        "implement_attempts": sum(event.get("phase") == "implement" for event in events),
        "review_attempts": sum(event.get("phase") == "review" for event in events),
        "resumed_attempts": sum(bool(event.get("resumed")) for event in events),
        "duration_seconds": round(sum(float(event.get("duration_seconds", 0)) for event in events), 2),
        "input_tokens": input_tokens,
        "output_tokens": output_tokens,
        "events": events,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
