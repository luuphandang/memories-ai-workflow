#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import AI_ROOT, atomic_write, read_yaml

GROUPS = {
    "backlog.md": {"backlog"},
    "in-progress.md": {
        "ready",
        "prepared",
        "implementing",
        "interrupted",
        "validating",
        "reopened",
        "changes_requested_by_user",
    },
    "review.md": {
        "reviewing",
        "changes_requested_by_codex",
        "awaiting_user_acceptance",
    },
    "completed.md": {"completed"},
    "failed.md": {"needs_input", "blocked", "failed"},
}


def main() -> None:
    rows = []
    tasks_root = AI_ROOT / "tasks"
    for td in sorted(tasks_root.iterdir() if tasks_root.exists() else []):
        if (
            not td.is_dir()
            or td.name.startswith(".")
            or not (td / "task.yaml").exists()
        ):
            continue
        task = read_yaml(td / "task.yaml")
        state = read_yaml(td / "state.yaml")
        rows.append(
            {
                "id": task.get("id", td.name),
                "type": task.get("jira", {}).get("type", "?"),
                "title": task.get("title", ""),
                "parent": task.get("jira", {}).get("parent_id") or "-",
                "status": state.get("status", "?"),
                "cycle": state.get("change_cycle", 0),
                "updated": max(
                    (str(value) for value in state.get("timestamps", {}).values()),
                    default="-",
                ),
            }
        )

    for filename, statuses in GROUPS.items():
        lines = [
            f"# {filename[:-3].replace('-', ' ').title()}",
            "",
            "_Auto-generated by `./ai/bin/rebuild-indexes`. Do not edit manually._",
            "",
            "| Jira ID | Type | Title | Parent | Status | Change cycle | Updated |",
            "|---|---|---|---|---|---:|---|",
        ]
        for item in rows:
            if item["status"] not in statuses:
                continue
            title = item["title"].replace("|", "/")
            lines.append(
                f"| {item['id']} | {item['type']} | {title} | {item['parent']} | "
                f"{item['status']} | {item['cycle']} | {item['updated']} |"
            )
        atomic_write(AI_ROOT / "indexes" / filename, "\n".join(lines) + "\n")
    print(f"Rebuilt indexes for {len(rows)} tasks")


if __name__ == "__main__":
    main()
