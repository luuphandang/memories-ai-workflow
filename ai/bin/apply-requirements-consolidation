#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import (
    ROOT,
    atomic_write,
    ensure_task,
    now_iso,
    read_yaml,
    require_file,
    sha256_file,
    write_yaml,
)


MANIFEST_NAME = "requirements-consolidation-manifest.json"
DRAFT_NAME = "requirements-consolidation-draft.md"


from lib.ai_common import task_transactional


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Apply a reviewed, manifest-verified requirements-consolidation draft, replacing task.md"
    )
    parser.add_argument("task_id")
    parser.add_argument("--approved-by", required=True)
    args = parser.parse_args()

    approved_by = args.approved_by.strip()
    if not approved_by:
        raise SystemExit("--approved-by must be non-empty (after trimming whitespace)")

    td = ensure_task(args.task_id)
    state = read_yaml(td / "state.yaml")
    if state.get("status") != "completed":
        raise SystemExit(
            "Requirements consolidation can only be applied while the task is "
            f"completed; found status={state.get('status')}"
        )
    change_cycle = int(state.get("change_cycle", 0))
    consolidated_through = int(state.get("requirements_consolidated_through_cycle", 0) or 0)
    if change_cycle <= consolidated_through:
        raise SystemExit("No pending consolidation draft to apply")

    draft_path = require_file(
        td / DRAFT_NAME,
        "requirements consolidation draft",
        f"run ./ai/bin/ai task consolidate-requirements {args.task_id}",
    )
    manifest_path = require_file(
        td / MANIFEST_NAME,
        "requirements consolidation manifest",
        f"run ./ai/bin/ai task consolidate-requirements {args.task_id}",
    )

    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Consolidation manifest is not valid JSON: {exc}") from exc

    task_md = td / "task.md"
    problems: list[str] = []

    if manifest.get("task_id") != args.task_id:
        problems.append(f"manifest task_id mismatch: manifest={manifest.get('task_id')!r}, expected={args.task_id!r}")
    if manifest.get("target_change_cycle") != change_cycle:
        problems.append(
            "out-of-cycle draft: manifest targets change_cycle="
            f"{manifest.get('target_change_cycle')!r}, current state.yaml change_cycle={change_cycle}"
        )
    if manifest.get("source_consolidated_through_cycle") != consolidated_through:
        problems.append(
            "stale draft: manifest was generated from requirements_consolidated_through_cycle="
            f"{manifest.get('source_consolidated_through_cycle')!r}, current state.yaml value={consolidated_through}"
        )

    task_md_hash = sha256_file(task_md) if task_md.is_file() else None
    if task_md_hash != manifest.get("source_task_md_sha256"):
        problems.append("task.md has changed since the draft was generated (source_task_md_sha256 mismatch)")

    for entry in manifest.get("addenda", []):
        addendum_path = ROOT / entry.get("path", "")
        if not addendum_path.is_file():
            problems.append(f"source addendum is missing: {entry.get('path')}")
            continue
        if sha256_file(addendum_path) != entry.get("sha256"):
            problems.append(f"source addendum changed since the draft was generated: {entry.get('path')}")

    draft_text = draft_path.read_text(encoding="utf-8")
    if not draft_text.strip():
        problems.append("draft is empty")
    elif sha256_file(draft_path) != manifest.get("draft_sha256"):
        problems.append("draft was edited or regenerated after the manifest was written (draft_sha256 mismatch)")

    if problems:
        raise SystemExit(
            "Refusing to apply requirements consolidation:\n- " + "\n- ".join(problems)
            + "\nRegenerate with consolidate-requirements before applying."
        )

    history_dir = td / "task-md-history" / f"consolidated-{consolidated_through + 1:03d}-to-{change_cycle:03d}"
    history_dir.mkdir(parents=True, exist_ok=True)
    # Preserve full provenance (old task.md, the applied draft, and the manifest that
    # proved its source hashes) instead of deleting it once applied.
    atomic_write(history_dir / "task.md", task_md.read_text(encoding="utf-8") if task_md.is_file() else "")
    shutil.copy2(draft_path, history_dir / DRAFT_NAME)
    shutil.copy2(manifest_path, history_dir / MANIFEST_NAME)

    # Update task.md itself atomically (temp file + rename); state.yaml is already
    # written atomically by write_yaml. The backup above is written first so a crash
    # between these steps leaves recoverable provenance rather than silent data loss.
    atomic_write(task_md, draft_text)
    draft_path.unlink()
    manifest_path.unlink()

    state["requirements_consolidated_through_cycle"] = change_cycle
    state.setdefault("requirements_consolidation_history", []).append(
        {
            "folded_cycles": f"{consolidated_through + 1}..{change_cycle}",
            "approved_by": approved_by,
            "applied_at": now_iso(),
            "history_dir": str(history_dir.relative_to(ROOT)),
        }
    )
    write_yaml(td / "state.yaml", state)

    print(f"Applied: folded cycles {consolidated_through + 1}..{change_cycle} into task.md")
    print(f"Previous task.md, draft and manifest preserved in: {history_dir.relative_to(ROOT)}")


main = task_transactional(main)
if __name__ == "__main__":
    main()
