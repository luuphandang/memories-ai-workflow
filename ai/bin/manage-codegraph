#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import ROOT, ensure_task, read_yaml
from lib.codegraph import inspect_task_repositories


def main() -> None:
    parser = argparse.ArgumentParser(description="Prepare or inspect CodeGraph indexes for a task")
    parser.add_argument("task_id")
    parser.add_argument("--init", action="store_true", help="Create missing indexes")
    parser.add_argument("--no-sync", action="store_true", help="Do not incrementally sync existing indexes")
    args = parser.parse_args()
    task = read_yaml(ensure_task(args.task_id) / "task.yaml")
    result = inspect_task_repositories(
        ROOT, task, initialize=args.init, sync=not args.no_sync
    )
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if any(not item.get("ready") for item in result.values()):
        raise SystemExit(1)


if __name__ == "__main__":
    main()
