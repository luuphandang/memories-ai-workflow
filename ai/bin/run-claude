#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import (
    AI_ROOT,
    ROOT,
    enforce_global_git_policy,
    ensure_task,
    env_timeout_seconds,
    now_iso,
    read_yaml,
    read_json,
    requirement_documents,
    run,
    runtime_dir,
    append_agent_metric,
    skill_manifest,
    verify_locked_skills,
    validate_json,
    run_delivery_quality_gates,
    write_yaml,
    active_execution_slice,
    token_budget,
)
from lib.codegraph import claude_mcp_config, prompt_guidance


INTERRUPTION_MARKERS = (
    "hit your session limit",
    "usage limit",
    "rate limit",
    "quota exceeded",
    "credit balance",
    "maximum context length",
    "context window",
)

# result.subtype values that mean Claude stopped on its own configured cap
# rather than a real Anthropic-side usage/rate limit.
CAP_SUBTYPES = ("error_max_turns", "error_max_budget_usd")

# rate_limit_info.status values that do NOT indicate the request was blocked
# (e.g. "allowed_warning" is still an allowed request, just close to a
# threshold); anything else, including unknown future statuses, is treated
# as a real block.
NON_BLOCKING_RATE_LIMIT_STATUSES = ("allowed", "allowed_warning")


def classify_termination(output: str) -> tuple[str, str]:
    """Classify why a non-zero-exit Claude invocation stopped.

    Returns (category, detail). category is one of:
    - "usage_limit": a real Anthropic-side rate/usage limit was hit
    - "turn_or_budget_cap": Claude stopped after its own turn/budget cap
    - "ok": the structured result event reports a normal/non-limit outcome
    - "unstructured": no structured result event was found at all

    Structured JSONL events (rate_limit_event, result) are parsed and trusted
    first. Free-text marker matching is used only as a fallback over lines
    that are NOT valid JSON, so assistant-generated prose that happens to
    mention e.g. "rate limit" as a normal domain term (inside a JSON
    "assistant" message event) is never mistaken for a real interruption.
    """
    result_event: dict | None = None
    rate_limited = False
    unstructured_lines: list[str] = []
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            if line.strip():
                unstructured_lines.append(line)
            continue
        if not isinstance(event, dict):
            continue
        if event.get("type") == "rate_limit_event":
            status = (event.get("rate_limit_info") or {}).get("status")
            if status and status not in NON_BLOCKING_RATE_LIMIT_STATUSES:
                rate_limited = True
        elif event.get("type") == "result":
            result_event = event

    if rate_limited:
        return "usage_limit", "rate_limit_info.status != allowed"
    if result_event is not None:
        subtype = result_event.get("subtype")
        if subtype in CAP_SUBTYPES:
            return "turn_or_budget_cap", subtype
        return "ok", subtype or "unknown"

    unstructured = "\n".join(unstructured_lines).lower()
    if any(marker in unstructured for marker in INTERRUPTION_MARKERS):
        return "usage_limit", "unstructured output marker match"
    return "unstructured", "no result event found"


def stream_metadata(output: str) -> tuple[str | None, str, dict]:
    """Extract the persisted Claude session id and final printable response."""
    session_id = None
    final_text = ""
    usage: dict = {}
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict):
            session_id = event.get("session_id") or session_id
            if event.get("type") == "result" and isinstance(event.get("result"), str):
                final_text = event["result"]
                usage = event.get("usage") or {}
                for key in ("total_cost_usd", "duration_ms", "duration_api_ms", "num_turns"):
                    if key in event:
                        usage[key] = event[key]
    return session_id, final_text, usage


def git_resume_summary(task: dict) -> str:
    sections: list[str] = []
    for item in task.get("worktrees", []):
        path = ROOT / item["path"]
        status = run(["git", "status", "--short"], cwd=path, timeout=30).stdout.strip()
        stat = run(["git", "diff", "--stat"], cwd=path, timeout=30).stdout.strip()
        sections.append(
            f"## {item['repo']} ({item['path']})\n"
            f"### Status\n```text\n{status or '(clean)'}\n```\n"
            f"### Diff stat\n```text\n{stat or '(no tracked diff)'}\n```"
        )
    return "\n\n".join(sections)


def timeout_output(exc: subprocess.TimeoutExpired) -> str:
    value = exc.stdout or ""
    return value.decode(errors="replace") if isinstance(value, bytes) else value


def main() -> None:
    parser = argparse.ArgumentParser(description="Run Claude implementer")
    parser.add_argument("task_id")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--print-command", action="store_true")
    args = parser.parse_args()

    td = ensure_task(args.task_id)
    task = read_yaml(td / "task.yaml")
    enforce_global_git_policy(task)
    state = read_yaml(td / "state.yaml")
    previous_status = state.get("status")
    runtime = runtime_dir(args.task_id)
    requirements = requirement_documents(args.task_id, include_user_request=True)
    context_lock = read_json(td / "context.lock.json")
    codegraph_guidance = prompt_guidance(ROOT, context_lock)
    budget = token_budget()
    active_slice = active_execution_slice(args.task_id)
    slice_id = active_slice.get("id") if active_slice else None
    required_skills = task.get("skills", {}).get("implement", [])
    locked_skills = context_lock.get("skills", {}).get("locked", {})
    verify_locked_skills(context_lock)
    skill_lines: list[str] = []
    for name in required_skills:
        locked = locked_skills.get(name)
        if not locked:
            raise SystemExit(f"Required implement skill is not context-locked: {name}; run prepare-context")
        skill_path = ROOT / locked["path"]
        if not skill_path.is_file():
            raise SystemExit(f"Required implement skill is missing: {skill_path}")
        skill_lines.append(f"- ${name}: {locked['path']} (sha256 {locked['sha256']})")
    checkpoint_path = td / "implementation-progress.json"
    if not checkpoint_path.exists():
        checkpoint = json.loads(
            (AI_ROOT / "templates" / "implementation-progress.json")
            .read_text(encoding="utf-8")
            .replace("{{TASK_ID}}", args.task_id)
        )
        checkpoint["implementation_cycle"] = int(state.get("implementation_cycle", 1))
        checkpoint["change_cycle"] = int(state.get("change_cycle", 0))
        checkpoint_path.write_text(
            json.dumps(checkpoint, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )

    attempt = int(state.get("implementation_attempt", 0)) + 1
    resume_context_path = runtime / "input" / f"resume-context-attempt-{attempt:03d}.md"
    resume_context_path.write_text(
        "# Existing worktree state\n\n" + git_resume_summary(task) + "\n",
        encoding="utf-8",
    )
    fix_requests = list((runtime / "input").glob("fix-request-*.md"))
    latest_fix_request = max(fix_requests, key=lambda path: path.stat().st_mtime).relative_to(ROOT) if fix_requests else None

    requirement_lines = "\n".join(f"- {path}" for path in requirements)
    required_skill_lines = "\n".join(skill_lines) or "- none"
    worktree_lines = "\n".join(
        f"- {item['repo']}: {item['path']}" for item in task.get("worktrees", [])
    )
    evidence_key_lines = "- none (execution plan not required)"
    slice_scope = "No execution-plan slice; use the smallest coherent task scope."
    evidence_check_command = ""
    slice_instruction = "Work ONLY on this selected slice; finish the session after its checkpoint/evidence is updated:"
    other_slices_instruction = "- Do not investigate, implement, or revalidate other slices."
    post_review_correction = False
    plan_slices: list = []
    correction_scope_mode: str | None = None
    correction_scope_reason: str | None = None
    correction_scope_slices: list[str] = []
    bundle_slices: list = []
    if task.get("scope", {}).get("execution_plan_required", False):
        execution_plan = read_json(td / "execution-plan.json")
        plan_slices = execution_plan.get("slices", [])
        plan_by_id = {item["id"]: item for item in plan_slices}
        plan_complete = bool(plan_slices) and all(item.get("status") == "completed" for item in plan_slices)
        if active_slice is None and plan_complete and fix_requests:
            post_review_correction = True
            # Prefer the machine-readable correction-scope sidecar (written by
            # request-fixes) for the latest review-driven fix request, so an
            # unaffected completed slice's evidence is left untouched instead of
            # forcing a full-plan re-scan on every correction.
            review_fix_requests = sorted((runtime / "input").glob("fix-request-review-*.md"))
            latest_review_fix_request = review_fix_requests[-1] if review_fix_requests else None
            scope_manifest = None
            if latest_review_fix_request is not None:
                scope_path = latest_review_fix_request.with_name(
                    latest_review_fix_request.name.replace("fix-request-review-", "correction-scope-review-", 1).replace(".md", ".json")
                )
                if scope_path.is_file():
                    scope_manifest = read_json(scope_path)

            impacted_ids = [
                sid for sid in (scope_manifest or {}).get("impacted_slices", []) if sid in plan_by_id
            ] if scope_manifest else []
            use_scoped = bool(scope_manifest) and not scope_manifest.get("full_plan_fallback_required") and bool(impacted_ids)

            if use_scoped:
                dependency_ids = {dep for sid in impacted_ids for dep in plan_by_id[sid].get("depends_on", [])}
                scoped_ids = set(impacted_ids) | dependency_ids
                scoped_slices = [item for item in plan_slices if item["id"] in scoped_ids]
                bundle_slices = scoped_slices
                correction_scope_mode = "slices"
                correction_scope_slices = sorted(impacted_ids)
                evidence_key_lines = "\n".join(f"- `slice:{sid}`" for sid in impacted_ids)
                slice_scope = json.dumps(scoped_slices, ensure_ascii=False, indent=2)
                slice_instruction = (
                    "This is a post-review correction. The latest Codex finding(s) were mapped to the "
                    "slice(s) below (their direct dependencies are also included, for context only):"
                )
                other_slices_instruction = (
                    "- Fix ONLY the impacted slice(s) listed above (not their dependencies). Do not touch, "
                    "re-verify, or re-implement any other slice; preserve their existing evidence exactly "
                    "as recorded in implementation.json."
                )
                evidence_check_command = (
                    f"- Before finishing, run `python3 ai/skills/review-vertical-slice-completeness/scripts/"
                    f"build_evidence_matrix.py ai/tasks/{args.task_id}/execution-plan.json "
                    f"ai/tasks/{args.task_id}/implementation.json`; do not finish while it reports missing criteria."
                )
            else:
                bundle_slices = plan_slices
                correction_scope_mode = "full_plan"
                correction_scope_reason = (
                    (scope_manifest or {}).get("full_plan_fallback_reason")
                    or "no correction-scope manifest available for the latest fix request"
                )
                evidence_key_lines = "\n".join(f"- `slice:{item['id']}`" for item in plan_slices)
                slice_scope = json.dumps(plan_slices, ensure_ascii=False, indent=2)
                slice_instruction = (
                    "The plan is fully complete; this is a post-review correction that could not be safely "
                    f"scoped to specific slices ({correction_scope_reason}). A Codex finding may be in any "
                    "slice below, so investigate and fix wherever the finding actually is:"
                )
                other_slices_instruction = "- Preserve evidence for slices unaffected by the finding; do not redo unrelated work."
                evidence_check_command = (
                    f"- Before finishing, run `python3 ai/skills/review-vertical-slice-completeness/scripts/"
                    f"build_evidence_matrix.py ai/tasks/{args.task_id}/execution-plan.json "
                    f"ai/tasks/{args.task_id}/implementation.json`; do not finish while it reports missing criteria."
                )
        elif active_slice is None:
            raise SystemExit("No runnable execution-plan slice remains; reconcile completed evidence before implementing")
        else:
            evidence_key_lines = f"- `slice:{active_slice['id']}`"
            slice_scope = json.dumps(active_slice, ensure_ascii=False, indent=2)
            remaining = [item for item in plan_slices if item.get("status") != "completed"]
            if len(remaining) == 1:
                evidence_check_command = (
                    f"- This is the final slice. Before finishing, run `python3 ai/skills/review-vertical-slice-completeness/scripts/"
                    f"build_evidence_matrix.py ai/tasks/{args.task_id}/execution-plan.json "
                    f"ai/tasks/{args.task_id}/implementation.json`; do not finish while it reports missing criteria."
                )
            else:
                evidence_check_command = "- Record concrete evidence for this slice; the global evidence matrix runs after the final slice."
    context_bundle = {
        "task_id": args.task_id,
        "slice": active_slice,
        "slices": bundle_slices if post_review_correction else None,
        "requirements": requirements,
        "knowledge": [item.get("path") for item in context_lock.get("files", []) if item.get("category") == "knowledge"],
        "worktrees": task.get("worktrees", []),
        "instruction": "Read only this bundle initially; expand to locked files on demand when directly relevant to the selected slice.",
    }
    bundle_path = runtime / "input" / f"slice-context-{slice_id or 'task'}.json"
    bundle_path.write_text(json.dumps(context_bundle, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    prompt = f"""Implement Jira item {args.task_id}.

Code intelligence:
{codegraph_guidance}

Current implementation cycle: {state.get('implementation_cycle', 1)}
Current change cycle: {state.get('change_cycle', 0)}

Read common rules and requirement documents in this order:
- ai/agents/common.md
- ai/agents/claude-implementer.md
- Start with compact context bundle: {bundle_path.relative_to(ROOT)}
- Read only the requirement sections and locked knowledge directly relevant to the selected slice.
- ai/tasks/{args.task_id}/task.yaml
- ai/tasks/{args.task_id}/context.yaml
- ai/tasks/{args.task_id}/context.lock.json

Worktrees:
{worktree_lines}

Required implementation skills (read each SKILL.md completely and apply it):
{required_skill_lines}

Execution plan:
- ai/tasks/{args.task_id}/execution-plan.json
- {slice_instruction}
{slice_scope}
{other_slices_instruction}
- In implementation.json use exact criterion strings, or one `slice:<slice-id>` entry
  with complete evidence for a fully passed slice. Keep failures/waivers criterion-specific.
- Required slice evidence keys for this exact plan are:
{evidence_key_lines}
{evidence_check_command}

Session execution:
- Continue until the assigned implementation work is complete; there is no workflow-imposed agent-turn limit.
- Prefer batched reads/searches and bundled validation commands.
- Do not repeatedly update todos or narrate individual commands.

Continuation protocol:
- This is implementation attempt {attempt}. Previous status: {previous_status}.
- Read ai/tasks/{args.task_id}/implementation-progress.json first.
- Read {resume_context_path.relative_to(ROOT)} for a compact snapshot of existing changes.
- Treat existing worktree changes as work to inspect and continue; do not redo completed work.
- Update implementation-progress.json before coding and after each meaningful milestone,
  validation run, decision, or newly discovered remaining step. Keep it concise and valid
  against ai/schemas/implementation-progress.schema.json.
- The checkpoint is a recovery aid, not the final implementation handoff.
{f'- Read and resolve the latest fix request: {latest_fix_request}' if latest_fix_request else '- No fix request is pending.'}

The newest requirement addendum wins only for conflicts it explicitly changes.
Work only in registered worktrees. Do not create worktrees, commit, push,
change branch, or manage Git worktrees.

Write the final structured handoff to:
ai/tasks/{args.task_id}/implementation.json

Keep implementation.json concise (target under 64 KiB): reference validation/evidence artifact paths
instead of embedding logs, repeated execution-plan text, or long test output.
Merge this slice into the existing handoff: preserve evidence, changed files, decisions, and
applied-skill records from completed slices; do not replace the artifact with only this slice.

The output must match ai/schemas/implementation.schema.json and include
implementation_cycle, change_cycle, and applied_skills with the locked hashes
and deterministic checks completed for every required implementation skill.
"""
    command = os.environ.get("CLAUDE_COMMAND", "claude")
    timeout_seconds = env_timeout_seconds("CLAUDE_TIMEOUT_SECONDS", 3600)
    session_id = state.get("claude_session_id") if previous_status == "interrupted" else None
    if session_id and state.get("interrupted_slice") not in (None, slice_id):
        session_id = None
    invocation_prompt = prompt
    if session_id:
        invocation_prompt = f"""Continue implementing Jira item {args.task_id} in the existing session.

This is attempt {attempt}. Do not repeat completed investigation or implementation.
Read the current ai/tasks/{args.task_id}/implementation-progress.json and
{resume_context_path.relative_to(ROOT)}, reconcile them with the existing worktree,
then continue from current_step/remaining_steps. Keep the checkpoint current after
each milestone. Finish by writing ai/tasks/{args.task_id}/implementation.json.
Use these exact slice evidence keys for completed execution-plan slices:
{evidence_key_lines}
{evidence_check_command}
"""
    (runtime / "input" / "claude-prompt.md").write_text(invocation_prompt, encoding="utf-8")

    cmd = [command, "-p", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions"]
    mcp_config = claude_mcp_config(ROOT, context_lock)
    if mcp_config["mcpServers"]:
        mcp_config_path = runtime / "input" / "codegraph-mcp.json"
        mcp_config_path.write_text(json.dumps(mcp_config, indent=2) + "\n", encoding="utf-8")
        # claude's --mcp-config takes a variadic list (`<configs...>`), so a
        # separate "--mcp-config", path pair would swallow the trailing
        # invocation_prompt positional as an extra (bogus) config file
        # whenever no --resume flag sits between them; `=` pins it to one value.
        cmd.append(f"--mcp-config={mcp_config_path}")
    if session_id:
        cmd.extend(["--resume", str(session_id)])
    cmd.append(invocation_prompt)
    if args.print_command or args.dry_run:
        print(" ".join(shlex.quote(value) for value in cmd))
        print(f"Timeout: {timeout_seconds} seconds")
        if args.dry_run:
            return

    state["status"] = "implementing"
    state["implementation_attempt"] = attempt
    state.setdefault("timestamps", {})["implementation_started_at"] = now_iso()
    write_yaml(td / "state.yaml", state)

    log_path = runtime / "exchange" / f"claude-session-attempt-{attempt:03d}.jsonl"
    started_monotonic = time.monotonic()
    try:
        result = run(cmd, cwd=ROOT, timeout=timeout_seconds)
    except subprocess.TimeoutExpired as exc:
        partial_output = timeout_output(exc)
        log_path.write_text(partial_output, encoding="utf-8")
        state = read_yaml(td / "state.yaml")
        detected_session_id, _, usage = stream_metadata(partial_output)
        if detected_session_id:
            state["claude_session_id"] = detected_session_id
        state["interrupted_slice"] = slice_id
        state["last_implementation_log"] = str(log_path)
        state["status"] = "interrupted"
        state["last_error"] = (
            f"Claude timed out after {timeout_seconds} seconds. Retry implement to resume "
            f"from the checkpoint; inspect {log_path}."
        )
        state.setdefault("timestamps", {})["implementation_finished_at"] = now_iso()
        write_yaml(td / "state.yaml", state)
        append_agent_metric(args.task_id, {"generated_at": now_iso(), "agent": "claude", "phase": "implement", "attempt": attempt, "implementation_cycle": int(state.get("implementation_cycle", 1)), "change_cycle": int(state.get("change_cycle", 0)), "status": "interrupted", "duration_seconds": round(time.monotonic() - started_monotonic, 2), "resumed": bool(session_id), "session_id": detected_session_id or session_id, "usage": usage})
        raise SystemExit(state["last_error"])

    log_path.write_text(result.stdout, encoding="utf-8")
    state = read_yaml(td / "state.yaml")
    detected_session_id, final_text, usage = stream_metadata(result.stdout)
    if detected_session_id:
        state["claude_session_id"] = detected_session_id
    state["last_implementation_log"] = str(log_path)
    state.setdefault("timestamps", {})["implementation_finished_at"] = now_iso()
    if result.returncode != 0:
        category, detail = classify_termination(result.stdout)
        if category == "usage_limit":
            state["status"] = "interrupted"
            state["last_error"] = f"Claude was interrupted by a usage/session limit ({detail}); retry implement to resume. See {log_path}"
        elif category == "turn_or_budget_cap":
            state["status"] = "interrupted"
            state["last_error"] = f"Claude stopped after reaching its own turn/budget cap ({detail}); retry implement to resume. See {log_path}"
        else:
            state["status"] = "failed"
            state["last_error"] = f"Claude exited {result.returncode}; see {log_path}"
    else:
        checker_failures: list[str] = []
        handoff_path = td / "implementation.json"
        if not handoff_path.is_file():
            checker_failures.append("missing implementation.json handoff")
        else:
            try:
                validate_json(handoff_path, AI_ROOT / "schemas" / "implementation.schema.json")
                handoff = read_json(handoff_path)
                applied = {item.get("name"): item for item in handoff.get("applied_skills", [])}
                missing_applied = [name for name in required_skills if name not in applied]
                stale_applied = [name for name in required_skills if name in applied and applied[name].get("sha256") != locked_skills[name]["sha256"]]
                if missing_applied or stale_applied:
                    checker_failures.append("handoff required skills missing=" + ",".join(missing_applied) + "; stale=" + ",".join(stale_applied))
            except Exception as exc:
                checker_failures.append(f"invalid implementation handoff: {exc}")
        if "implement-nestjs-vertical-slice" in required_skills:
            checker = AI_ROOT / "skills" / "implement-nestjs-vertical-slice" / "scripts" / "check_port_bindings.py"
            for item in task.get("worktrees", []):
                check = run([sys.executable, str(checker), str(ROOT / item["path"])], cwd=ROOT, timeout=120)
                check_log = runtime / "validation" / f"skill-port-bindings-{item['repo']}.log"
                check_log.write_text(check.stdout, encoding="utf-8")
                if check.returncode != 0:
                    checker_failures.append(f"{item['repo']}: {check.stdout.strip()}")
        plan_complete = True
        if task.get("scope", {}).get("execution_plan_required", False):
            current_plan = read_json(td / "execution-plan.json")
            plan_complete = all(item.get("status") == "completed" for item in current_plan.get("slices", []))
        if not checker_failures and plan_complete:
            try:
                run_delivery_quality_gates(args.task_id, handoff)
            except SystemExit as exc:
                checker_failures.append(str(exc))
        if checker_failures:
            state["status"] = "failed"
            state["last_error"] = "Required skill checks failed: " + " | ".join(checker_failures)
            result = subprocess.CompletedProcess(result.args, 3, result.stdout)
        else:
            state["status"] = "prepared"
            state["last_error"] = None
            state["last_completed_slice"] = slice_id
    if post_review_correction:
        # Record the scoping decision (and fallback reason, if any) in state, not only
        # in metrics, so it's visible without digging through agent-attempts.jsonl.
        state["last_correction_implementation_scope"] = {
            "mode": correction_scope_mode,
            "slices": correction_scope_slices,
            "full_plan_fallback_reason": correction_scope_reason,
        }
    write_yaml(td / "state.yaml", state)
    context_tokens = sum(int(usage.get(key, 0) or 0) for key in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
    if context_tokens >= budget["warn_context_tokens"]:
        state.setdefault("budget_warnings", []).append(f"attempt {attempt} slice {slice_id or 'whole-task'} used {context_tokens} context tokens")
        if context_tokens >= budget["max_context_tokens"]:
            state["last_budget_breach"] = {"attempt": attempt, "slice": slice_id, "context_tokens": context_tokens, "action": "next work continues in a fresh bounded session"}
        write_yaml(td / "state.yaml", state)
    append_agent_metric(args.task_id, {"generated_at": now_iso(), "agent": "claude", "phase": "implement", "attempt": attempt, "implementation_cycle": int(state.get("implementation_cycle", 1)), "change_cycle": int(state.get("change_cycle", 0)), "status": state["status"], "duration_seconds": round(time.monotonic() - started_monotonic, 2), "resumed": bool(session_id), "session_id": detected_session_id or session_id, "slice_id": slice_id, "budget": budget, "usage": usage, "correction_scope_mode": correction_scope_mode, "correction_scope_slices": correction_scope_slices, "correction_scope_fallback_reason": correction_scope_reason})
    print(final_text or result.stdout)
    raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
