#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import AI_ROOT, ROOT, ensure_task, now_iso, read_json, read_yaml, runtime_dir, write_yaml


def invoke(args: list[str]) -> int:
    print("RUN:", " ".join(args), flush=True)
    result = subprocess.run(args, text=True, check=False)
    return result.returncode


def repository_fingerprint(task: dict) -> str:
    """Hash tracked diffs and untracked contents across registered worktrees."""
    digest = hashlib.sha256()
    for item in sorted(task.get("worktrees", []), key=lambda value: value.get("repo", "")):
        repo = ROOT / item["path"]
        digest.update(str(item.get("repo", "")).encode())
        diff = subprocess.run(
            ["git", "diff", "--binary", "HEAD", "--"],
            cwd=repo,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        digest.update(diff.stdout)
        untracked = subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard", "-z"],
            cwd=repo,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        for raw_path in sorted(path for path in untracked.stdout.split(b"\0") if path):
            digest.update(raw_path)
            path = repo / raw_path.decode("utf-8", errors="surrogateescape")
            if path.is_file():
                digest.update(path.read_bytes())
    return digest.hexdigest()


def is_no_progress_failure(code: int, status: str | None, before: str, after: str) -> bool:
    return (code != 0 or status == "failed") and before == after


def validation_fix_request(task_id: str, attempt: int) -> Path:
    runtime = runtime_dir(task_id)
    summary_path = runtime / "validation" / "summary.json"
    summary = read_json(summary_path) if summary_path.exists() else {}
    lines = [
        f"# Validation fix request — {task_id} — automation attempt {attempt}", "",
        "Fix the required validation failures below without weakening or bypassing validation.",
        "Inspect the full current-cycle validation artifacts and update implementation.json.", "",
    ]
    for repo in summary.get("repositories", []):
        for item in repo.get("commands", []):
            if item.get("required") and item.get("status") not in {"passed", "planned"}:
                tail = item.get("output_tail", "").splitlines()[-40:]
                lines.extend([f"## {repo.get('repo')} — {item.get('name')}", "", f"- Command: `{item.get('command', '')}`", f"- Status: {item.get('status')}", f"- Full log: `{summary_path.relative_to(ROOT)}`", f"- Relevant output (last {len(tail)} lines):\n\n```text\n" + "\n".join(tail) + "\n```", ""])
    path = runtime / "input" / f"fix-request-validation-attempt-{attempt:03d}.md"
    path.write_text("\n".join(lines), encoding="utf-8")
    return path


def delivery_gate_fix_request(task_id: str, attempt: int) -> Path | None:
    runtime = runtime_dir(task_id)
    gate_path = runtime / "validation" / "skills" / "delivery-gates.json"
    gate = read_json(gate_path) if gate_path.exists() else {}
    if gate.get("passed") is True or not gate.get("failures"):
        return None
    lines = [
        f"# Delivery-gate fix request — {task_id} — automation attempt {attempt}", "",
        "Fix the implementation handoff or implementation defects reported below without weakening or bypassing the gates.",
        "For acceptance-evidence failures, use the exact criterion strings from execution-plan.json or add one passed `slice:<slice-id>` entry with concrete evidence for each fully completed slice.", "",
        "## Failed gates", "",
    ]
    for check in gate.get("checks", []):
        if check.get("passed"):
            continue
        lines.append(f"- {check.get('name')}")
        for missing in check.get("missing", []):
            lines.append(f"  - missing: {missing}")
        if check.get("output"):
            tail = check["output"].splitlines()[-40:]
            lines.extend(["", "```text", "\n".join(tail), "```"])
    path = runtime / "input" / f"fix-request-delivery-gates-attempt-{attempt:03d}.md"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def main() -> None:
    parser = argparse.ArgumentParser(description="Autonomously run implement/validate/review/fix cycles")
    parser.add_argument("task_id")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--max-attempts", type=int, help="Maximum implement attempts for this run; defaults to review.max_cycles")
    parser.add_argument("--resume-interrupted", action="store_true", help="Retry an interrupted Claude session within this run")
    parser.add_argument("--max-interrupted-retries", type=int, default=1)
    args = parser.parse_args()
    td = ensure_task(args.task_id)
    task = read_yaml(td / "task.yaml")
    pending_slices = 0
    plan_path = td / "execution-plan.json"
    if task.get("scope", {}).get("execution_plan_required", False) and plan_path.exists():
        pending_slices = sum(item.get("status") != "completed" for item in read_json(plan_path).get("slices", []))
    correction_budget = int(task.get("review", {}).get("max_cycles", 5))
    max_attempts = args.max_attempts or max(correction_budget, pending_slices + correction_budget)
    if max_attempts <= 0 or args.max_interrupted_retries < 0:
        raise SystemExit("max attempts/retries must be positive/non-negative")
    commands = ["implement", "validate-code", "review", "request-fixes", "report"]
    if args.dry_run:
        print(f"Autonomous task run: max_attempts={max_attempts}, resume_interrupted={args.resume_interrupted}")
        for command in commands:
            print(f"- ./ai/bin/ai task {command} {args.task_id}")
        print("Stops at awaiting_user_acceptance; never runs accept.")
        return

    state = read_yaml(td / "state.yaml")
    if state.get("status") == "completed":
        raise SystemExit("Task is already completed; create a requirement-change cycle first")
    if state.get("status") == "interrupted" and not args.resume_interrupted:
        raise SystemExit("Task is interrupted; re-run with --resume-interrupted after quota/availability is restored")

    state["automation"] = {"status": "running", "started_at": now_iso(), "max_attempts": max_attempts, "attempts": 0}
    write_yaml(td / "state.yaml", state)
    interrupted_retries = 0
    attempt = 0
    while attempt < max_attempts:
        attempt += 1
        state = read_yaml(td / "state.yaml")
        state["automation"]["attempts"] = attempt
        write_yaml(td / "state.yaml", state)

        before_fingerprint = repository_fingerprint(task)
        code = invoke([str(AI_ROOT / "bin" / "run-claude"), args.task_id])
        after_fingerprint = repository_fingerprint(task)
        state = read_yaml(td / "state.yaml")
        if state.get("status") == "interrupted":
            if args.resume_interrupted and interrupted_retries < args.max_interrupted_retries:
                interrupted_retries += 1
                attempt -= 1
                continue
            state["automation"].update({"status": "interrupted", "finished_at": now_iso()})
            write_yaml(td / "state.yaml", state)
            raise SystemExit(code or 1)
        if is_no_progress_failure(code, state.get("status"), before_fingerprint, after_fingerprint):
            state["status"] = "blocked"
            state["last_error"] = (
                "Implementation attempt made no code changes; automation stopped to prevent "
                "a no-progress retry loop"
            )
            state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
            write_yaml(td / "state.yaml", state)
            raise SystemExit(state["last_error"])
        if (
            (code != 0 or state.get("status") == "failed")
            and str(state.get("last_error", "")).startswith("Required skill checks failed:")
        ):
            request = delivery_gate_fix_request(args.task_id, attempt)
            if request is None:
                state.setdefault("automation", {}).update({"status": "stopped", "finished_at": now_iso()})
                write_yaml(td / "state.yaml", state)
                raise SystemExit(
                    "Implementation reported required-skill failures, but delivery-gates.json "
                    "is passing or contains no failures; refusing to queue an empty fix request"
                )
            print(f"Delivery quality gates failed; queued for next implementation attempt: {request}")
            if attempt < max_attempts:
                continue
            break
        if code != 0 or state.get("status") in {"failed", "blocked", "needs_input"}:
            state["automation"].update({"status": "stopped", "finished_at": now_iso()})
            write_yaml(td / "state.yaml", state)
            raise SystemExit(code or 1)

        plan_path = td / "execution-plan.json"
        plan_complete = True
        if task.get("scope", {}).get("execution_plan_required", False) and plan_path.exists():
            plan = read_json(plan_path)
            plan_complete = all(item.get("status") == "completed" for item in plan.get("slices", []))
        if not plan_complete:
            code = invoke([str(AI_ROOT / "bin" / "validate"), args.task_id, "--tier", "quick"])
            if code != 0:
                request = validation_fix_request(args.task_id, attempt)
                print(f"Quick slice validation failed; queued for next slice attempt: {request}")
                if attempt < max_attempts:
                    continue
                break
            print("Slice passed quick validation; continuing with a fresh bounded implementation session.")
            continue

        code = invoke([str(AI_ROOT / "bin" / "validate"), args.task_id, "--tier", "full"])
        if code != 0:
            request = validation_fix_request(args.task_id, attempt)
            print(f"Validation failed; queued for next implementation attempt: {request}")
            if attempt < max_attempts:
                continue
            break

        code = invoke([str(AI_ROOT / "bin" / "run-codex-review"), args.task_id])
        state = read_yaml(td / "state.yaml")
        if code != 0 or state.get("status") in {"failed", "blocked", "needs_input"}:
            state.setdefault("automation", {}).update({"status": "stopped", "finished_at": now_iso()})
            write_yaml(td / "state.yaml", state)
            raise SystemExit(code or 1)
        review = read_json(td / "review.json")
        if review.get("verdict") == "pass":
            state = read_yaml(td / "state.yaml")
            if state.get("last_review_mode") == "delta":
                print("Delta correction review passed; running one final full review before handoff.")
                code = invoke([str(AI_ROOT / "bin" / "run-codex-review"), args.task_id, "--mode", "full"])
                state = read_yaml(td / "state.yaml")
                if code != 0 or state.get("status") in {"failed", "blocked", "needs_input"}:
                    # Preserve the task status/last_error run-codex-review already wrote
                    # (timeout, blocked verdict, invalid output, ...); only terminate automation.
                    state.setdefault("automation", {}).update({"status": "stopped", "finished_at": now_iso()})
                    write_yaml(td / "state.yaml", state)
                    raise SystemExit(code or state.get("last_error") or "Final full review did not pass")
                review = read_json(td / "review.json")
                if review.get("verdict") == "changes_requested":
                    if attempt < max_attempts:
                        code = invoke([str(AI_ROOT / "bin" / "request-fixes"), args.task_id])
                        if code != 0:
                            state = read_yaml(td / "state.yaml")
                            state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
                            write_yaml(td / "state.yaml", state)
                            raise SystemExit(code)
                        continue
                    state = read_yaml(td / "state.yaml")
                    state["status"] = "blocked"
                    state["last_error"] = "Final full review requested changes but automation attempts are exhausted"
                    state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
                    write_yaml(td / "state.yaml", state)
                    raise SystemExit(state["last_error"])
                if review.get("verdict") != "pass":
                    # Defensive: run-codex-review's own gates should already have produced a
                    # non-zero exit / failed-blocked-needs_input status caught above.
                    state = read_yaml(td / "state.yaml")
                    state["status"] = "blocked"
                    state["last_error"] = f"Unexpected final full review verdict: {review.get('verdict')}"
                    state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
                    write_yaml(td / "state.yaml", state)
                    raise SystemExit(state["last_error"])
            code = invoke([str(AI_ROOT / "bin" / "finalize-task"), args.task_id])
            state = read_yaml(td / "state.yaml")
            state.setdefault("automation", {}).update({"status": "awaiting_user_acceptance", "finished_at": now_iso()})
            write_yaml(td / "state.yaml", state)
            raise SystemExit(code)
        if review.get("verdict") == "changes_requested":
            code = invoke([str(AI_ROOT / "bin" / "request-fixes"), args.task_id])
            if code != 0:
                state = read_yaml(td / "state.yaml")
                state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
                write_yaml(td / "state.yaml", state)
                raise SystemExit(code)
            continue
        state["status"] = "blocked"
        state["last_error"] = "Review did not return pass or changes_requested"
        state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
        write_yaml(td / "state.yaml", state)
        raise SystemExit(state["last_error"])

    state = read_yaml(td / "state.yaml")
    state["status"] = "blocked"
    state["last_error"] = f"Autonomous run reached maximum implementation attempts ({max_attempts})"
    state.setdefault("automation", {}).update({"status": "blocked", "finished_at": now_iso()})
    write_yaml(td / "state.yaml", state)
    raise SystemExit(state["last_error"])


if __name__ == "__main__":
    main()
