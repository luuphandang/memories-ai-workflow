#!/usr/bin/env python3
from __future__ import annotations
import argparse, contextlib, subprocess, time
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import AI_ROOT, enforce_global_git_policy, ensure_task, read_yaml, write_yaml, write_json, safe_workspace_path, run, git_value, dirty_worktree_hash, runtime_dir, now_iso
from lib.docker_infra import acquire_heavy_validation_slot, ensure_infra_up, infra_env_for_manifest, infra_gc


def main() -> None:
    p = argparse.ArgumentParser(description="Run deterministic repository validations")
    p.add_argument("task_id")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--include-optional", action="store_true")
    p.add_argument("--command", action="append", help="Only run named command; repeatable")
    p.add_argument("--tier", choices=("quick", "full"), default="full", help="Quick runs changed-scope static checks; full is required before final review")
    args = p.parse_args()
    td = ensure_task(args.task_id)
    task = read_yaml(td / "task.yaml")
    enforce_global_git_policy(task)
    try:
        infra_gc(best_effort=True)
    except Exception:
        pass  # opportunistic cleanup only; never let a GC hiccup block validation
    rt = runtime_dir(args.task_id)
    validation_dir = rt / "validation"

    state = read_yaml(td / "state.yaml")
    implementation_cycle = int(state.get("implementation_cycle", 1))
    change_cycle = int(state.get("change_cycle", 0))
    state["status"] = "validating"
    state.setdefault("timestamps", {})["validation_started_at"] = now_iso()
    write_yaml(td / "state.yaml", state)

    overall = True
    repo_summaries = []
    for wt in task.get("worktrees", []):
        repo = wt["repo"]
        wp = safe_workspace_path(wt["path"])
        config_path = AI_ROOT / "repos" / repo / "commands.yaml"
        if not config_path.exists():
            repo_summaries.append({"repo":repo,"passed":False,"error":f"Missing {config_path}"})
            overall = False
            continue
        commands_config = read_yaml(config_path).get("commands", {})
        selected = task.get("validation", {}).get(repo, list(commands_config))
        if args.tier == "quick" and not args.command:
            selected = [name for name in selected if name in {"lint", "typecheck", "test-architecture"}]
        if args.command: selected = [x for x in selected if x in args.command]

        # requires_infra commands need this task's own isolated Postgres/Redis/MinIO stack
        # (see ai/bin/lib/docker_infra.py) — provisioned/reused once per repo here, its ports
        # injected only into the subprocess env of the commands that actually declared they
        # need it, never into apps/backend/.env.
        needs_infra = (not args.dry_run) and any(commands_config.get(name, {}).get("requires_infra") for name in selected)
        infra_env: dict[str, str] = {}
        infra_error: str | None = None
        if needs_infra:
            try:
                infra_env = infra_env_for_manifest(ensure_infra_up(args.task_id, wp))
            except SystemExit as exc:
                infra_error = str(exc)

        results = []
        heavy_slot = acquire_heavy_validation_slot() if needs_infra else contextlib.nullcontext()
        with heavy_slot:
            for name in selected:
                spec = commands_config.get(name)
                if not spec:
                    results.append({"name":name,"status":"missing","required":True})
                    overall = False
                    continue
                required = bool(spec.get("required", True))
                if not required and not args.include_optional:
                    results.append({"name":name,"command":spec["command"],"status":"skipped","required":False})
                    continue
                if args.dry_run:
                    results.append({"name":name,"command":spec["command"],"status":"planned","required":required})
                    continue
                if spec.get("requires_infra") and infra_error:
                    results.append({"name":name,"command":spec["command"],"status":"error","required":required,"duration_seconds":0.0,"exit_code":None,"output_tail":f"infra provisioning failed: {infra_error}"})
                    if required: overall = False
                    continue
                started = time.time()
                try:
                    cp = run(spec["command"], cwd=wp, timeout=int(spec.get("timeout_seconds", 900)), shell=True, env=(infra_env if spec.get("requires_infra") else None))
                    status = "passed" if cp.returncode == 0 else "failed"
                    # Passed output is rarely inspected downstream; keep a short tail and
                    # reserve the full 12000-char tail for failures that need debugging.
                    output = cp.stdout[-12000:] if status != "passed" else cp.stdout[-300:]
                except Exception as exc:
                    status, output, cp = "error", str(exc), None
                item = {"name":name,"command":spec["command"],"status":status,"required":required,"duration_seconds":round(time.time()-started,2),"exit_code":None if cp is None else cp.returncode,"output_tail":output}
                results.append(item)
                if required and status != "passed": overall = False
        summary = {
            "task_id": args.task_id, "repo": repo, "path": wt["path"], "generated_at": now_iso(),
            "implementation_cycle": implementation_cycle, "change_cycle": change_cycle,
            "passed": all((not x.get("required")) or x["status"] in ("passed","planned") for x in results),
            "commands": results,
            "git": {"branch":git_value(wp,["branch","--show-current"]),"head":git_value(wp,["rev-parse","HEAD"]),"diff_stat":git_value(wp,["diff","--stat"],""),"dirty_snapshot_sha256":dirty_worktree_hash(wp)}
        }
        write_json(validation_dir / f"{repo}.json", summary)
        repo_summaries.append(summary)
    write_json(validation_dir / "summary.json", {"task_id":args.task_id,"generated_at":now_iso(),"implementation_cycle":implementation_cycle,"change_cycle":change_cycle,"passed":overall,"repositories":repo_summaries,"dry_run":args.dry_run,"tier":args.tier})

    # Full validation rewrites these JSON artifacts on every run (timestamps and
    # durations included). Rebind only those outputs immediately after producing
    # them, then publish provenance when every independently maintained input and
    # artifact is also current. This prevents validate -> review from invalidating
    # its own evidence without concealing stale source/input hashes.
    provenance_ok = True
    if overall and not args.dry_run and args.tier == "full":
        provenance_script = AI_ROOT / "skills" / "validate-evidence-provenance" / "scripts"
        refresh = subprocess.run(
            [
                sys.executable,
                str(provenance_script / "refresh_validation_artifacts.py"),
                str(td),
                str(validation_dir),
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        print(refresh.stdout, end="")
        if refresh.returncode == 0:
            sync = subprocess.run(
                [
                    sys.executable,
                    str(provenance_script / "sync_provenance.py"),
                    str(td),
                    str(validation_dir),
                ],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
            )
            print(sync.stdout, end="")
            if sync.returncode != 0:
                provenance_ok = False
                print("Validation passed, but provenance still has non-validation stale entries; update those before review.")
        else:
            provenance_ok = False
            print("Validation passed, but automatic validation-artifact provenance refresh failed.")

    state = read_yaml(td / "state.yaml")
    ready_for_review = overall and provenance_ok and not args.dry_run
    state["status"] = "reviewing" if ready_for_review else ("prepared" if overall else "failed")
    state.setdefault("timestamps", {})["validation_finished_at"] = now_iso()
    if not overall: state["last_error"] = "One or more required validations failed"
    elif not provenance_ok:
        state["last_error"] = "Validation commands passed, but evidence provenance is stale"
    write_yaml(td / "state.yaml", state)
    print(f"Validation {'PASSED' if overall else 'FAILED'}; see {validation_dir / 'summary.json'}")
    if (not overall or not provenance_ok) and not args.dry_run: raise SystemExit(1)

if __name__ == "__main__": main()
