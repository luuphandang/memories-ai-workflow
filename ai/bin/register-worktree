#!/usr/bin/env python3
from __future__ import annotations
import argparse
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import AI_ROOT, DEFAULT_BASE_REF, coordination_policy, ensure_task, read_yaml, write_yaml, safe_workspace_path, relative_to_root, git_value, runtime_dir, repository_identity
from lib.coordination import CoordinationStore
from lib.ai_common import task_transactional


def ensure_unique_writable_path(task_id: str, path: Path, writable: bool) -> None:
    if not writable:
        return
    canonical = path.resolve()
    # A completed task may be reopened and must retain its registered worktree. Only a
    # permanently failed record releases this registration guard; explicit worktree
    # deregistration/transfer can be added later if the developer wants reassignment.
    terminal = {"failed"}
    for candidate in (AI_ROOT / "tasks").iterdir():
        if not candidate.is_dir() or candidate.name == task_id:
            continue
        task_path = candidate / "task.yaml"
        state_path = candidate / "state.yaml"
        if not task_path.is_file() or not state_path.is_file():
            continue
        if read_yaml(state_path).get("status") in terminal:
            continue
        for registered in read_yaml(task_path).get("worktrees", []):
            if not registered.get("writable", True):
                continue
            try:
                existing = safe_workspace_path(registered["path"]).resolve()
            except (KeyError, SystemExit):
                continue
            if existing == canonical:
                raise SystemExit(
                    f"Writable worktree already owned by active task {candidate.name}: {registered['path']}"
                )


def main() -> None:
    p=argparse.ArgumentParser(description="Register a developer-created Git worktree")
    p.add_argument("task_id"); p.add_argument("--repo",required=True); p.add_argument("--path",required=True)
    p.add_argument("--base-ref", help=f"Integration target ref (default: task policy or {DEFAULT_BASE_REF})"); p.add_argument("--read-only",action="store_true"); p.add_argument("--allow-missing",action="store_true")
    args=p.parse_args(); td=ensure_task(args.task_id); wp=safe_workspace_path(args.path)
    if not wp.exists() and not args.allow_missing: raise SystemExit(f"Worktree path does not exist: {wp}")
    if wp.exists() and git_value(wp,["rev-parse","--is-inside-work-tree"],"false")!="true": raise SystemExit(f"Not a Git worktree: {wp}")
    with CoordinationStore().lock("worktree-registration"):
        ensure_unique_writable_path(args.task_id, wp, not args.read_only)
        task=read_yaml(td/"task.yaml")
        target_ref=args.base_ref or coordination_policy(task)["target_ref"]
        entry={"repo":args.repo,"path":relative_to_root(wp),"base_ref":target_ref,"target_ref":target_ref,"writable":not args.read_only}
        task["worktrees"]=[x for x in task.get("worktrees",[]) if x.get("repo")!=args.repo]+[entry]
        task.setdefault("validation",{}).setdefault(args.repo,["lint","typecheck","test","build"]); write_yaml(td/"task.yaml",task)
        context=read_yaml(td/"context.yaml")
        knowledge=AI_ROOT/"repos"/args.repo
        candidates=[
            ("INDEX.md","Repository knowledge index","initial"),
            ("architecture.md","Architecture and module boundaries","on-demand"),
            ("conventions.md","Repository conventions","on-demand"),
            ("testing.md","Testing requirements","on-demand"),
            ("source-map.md","Source navigation map","on-demand"),
        ]
        context.setdefault("repositories",{})[args.repo]=[
            {"path":f"ai/repos/{args.repo}/{name}","reason":reason,"load":load}
            for name,reason,load in candidates if (knowledge/name).is_file()
        ]
        write_yaml(td/"context.yaml",context)
        branch=git_value(wp,["branch","--show-current"]) if wp.exists() else "missing"
        state=read_yaml(td/"state.yaml")
        repo_identity=repository_identity(wp,args.repo) if wp.exists() else "missing"
        state.setdefault("repositories",{})[args.repo]={"path":entry["path"],"repository_id":repo_identity,"base_ref":target_ref,"target_ref":target_ref,"base_sha":git_value(wp,["rev-parse","HEAD"]) if wp.exists() else "missing","branch":branch,"registered_branch":branch}
        write_yaml(td/"state.yaml",state); runtime_dir(args.task_id); print(f"Registered {args.repo}: {entry['path']}")
main = task_transactional(main)
if __name__=="__main__": main()
