#!/usr/bin/env python3
from pathlib import Path
import os, shutil
ROOT = Path(__file__).resolve().parents[2]
AI = ROOT / "ai"
HOME = Path.home() / ".project-ai"
links = {
    HOME / "claude" / "CLAUDE.md": AI / "config" / "claude" / "CLAUDE.md",
    HOME / "claude" / "settings.json": AI / "config" / "claude" / "settings.json",
    HOME / "codex" / "AGENTS.md": AI / "config" / "codex" / "AGENTS.md",
    HOME / "codex" / "config.toml": AI / "config" / "codex" / "config.toml",
    HOME / "codex" / "review.config.toml": AI / "config" / "codex" / "review.config.toml",
}
for link, target in links.items():
    link.parent.mkdir(parents=True, exist_ok=True)
    if link.is_symlink() or link.exists(): link.unlink()
    link.symlink_to(target)
for product in ("claude", "codex"):
    skill_home = HOME / product / "skills"
    skill_home.mkdir(parents=True, exist_ok=True)
    for target in sorted((AI / "skills").iterdir()):
        if not (target / "SKILL.md").is_file():
            continue
        link = skill_home / target.name
        if link.is_symlink() or link.is_file():
            link.unlink()
        elif link.exists():
            raise SystemExit(f"Refusing to replace non-symlink skill directory: {link}")
        link.symlink_to(target, target_is_directory=True)
for p in (AI / "bin").iterdir():
    if p.is_file() and p.name not in {"README.md"}: p.chmod(p.stat().st_mode | 0o111)
print(f"Configured local AI home: {HOME}")
print(f"export CLAUDE_CONFIG_DIR={HOME / 'claude'}")
print(f"export CODEX_HOME={HOME / 'codex'}")
if shutil.which(os.environ.get("CODEGRAPH_COMMAND", "codegraph")):
    print("CodeGraph CLI detected; initialize task worktrees with: ai task codegraph <ID> --init")
else:
    print("CodeGraph CLI not found (optional). Install it, then run: ai task codegraph <ID> --init")
