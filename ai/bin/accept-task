#!/usr/bin/env python3
from __future__ import annotations

import argparse
from copy import deepcopy
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import (
    AI_ROOT,
    ROOT,
    configured_fail_severities,
    dirty_worktree_hash,
    ensure_task,
    git_value,
    now_iso,
    read_json,
    read_yaml,
    require_file,
    runtime_dir,
    run_delivery_quality_gates,
    validate_json,
    write_yaml,
)
from lib.docker_infra import teardown_infra


def current_finalization_matches(state: dict) -> bool:
    return (
        state.get("finalized_implementation_cycle") == int(state.get("implementation_cycle", 1))
        and state.get("finalized_change_cycle") == int(state.get("change_cycle", 0))
        and state.get("finalized_review_cycle") == int(state.get("review_cycle", 0))
    )


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Record explicit user acceptance and complete the current task cycle"
    )
    parser.add_argument("task_id")
    parser.add_argument("--accepted-by", default="user")
    parser.add_argument("--note", default="")
    args = parser.parse_args()

    td = ensure_task(args.task_id)
    task = read_yaml(td / "task.yaml")
    state = read_yaml(td / "state.yaml")
    if state.get("status") != "awaiting_user_acceptance":
        raise SystemExit(
            "Task must be awaiting_user_acceptance, found: "
            f"{state.get('status')}\nNext: run the missing implement/validate/review/report steps first."
        )
    report_path = require_file(
        td / "final-report.md",
        "current-cycle final report",
        f"run ./ai/bin/ai task report {args.task_id}",
    )

    implementation_path = require_file(
        td / "implementation.json",
        "Claude implementation handoff",
        f"run ./ai/bin/ai task implement {args.task_id}",
    )
    review_path = require_file(
        td / "review.json",
        "Codex review output",
        f"run ./ai/bin/ai task review {args.task_id}",
    )
    summary_path = require_file(
        runtime_dir(args.task_id) / "validation" / "summary.json",
        "validation summary",
        f"run ./ai/bin/ai task validate-code {args.task_id}",
    )
    validate_json(implementation_path, AI_ROOT / "schemas" / "implementation.schema.json")
    validate_json(review_path, AI_ROOT / "schemas" / "review.schema.json")
    implementation = read_json(implementation_path)
    review = read_json(review_path)
    summary = read_json(summary_path)
    run_delivery_quality_gates(args.task_id, implementation, review)

    current_implementation_cycle = int(state.get("implementation_cycle", 1))
    current_change_cycle = int(state.get("change_cycle", 0))
    cycles_match = (
        implementation.get("implementation_cycle") == current_implementation_cycle
        and implementation.get("change_cycle") == current_change_cycle
        and review.get("implementation_cycle") == current_implementation_cycle
        and review.get("change_cycle") == current_change_cycle
        and summary.get("implementation_cycle") == current_implementation_cycle
        and summary.get("change_cycle") == current_change_cycle
    )
    fail_on = configured_fail_severities(task)
    blocking_findings = [
        item for item in review.get("findings", []) if item.get("severity") in fail_on
    ]
    # The reviewer declared it reviewed a specific revision per repo (orchestrator-injected
    # in run-codex-review, not model-authored). Checked here too (not only in finalize-task)
    # so a direct manual `accept` call can't authorize acceptance for a stale review.
    reviewed_revisions = review.get("reviewed_revisions", {})
    # dirty_snapshot_sha256 (not head alone) is what actually changes mid-task: this workflow
    # never commits until acceptance, so HEAD alone would not detect a worktree edited after
    # review (see ai_common.dirty_worktree_hash's docstring).
    actual_revisions = {
        item["repo"]: {
            "head": git_value(ROOT / item["path"], ["rev-parse", "HEAD"]),
            "dirty_snapshot_sha256": dirty_worktree_hash(ROOT / item["path"]),
        }
        for item in task.get("worktrees", [])
    }
    revisions_match = all(
        reviewed_revisions.get(repo) == value for repo, value in actual_revisions.items()
    )
    # A delta review's own "pass" can never directly authorize user acceptance — it only
    # reviewed the latest fix's diff/dependencies, not the full seven passes. Checked here
    # too (not only in run-task/finalize-task) so a direct manual `accept` call can't
    # bypass the requirement for a passing full review.
    last_review_mode = state.get("last_review_mode")
    gates_passed = (
        review.get("verdict") == "pass"
        and summary.get("passed") is True
        and summary.get("dry_run") is not True
        and cycles_match
        and not blocking_findings
        and last_review_mode == "full"
        and revisions_match
        and current_finalization_matches(state)
        and report_path.is_file()
    )
    if not gates_passed:
        reasons = []
        if summary.get("dry_run") is True:
            reasons.append("validation was only a dry-run")
        if blocking_findings:
            reasons.append("configured blocking review findings remain")
        if not cycles_match:
            reasons.append("outputs belong to a different cycle")
        if last_review_mode != "full":
            reasons.append(f"last review mode was {last_review_mode!r}, not a passing full review")
        if not revisions_match:
            reasons.append("source changed since the reviewed revision; re-run review")
        if state.get("finalized_review_cycle") != int(state.get("review_cycle", 0)):
            reasons.append("final report was not generated for the current review cycle")
        raise SystemExit(
            "Acceptance blocked: current review/validation gates are not satisfied"
            + (f" ({'; '.join(reasons)})" if reasons else "")
        )

    now = now_iso()
    state_before_acceptance = deepcopy(state)
    acceptance_path = td / "acceptance.yaml"
    acceptance_before = acceptance_path.read_bytes() if acceptance_path.exists() else None
    report_before = report_path.read_bytes() if report_path.exists() else None
    acceptance = {
        "task_id": args.task_id,
        "status": "accepted",
        "accepted_at": now,
        "accepted_by": args.accepted_by,
        "accepted_change_cycle": current_change_cycle,
        "accepted_review_cycle": int(state.get("review_cycle", 0)),
        "note": args.note,
    }
    write_yaml(acceptance_path, acceptance)
    validate_json(acceptance_path, AI_ROOT / "schemas" / "user-acceptance.schema.json")

    active_change = state.get("active_change") or {}
    state["status"] = "completed"
    state["active_change"] = None
    state.setdefault("timestamps", {})["completed_at"] = now
    state["user_acceptance"] = {
        "status": "accepted",
        "accepted_at": now,
        "accepted_by": args.accepted_by,
        "accepted_change_cycle": current_change_cycle,
    }
    state["last_error"] = None
    write_yaml(td / "state.yaml", state)

    report_result = subprocess.run(
        [str(AI_ROOT / "bin" / "finalize-task"), args.task_id, "--report-only"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if report_result.returncode != 0:
        write_yaml(td / "state.yaml", state_before_acceptance)
        if acceptance_before is None:
            acceptance_path.unlink(missing_ok=True)
        else:
            acceptance_path.write_bytes(acceptance_before)
        if report_before is not None:
            report_path.write_bytes(report_before)
        raise SystemExit(
            "Acceptance was rolled back because final report regeneration failed:\n"
            + report_result.stdout
        )
    knowledge_result = subprocess.run(
        [
            str(AI_ROOT / "bin" / "update-knowledge"),
            args.task_id,
            "--apply",
            "--strict",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if knowledge_result.returncode != 0:
        write_yaml(td / "state.yaml", state_before_acceptance)
        if acceptance_before is None:
            acceptance_path.unlink(missing_ok=True)
        else:
            acceptance_path.write_bytes(acceptance_before)
        if report_before is not None:
            report_path.write_bytes(report_before)
        raise SystemExit(
            "Acceptance was rolled back because automatic knowledge application failed:\n"
            + knowledge_result.stdout
        )
    if active_change.get("path"):
        metadata_path = Path(active_change["path"])
        if not metadata_path.is_absolute():
            metadata_path = AI_ROOT.parent / metadata_path
        metadata_path = metadata_path / "metadata.yaml"
        if metadata_path.exists():
            metadata = read_yaml(metadata_path)
            metadata["status"] = "accepted"
            write_yaml(metadata_path, metadata)
    subprocess.run([str(AI_ROOT / "bin" / "rebuild-indexes")], check=False)
    try:
        teardown_infra(args.task_id)
    except Exception as exc:
        # Best-effort: acceptance itself is already durable at this point; an orphaned infra
        # stack is reclaimed later by infra-gc, not worth rolling back a completed task for.
        print(f"Warning: could not tear down validation infra for {args.task_id}: {exc}")
    if knowledge_result.stdout.strip():
        print(knowledge_result.stdout.strip())
    print(f"Accepted and completed: {args.task_id}")


if __name__ == "__main__":
    main()
