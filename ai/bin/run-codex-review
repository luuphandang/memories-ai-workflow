#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.ai_common import (
    AI_ROOT,
    ROOT,
    configured_fail_severities,
    detect_risk_categories,
    dirty_worktree_hash,
    enforce_global_git_policy,
    ensure_task,
    env_timeout_seconds,
    git_value,
    now_iso,
    read_json,
    read_yaml,
    require_file,
    requirement_documents,
    run,
    runtime_dir,
    append_agent_metric,
    verify_locked_skills,
    run_delivery_quality_gates,
    validate_json,
    write_yaml,
    write_json,
    task_risk_level,
)
from lib.codegraph import codex_mcp_overrides, prompt_guidance


def timeout_output(exc: subprocess.TimeoutExpired) -> str:
    value = exc.stdout or ""
    return value.decode(errors="replace") if isinstance(value, bytes) else value


CODEX_USAGE_FIELDS = {
    "input_tokens": "input_tokens",
    "cached_input_tokens": "cache_read_input_tokens",
    "cache_write_input_tokens": "cache_creation_input_tokens",
    "output_tokens": "output_tokens",
    "reasoning_output_tokens": "reasoning_output_tokens",
}


def codex_stream_metadata(output: str) -> tuple[dict, str]:
    """Sum usage across turn.completed events and extract the last agent message
    from `codex exec --json` output (confirmed schema: thread.started, turn.started,
    item.completed{item.type=agent_message}, turn.completed{usage})."""
    usage: dict = {}
    final_text = ""
    turns = 0
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        if event.get("type") == "turn.completed":
            turns += 1
            turn_usage = event.get("usage") or {}
            for codex_key, metric_key in CODEX_USAGE_FIELDS.items():
                value = turn_usage.get(codex_key)
                if value is not None:
                    usage[metric_key] = usage.get(metric_key, 0) + int(value)
        elif event.get("type") == "item.completed":
            item = event.get("item") or {}
            if item.get("type") == "agent_message" and item.get("text"):
                final_text = item["text"]
    if turns:
        usage["num_turns"] = turns
    return usage, final_text


def main() -> None:
    parser = argparse.ArgumentParser(description="Run Codex read-only review")
    parser.add_argument("task_id")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--print-command", action="store_true")
    parser.add_argument("--mode", choices=("auto", "full", "delta"), default="auto")
    args = parser.parse_args()

    td = ensure_task(args.task_id)
    task = read_yaml(td / "task.yaml")
    enforce_global_git_policy(task)
    fail_on = configured_fail_severities(task)
    state = read_yaml(td / "state.yaml")
    runtime = runtime_dir(args.task_id)
    review_path = td / "review.json"
    baseline_path = td / "review-baseline.json"
    baseline_instruction = (
        f"- ai/tasks/{args.task_id}/review-baseline.json (locked review scope; do not silently expand its input contract)"
        if baseline_path.exists() else
        "- No review baseline exists yet; this full review must establish one exhaustive, bounded contract."
    )
    implementation_path = require_file(
        td / "implementation.json",
        "Claude implementation handoff",
        f"run ./ai/bin/ai task implement {args.task_id}",
    )
    validation_path = require_file(
        runtime / "validation" / "summary.json",
        "validation summary",
        f"run ./ai/bin/ai task validate-code {args.task_id}",
    )
    validate_json(implementation_path, AI_ROOT / "schemas" / "implementation.schema.json")
    implementation = read_json(implementation_path)
    validation = read_json(validation_path)
    context_lock = read_json(td / "context.lock.json")
    codegraph_guidance = prompt_guidance(ROOT, context_lock)
    current_implementation_cycle = int(state.get("implementation_cycle", 1))
    current_change_cycle = int(state.get("change_cycle", 0))
    if implementation.get("implementation_cycle") != current_implementation_cycle or implementation.get("change_cycle") != current_change_cycle:
        raise SystemExit("Implementation handoff belongs to an older cycle; run Claude for the current cycle")
    if validation.get("implementation_cycle") != current_implementation_cycle or validation.get("change_cycle") != current_change_cycle:
        raise SystemExit("Validation summary belongs to an older cycle; run validation for the current cycle")
    if validation.get("dry_run") is True or validation.get("passed") is not True:
        raise SystemExit("Codex review requires a real, passing validation run; dry-run/planned validation is not sufficient")
    if validation.get("tier", "full") != "full":
        raise SystemExit("Codex review requires full validation; run validate-code --tier full")
    # This workflow never commits mid-task, so HEAD alone would not detect a worktree edited
    # after validate-code ran; compare the same dirty-worktree fingerprint validate published.
    validated_by_repo = {item.get("repo"): item for item in validation.get("repositories", [])}
    stale_repos = []
    for item in task.get("worktrees", []):
        validated_hash = (validated_by_repo.get(item["repo"]) or {}).get("git", {}).get("dirty_snapshot_sha256")
        if validated_hash != dirty_worktree_hash(ROOT / item["path"]):
            stale_repos.append(item["repo"])
    if stale_repos:
        raise SystemExit(
            "Source changed since validate-code ran in: " + ", ".join(stale_repos) +
            f"; re-run ./ai/bin/ai task validate-code {args.task_id} --tier full"
        )

    locked_skills = context_lock.get("skills", {}).get("locked", {})
    verify_locked_skills(context_lock)
    required_implementation_skills = task.get("skills", {}).get("implement", [])
    applied_implementation_skills = {item.get("name"): item for item in implementation.get("applied_skills", [])}
    missing_applied = [name for name in required_implementation_skills if name not in applied_implementation_skills]
    stale_applied = [
        name for name in required_implementation_skills
        if name in applied_implementation_skills
        and applied_implementation_skills[name].get("sha256") != locked_skills.get(name, {}).get("sha256")
    ]
    if missing_applied or stale_applied:
        parts = []
        if missing_applied:
            parts.append("missing applied skills: " + ", ".join(missing_applied))
        if stale_applied:
            parts.append("stale skill hashes: " + ", ".join(stale_applied))
        raise SystemExit("Implementation handoff failed required-skill gate: " + "; ".join(parts))
    run_delivery_quality_gates(args.task_id, implementation)

    skill_check_dir = runtime / "validation" / "skills"
    skill_check_dir.mkdir(parents=True, exist_ok=True)
    if "verify-implementation-handoff" in required_implementation_skills:
        checker = AI_ROOT / "skills" / "verify-implementation-handoff" / "scripts" / "check_handoff.py"
        check = run([sys.executable, str(checker), str(td)], cwd=ROOT, timeout=120)
        (skill_check_dir / "implementation-handoff.log").write_text(check.stdout, encoding="utf-8")
        if check.returncode != 0:
            raise SystemExit("Pre-review implementation-handoff gate failed:\n" + check.stdout)
    if "validate-evidence-provenance" in required_implementation_skills:
        synchronizer = AI_ROOT / "skills" / "validate-evidence-provenance" / "scripts" / "sync_provenance.py"
        sync = run([sys.executable, str(synchronizer), str(td), str(runtime / "validation")], cwd=ROOT, timeout=120)
        (skill_check_dir / "evidence-provenance-sync.log").write_text(sync.stdout, encoding="utf-8")
        if sync.returncode != 0:
            raise SystemExit("Pre-review evidence-provenance sync failed:\n" + sync.stdout)
        checker = AI_ROOT / "skills" / "validate-evidence-provenance" / "scripts" / "check_provenance.py"
        manifests = sorted((runtime / "validation").glob("**/provenance.json"))
        if not manifests:
            raise SystemExit("Pre-review evidence-provenance gate failed: no provenance.json manifest found")
        for index, manifest in enumerate(manifests):
            check = run([sys.executable, str(checker), str(manifest)], cwd=ROOT, timeout=120)
            (skill_check_dir / f"evidence-provenance-{index}.log").write_text(check.stdout, encoding="utf-8")
            if check.returncode != 0:
                raise SystemExit("Pre-review evidence-provenance gate failed:\n" + check.stdout)
    if "design-database-invariants" in required_implementation_skills:
        checker = AI_ROOT / "skills" / "design-database-invariants" / "scripts" / "check_invariant_matrix.py"
        matrix = runtime / "validation" / "database-invariants.json"
        if not matrix.is_file():
            raise SystemExit("Pre-review database-invariant gate failed: missing database-invariants.json")
        check = run([sys.executable, str(checker), str(matrix)], cwd=ROOT, timeout=120)
        (skill_check_dir / "database-invariants.log").write_text(check.stdout, encoding="utf-8")
        if check.returncode != 0:
            raise SystemExit("Pre-review database-invariant gate failed:\n" + check.stdout)
    if "implement-nestjs-vertical-slice" in required_implementation_skills:
        checker = AI_ROOT / "skills" / "implement-nestjs-vertical-slice" / "scripts" / "check_port_bindings.py"
        failures = []
        for item in task.get("worktrees", []):
            check = run([sys.executable, str(checker), str(ROOT / item["path"])], cwd=ROOT, timeout=120)
            (skill_check_dir / f"port-bindings-{item['repo']}.log").write_text(check.stdout, encoding="utf-8")
            if check.returncode != 0:
                failures.append(f"{item['repo']}: {check.stdout.strip()}")
        if failures:
            raise SystemExit("Pre-review NestJS wiring gate failed:\n- " + "\n- ".join(failures))

    execution_plan_path = td / "execution-plan.json"
    if task.get("scope", {}).get("execution_plan_required", False):
        matrix_script = AI_ROOT / "skills" / "review-vertical-slice-completeness" / "scripts" / "build_evidence_matrix.py"
        matrix_path = skill_check_dir / "acceptance-evidence.json"
        matrix = run([sys.executable, str(matrix_script), str(execution_plan_path), str(implementation_path), "--output", str(matrix_path), "--evidence-dir", str(td / "evidence")], cwd=ROOT, timeout=120)
        if matrix.returncode != 0:
            if matrix_path.is_file():
                evidence = read_json(matrix_path)
                detail = "missing/non-passing criteria: " + ", ".join(evidence.get("missing", []))
            else:
                detail = matrix.stdout.strip() or "evidence matrix builder failed without producing output"
            raise SystemExit("Pre-review acceptance-evidence gate failed; " + detail)

    requirements = requirement_documents(args.task_id, include_user_request=True)
    requirement_lines = "\n".join(f"- {path}" for path in requirements)
    worktree_lines = "\n".join(
        f"- {item['repo']}: {item['path']}" for item in task.get("worktrees", [])
    )
    fail_on_text = ", ".join(fail_on)
    required_review_skills = task.get("skills", {}).get("review", [])
    review_skill_lines = "\n".join(
        f"- ${name}: read {locked_skills[name]['path']} (locked skill package sha256 "
        f"{locked_skills[name]['sha256']} — this is the whole skill directory's combined hash, "
        f"not the sha256 of SKILL.md alone; do not compare it against a single-file hash)"
        for name in required_review_skills if name in locked_skills
    ) or "- none"
    def fix_request_cycle(path: Path) -> int:
        digits = "".join(ch for ch in path.stem.rsplit("-", 1)[-1] if ch.isdigit())
        return int(digits) if digits else -1

    prior_fix_requests = sorted((runtime / "input").glob("fix-request-review-*.md"), key=fix_request_cycle)
    prior_fix_lines = "\n".join(f"- {path.relative_to(ROOT)}" for path in prior_fix_requests) or "- none (first review cycle)"
    fix_text = "\n".join(path.read_text(encoding="utf-8").lower() for path in prior_fix_requests)

    # Orchestrator-computed, not model-authored: the actual current HEAD and dirty-worktree
    # hash per worktree, injected into review.json after Codex returns so a later
    # cycle/finalize can detect source drift instead of trusting a self-reported revision.
    # HEAD is kept for human-readable audit; dirty_snapshot_sha256 is what actually changes
    # mid-task (see dirty_worktree_hash's docstring) and is what finalize/accept compare.
    actual_revisions = {
        item["repo"]: {
            "head": git_value(ROOT / item["path"], ["rev-parse", "HEAD"]),
            "dirty_snapshot_sha256": dirty_worktree_hash(ROOT / item["path"]),
        }
        for item in task.get("worktrees", [])
    }

    # Durable ledger of the immediately preceding cycle's blocking findings (review.json
    # itself is overwritten every cycle, so without this a later cycle could silently drop
    # a finding from review_coverage.prior_findings and nothing would notice).
    review_history_dir = td / "review-history"
    prior_review_cycle = int(state.get("review_cycle", 0))
    prior_ledger_path = review_history_dir / f"cycle-{prior_review_cycle:03d}.json"
    prior_ledger = read_json(prior_ledger_path) if prior_review_cycle > 0 and prior_ledger_path.is_file() else None
    prior_ledger_lines = (
        "\n".join(
            f"- {item['finding_id']}: [{item['severity']}] {item['title']} ({item['repo']}:{item['file']})"
            for item in prior_ledger.get("findings", [])
        )
        if prior_ledger and prior_ledger.get("findings")
        else "- none (first review cycle, or nothing blocking last cycle)"
    )
    # Delta is only allowed directly after a FULL review produced the correction request
    # being reviewed now; this prevents delta->delta chains that never re-run the full
    # seven-pass review. Every delta pass is itself required (by run-task/finalize-task/
    # accept-task) to be followed by one more full review before report/acceptance.
    delta_safe = (
        bool(prior_fix_requests)
        and not detect_risk_categories(fix_text)
        and state.get("last_review_mode") == "full"
    )
    review_mode = args.mode if args.mode != "auto" else ("delta" if delta_safe else "full")
    if args.mode == "delta" and not delta_safe:
        raise SystemExit(
            "Delta review is unsafe here: it requires a prior full review's correction "
            "request, no sensitive-term findings, and the immediately preceding review "
            f"to have been full (last_review_mode={state.get('last_review_mode')!r}); use full review"
        )
    review_pass_instruction = (
        "Review only the latest fix request, its affected diff/dependencies, tests, and regression. "
        "Complete diff, behavior, tests, and regression passes."
        if review_mode == "delta" else
        "Complete all seven independent review passes (requirements, diff, architecture, behavior, tests, security, regression)."
    )
    prompt = f"""Review the current implementation for Jira item {args.task_id}.

Code intelligence:
{codegraph_guidance}

Current implementation cycle: {current_implementation_cycle}
Current change cycle: {current_change_cycle}
Configured blocking severities (review.fail_on): {fail_on_text}

Read in precedence order:
- ai/agents/common.md
- ai/agents/codex-reviewer.md
{requirement_lines}
- ai/tasks/{args.task_id}/task.yaml
- ai/tasks/{args.task_id}/context.lock.json
- ai/tasks/{args.task_id}/implementation.json
- worktrees/{args.task_id}/.ai/validation/summary.json

Inspect the complete Git diff in every declared worktree:
{worktree_lines}

Required review skills (read each SKILL.md completely and apply it):
{review_skill_lines}

Deterministic skill evidence:
- {skill_check_dir.relative_to(ROOT)}

Prior Codex findings that must each be retested against the current code:
{prior_fix_lines}

Prior cycle's blocking-findings ledger (retest each finding_id below against current code
and current-cycle evidence; report its current status in review_coverage.prior_findings
using the exact same finding_id so it can be matched programmatically):
{prior_ledger_lines}
Give every finding in `findings` a stable `finding_id` (e.g. "repo:file:severity:short-slug").

Review baseline:
{baseline_instruction}
New findings outside an existing baseline must be explicitly attributable to code changed by
the latest fix. If they instead require a broader input/behavior contract, report `blocked`
as a requirement gap rather than silently moving the implementation goalposts.

Review mode: {review_mode}.
Evaluate only current-cycle validation. {review_pass_instruction}
In delta mode, inventory every file affected by the latest correction and its direct dependencies;
in full mode inventory every tracked and untracked implementation file.
Do not issue a partial defect list: aggregate findings only after coverage is complete.
Before assessing existing tests, build test_matrix from both effective requirements and
the complete diff/impact analysis. Include positive, negative, boundary, regression, and
applicable security/concurrency/transaction/compatibility cases. Each case must identify
its sources (use explicit labels such as "requirement: AC..." and "diff-impact: path/symbol"),
target, level, scenario, expected result, status, and concrete evidence. Mark absent tests
as missing. A full review must contain cases from both requirement and diff-impact sources;
a delta review must contain diff-impact cases and corrected behavior/regression cases.
For every finding whose severity is in review.fail_on, include implementation_guidance
with an actionable approach, affected code locations, tests to add/change, and objective
done_when checks. Keep expected_fix as the concise outcome.
Do not modify files. Return only JSON matching ai/schemas/review.schema.json. Include
applied_skills with the locked hash and completed checks for every required review
skill, plus review_coverage with concrete evidence. Return blocked if any review pass,
changed file, applicable risk area, or prior finding remains unverified. Return
changes_requested when coverage is complete and at least one finding has a configured
blocking severity, an acceptance criterion fails, or required validation evidence is
missing. A pass means technically ready for user acceptance, not completed.
Approve a knowledge update only when its target is appropriate and its implementation entry has
type `append`, `replace`, or `create` plus complete canonical content with no placeholders. Do not
approve proposal-only or empty-content entries; they cannot be deferred to human editing.
"""
    (runtime / "input" / "codex-review-prompt.md").write_text(prompt, encoding="utf-8")

    command = os.environ.get("CODEX_COMMAND", "codex")
    timeout_seconds = env_timeout_seconds("CODEX_TIMEOUT_SECONDS", 1800)
    cmd = [
        command,
        "exec",
        "--profile",
        "review",
        "--ephemeral",
        "--sandbox",
        "read-only",
        "--skip-git-repo-check",
        "--json",
        "--cd",
        str(ROOT),
        "-c",
        f"model_reasoning_effort={'medium' if review_mode == 'delta' else task_risk_level(task, context_lock)}",
        "--output-schema",
        str(AI_ROOT / "schemas" / "review.schema.json"),
        "--output-last-message",
        str(review_path),
        prompt,
    ]
    prompt_value = cmd.pop()
    cmd.extend(codex_mcp_overrides(ROOT, context_lock))
    cmd.append(prompt_value)
    if args.print_command or args.dry_run:
        print(" ".join(shlex.quote(value) for value in cmd))
        print(f"Timeout: {timeout_seconds} seconds")
        if args.dry_run:
            return

    state["status"] = "reviewing"
    state.pop("finalized_implementation_cycle", None)
    state.pop("finalized_change_cycle", None)
    state.pop("finalized_review_cycle", None)
    state["last_review_mode"] = review_mode
    state["review_cycle"] = int(state.get("review_cycle", 0)) + 1
    state["review_cycles_total"] = int(state.get("review_cycles_total", 0)) + 1
    state.setdefault("timestamps", {})["review_started_at"] = now_iso()
    write_yaml(td / "state.yaml", state)

    log_path = runtime / "exchange" / "codex-session.log"
    started_monotonic = time.monotonic()
    try:
        result = run(cmd, cwd=ROOT, timeout=timeout_seconds)
    except subprocess.TimeoutExpired as exc:
        partial_output = timeout_output(exc)
        log_path.write_text(partial_output, encoding="utf-8")
        partial_usage, _ = codex_stream_metadata(partial_output)
        state = read_yaml(td / "state.yaml")
        state["status"] = "blocked"
        state["last_error"] = (
            f"Codex timed out after {timeout_seconds} seconds. "
            "Inspect the session log and CLI configuration before retrying."
        )
        state.setdefault("timestamps", {})["review_finished_at"] = now_iso()
        write_yaml(td / "state.yaml", state)
        append_agent_metric(args.task_id, {"generated_at": now_iso(), "agent": "codex", "phase": "review", "attempt": state.get("review_cycle", 0), "implementation_cycle": int(state.get("implementation_cycle", 1)), "change_cycle": int(state.get("change_cycle", 0)), "status": "blocked", "duration_seconds": round(time.monotonic() - started_monotonic, 2), "resumed": False, "usage": partial_usage})
        raise SystemExit(state["last_error"])

    log_path.write_text(result.stdout, encoding="utf-8")
    state = read_yaml(td / "state.yaml")
    effective_returncode = result.returncode
    review: dict | None = None
    if result.returncode != 0:
        state["status"] = "failed"
        state["last_error"] = f"Codex exited {result.returncode}; see {log_path}"
    else:
        try:
            require_file(review_path, "Codex review output", f"inspect {log_path}")
            raw_review = json.loads(review_path.read_text(encoding="utf-8"))
            if isinstance(raw_review, dict):
                raw_review["reviewed_revisions"] = actual_revisions
                write_json(review_path, raw_review)
            validate_json(review_path, AI_ROOT / "schemas" / "review.schema.json")
            review = json.loads(review_path.read_text(encoding="utf-8"))
        except (SystemExit, Exception) as exc:
            state["status"] = "failed"
            state["last_error"] = f"Codex returned invalid/unparseable review output: {exc}; see {log_path}"
            effective_returncode = 6
    if review is not None:
        coverage = review.get("review_coverage", {})
        required_passes = ({"diff", "behavior", "tests", "regression"} if review_mode == "delta" else {"requirements", "diff", "architecture", "behavior", "tests", "security", "regression"})
        completed_passes = set(coverage.get("review_passes", []))
        incomplete_coverage = []
        if not required_passes.issubset(completed_passes):
            missing_passes = sorted(required_passes - completed_passes)
            detail = ",".join(missing_passes) if missing_passes else "duplicate or unexpected pass entries"
            incomplete_coverage.append("invalid review passes: " + detail)
        if not coverage.get("changed_files"):
            incomplete_coverage.append("changed-file inventory is empty")
        if any(item.get("status") != "reviewed" for item in coverage.get("changed_files", [])):
            incomplete_coverage.append("one or more changed files were not reviewed")
        if not coverage.get("risk_areas"):
            incomplete_coverage.append("risk-area assessment is empty")
        if any(item.get("status") == "not_reviewed" for item in coverage.get("risk_areas", [])):
            incomplete_coverage.append("one or more risk areas were not reviewed")
        if prior_fix_requests and not coverage.get("prior_findings"):
            incomplete_coverage.append("prior fix requests exist but prior-findings assessment is empty")
        if any(item.get("status") == "not_verified" for item in coverage.get("prior_findings", [])):
            incomplete_coverage.append("one or more prior findings were not verified")
        if prior_ledger and prior_ledger.get("findings"):
            reported_ids = {
                item.get("finding_id") for item in coverage.get("prior_findings", []) if item.get("finding_id")
            }
            missing_ids = sorted(
                item["finding_id"] for item in prior_ledger["findings"] if item["finding_id"] not in reported_ids
            )
            if missing_ids:
                incomplete_coverage.append(
                    "prior findings ledger missing retest for: " + ", ".join(missing_ids)
                )
        if any(item.get("status") == "not_verified" for item in review.get("acceptance_criteria", [])):
            incomplete_coverage.append("one or more acceptance criteria were not verified")
        if coverage.get("completion_statement") is not True:
            incomplete_coverage.append("completion_statement is not true")
        test_matrix = review.get("test_matrix", [])
        if not test_matrix:
            incomplete_coverage.append("test matrix is empty")
        else:
            matrix_sources = "\n".join(
                source.lower()
                for case in test_matrix
                for source in case.get("sources", [])
            )
            if review_mode == "full" and not any(token in matrix_sources for token in ("requirement", "acceptance", " ac")):
                incomplete_coverage.append("test matrix has no requirement/acceptance-derived case")
            if not any(token in matrix_sources for token in ("diff", "changed", "impact", "blast")):
                incomplete_coverage.append("test matrix has no diff/impact-derived case")
            if any(case.get("status") == "missing" for case in test_matrix) and review.get("validation_assessment", {}).get("passed") is True:
                incomplete_coverage.append("test matrix contains missing cases but validation_assessment.passed is true")
        applied_review_skills = {item.get("name"): item for item in review.get("applied_skills", [])}
        missing_review_skills = [name for name in required_review_skills if name not in applied_review_skills]
        stale_review_skills = [name for name in required_review_skills if name in applied_review_skills and applied_review_skills[name].get("sha256") != locked_skills.get(name, {}).get("sha256")]
        skill_output_invalid = bool(missing_review_skills or stale_review_skills)
        if skill_output_invalid:
            state["status"] = "failed"
            state["last_error"] = "Review output failed required-skill gate: missing=" + ",".join(missing_review_skills) + "; stale=" + ",".join(stale_review_skills)
            effective_returncode = 3
        verdict = review["verdict"]
        blocking = [item for item in review.get("findings", []) if item.get("severity") in fail_on]
        if any(not item.get("implementation_guidance") for item in blocking):
            incomplete_coverage.append("one or more blocking findings lack implementation guidance")
        if skill_output_invalid:
            pass
        elif incomplete_coverage and verdict != "blocked":
            state["status"] = "failed"
            state["last_error"] = "Review output failed exhaustive-coverage gate: " + "; ".join(incomplete_coverage)
            effective_returncode = 4
        elif verdict == "pass" and blocking:
            state["status"] = "changes_requested_by_codex"
            state["last_error"] = (
                "Codex returned pass while configured blocking findings exist: "
                + ", ".join(item.get("severity", "unknown") for item in blocking)
            )
            effective_returncode = 2
        elif verdict == "changes_requested":
            state["status"] = "changes_requested_by_codex"
            state["last_error"] = None
        elif verdict == "blocked":
            state["status"] = "blocked"
            state["last_error"] = review.get("summary") or "Codex review is blocked"
        elif verdict == "pass":
            # A passing review is only a technical result.  finalize-task owns the
            # transition to awaiting_user_acceptance after it has successfully
            # rendered and recorded the current-cycle report.
            state["status"] = "reviewing"
            state["last_error"] = None
        else:
            state["status"] = "failed"
            state["last_error"] = f"Unsupported Codex verdict: {verdict}"
            effective_returncode = 5
    state.setdefault("timestamps", {})["review_finished_at"] = now_iso()
    if (
        review is not None and review_mode == "full" and not baseline_path.exists()
        and review.get("review_coverage", {}).get("completion_statement") is True
    ):
        write_json(baseline_path, {
            "task_id": args.task_id,
            "implementation_cycle": current_implementation_cycle,
            "change_cycle": current_change_cycle,
            "created_at": now_iso(),
            "acceptance_criteria": [item.get("criterion") for item in review.get("acceptance_criteria", [])],
            "risk_areas": review.get("review_coverage", {}).get("risk_areas", []),
            "test_contract": [
                {key: item.get(key) for key in ("sources", "target", "test_level", "scenario", "expected_result")}
                for item in review.get("test_matrix", [])
            ],
            "initial_findings": [
                {key: item.get(key) for key in ("severity", "repo", "file", "title", "expected_fix")}
                for item in review.get("findings", [])
            ],
        })
    if review is not None:
        review_history_dir.mkdir(parents=True, exist_ok=True)
        current_review_cycle = int(state.get("review_cycle", 0))
        ledger_findings = [
            {key: item.get(key) for key in ("finding_id", "severity", "title", "repo", "file")}
            for item in review.get("findings", [])
            if item.get("severity") in fail_on
        ]
        write_json(review_history_dir / f"cycle-{current_review_cycle:03d}.json", {
            "task_id": args.task_id,
            "review_cycle": current_review_cycle,
            "reviewed_revisions": actual_revisions,
            "findings": ledger_findings,
        })
    write_yaml(td / "state.yaml", state)
    extracted_usage, final_message = codex_stream_metadata(result.stdout)
    usage = {
        "review_mode": review_mode,
        "reasoning_effort": "medium" if review_mode == "delta" else task_risk_level(task, context_lock),
        **extracted_usage,
    }
    append_agent_metric(args.task_id, {"generated_at": now_iso(), "agent": "codex", "phase": "review", "attempt": state.get("review_cycle", 0), "implementation_cycle": int(state.get("implementation_cycle", 1)), "change_cycle": int(state.get("change_cycle", 0)), "status": state["status"], "duration_seconds": round(time.monotonic() - started_monotonic, 2), "resumed": False, "review_mode": review_mode, "usage": usage, "output_bytes": len(result.stdout.encode("utf-8"))})
    print(final_message or result.stdout)
    raise SystemExit(effective_returncode)


if __name__ == "__main__":
    main()
