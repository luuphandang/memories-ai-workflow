{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "updates"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "type",
          "summary",
          "approved"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^ai/(shared|repos|domains)/"
          },
          "type": {
            "enum": [
              "append",
              "replace",
              "create",
              "proposal"
            ]
          },
          "summary": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "category": {
            "description": "Optional durable-knowledge category, used by ai/bin/memory-publish when publishing this entry to long-term memory. Older entries without this field fall back to a filename heuristic (see ai/integrations/tencentdb-memory/publish-policy.yaml).",
            "enum": [
              "architecture_decision",
              "business_rule",
              "repository_convention",
              "known_issue",
              "implementation_pattern",
              "review_pattern",
              "api_contract",
              "source_map_knowledge"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
