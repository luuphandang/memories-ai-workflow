{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "cycle",
    "kind",
    "title",
    "created_at",
    "created_from_status",
    "status",
    "worktree_policy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "correction",
        "requirement_change"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "created_from_status": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "implemented",
        "accepted",
        "superseded"
      ]
    },
    "worktree_policy": {
      "const": "reuse_registered_worktrees"
    }
  },
  "additionalProperties": true
}
