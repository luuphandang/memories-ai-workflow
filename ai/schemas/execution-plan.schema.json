{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "implementation_cycle", "change_cycle", "status", "slices"],
  "properties": {
    "task_id": {"type": "string"},
    "implementation_cycle": {"type": "integer", "minimum": 1},
    "change_cycle": {"type": "integer", "minimum": 0},
    "status": {"enum": ["draft", "ready", "in_progress", "completed"]},
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "depends_on", "acceptance_criteria", "requirement_details", "deliverables", "tests", "validation", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "requirement_details": {"type": "object", "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
          "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"enum": ["pending", "in_progress", "completed", "blocked"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
