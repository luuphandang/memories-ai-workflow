{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "verdict",
    "reviewed_repositories",
    "reviewed_revisions",
    "findings",
    "validation_assessment",
    "acceptance_criteria",
    "knowledge_updates",
    "summary",
    "implementation_cycle",
    "change_cycle",
    "applied_skills",
    "review_coverage",
    "test_matrix"
  ],
  "properties": {
    "reviewed_revisions": {
      "type": "object",
      "description": "repo -> {head, dirty_snapshot_sha256}, orchestrator-computed and injected before schema validation; not model-authored. dirty_snapshot_sha256 (see ai_common.dirty_worktree_hash) is the field that actually changes mid-task, since this workflow never commits until acceptance -- head alone would not detect a worktree edited after review.",
      "additionalProperties": {
        "type": "object",
        "required": ["head", "dirty_snapshot_sha256"],
        "properties": {
          "head": {"type": "string"},
          "dirty_snapshot_sha256": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "applied_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256", "checks_completed"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string"},
          "checks_completed": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "task_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "changes_requested",
        "blocked"
      ]
    },
    "reviewed_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_coverage": {
      "type": "object",
      "required": ["review_passes", "changed_files", "risk_areas", "prior_findings", "completion_statement"],
      "properties": {
        "review_passes": {
          "type": "array",
          "items": {
            "enum": ["requirements", "diff", "architecture", "behavior", "tests", "security", "regression"]
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "file", "status", "evidence"],
            "properties": {
              "repo": {"type": "string"},
              "file": {"type": "string"},
              "status": {"enum": ["reviewed", "not_reviewed"]},
              "evidence": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "risk_areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["area", "status", "evidence"],
            "properties": {
              "area": {"type": "string"},
              "status": {"enum": ["reviewed", "not_applicable", "not_reviewed"]},
              "evidence": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "prior_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "title", "status", "evidence"],
            "properties": {
              "source": {"type": "string"},
              "title": {"type": "string"},
              "status": {"enum": ["resolved", "regressed", "not_applicable", "not_verified"]},
              "evidence": {"type": "string"},
              "finding_id": {
                "type": "string",
                "description": "finding_id from the prior cycle's review.json this row retests, when the source is a prior review finding."
              }
            },
            "additionalProperties": false
          }
        },
        "completion_statement": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "repo",
          "file",
          "line",
          "title",
      "evidence",
      "expected_fix",
      "implementation_guidance"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id this cycle assigns the finding, e.g. 'repo:file:severity:short-slug'. Reused verbatim by a later cycle's review_coverage.prior_findings when retesting it."
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "note"
            ]
          },
          "repo": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "expected_fix": {
            "type": "string"
          },
      "implementation_guidance": {
        "type": ["object", "null"],
            "required": ["approach", "code_locations", "tests", "done_when"],
            "properties": {
              "approach": {"type": "string", "minLength": 1},
              "code_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "done_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "test_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sources", "target", "test_level", "scenario", "expected_result", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "target": {"type": "string", "minLength": 1},
          "test_level": {"enum": ["static", "unit", "integration", "contract", "e2e", "manual"]},
          "scenario": {"type": "string", "minLength": 1},
          "expected_result": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "missing", "not_applicable"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "validation_assessment": {
      "type": "object",
      "required": [
        "passed",
        "missing"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "status"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "partial",
              "not_verified"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "knowledge_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "approved"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "implementation_cycle": {
      "type": "integer",
      "minimum": 1
    },
    "change_cycle": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
