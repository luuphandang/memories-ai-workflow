{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "summary",
    "repositories",
    "decisions",
    "assumptions",
    "validation_commands",
    "acceptance_criteria",
    "knowledge_updates",
    "implementation_cycle",
    "change_cycle"
  ],
    "properties": {
    "applied_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "checks_completed"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string"},
          "checks_completed": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "not_started",
        "implemented",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "changed_files"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "changed_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "reason"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "command",
          "result"
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "partial",
              "not_tested"
            ]
          }
        }
      }
    },
    "knowledge_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "type",
          "summary"
        ]
      }
    },
    "implementation_cycle": {
      "type": "integer",
      "minimum": 1
    },
    "change_cycle": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
