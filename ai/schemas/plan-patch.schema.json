{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["patch_id", "task_id", "base_version", "source", "reason", "changes"],
  "properties": {
    "patch_id": {"type": "string"},
    "task_id": {"type": "string"},
    "base_version": {"type": "integer", "minimum": 1},
    "source": {"type": "object", "required": ["task"], "properties": {"task": {"type": "string"}}, "additionalProperties": true},
    "reason": {"type": "string"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "slice_id"],
        "properties": {
          "type": {"enum": ["ADD_DEPENDENCY"]},
          "slice_id": {"type": "string"},
          "dependency": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
