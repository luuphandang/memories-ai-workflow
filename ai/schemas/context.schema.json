{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "mandatory",
    "repositories",
    "domains",
    "exclude"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mandatory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/item"
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "load": {
          "enum": [
            "initial",
            "on-demand"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
