{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "viewport", "state", "status"],
        "properties": {
          "route": {"type": "string", "pattern": "^/"},
          "viewport": {"type": "string", "pattern": "^[1-9][0-9]{2,3}x[1-9][0-9]{2,3}$"},
          "state": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not_verified"]},
          "reference": {"type": "string"},
          "actual": {"type": "string"},
          "reference_sha256": {"type": "string"},
          "actual_sha256": {"type": "string"},
          "comparison": {
            "type": "object",
            "properties": {
              "tool": {"type": "string", "minLength": 1},
              "tool_version": {"type": "string", "minLength": 1},
              "algorithm": {"type": "string", "minLength": 1},
              "threshold": {"type": "number"},
              "score": {"type": "number"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "if": {"properties": {"status": {"const": "passed"}}},
        "then": {
          "required": [
            "reference", "actual", "reference_sha256", "actual_sha256", "comparison"
          ],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "actual": {"type": "string", "minLength": 1},
            "reference_sha256": {"type": "string", "minLength": 1},
            "actual_sha256": {"type": "string", "minLength": 1},
            "comparison": {
              "type": "object",
              "required": ["tool", "tool_version", "algorithm", "threshold", "score"]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
