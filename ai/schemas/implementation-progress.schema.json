{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id", "implementation_cycle", "change_cycle", "updated_at",
    "completed_criteria", "changed_files", "decisions", "validation",
    "current_slice", "current_step", "remaining_steps", "notes"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "implementation_cycle": {"type": "integer", "minimum": 1},
    "change_cycle": {"type": "integer", "minimum": 0},
    "updated_at": {"type": ["string", "null"]},
    "completed_criteria": {"type": "array", "items": {"type": "string"}},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "string"}},
    "current_slice": {"type": ["string", "null"]},
    "current_step": {"type": "string"},
    "remaining_steps": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "description", "status", "evidence", "updated_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"enum": ["execution_plan", "acceptance", "review_finding", "validation"]},
          "source_ref": {"type": ["string", "null"]},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "in_progress", "completed", "blocked"]},
          "evidence": {"type": "string"},
          "updated_at": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
